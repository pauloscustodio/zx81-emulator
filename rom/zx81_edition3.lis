  1854  041c  2a0a40                    ld      hl, (E_PPC)     ; sv E_PPC_lo
  1855  041f  ed5b2340                  ld      de, (S_TOP)     ; sv S_TOP_lo
  1856  0423  a7                        and     a               ;
  1857  0424  ed52                      sbc     hl, de          ;
  1858  0426  eb                        ex      de, hl          ;
  1859  0427  3004                      jr      nc, ADDR_TOP    ; to ADDR-TOP
  1860                          
