  1092                          
  1093                          ; ------------------------------
  1094                          ; THE 'LOAD-SAVE UPDATE' ROUTINE
  1095                          ; ------------------------------
  1096                          
  1097                          LOAD_SAVE:
  1098  01fc  23                        inc     hl
  1099  01fd  eb                        ex      de, hl
  1100  01fe  2a1440                    ld      hl, (E_LINE)    ; system variable edit line E_LINE.
  1101  0201  37                        scf                     ; set carry flag
  1102  0202  ed52                      sbc     hl, de
  1103  0204  eb                        ex      de, hl
  1104  0205  d0                        ret     nc              ; return if more bytes to load/save.
  1105                          
  1106  0206  e1                        pop     hl              ; else drop return address
  1107                          
  1108                          ; ----------------------
  1109                          ; THE 'DISPLAY' ROUTINES
  1110                          ; ----------------------
  1111                          
  1112                          SLOW_FAST:
  1113  0207  213b40                    ld      hl, CDFLAG      ; Address the system variable CDFLAG.
  1114  020a  7e                        ld      a, (hl)         ; Load value to the accumulator.
  1115  020b  17                        rla                     ; rotate bit 6 to position 7.
  1116  020c  ae                        xor     (hl)            ; exclusive or with original bit 7.
  1117  020d  17                        rla                     ; rotate result out to carry.
  1118  020e  d0                        ret     nc              ; return if both bits were the same.
  1119                          
  1120                          ; Now test if this really is a ZX81 or a ZX80 running the upgraded ROM.
  1121                          ; The standard ZX80 did not have an NMI generator.
  1122                          
  1123  020f  3e7f                      ld      a, $7F          ; Load accumulator with %011111111
  1124  0211  08                        ex      af, af'         ; save in AF'
  1125                          
  1126  0212  0611                      ld      b, $11          ; A counter within which an NMI should occur
  1127                                                          ; if this is a ZX81.
  1128  0214  d3fe                      out     ($FE), a        ; start the NMI generator.
  1129                          
  1130                          ;  Note that if this is a ZX81 then the NMI will increment AF'.
  1131                          
  1132                          LOOP_11:
  1133  0216  10fe                      djnz    LOOP_11         ; self loop to give the NMI a chance to kick in.
  1134                                                          ; = 16*13 clock cycles + 8 = 216 clock cycles.
  1135                          
  1136  0218  d3fd                      out     ($FD), a        ; Turn off the NMI generator.
  1137  021a  08                        ex      af, af'         ; bring back the AF' value.
  1138  021b  17                        rla                     ; test bit 7.
  1139  021c  3008                      jr      nc, NO_SLOW     ; forward, if bit 7 is still reset, to NO-SLOW.
  1140                          
  1141                          ;   If the AF' was incremented then the NMI generator works and SLOW mode can
  1142                          ;   be set.
  1143                          
  1144  021e  cbfe                      set     7, (hl)         ; Indicate SLOW mode - Compute and Display.
  1145                          
  1146  0220  f5                        push    af              ; *             Save Main Registers
  1147  0221  c5                        push    bc              ; **
  1148  0222  d5                        push    de              ; ***
  1149  0223  e5                        push    hl              ; ****
  1150                          
  1151  0224  1803                      jr      DISPLAY_1       ; skip forward - to DISPLAY-1.
  1152                          
  1153                          ; ---
  1154                          
  1155                          NO_SLOW:
  1156  0226  cbb6                      res     6, (hl)         ; reset bit 6 of CDFLAG.
  1157  0228  c9                        ret                     ; return.
  1158                          
  1159                          ; -----------------------
  1160                          ; THE 'MAIN DISPLAY' LOOP
  1161                          ; -----------------------
  1162                          ; This routine is executed once for every frame displayed.
  1163                          
  1164                          DISPLAY_1:
  1165  0229  2a3440                    ld      hl, (FRAMES)    ; fetch two-byte system variable FRAMES.
  1166  022c  2b                        dec     hl              ; decrement frames counter.
  1167                          
  1168                          DISPLAY_P:
  1169  022d  3e7f                      ld      a, $7F          ; prepare a mask
  1170  022f  a4                        and     h               ; pick up bits 6-0 of H.
  1171  0230  b5                        or      l               ; and any bits of L.
  1172  0231  7c                        ld      a, h            ; reload A with all bits of H for PAUSE test.
  1173                          
  1174                          ;   Note both branches must take the same time.
  1175                          
  1176  0232  2003                      jr      nz, ANOTHER     ; (12/7) forward if bits 14-0 are not zero
  1177                                                          ; to ANOTHER
  1178                          
  1179  0234  17                        rla                     ; (4) test bit 15 of FRAMES.
  1180  0235  1802                      jr      OVER_NC         ; (12) forward with result to OVER-NC
  1181                          
  1182                          ; ---
  1183                          
  1184                          ANOTHER:
  1185  0237  46                        ld      b, (hl)         ; (7) Note. Harmless Nonsensical Timing weight.
  1186  0238  37                        scf                     ; (4) Set Carry Flag.
  1187                          
  1188                          ; Note. the branch to here takes either (12)(7)(4) cyles or (7)(4)(12) cycles.
  1189                          
  1190                          OVER_NC:
  1191  0239  67                        ld      h, a            ; (4)  set H to zero
  1192  023a  223440                    ld      (FRAMES), hl    ; (16) update system variable FRAMES
  1193  023d  d0                        ret     nc              ; (11/5) return if FRAMES is in use by PAUSE
  1194                                                          ; command.
  1195                          
  1196                          DISPLAY_2:
  1197  023e  cdbb02                    call    KEYBOARD        ; routine KEYBOARD gets the key row in H and
  1198                                                          ; the column in L. Reading the ports also starts
  1199                                                          ; the TV frame synchronization pulse. (VSYNC)
  1200                          
  1201  0241  ed4b2540                  ld      bc, (LAST_K)    ; fetch the last key values read from LAST_K
  1202  0245  222540                    ld      (LAST_K), hl    ; update LAST_K with new values.
  1203                          
  1204  0248  78                        ld      a, b            ; load A with previous column - will be $FF if
  1205                                                          ; there was no key.
  1206  0249  c602                      add     a, $02          ; adding two will set carry if no previous key.
  1207                          
  1208  024b  ed42                      sbc     hl, bc          ; subtract with the carry the two key values.
  1209                          
  1210                          ; If the same key value has been returned twice then HL will be zero.
  1211                          
  1212  024d  3a2740                    ld      a, (DB_ST)      ; fetch system variable DEBOUNCE
  1213  0250  b4                        or      h               ; and OR with both bytes of the difference
  1214  0251  b5                        or      l               ; setting the zero flag for the upcoming branch.
  1215                          
  1216  0252  58                        ld      e, b            ; transfer the column value to E
  1217  0253  060b                      ld      b, $0B          ; and load B with eleven
  1218                          
  1219  0255  213b40                    ld      hl, CDFLAG      ; address system variable CDFLAG
  1220  0258  cb86                      res     0, (hl)         ; reset the rightmost bit of CDFLAG
  1221  025a  2008                      jr      nz, NO_KEY      ; skip forward if debounce/diff >0 to NO-KEY
  1222                          
  1223  025c  cb7e                      bit     7, (hl)         ; test compute and display bit of CDFLAG
  1224  025e  cbc6                      set     0, (hl)         ; set the rightmost bit of CDFLAG.
  1225  0260  c8                        ret     z               ; return if bit 7 indicated fast mode.
  1226                          
  1227  0261  05                        dec     b               ; (4) decrement the counter.
  1228  0262  00                        nop                     ; (4) Timing - 4 clock cycles. ??
  1229  0263  37                        scf                     ; (4) Set Carry Flag
  1230                          
  1231                          NO_KEY:
  1232  0264  212740                    ld      hl, DB_ST       ; sv DEBOUNCE
  1233  0267  3f                        ccf                     ; Complement Carry Flag
  1234  0268  cb10                      rl      b               ; rotate left B picking up carry
  1235                                                          ;  C<-76543210<-C
  1236                          
  1237                          LOOP_B:
  1238  026a  10fe                      djnz    LOOP_B          ; self-loop while B>0 to LOOP-B
  1239                          
  1240  026c  46                        ld      b, (hl)         ; fetch value of DEBOUNCE to B
  1241  026d  7b                        ld      a, e            ; transfer column value
  1242  026e  fefe                      cp      $FE             ;
  1243  0270  9f                        sbc     a, a            ;
  1244  0271  061f                      ld      b, $1F          ;
  1245  0273  b6                        or      (hl)            ;
  1246  0274  a0                        and     b               ;
  1247  0275  1f                        rra                     ;
  1248  0276  77                        ld      (hl), a         ;
  1249                          
  1250  0277  d3ff                      out     ($FF), a        ; end the TV frame synchronization pulse.
  1251                          
  1252  0279  2a0c40                    ld      hl, (D_FILE)    ; (12) set HL to the Display File from D_FILE
  1253  027c  cbfc                      set     7, h            ; (8) set bit 15 to address the echo display.
  1254                          
  1255  027e  cd9202                    call    DISPLAY_3       ; (17) routine DISPLAY-3 displays the top set
  1256                                                          ; of blank lines.
  1257                          
  1258                          ; ---------------------
  1259                          ; THE 'VIDEO-1' ROUTINE
  1260                          ; ---------------------
  1261                          
  1262                          R_IX_1:
  1263  0281  ed5f                      ld      a, r            ; (9)  Harmless Nonsensical Timing or something
  1264                                                          ;      very clever?
  1265  0283  010119                    ld      bc, $1901       ; (10) 25 lines, 1 scanline in first.
  1266  0286  3ef5                      ld      a, $F5          ; (7)  This value will be loaded into R and
  1267                                                          ; ensures that the cycle starts at the right
  1268                                                          ; part of the display  - after 32nd character
  1269                                                          ; position.
  1270                          
  1271  0288  cdb502                    call    DISPLAY_5       ; (17) routine DISPLAY-5 completes the current
  1272                                                          ; blank line and then generates the display of
  1273                                                          ; the live picture using INT interrupts
  1274                                                          ; The final interrupt returns to the next
  1275                                                          ; address.
  1276                          
  1277                          DISPLAY_5_RET:
  1278  028b  2b                        dec     hl              ; point HL to the last NEWLINE/HALT.
  1279                          
  1280  028c  cd9202                    call    DISPLAY_3       ; routine DISPLAY-3 displays the bottom set of
  1281                                                          ; blank lines.
  1282                          
  1283                          ; ---
  1284                          
  1285                          R_IX_2:
  1286  028f  c32902                    jp      DISPLAY_1       ; jump back to DISPLAY-1
  1287                          
  1288                          ; ---------------------------------
  1289                          ; THE 'DISPLAY BLANK LINES' ROUTINE
  1290                          ; ---------------------------------
  1291                          ;   This subroutine is called twice (see above) to generate first the blank
  1292                          ;   lines at the top of the television display and then the blank lines at the
  1293                          ;   bottom of the display.
  1294                          
  1295                          DISPLAY_3:
  1296  0292  dde1                      pop     ix              ; pop the return address to IX register.
  1297                                                          ; will be either R_IX_1 or R_IX_2 - see above.
  1298                          
  1299  0294  fd4e28                    ld      c, (iy+MARGIN-IY0)
  1300                                                          ; load C with value of system constant MARGIN.
  1301  0297  fdcb3b7e                  bit     7, (iy+CDFLAG-IY0)
  1302                                                          ; test CDFLAG for compute and display.
  1303  029b  280c                      jr      z, DISPLAY_4    ; forward, with FAST mode, to DISPLAY-4
  1304                          
  1305  029d  79                        ld      a, c            ; move MARGIN to A  - 31d or 55d.
  1306  029e  ed44                      neg                     ; Negate
  1307  02a0  3c                        inc     a               ;
  1308  02a1  08                        ex      af, af'         ; place negative count of blank lines in A'
  1309                          
  1310  02a2  d3fe                      out     ($FE), a        ; enable the NMI generator.
  1311                          
  1312  02a4  e1                        pop     hl              ; ****
  1313  02a5  d1                        pop     de              ; ***
  1314  02a6  c1                        pop     bc              ; **
  1315  02a7  f1                        pop     af              ; *             Restore Main Registers
  1316                          
  1317  02a8  c9                        ret                     ; return - end of interrupt.  Return is to
  1318                                                          ; user's program - BASIC or machine code.
  1319                                                          ; which will be interrupted by every NMI.
  1320                          
  1321                          ; ------------------------
  1322                          ; THE 'FAST MODE' ROUTINES
  1323                          ; ------------------------
  1324                          
  1325                          DISPLAY_4:
  1326  02a9  3efc                      ld      a, $FC          ; (7)  load A with first R delay value
  1327  02ab  0601                      ld      b, $01          ; (7)  one row only.
  1328                          
  1329  02ad  cdb502                    call    DISPLAY_5       ; (17) routine DISPLAY-5
  1330                          
  1331  02b0  2b                        dec     hl              ; (6)  point back to the HALT.
  1332  02b1  e3                        ex      (sp), hl        ; (19) Harmless Nonsensical Timing if paired.
  1333  02b2  e3                        ex      (sp), hl        ; (19) Harmless Nonsensical Timing.
  1334  02b3  dde9                      jp      (ix)            ; (8)  to R_IX_1 or R_IX_2
  1335                          
  1336                          ; --------------------------
  1337                          ; THE 'DISPLAY-5' SUBROUTINE
  1338                          ; --------------------------
  1339                          ;   This subroutine is called from SLOW mode and FAST mode to generate the
  1340                          ;   central TV picture. With SLOW mode the R register is incremented, with
  1341                          ;   each instruction, to $F7 by the time it completes.  With fast mode, the
  1342                          ;   final R value will be $FF and an interrupt will occur as soon as the
  1343                          ;   Program Counter reaches the HALT.  (24 clock cycles)
  1344                          
  1345                          DISPLAY_5:
  1346  02b5  ed4f                      ld      r, a            ; (9) Load R from A.    R = slow: $F5 fast: $FC
  1347  02b7  3edd                      ld      a, $DD          ; (7) load future R value.        $F6       $FD
  1348                          
  1349  02b9  fb                        ei                      ; (4) Enable Interrupts           $F7       $FE
  1350                          
  1351  02ba  e9                        jp      (hl)            ; (4) jump to the echo display.   $F8       $FF
  1352                          
  1353                          ; ----------------------------------
  1354                          ; THE 'KEYBOARD SCANNING' SUBROUTINE
  1355                          ; ----------------------------------
  1356                          ; The keyboard is read during the vertical sync interval while no video is
  1357                          ; being displayed.  Reading a port with address bit 0 low i.e. $FE starts the
  1358                          ; vertical sync pulse.
  1359                          ;
  1360                          ; Returns:
  1361                          ; H = high byte (column scan mask)
  1362                          ;       %11111111   no key pressed
  1363                          ;       %11111110   column 0 - shift key pressed
  1364                          ;       %11111101   column 1 - Space Enter P 0 1 Q A - key pressed
  1365                          ;       %11111011   column 2 - . L O 9 2 W S Z - key pressed
  1366                          ;       %11110111   column 3 - M K I 8 3 E D X - key pressed
  1367                          ;       %11101111   column 4 - N J U 7 4 R F C - key pressed
  1368                          ;       %11011111   column 5 - B H Y 6 5 T G V - key pressed
  1369                          ;
  1370                          ; C = low  byte (section scan mask)
  1371                          ;       %11111111   no key pressed
  1372                          ;       %11111110   section 0 - Z X C V - key pressed
  1373                          ;       %11111101   section 1 - A S D F G - key pressed
  1374                          ;       %11111011   section 2 - Q W E R T - key pressed
  1375                          ;       %11110111   section 3 - 1 2 3 4 5 - key pressed
  1376                          ;       %11101111   section 4 - 6 7 8 9 0 - key pressed
  1377                          ;       %11011111   section 5 - Y U I O P - key pressed
  1378                          ;       %10111111   section 6 - H J K L Enter - key pressed
  1379                          ;       %01111111   section 7 - B N M . Space - key pressed
  1380                          
  1381                          KEYBOARD:
  1382  02bb  21ffff                    ld      hl, $FFFF       ; (16) prepare a buffer to take key.
  1383  02be  01fefe                    ld      bc, $FEFE       ; (20) set BC to port $FEFE. The B register,
  1384                                                          ;      with its single reset bit also acts as
  1385                                                          ;      an 8-counter.
  1386  02c1  ed78                      in      a, (c)          ; (11) read the port - all 16 bits are put on
  1387                                                          ;      the address bus.  Start VSYNC pulse.
  1388  02c3  f601                      or      $01             ; (7)  set the rightmost bit so as to ignore
  1389                                                          ;      the SHIFT key.
  1390                          
  1391                          EACH_LINE:
  1392  02c5  f6e0                      or      $E0             ; [7] OR %11100000
  1393  02c7  57                        ld      d, a            ; [4] transfer to D.
  1394  02c8  2f                        cpl                     ; [4] complement - only bits 4-0 meaningful now.
  1395  02c9  fe01                      cp      $01             ; [7] sets carry if A is zero.
  1396  02cb  9f                        sbc     a, a            ; [4] $FF if $00 else zero.
  1397  02cc  b0                        or      b               ; [7] $FF or port FE,FD,FB....
  1398  02cd  a5                        and     l               ; [4] unless more than one key, L will still be
  1399                                                          ;     $FF. if more than one key is pressed then A is
  1400                                                          ;     now invalid.
  1401  02ce  6f                        ld      l, a            ; [4] transfer to L.
  1402                          
  1403                          ; now consider the column identifier.
  1404                          
  1405  02cf  7c                        ld      a, h            ; [4] will be $FF if no previous keys.
  1406  02d0  a2                        and     d               ; [4] 111xxxxx
  1407  02d1  67                        ld      h, a            ; [4] transfer A to H
  1408                          
  1409                          ; since only one key may be pressed, H will, if valid, be one of
  1410                          ; 11111110, 11111101, 11111011, 11110111, 11101111
  1411                          ; reading from the outer column, say Q, to the inner column, say T.
  1412                          
  1413  02d2  cb00                      rlc     b               ; [8]  rotate the 8-counter/port address.
  1414                                                          ;      sets carry if more to do.
  1415  02d4  ed78                      in      a, (c)          ; [10] read another half-row.
  1416                                                          ;      all five bits this time.
  1417                          
  1418  02d6  38ed                      jr      c, EACH_LINE    ; [12](7) loop back, until done, to EACH-LINE
  1419                          
  1420                          ;   The last row read is SHIFT,Z,X,C,V  for the second time.
  1421                          
  1422  02d8  1f                        rra                     ; (4) test the shift key - carry will be reset
  1423                                                          ;     if the key is pressed.
  1424  02d9  cb14                      rl      h               ; (8) rotate left H picking up the carry giving
  1425                                                          ;     column values -
  1426                                                          ;        $FD, $FB, $F7, $EF, $DF.
  1427                                                          ;     or $FC, $FA, $F6, $EE, $DE if shifted.
  1428                          
  1429                          ;   We now have H identifying the column and L identifying the row in the
  1430                          ;   keyboard matrix.
  1431                          
  1432                          ;   This is a good time to test if this is an American or British machine.
  1433                          ;   The US machine has an extra diode that causes bit 6 of a byte read from
  1434                          ;   a port to be reset.
  1435                          
  1436  02db  17                        rla                     ; (4) compensate for the shift test.
  1437  02dc  17                        rla                     ; (4) rotate bit 7 out.
  1438  02dd  17                        rla                     ; (4) test bit 6.
  1439                          
  1440  02de  9f                        sbc     a, a            ; (4)           $FF or $00 {USA}
  1441  02df  e618                      and     $18             ; (7)           $18 or $00
  1442  02e1  c61f                      add     a, $1F          ; (7)           $37 or $1F
  1443                          
  1444                          ;   result is either 31 (USA) or 55 (UK) blank lines above and below the TV
  1445                          ;   picture.
  1446                          
  1447  02e3  322840                    ld      (MARGIN), a     ; (13) update system variable MARGIN
  1448                          
  1449  02e6  c9                        ret                     ; (10) return
  1450                          
  1451                          ; ------------------------------
  1452                          ; THE 'SET FAST MODE' SUBROUTINE
  1453                          ; ------------------------------
  1454                          
  1455                          SET_FAST:
  1456  02e7  fdcb3b7e                  bit     7, (iy+CDFLAG-IY0)
  1457                                                          ; sv CDFLAG
  1458  02eb  c8                        ret     z
  1459                          
  1460  02ec  76                        halt                    ; Wait for Interrupt
  1461  02ed  d3fd                      out     ($FD), a
  1462  02ef  fdcb3bbe                  res     7, (iy+CDFLAG-IY0)
  1463                                                          ; sv CDFLAG
  1464  02f3  c9                        ret                     ; return.
  1465                          
  1466                          ; --------------
  1467                          ; THE 'REPORT-F'
  1468                          ; --------------
  1469                          
  1470                          REPORT_F:
  1471  02f4  cf                        rst     ERROR_1         ; ERROR-1
  1472  02f5  0e                        defb    ERR_F_PROG_NAME ; Error Report: No Program Name supplied.
  1473                          
  1474                          ; --------------------------
  1475                          ; THE 'SAVE COMMAND' ROUTINE
  1476                          ; --------------------------
  1477                          
  1478                          SAVE:
  1479  02f6  cda803                    call    NAME            ; routine NAME
  1480  02f9  38f9                      jr      c, REPORT_F     ; back with null name to REPORT-F above.
  1481                          
  1482  02fb  eb                        ex      de, hl          ; HL=address of name
  1483  02fc  11cb12                    ld      de, $12CB       ; five seconds timing value
  1484                          
  1485                          HEADER:
  1486  02ff  cd460f                    call    BREAK_1         ; routine BREAK-1
  1487  0302  302e                      jr      nc, BREAK_2     ; to BREAK-2
  1488                          
  1489                          
  1490                          DELAY_1:
  1491  0304  10fe                      djnz    DELAY_1         ; to DELAY-1
  1492                          
  1493  0306  1b                        dec     de              ;
  1494  0307  7a                        ld      a, d            ;
  1495  0308  b3                        or      e               ;
  1496  0309  20f4                      jr      nz, HEADER      ; back for delay to HEADER
  1497                          
  1498                          OUT_NAME:
  1499  030b  cd1e03                    call    OUT_BYTE        ; routine OUT-BYTE
  1500  030e  cb7e                      bit     7, (hl)         ; test for inverted bit.
  1501  0310  23                        inc     hl              ; address next character of name.
  1502  0311  28f8                      jr      z, OUT_NAME     ; back if not inverted to OUT-NAME
  1503                          
  1504                          ; now start saving the system variables onwards.
  1505                          
  1506  0313  210940                    ld      hl, VERSN       ; set start of area to VERSN thereby
  1507                                                          ; preserving RAMTOP etc.
  1508                          
  1509                          OUT_PROG:
  1510  0316  cd1e03                    call    OUT_BYTE        ; routine OUT-BYTE
  1511                          
  1512  0319  cdfc01                    call    LOAD_SAVE       ; routine LOAD/SAVE                     >>
  1513  031c  18f8                      jr      OUT_PROG        ; loop back to OUT-PROG
  1514                          
  1515                          ; -------------------------
  1516                          ; THE 'OUT-BYTE' SUBROUTINE
  1517                          ; -------------------------
  1518                          ; This subroutine outputs a byte a bit at a time to a domestic tape recorder.
  1519                          
  1520                          OUT_BYTE:
  1521  031e  5e                        ld      e, (hl)         ; fetch byte to be saved.
  1522  031f  37                        scf                     ; set carry flag - as a marker.
  1523                          
  1524                          EACH_BIT:
  1525  0320  cb13                      rl      e               ;  C < 76543210 < C
  1526  0322  c8                        ret     z               ; return when the marker bit has passed
  1527                                                          ; right through.                        >>
  1528                          
  1529  0323  9f                        sbc     a, a            ; $FF if set bit or $00 with no carry.
  1530  0324  e605                      and     $05             ; $05               $00
  1531  0326  c604                      add     a, $04          ; $09               $04
  1532  0328  4f                        ld      c, a            ; transfer timer to C. a set bit has a longer
  1533                                                          ; pulse than a reset bit.
  1534                          
  1535                          PULSES:
  1536  0329  d3ff                      out     ($FF), a        ; pulse to cassette.
  1537  032b  0623                      ld      b, $23          ; set timing constant
  1538                          
  1539                          DELAY_2:
  1540  032d  10fe                      djnz    DELAY_2         ; self-loop to DELAY-2
  1541                          
  1542  032f  cd460f                    call    BREAK_1         ; routine BREAK-1 test for BREAK key.
  1543                          
  1544                          BREAK_2:
  1545  0332  3072                      jr      nc, REPORT_D    ; forward with break to REPORT-D
  1546                          
  1547  0334  061e                      ld      b, $1E          ; set timing value.
  1548                          
  1549                          DELAY_3:
  1550  0336  10fe                      djnz    DELAY_3         ; self-loop to DELAY-3
  1551                          
  1552  0338  0d                        dec     c               ; decrement counter
  1553  0339  20ee                      jr      nz, PULSES      ; loop back to PULSES
  1554                          
  1555                          DELAY_4:
  1556  033b  a7                        and     a               ; clear carry for next bit test.
  1557  033c  10fd                      djnz    DELAY_4         ; self loop to DELAY-4 (B is zero - 256)
  1558                          
  1559  033e  18e0                      jr      EACH_BIT        ; loop back to EACH-BIT
  1560                          
  1561                          ; --------------------------
  1562                          ; THE 'LOAD COMMAND' ROUTINE
  1563                          ; --------------------------
  1564                          ;
  1565                          ;
  1566                          
  1567                          LOAD:
  1568  0340  cda803                    call    NAME            ; routine NAME
  1569                          
  1570                          ; DE points to start of name in RAM.
  1571                          
  1572  0343  cb12                      rl      d               ; pick up carry
  1573  0345  cb0a                      rrc     d               ; carry now in bit 7.
  1574                          
  1575                          ; DE address of file name, with bit 15=1 if file name was empty
  1576                          
  1577                          NEXT_PROG:
  1578  0347  cd4c03                    call    IN_BYTE         ; routine IN-BYTE
  1579  034a  18fb                      jr      NEXT_PROG       ; loop to NEXT-PROG
  1580                          
  1581                          ; ------------------------
  1582                          ; THE 'IN-BYTE' SUBROUTINE
  1583                          ; ------------------------
  1584                          
  1585                          IN_BYTE:
  1586  034c  0e01                      ld      c, $01          ; prepare an eight counter 00000001.
  1587                          
  1588                          NEXT_BIT:
  1589  034e  0600                      ld      b, $00          ; set counter to 256
  1590                          
  1591                          BREAK_3:
  1592  0350  3e7f                      ld      a, $7F          ; read the keyboard row
  1593  0352  dbfe                      in      a, ($FE)        ; with the SPACE key.
  1594                          
  1595  0354  d3ff                      out     ($FF), a        ; output signal to screen.
  1596                          
  1597  0356  1f                        rra                     ; test for SPACE pressed.
  1598  0357  3049                      jr      nc, BREAK_4     ; forward if so to BREAK-4
  1599                          
  1600  0359  17                        rla                     ; reverse above rotation
  1601  035a  17                        rla                     ; test tape bit.
  1602  035b  3828                      jr      c, GET_BIT      ; forward if set to GET-BIT
  1603                          
  1604  035d  10f1                      djnz    BREAK_3         ; loop back to BREAK-3
  1605                          
  1606  035f  f1                        pop     af              ; drop the return address.
  1607  0360  ba                        cp      d               ; ugh.
  1608                          
  1609                          RESTART:
  1610  0361  d2e503                    jp      nc, INITIAL     ; jump forward to INITIAL if D is zero
  1611                                                          ; to reset the system
  1612                                                          ; if the tape signal has timed out for example
  1613                                                          ; if the tape is stopped. Not just a simple
  1614                                                          ; report as some system variables will have
  1615                                                          ; been overwritten.
  1616                          
  1617  0364  62                        ld      h, d            ; else transfer the start of name
  1618  0365  6b                        ld      l, e            ; to the HL register
  1619                          
  1620                          IN_NAME:
  1621  0366  cd4c03                    call    IN_BYTE         ; routine IN-BYTE is sort of recursion for name
  1622                                                          ; part. received byte in C.
  1623  0369  cb7a                      bit     7, d            ; is name the null string ?
  1624  036b  79                        ld      a, c            ; transfer byte to A.
  1625  036c  2003                      jr      nz, MATCHING    ; forward with null string to MATCHING
  1626                          
  1627  036e  be                        cp      (hl)            ; else compare with string in memory.
  1628  036f  20d6                      jr      nz, NEXT_PROG   ; back with mis-match to NEXT-PROG
  1629                                                          ; (seemingly out of subroutine but return
  1630                                                          ; address has been dropped).
  1631                          
  1632                          MATCHING:
  1633  0371  23                        inc     hl              ; address next character of name
  1634  0372  17                        rla                     ; test for inverted bit.
  1635  0373  30f1                      jr      nc, IN_NAME     ; back if not to IN-NAME
  1636                          
  1637                          ; the name has been matched in full.
  1638                          ; proceed to load the data but first increment the high byte of E_LINE, which
  1639                          ; is one of the system variables to be loaded in. Since the low byte is loaded
  1640                          ; before the high byte, it is possible that, at the in-between stage, a false
  1641                          ; value could cause the load to end prematurely - see  LOAD/SAVE check.
  1642                          
  1643  0375  fd3415                    inc     (iy+E_LINE+1-IY0)
  1644                                                          ; increment system variable E_LINE_hi.
  1645  0378  210940                    ld      hl, VERSN       ; start loading at system variable VERSN.
  1646                          
  1647                          IN_PROG:
  1648  037b  50                        ld      d, b            ; set D to zero as indicator.
  1649  037c  cd4c03                    call    IN_BYTE         ; routine IN-BYTE loads a byte
  1650  037f  71                        ld      (hl), c         ; insert assembled byte in memory.
  1651  0380  cdfc01                    call    LOAD_SAVE       ; routine LOAD/SAVE                     >>
  1652  0383  18f6                      jr      IN_PROG         ; loop back to IN-PROG
  1653                          
  1654                          ; ---
  1655                          
  1656                          ; this branch assembles a full byte before exiting normally
  1657                          ; from the IN-BYTE subroutine.
  1658                          
  1659                          GET_BIT:
  1660  0385  d5                        push    de              ; save the
  1661  0386  1e94                      ld      e, $94          ; timing value.
  1662                          
  1663                          TRAILER:
  1664  0388  061a                      ld      b, $1A          ; counter to twenty six.
  1665                          
  1666                          COUNTER:
  1667  038a  1d                        dec     e               ; decrement the measuring timer.
  1668  038b  dbfe                      in      a, ($FE)        ; read the
  1669  038d  17                        rla                     ;
  1670  038e  cb7b                      bit     7, e            ;
  1671  0390  7b                        ld      a, e            ;
  1672  0391  38f5                      jr      c, TRAILER      ; loop back with carry to TRAILER
  1673                          
  1674  0393  10f5                      djnz    COUNTER         ; to COUNTER
  1675                          
  1676  0395  d1                        pop     de              ;
  1677  0396  2004                      jr      nz, BIT_DONE    ; to BIT-DONE
  1678                          
  1679  0398  fe56                      cp      $56             ;
  1680  039a  30b2                      jr      nc, NEXT_BIT    ; to NEXT-BIT
  1681                          
  1682                          BIT_DONE:
  1683  039c  3f                        ccf                     ; complement carry flag
  1684  039d  cb11                      rl      c               ;
  1685  039f  30ad                      jr      nc, NEXT_BIT    ; to NEXT-BIT
  1686                          
  1687  03a1  c9                        ret                     ; return with full byte.
  1688                          
  1689                          ; ---
  1690                          
  1691                          ; if break is pressed while loading data then perform a reset.
  1692                          ; if break pressed while waiting for program on tape then OK to break.
  1693                          
  1694                          BREAK_4:
  1695  03a2  7a                        ld      a, d            ; transfer indicator to A.
  1696  03a3  a7                        and     a               ; test for zero.
  1697  03a4  28bb                      jr      z, RESTART      ; back if so to RESTART
  1698                          
  1699                          
  1700                          REPORT_D:
  1701  03a6  cf                        rst     ERROR_1         ; ERROR-1
  1702  03a7  0c                        defb    ERR_D_BREAK     ; Error Report: BREAK - CONT repeats
  1703                          
  1704                          ; -----------------------------
  1705                          ; THE 'PROGRAM NAME' SUBROUTINE
  1706                          ; -----------------------------
  1707                          ; Enters with CH_ADD pointing at the file name
  1708                          ; Parses the file name, error if it is a number
  1709                          ; Exits with DE=address of file name, BC=length-1, HL=addresss of last char,
  1710                          ; last char inverted
  1711                          ; Carry Set if file name was null
  1712                          ;
  1713                          
  1714                          NAME:
  1715  03a8  cd550f                    call    SCANNING        ; routine SCANNING
  1716  03ab  3a0140                    ld      a, (FLAGS)      ; sv FLAGS
  1717  03ae  87                        add     a, a            ; bit 6 -> sign bit: Numeric or String result
  1718  03af  fa9a0d                    jp      m, REPORT_C     ; to REPORT-C; was 1, String result
  1719                          
  1720  03b2  e1                        pop     hl              ; return to caller of SAVE
  1721  03b3  d0                        ret     nc              ; bit 7 -> carry; 0=syntax check only
  1722                          
  1723  03b4  e5                        push    hl              ; restore return address
  1724  03b5  cde702                    call    SET_FAST        ; routine SET-FAST
  1725  03b8  cdf813                    call    STK_FETCH       ; routine STK-FETCH
  1726                                                          ; DE=address of name, BC=size of string
  1727  03bb  626b                      ld      hl, de          ; HL=address
  1728  03bd  0d                        dec     c               ; size--
  1729  03be  f8                        ret     m               ; Null name, return Carry set
  1730                          
  1731  03bf  09                        add     hl, bc          ; Point to last character
  1732  03c0  cbfe                      set     7, (hl)         ; Invert it
  1733  03c2  c9                        ret                     ;
  1734                          
  1735                          ; -------------------------
  1736                          ; THE 'NEW' COMMAND ROUTINE
  1737                          ; -------------------------
  1738                          ;
  1739                          ;
  1740                          
  1741                          NEW:
  1742  03c3  cde702                    call    SET_FAST        ; routine SET-FAST
  1743                          
  1744  03c6  ed4b0440                  ld      bc, (RAMTOP)    ; fetch value of system variable RAMTOP
  1745  03ca  0b                        dec     bc              ; point to last system byte.
  1746                          
  1747                          ; -----------------------
  1748                          ; THE 'RAM CHECK' ROUTINE
  1749                          ; -----------------------
  1750                          ;
  1751                          ;
  1752                          
  1753                          
  1754                          RAM_CHECK:
  1755  03cb  60                        ld      h, b
  1756  03cc  69                        ld      l, c
  1757  03cd  3e3f                      ld      a, $3F
  1758                          
  1759                          RAM_FILL:
  1760  03cf  3602                      ld      (hl), $02
  1761  03d1  2b                        dec     hl
  1762  03d2  bc                        cp      h
  1763  03d3  20fa                      jr      nz, RAM_FILL    ; to RAM-FILL
  1764                          
  1765                          RAM_READ:
  1766  03d5  a7                        and     a
  1767  03d6  ed42                      sbc     hl, bc
  1768  03d8  09                        add     hl, bc
  1769  03d9  23                        inc     hl
  1770  03da  3006                      jr      nc, SET_TOP     ; to SET-TOP
  1771                          
  1772  03dc  35                        dec     (hl)
  1773  03dd  2803                      jr      z, SET_TOP      ; to SET-TOP
  1774                          
  1775  03df  35                        dec     (hl)
  1776  03e0  28f3                      jr      z, RAM_READ     ; to RAM-READ
  1777                          
  1778                          SET_TOP:
  1779  03e2  220440                    ld      (RAMTOP), hl    ; set system variable RAMTOP to first byte
  1780                                                          ; above the BASIC system area.
  1781                          
  1782                          
  1783                          
  1784                          ; ----------------------------
  1785                          ; THE 'INITIALIZATION' ROUTINE
  1786                          ; ----------------------------
  1787                          ;
  1788                          ;
  1789                          
  1790                          INITIAL:
  1791  03e5  2a0440                    ld      hl, (RAMTOP)    ; fetch system variable RAMTOP.
  1792  03e8  2b                        dec     hl              ; point to last system byte.
  1793  03e9  363e                      ld      (hl), $3E       ; make GO SUB end-marker $3E - too high for
  1794                                                          ; high order byte of line number.
  1795                                                          ; (was $3F on ZX80)
  1796  03eb  2b                        dec     hl              ; point to unimportant low-order byte.
  1797  03ec  f9                        ld      sp, hl          ; and initialize the stack-pointer to this
  1798                                                          ; location.
  1799  03ed  2b                        dec     hl              ; point to first location on the machine stack
  1800  03ee  2b                        dec     hl              ; which will be filled by next CALL/PUSH.
  1801  03ef  220240                    ld      (ERR_SP), hl    ; set the error stack pointer ERR_SP to
  1802                                                          ; the base of the now empty machine stack.
  1803                          
  1804                          ; Now set the I register so that the video hardware knows where to find the
  1805                          ; character set. This ROM only uses the character set when printing to
  1806                          ; the ZX Printer. The TV picture is formed by the external video hardware.
  1807                          ; Consider also, that this 8K ROM can be retro-fitted to the ZX80 instead of
  1808                          ; its original 4K ROM so the video hardware could be on the ZX80.
  1809                          
  1810  03f2  3e1e                      ld      a, char_set >> 8; address for this ROM is $1E00.
  1811  03f4  ed47                      ld      i, a            ; set I register from A.
  1812  03f6  ed56                      im      1               ; select Z80 Interrupt Mode 1.
  1813                          
  1814  03f8  fd210040                  ld      iy, ERR_NR      ; set IY to the start of RAM so that the
  1815                                                          ; system variables can be indexed.
  1816  03fc  fd363b40                  ld      (iy+CDFLAG-IY0), $40
  1817                                                          ; set CDFLAG 0100 0000. Bit 6 indicates
  1818                                                          ; Compute and Display required.
  1819                          
  1820  0400  217d40                    ld      hl, PROG        ; The first location after System Variables -
  1821                                                          ; 16509 decimal.
  1822                          
  1823                          
  1824  0403  220c40                    ld      (D_FILE), hl    ; set system variable D_FILE to this value.
  1825  0406  0619                      ld      b, $19          ; prepare minimal screen of 24 NEWLINEs
  1826                                                          ; following an initial NEWLINE.
  1827                          
  1828                          LINE:
  1829  0408  3676                      ld      (hl), $76       ; insert NEWLINE (HALT instruction)
  1830  040a  23                        inc     hl              ; point to next location.
  1831  040b  10fb                      djnz    LINE            ; loop back for all twenty five to LINE
  1832                          
  1833  040d  221040                    ld      (VARS), hl      ; set system variable VARS to next location
  1834                          
  1835  0410  cd9a14                    call    CLEAR           ; routine CLEAR sets $80 end-marker and the
  1836                                                          ; dynamic memory pointers E_LINE, STKBOT and
  1837                                                          ; STKEND.
  1838                          
  1839                          NL_ONLY:
  1840  0413  cdad14                    call    CURSOR_IN       ; routine CURSOR-IN inserts the cursor and
  1841                                                          ; end-marker in the Edit Line also setting
  1842                                                          ; size of lower display to two lines.
  1843                          
  1844  0416  cd0702                    call    SLOW_FAST       ; routine SLOW/FAST selects COMPUTE and DISPLAY
  1845                          
