  2460                                                          ; sv ERR_NR
  2461  068a  2822                      jr      z, STOP_LINE    ; to STOP-LINE
  2462                          
  2463  068c  2a2940                    ld      hl, (NXTLIN)    ; sv NXTLIN_lo
  2464  068f  a6                        and     (hl)            ;
  2465  0690  201c                      jr      nz, STOP_LINE   ; to STOP-LINE
  2466                          
  2467  0692  56                        ld      d, (hl)         ;
  2468  0693  23                        inc     hl              ;
  2469  0694  5e                        ld      e, (hl)         ;
  2470  0695  ed530740                  ld      (PPC), de       ; sv PPC_lo
  2471  0699  23                        inc     hl              ;
  2472  069a  5e                        ld      e, (hl)         ;
  2473  069b  23                        inc     hl              ;
  2474  069c  56                        ld      d, (hl)         ;
  2475  069d  23                        inc     hl              ;
  2476  069e  eb                        ex      de, hl          ;
  2477  069f  19                        add     hl, de          ;
  2478  06a0  cd460f                    call    BREAK_1         ; routine BREAK-1
  2479  06a3  38c7                      jr      c, NEXT_LINE    ; to NEXT-LINE
  2480                          
  2481  06a5  210040                    ld      hl, ERR_NR      ; sv ERR_NR
  2482  06a8  cb7e                      bit     7, (hl)         ;
  2483  06aa  2802                      jr      z, STOP_LINE    ; to STOP-LINE
  2484                          
  2485  06ac  360c                      ld      (hl), ERR_D_BREAK
  2486                          
  2487                          STOP_LINE:
  2488  06ae  fdcb387e                  bit     7, (iy+PR_CC-IY0)
  2489                                                          ; sv PR_CC
