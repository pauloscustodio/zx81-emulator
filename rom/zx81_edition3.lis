  6569                          ; -----------------------
  6570                          ; THE 'CURSOR-IN' ROUTINE
  6571                          ; -----------------------
  6572                          ; This routine is called to set the edit line to the minimum cursor/newline
  6573                          ; and to set STKEND, the start of free space, at the next position.
  6574                          
  6575                          CURSOR_IN:
  6576  14ad  2a1440                    ld      hl, (E_LINE)    ; fetch start of edit line from E_LINE
  6577  14b0  367f                      ld      (hl), $7F       ; insert cursor character
  6578                          
  6579  14b2  23                        inc     hl              ; point to next location.
  6580  14b3  3676                      ld      (hl), $76       ; insert NEWLINE character
  6581  14b5  23                        inc     hl              ; point to next free location.
  6582                          
  6583  14b6  fd362202                  ld      (iy+DF_SZ-IY0), $02
  6584                                                          ; set lower screen display file size DF_SZ
  6585                          
  6586  14ba  18ea                      jr      SET_STK_B       ; exit via SET-STK-B above
  6587                          
  6588                          ; ------------------------
  6589                          ; THE 'SET-MIN' SUBROUTINE
  6590                          ; ------------------------
  6591                          ;
  6592                          ;
