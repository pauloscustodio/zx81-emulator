  4493                          
  4494                          ; --------------------------------
  4495                          ; THE 'NUMBER TO STACK' SUBROUTINE
  4496                          ; --------------------------------
  4497                          ;
  4498                          ;
  4499                          
  4500                          NO_TO_STK:
  4501  0d9c  20f4                      jr      nz, CLASS_6     ; back to CLASS-6 with a non-zero number.
  4502                          
  4503  0d9e  cda60d                    call    SYNTAX_Z        ; routine SYNTAX-Z
  4504  0da1  c8                        ret     z               ; return if checking syntax.
  4505                          
  4506                          ; in runtime a zero default is placed on the calculator stack.
  4507                          
  4508  0da2  ef                        rst     FP_CALC         ;; FP-CALC
  4509  0da3  a0                        defb    $A0             ;;stk-zero
  4510  0da4  34                        defb    $34             ;;end-calc
  4511                          
  4512  0da5  c9                        ret                     ; return.
  4513                          
  4514                          ; -------------------------
  4515                          ; THE 'SYNTAX-Z' SUBROUTINE
  4516                          ; -------------------------
  4517                          ; This routine returns with zero flag set if checking syntax.
  4518                          ; Calling this routine uses three instruction bytes compared to four if the
  4519                          ; bit test is implemented inline.
  4520                          
  4521                          SYNTAX_Z:
  4522  0da6  fdcb017e                  bit     7, (iy+FLAGS-IY0)
  4523                                                          ; test FLAGS  - checking syntax only?
  4524  0daa  c9                        ret                     ; return.
  4525                          
  4526                          ; ------------------------
  4527                          ; THE 'IF' COMMAND ROUTINE
  4528                          ; ------------------------
  4529                          ; In runtime, the class routines have evaluated the test expression and
  4530                          ; the result, true or false, is on the stack.
  4531                          
  4532                          IF:
  4533  0dab  cda60d                    call    SYNTAX_Z        ; routine SYNTAX-Z
  4534  0dae  2806                      jr      z, IF_END       ; forward if checking syntax to IF-END
  4535                          
  4536                          ; else delete the Boolean value on the calculator stack.
  4537                          
  4538  0db0  ef                        rst     FP_CALC         ;; FP-CALC
  4539  0db1  02                        defb    $02             ;;delete
  4540  0db2  34                        defb    $34             ;;end-calc
  4541                          
  4542                          ; register DE points to exponent of floating point value.
  4543                          
  4544  0db3  1a                        ld      a, (de)         ; fetch exponent.
  4545  0db4  a7                        and     a               ; test for zero - FALSE.
  4546  0db5  c8                        ret     z               ; return if so.
  4547                          
  4548                          IF_END:
  4549  0db6  c3de0c                    jp      LINE_NULL       ; jump back to LINE-NULL
  4550                          
  4551                          ; -------------------------
  4552                          ; THE 'FOR' COMMAND ROUTINE
  4553                          ; -------------------------
  4554                          ;
  4555                          ;
  4556                          
  4557                          FOR:
  4558  0db9  fee0                      cp      $E0             ; is current character 'STEP' ?
  4559  0dbb  2009                      jr      nz, F_USE_ONE   ; forward if not to F-USE-ONE
  4560                          
  4561                          
  4562  0dbd  e7                        rst     NEXT_CHAR       ; NEXT-CHAR
  4563  0dbe  cd920d                    call    CLASS_6         ; routine CLASS-6 stacks the number
  4564  0dc1  cd1d0d                    call    CHECK_END       ; routine CHECK-END
  4565  0dc4  1806                      jr      F_REORDER       ; forward to F-REORDER
  4566                          
  4567                          ; ---
  4568                          
  4569                          F_USE_ONE:
  4570  0dc6  cd1d0d                    call    CHECK_END       ; routine CHECK-END
  4571                          
  4572  0dc9  ef                        rst     FP_CALC         ;; FP-CALC
  4573  0dca  a1                        defb    $A1             ;;stk-one
  4574  0dcb  34                        defb    $34             ;;end-calc
  4575                          
  4576                          
  4577                          
  4578                          F_REORDER:
  4579  0dcc  ef                        rst     FP_CALC         ;; FP-CALC      v, l, s.
  4580  0dcd  c0                        defb    $C0             ;;st-mem-0      v, l, s.
  4581  0dce  02                        defb    $02             ;;delete        v, l.
  4582  0dcf  01                        defb    $01             ;;exchange      l, v.
  4583  0dd0  e0                        defb    $E0             ;;get-mem-0     l, v, s.
  4584  0dd1  01                        defb    $01             ;;exchange      l, s, v.
  4585  0dd2  34                        defb    $34             ;;end-calc      l, s, v.
  4586                          
  4587  0dd3  cd2113                    call    LET             ; routine LET
  4588                          
  4589  0dd6  221f40                    ld      (MEM), hl       ; set MEM to address variable.
  4590  0dd9  2b                        dec     hl              ; point to letter.
  4591  0dda  7e                        ld      a, (hl)         ;
  4592  0ddb  cbfe                      set     7, (hl)         ;
  4593  0ddd  010600                    ld      bc, $0006       ;
  4594  0de0  09                        add     hl, bc          ;
  4595  0de1  07                        rlca                    ;
  4596  0de2  3806                      jr      c, F_LMT_STP    ; to F-LMT-STP
  4597                          
  4598  0de4  cb21                      sla     c               ;
  4599  0de6  cd9e09                    call    MAKE_ROOM       ; routine MAKE-ROOM
  4600  0de9  23                        inc     hl              ;
  4601                          
  4602                          F_LMT_STP:
  4603  0dea  e5                        push    hl              ;
  4604                          
  4605  0deb  ef                        rst     FP_CALC         ;; FP-CALC
  4606  0dec  02                        defb    $02             ;;delete
  4607  0ded  02                        defb    $02             ;;delete
  4608  0dee  34                        defb    $34             ;;end-calc
  4609                          
  4610  0def  e1                        pop     hl              ;
  4611  0df0  eb                        ex      de, hl          ;
  4612                          
  4613  0df1  0e0a                      ld      c, $0A          ; ten bytes to be moved.
  4614  0df3  edb0                      ldir                    ; copy bytes
  4615                          
  4616  0df5  2a0740                    ld      hl, (PPC)       ; set HL to system variable PPC current line.
  4617  0df8  eb                        ex      de, hl          ; transfer to DE, variable pointer to HL.
  4618  0df9  13                        inc     de              ; loop start will be this line + 1 at least.
  4619  0dfa  73                        ld      (hl), e         ;
  4620  0dfb  23                        inc     hl              ;
  4621  0dfc  72                        ld      (hl), d         ;
  4622  0dfd  cd5a0e                    call    NEXT_LOOP       ; routine NEXT-LOOP considers an initial pass.
  4623  0e00  d0                        ret     nc              ; return if possible.
  4624                          
  4625                          ; else program continues from point following matching NEXT.
  4626                          
  4627  0e01  fdcb087e                  bit     7, (iy+PPC+1-IY0)
  4628                                                          ; test PPC_hi
  4629  0e05  c0                        ret     nz              ; return if over 32767 ???
  4630                          
  4631  0e06  fd462e                    ld      b, (iy+STRLEN-IY0)
  4632                                                          ; fetch variable name from STRLEN_lo
  4633  0e09  cbb0                      res     6, b            ; make a true letter.
  4634  0e0b  2a2940                    ld      hl, (NXTLIN)    ; set HL from NXTLIN
  4635                          
  4636                          ; now enter a loop to look for matching next.
  4637                          
  4638                          NXTLIN_NO:
  4639  0e0e  7e                        ld      a, (hl)         ; fetch high byte of line number.
  4640  0e0f  e6c0                      and     $C0             ; mask off low bits $3F
  4641  0e11  2017                      jr      nz, FOR_END     ; forward at end of program to FOR-END
  4642                          
  4643  0e13  c5                        push    bc              ; save letter
  4644  0e14  cdf209                    call    NEXT_ONE        ; routine NEXT-ONE finds next line.
  4645  0e17  c1                        pop     bc              ; restore letter
  4646                          
  4647  0e18  23                        inc     hl              ; step past low byte
  4648  0e19  23                        inc     hl              ; past the
  4649  0e1a  23                        inc     hl              ; line length.
  4650  0e1b  cd4c00                    call    TEMP_PTR1       ; routine TEMP-PTR1 sets CH_ADD
  4651                          
  4652  0e1e  df                        rst     GET_CHAR        ; GET-CHAR
  4653  0e1f  fef3                      cp      $F3             ; compare to 'NEXT'.
  4654  0e21  eb                        ex      de, hl          ; next line to HL.
  4655  0e22  20ea                      jr      nz, NXTLIN_NO   ; back with no match to NXTLIN-NO
  4656                          
  4657                          ;
  4658                          
  4659  0e24  eb                        ex      de, hl          ; restore pointer.
  4660                          
  4661  0e25  e7                        rst     NEXT_CHAR       ; NEXT-CHAR advances and gets letter in A.
  4662  0e26  eb                        ex      de, hl          ; save pointer
  4663  0e27  b8                        cp      b               ; compare to variable name.
  4664  0e28  20e4                      jr      nz, NXTLIN_NO   ; back with mismatch to NXTLIN-NO
  4665                          
  4666                          FOR_END:
  4667  0e2a  222940                    ld      (NXTLIN), hl    ; update system variable NXTLIN
  4668  0e2d  c9                        ret                     ; return.
  4669                          
  4670                          ; --------------------------
  4671                          ; THE 'NEXT' COMMAND ROUTINE
  4672                          ; --------------------------
  4673                          ;
  4674                          ;
  4675                          
  4676                          NEXT:
  4677  0e2e  fdcb2d4e                  bit     1, (iy+FLAGX-IY0)
  4678                                                          ; sv FLAGX
  4679  0e32  c24b0d                    jp      nz, REPORT_2    ; to REPORT-2
  4680                          
  4681  0e35  2a1240                    ld      hl, (DEST)      ; DEST
  4682  0e38  cb7e                      bit     7, (hl)         ;
  4683  0e3a  281c                      jr      z, REPORT_1     ; to REPORT-1
  4684                          
  4685  0e3c  23                        inc     hl              ;
  4686  0e3d  221f40                    ld      (MEM), hl       ; sv MEM_lo
  4687                          
  4688  0e40  ef                        rst     FP_CALC         ;; FP-CALC
  4689  0e41  e0                        defb    $E0             ;;get-mem-0
  4690  0e42  e2                        defb    $E2             ;;get-mem-2
  4691  0e43  0f                        defb    $0F             ;;addition
  4692  0e44  c0                        defb    $C0             ;;st-mem-0
  4693  0e45  02                        defb    $02             ;;delete
  4694  0e46  34                        defb    $34             ;;end-calc
  4695                          
  4696  0e47  cd5a0e                    call    NEXT_LOOP       ; routine NEXT-LOOP
  4697  0e4a  d8                        ret     c               ;
  4698                          
  4699  0e4b  2a1f40                    ld      hl, (MEM)       ; sv MEM_lo
  4700  0e4e  110f00                    ld      de, $000F       ;
  4701  0e51  19                        add     hl, de          ;
  4702  0e52  5e                        ld      e, (hl)         ;
  4703  0e53  23                        inc     hl              ;
  4704  0e54  56                        ld      d, (hl)         ;
  4705  0e55  eb                        ex      de, hl          ;
  4706  0e56  182e                      jr      GOTO_2          ; to GOTO-2
  4707                          
  4708                          ; ---
  4709                          
  4710                          
  4711                          REPORT_1:
  4712  0e58  cf                        rst     ERROR_1         ; ERROR-1
  4713  0e59  00                        defb    ERR_1_NEXT_WO_FOR
  4714                                                          ; Error Report: NEXT without FOR
  4715                          
  4716                          
  4717                          ; --------------------------
  4718                          ; THE 'NEXT-LOOP' SUBROUTINE
  4719                          ; --------------------------
  4720                          ;
  4721                          ;
  4722                          
  4723                          NEXT_LOOP:
  4724  0e5a  ef                        rst     FP_CALC         ;; FP-CALC
  4725  0e5b  e1                        defb    $E1             ;;get-mem-1
  4726  0e5c  e0                        defb    $E0             ;;get-mem-0
  4727  0e5d  e2                        defb    $E2             ;;get-mem-2
  4728  0e5e  32                        defb    $32             ;;less-0
  4729  0e5f  00                        defb    $00             ;;jump-true
  4730  0e60  02                        defb    $02             ;;to L0E62, LMT-V-VAL
  4731                          
  4732  0e61  01                        defb    $01             ;;exchange
  4733                          
  4734                          LMT_V_VAL:
  4735  0e62  03                        defb    $03             ;;subtract
  4736  0e63  33                        defb    $33             ;;greater-0
  4737  0e64  00                        defb    $00             ;;jump-true
  4738  0e65  04                        defb    $04             ;;to L0E69, IMPOSS
  4739                          
  4740  0e66  34                        defb    $34             ;;end-calc
  4741                          
  4742  0e67  a7                        and     a               ; clear carry flag
  4743  0e68  c9                        ret                     ; return.
  4744                          
  4745                          ; ---
  4746                          
  4747                          
  4748                          IMPOSS:
  4749  0e69  34                        defb    $34             ;;end-calc
  4750                          
  4751  0e6a  37                        scf                     ; set carry flag
  4752  0e6b  c9                        ret                     ; return.
  4753                          
  4754                          ; --------------------------
  4755                          ; THE 'RAND' COMMAND ROUTINE
  4756                          ; --------------------------
  4757                          ; The keyword was 'RANDOMISE' on the ZX80, is 'RAND' here on the ZX81 and
  4758                          ; becomes 'RANDOMIZE' on the ZX Spectrum.
  4759                          ; In all invocations the procedure is the same - to set the SEED system variable
  4760                          ; with a supplied integer value or to use a time-based value if no number, or
  4761                          ; zero, is supplied.
  4762                          
  4763                          RAND:
  4764  0e6c  cda70e                    call    FIND_INT        ; routine FIND-INT
  4765  0e6f  78                        ld      a, b            ; test value
  4766  0e70  b1                        or      c               ; for zero
  4767  0e71  2004                      jr      nz, SET_SEED    ; forward if not zero to SET-SEED
  4768                          
  4769  0e73  ed4b3440                  ld      bc, (FRAMES)    ; fetch value of FRAMES system variable.
  4770                          
  4771                          SET_SEED:
  4772  0e77  ed433240                  ld      (SEED), bc      ; update the SEED system variable.
  4773  0e7b  c9                        ret                     ; return.
  4774                          
  4775                          ; --------------------------
  4776                          ; THE 'CONT' COMMAND ROUTINE
  4777                          ; --------------------------
  4778                          ; Another abbreviated command. ROM space was really tight.
  4779                          ; CONTINUE at the line number that was set when break was pressed.
  4780                          ; Sometimes the current line, sometimes the next line.
  4781                          
  4782                          CONT:
  4783  0e7c  2a2b40                    ld      hl, (OLDPPC)    ; set HL from system variable OLDPPC
  4784  0e7f  1805                      jr      GOTO_2          ; forward to GOTO-2
  4785                          
  4786                          ; --------------------------
  4787                          ; THE 'GOTO' COMMAND ROUTINE
  4788                          ; --------------------------
  4789                          ; This token also suffered from the shortage of room and there is no space
  4790                          ; getween GO and TO as there is on the ZX80 and ZX Spectrum. The same also
  4791                          ; applies to the GOSUB keyword.
  4792                          
  4793                          GOTO:
  4794  0e81  cda70e                    call    FIND_INT        ; routine FIND-INT
  4795  0e84  60                        ld      h, b            ;
  4796  0e85  69                        ld      l, c            ;
  4797                          
  4798                          GOTO_2:
  4799  0e86  7c                        ld      a, h            ;
  4800  0e87  fef0                      cp      $F0             ;
  4801  0e89  3022                      jr      nc, REPORT_B    ; to REPORT-B
  4802                          
  4803  0e8b  cdd809                    call    LINE_ADDR       ; routine LINE-ADDR
  4804  0e8e  222940                    ld      (NXTLIN), hl    ; sv NXTLIN_lo
  4805  0e91  c9                        ret                     ;
  4806                          
  4807                          ; --------------------------
  4808                          ; THE 'POKE' COMMAND ROUTINE
  4809                          ; --------------------------
  4810                          ;
  4811                          ;
  4812                          
  4813                          POKE:
  4814  0e92  cdcd15                    call    FP_TO_A         ; routine FP-TO-A
  4815  0e95  3816                      jr      c, REPORT_B     ; forward, with overflow, to REPORT-B
  4816                          
  4817  0e97  2802                      jr      z, POKE_SAVE    ; forward, if positive, to POKE-SAVE
  4818                          
  4819  0e99  ed44                      neg                     ; negate
  4820                          
  4821                          POKE_SAVE:
  4822  0e9b  f5                        push    af              ; preserve value.
  4823  0e9c  cda70e                    call    FIND_INT        ; routine FIND-INT gets address in BC
  4824                                                          ; invoking the error routine with overflow
  4825                                                          ; or a negative number.
  4826  0e9f  f1                        pop     af              ; restore value.
  4827                          
  4828                          ; Note. the next two instructions are legacy code from the ZX80 and
  4829                          ; inappropriate here.
  4830                          
  4831  0ea0  fdcb007e                  bit     7, (iy+ERR_NR-IY0)
  4832                                                          ; test ERR_NR - is it still $FF ?
  4833  0ea4  c8                        ret     z               ; return with error.
  4834                          
  4835  0ea5  02                        ld      (bc), a         ; update the address contents.
  4836  0ea6  c9                        ret                     ; return.
  4837                          
  4838                          ; -----------------------------
  4839                          ; THE 'FIND INTEGER' SUBROUTINE
  4840                          ; -----------------------------
  4841                          ;
  4842                          ;
  4843                          
  4844                          FIND_INT:
  4845  0ea7  cd8a15                    call    FP_TO_BC        ; routine FP-TO-BC
  4846  0eaa  3801                      jr      c, REPORT_B     ; forward with overflow to REPORT-B
  4847                          
  4848  0eac  c8                        ret     z               ; return if positive (0-65535).
  4849                          
  4850                          
  4851                          REPORT_B:
  4852  0ead  cf                        rst     ERROR_1         ; ERROR-1
  4853  0eae  0a                        defb    ERR_B_INT_OVERFLOW
  4854                                                          ; Error Report: Integer out of range
  4855                          
  4856                          ; -------------------------
  4857                          ; THE 'RUN' COMMAND ROUTINE
  4858                          ; -------------------------
  4859                          ;
  4860                          ;
  4861                          
  4862                          RUN:
  4863  0eaf  cd810e                    call    GOTO            ; routine GOTO
  4864  0eb2  c39a14                    jp      CLEAR           ; to CLEAR
  4865                          
  4866                          ; ---------------------------
  4867                          ; THE 'GOSUB' COMMAND ROUTINE
  4868                          ; ---------------------------
  4869                          ;
  4870                          ;
  4871                          
  4872                          GOSUB:
  4873  0eb5  2a0740                    ld      hl, (PPC)       ; sv PPC_lo
  4874  0eb8  23                        inc     hl              ;
  4875  0eb9  e3                        ex      (sp), hl        ;
  4876  0eba  e5                        push    hl              ;
  4877  0ebb  ed730240                  ld      (ERR_SP), sp    ; set the error stack pointer - ERR_SP
  4878  0ebf  cd810e                    call    GOTO            ; routine GOTO
  4879  0ec2  010600                    ld      bc, $0006       ;
  4880                          
  4881                          ; --------------------------
  4882                          ; THE 'TEST ROOM' SUBROUTINE
  4883                          ; --------------------------
  4884                          ;
  4885                          ;
  4886                          
  4887                          TEST_ROOM:
  4888  0ec5  2a1c40                    ld      hl, (STKEND)    ; sv STKEND_lo
  4889  0ec8  09                        add     hl, bc          ;
  4890  0ec9  3808                      jr      c, REPORT_4     ; to REPORT-4
  4891                          
  4892  0ecb  eb                        ex      de, hl          ;
  4893  0ecc  212400                    ld      hl, $0024       ;
  4894  0ecf  19                        add     hl, de          ;
  4895  0ed0  ed72                      sbc     hl, sp          ;
  4896  0ed2  d8                        ret     c               ;
  4897                          
  4898                          REPORT_4:
  4899  0ed3  2e03                      ld      l, ERR_4_NO_ROOM
  4900  0ed5  c35800                    jp      ERROR_3         ; to ERROR-3
  4901                          
  4902                          ; ----------------------------
  4903                          ; THE 'RETURN' COMMAND ROUTINE
  4904                          ; ----------------------------
  4905                          ;
  4906                          ;
  4907                          
  4908                          RETURN:
  4909  0ed8  e1                        pop     hl              ;
  4910  0ed9  e3                        ex      (sp), hl        ;
  4911  0eda  7c                        ld      a, h            ;
  4912  0edb  fe3e                      cp      $3E             ;
  4913  0edd  2806                      jr      z, REPORT_7     ; to REPORT-7
  4914                          
  4915  0edf  ed730240                  ld      (ERR_SP), sp    ; sv ERR_SP_lo
  4916  0ee3  18a1                      jr      GOTO_2          ; back to GOTO-2
  4917                          
  4918                          ; ---
  4919                          
  4920                          REPORT_7:
  4921  0ee5  e3                        ex      (sp), hl        ;
  4922  0ee6  e5                        push    hl              ;
  4923                          
  4924  0ee7  cf                        rst     ERROR_1         ; ERROR-1
  4925  0ee8  06                        defb    ERR_7_RET_WO_GOSUB
  4926                                                          ; Error Report: RETURN without GOSUB
  4927                          
  4928                          ; ---------------------------
  4929                          ; THE 'INPUT' COMMAND ROUTINE
  4930                          ; ---------------------------
  4931                          ;
  4932                          ;
  4933                          
  4934                          INPUT:
  4935  0ee9  fdcb087e                  bit     7, (iy+PPC+1-IY0)
  4936                                                          ; Test high byte of PPC for line number
  4937  0eed  2032                      jr      nz, REPORT_8    ; REPORT-8 (Input must have line number)
  4938                          
  4939                          
  4940                          ; In edition 2 ROM, a new CALL instruction added to clear the workspace
  4941                          ; during the INPUT routine
  4942                          
  4943  0eef  cda314                    call    X_TEMP          ; Call X-TEMP to clears the workspace
  4944                          
  4945  0ef2  212d40                    ld      hl, FLAGX       ; FLAGX
  4946  0ef5  cbee                      set     5, (hl)         ; Set INPUT mode
  4947  0ef7  cbb6                      res     6, (hl)         ; to string
  4948  0ef9  3a0140                    ld      a, (FLAGS)      ; sv FLAGS
  4949  0efc  e640                      and     $40             ;
  4950  0efe  010200                    ld      bc, $0002       ;
  4951  0f01  2002                      jr      nz, PROMPT      ; to PROMPT
  4952                          
  4953  0f03  0e04                      ld      c, $04          ;
  4954                          
  4955                          PROMPT:
  4956  0f05  b6                        or      (hl)            ;
  4957  0f06  77                        ld      (hl), a         ;
  4958                          
  4959  0f07  f7                        rst     BC_SPACES       ; BC-SPACES
  4960  0f08  3676                      ld      (hl), $76       ;
  4961  0f0a  79                        ld      a, c            ;
  4962  0f0b  0f                        rrca                    ;
  4963  0f0c  0f                        rrca                    ;
  4964  0f0d  3805                      jr      c, ENTER_CUR    ; to ENTER-CUR
  4965                          
  4966  0f0f  3e0b                      ld      a, $0B          ;
  4967  0f11  12                        ld      (de), a         ;
  4968  0f12  2b                        dec     hl              ;
  4969  0f13  77                        ld      (hl), a         ;
  4970                          
  4971                          ENTER_CUR:
  4972  0f14  2b                        dec     hl              ;
  4973  0f15  367f                      ld      (hl), $7F       ;
  4974  0f17  2a3940                    ld      hl, (S_POSN)    ; sv S_POSN_x
  4975  0f1a  223040                    ld      (T_ADDR), hl    ; sv T_ADDR_lo
  4976  0f1d  e1                        pop     hl              ;
  4977  0f1e  c37204                    jp      LOWER           ; to LOWER
  4978                          
  4979                          ; ---
  4980                          
  4981                          REPORT_8:
  4982  0f21  cf                        rst     ERROR_1         ; ERROR-1
  4983  0f22  07                        defb    ERR_8_EOF       ; Error Report: End of file
  4984                          
  4985                          ; ---------------------------
  4986                          ; THE 'PAUSE' COMMAND ROUTINE
  4987                          ; ---------------------------
  4988                          ;
  4989                          ;
  4990                          
  4991                          FAST:
  4992  0f23  cde702                    call    SET_FAST        ; routine SET-FAST
  4993  0f26  fdcb3bb6                  res     6, (iy+CDFLAG-IY0)
  4994                                                          ; sv CDFLAG
  4995  0f2a  c9                        ret                     ; return.
  4996                          
  4997                          ; --------------------------
  4998                          ; THE 'SLOW' COMMAND ROUTINE
  4999                          ; --------------------------
  5000                          ;
  5001                          ;
  5002                          
  5003                          SLOW:
  5004  0f2b  fdcb3bf6                  set     6, (iy+CDFLAG-IY0)
  5005                                                          ; sv CDFLAG
  5006  0f2f  c30702                    jp      SLOW_FAST       ; to SLOW/FAST
  5007                          
  5008                          ; ---------------------------
  5009                          ; THE 'PAUSE' COMMAND ROUTINE
  5010                          ; ---------------------------
  5011                          
  5012                          PAUSE:
  5013  0f32  cda70e                    call    FIND_INT        ; Call FIND-INT to get the PAUSE parameter
  5014  0f35  cde702                    call    SET_FAST        ; Call SET-FAST to go into fast mode
  5015                                                          ; (but keep CDFLAG bit 6 set, indicating SLOW mode)
  5016  0f38  6069                      ld      hl, bc          ; Move PAUSE parameter into HL
  5017                                                          ; NB: This will be saved to FRAMES
  5018  0f3a  cd2d02                    call    DISPLAY_P       ; Call DISPLAY-P to generate display until
  5019                                                          ; FRAMES zero or a key is pressed
  5020                          
  5021                          ; In edition 3 ROM, rewritten PAUSE routine to ensure new frame does not get
  5022                          ; FRAMES to zero
  5023  0f3d  fd3635ff                  ld      (iy+FRAMES+1-IY0), $FF
  5024                                                          ; Set high byte of FRAMES to make sure a
  5025                                                          ; new frame does not get FRAMES to zero
  5026                          
  5027  0f41  cd0702                    call    SLOW_FAST       ; Call SLOW/FAST to re-enter "normal" slow mode
  5028  0f44  1805                      jr      DEBOUNCE        ; routine DEBOUNCE
  5029                          
  5030                          ; ----------------------
  5031                          ; THE 'BREAK' SUBROUTINE
  5032                          ; ----------------------
  5033                          ;
  5034                          ;
  5035                          
  5036                          BREAK_1:
  5037  0f46  3e7f                      ld      a, $7F          ; read port $7FFE - keys B,N,M,.,SPACE.
  5038  0f48  dbfe                      in      a, ($FE)        ;
  5039  0f4a  1f                        rra                     ; carry will be set if space not pressed.
  5040                          
  5041                          ; -------------------------
  5042                          ; THE 'DEBOUNCE' SUBROUTINE
  5043                          ; -------------------------
  5044                          ;
  5045                          ;
  5046                          
  5047                          DEBOUNCE:
  5048  0f4b  fdcb3b86                  res     0, (iy+CDFLAG-IY0)
  5049                                                          ; update system variable CDFLAG
  5050                                                          ; bit 0 reset, no key available
  5051  0f4f  3eff                      ld      a, $FF          ;
  5052  0f51  322740                    ld      (DB_ST), a      ; update system variable DEBOUNCE
  5053  0f54  c9                        ret                     ; return.
  5054                          
  5055                          
  5056                          ; -------------------------
  5057                          ; THE 'SCANNING' SUBROUTINE
  5058                          ; -------------------------
  5059                          ; This recursive routine is where the ZX81 gets its power. Provided there is
  5060                          ; enough memory it can evaluate an expression of unlimited complexity.
  5061                          ; Note. there is no unary plus so, as on the ZX80, PRINT +1 gives a syntax error.
  5062                          ; PRINT +1 works on the Spectrum but so too does PRINT + "STRING".
  5063                          
  5064                          SCANNING:
  5065  0f55  df                        rst     GET_CHAR        ; GET-CHAR
  5066  0f56  0600                      ld      b, $00          ; set B register to zero.
  5067  0f58  c5                        push    bc              ; stack zero as a priority end-marker.
  5068                          
  5069                          S_LOOP_1:
  5070  0f59  fe40                      cp      $40             ; compare to the 'RND' character
  5071  0f5b  202f                      jr      nz, S_TEST_PI   ; forward, if not, to S-TEST-PI
  5072                          
  5073                          ; ------------------
  5074                          ; THE 'RND' FUNCTION
  5075                          ; ------------------
  5076                          
  5077  0f5d  cda60d                    call    SYNTAX_Z        ; routine SYNTAX-Z
  5078  0f60  2828                      jr      z, S_JPI_END    ; forward if checking syntax to S-JPI-END
  5079                          
  5080  0f62  ed4b3240                  ld      bc, (SEED)      ; sv SEED_lo
  5081  0f66  cd2015                    call    STACK_BC        ; routine STACK-BC
  5082                          
  5083  0f69  ef                        rst     FP_CALC         ;; FP-CALC
  5084  0f6a  a1                        defb    $A1             ;;stk-one
  5085  0f6b  0f                        defb    $0F             ;;addition
  5086  0f6c  30                        defb    $30             ;;stk-data
  5087  0f6d  37                        defb    $37             ;;Exponent: $87, Bytes: 1
  5088  0f6e  16                        defb    $16             ;;(+00,+00,+00)
  5089  0f6f  04                        defb    $04             ;;multiply
  5090  0f70  30                        defb    $30             ;;stk-data
  5091  0f71  80                        defb    $80             ;;Bytes: 3
  5092  0f72  41                        defb    $41             ;;Exponent $91
  5093  0f73  000080                    defb    $00, $00, $80   ;;(+00)
  5094  0f76  2e                        defb    $2E             ;;n-mod-m
  5095  0f77  02                        defb    $02             ;;delete
  5096  0f78  a1                        defb    $A1             ;;stk-one
  5097  0f79  03                        defb    $03             ;;subtract
  5098  0f7a  2d                        defb    $2D             ;;duplicate
  5099  0f7b  34                        defb    $34             ;;end-calc
  5100                          
  5101  0f7c  cd8a15                    call    FP_TO_BC        ; routine FP-TO-BC
  5102  0f7f  ed433240                  ld      (SEED), bc      ; update the SEED system variable.
  5103  0f83  7e                        ld      a, (hl)         ; HL addresses the exponent of the last value.
  5104  0f84  a7                        and     a               ; test for zero
  5105  0f85  2803                      jr      z, S_JPI_END    ; forward, if so, to S-JPI-END
  5106                          
  5107  0f87  d610                      sub     $10             ; else reduce exponent by sixteen
  5108  0f89  77                        ld      (hl), a         ; thus dividing by 65536 for last value.
  5109                          
  5110                          S_JPI_END:
  5111  0f8a  180d                      jr      S_PI_END        ; forward to S-PI-END
  5112                          
  5113                          ; ---
  5114                          
  5115                          S_TEST_PI:
  5116  0f8c  fe42                      cp      $42             ; the 'PI' character
  5117  0f8e  200d                      jr      nz, S_TST_INK   ; forward, if not, to S-TST-INK
  5118                          
  5119                          ; -------------------
  5120                          ; THE 'PI' EVALUATION
  5121                          ; -------------------
  5122                          
  5123  0f90  cda60d                    call    SYNTAX_Z        ; routine SYNTAX-Z
  5124  0f93  2804                      jr      z, S_PI_END     ; forward if checking syntax to S-PI-END
  5125                          
  5126                          
  5127  0f95  ef                        rst     FP_CALC         ;; FP-CALC
  5128  0f96  a3                        defb    $A3             ;;stk-pi/2
  5129  0f97  34                        defb    $34             ;;end-calc
  5130                          
  5131  0f98  34                        inc     (hl)            ; double the exponent giving PI on the stack.
  5132                          
  5133                          S_PI_END:
  5134  0f99  e7                        rst     NEXT_CHAR       ; NEXT-CHAR advances character pointer.
  5135                          
  5136  0f9a  c38310                    jp      S_NUMERIC       ; jump forward to S-NUMERIC to set the flag
  5137                                                          ; to signal numeric result before advancing.
  5138                          
  5139                          ; ---
  5140                          
  5141                          S_TST_INK:
  5142  0f9d  fe41                      cp      $41             ; compare to character 'INKEY$'
  5143  0f9f  2011                      jr      nz, S_ALPHANUM  ; forward, if not, to S-ALPHANUM
  5144                          
  5145                          ; -----------------------
  5146                          ; THE 'INKEY$' EVALUATION
  5147                          ; -----------------------
  5148                          
  5149  0fa1  cdbb02                    call    KEYBOARD        ; routine KEYBOARD
  5150  0fa4  44                        ld      b, h            ;
  5151  0fa5  4d                        ld      c, l            ;
  5152  0fa6  51                        ld      d, c            ;
  5153  0fa7  14                        inc     d               ;
  5154  0fa8  c4bd07                    call    nz, DECODE      ; routine DECODE
  5155  0fab  7a                        ld      a, d            ;
  5156  0fac  8a                        adc     a, d            ;
  5157  0fad  42                        ld      b, d            ;
  5158  0fae  4f                        ld      c, a            ;
  5159  0faf  eb                        ex      de, hl          ;
  5160  0fb0  183b                      jr      S_STRING        ; forward to S-STRING
  5161                          
  5162                          ; ---
  5163                          
  5164                          S_ALPHANUM:
  5165  0fb2  cdd214                    call    ALPHANUM        ; routine ALPHANUM
  5166  0fb5  386e                      jr      c, S_LTR_DGT    ; forward, if alphanumeric to S-LTR-DGT
  5167                          
  5168  0fb7  fe1b                      cp      $1B             ; is character a '.' ?
  5169  0fb9  ca4710                    jp      z, S_DECIMAL    ; jump forward if so to S-DECIMAL
  5170                          
  5171  0fbc  01d809                    ld      bc, $09D8       ; prepare priority 09, operation 'subtract'
  5172  0fbf  fe16                      cp      $16             ; is character unary minus '-' ?
  5173  0fc1  285d                      jr      z, S_PUSH_PO    ; forward, if so, to S-PUSH-PO
  5174                          
  5175  0fc3  fe10                      cp      $10             ; is character a '(' ?
  5176  0fc5  200f                      jr      nz, S_QUOTE     ; forward if not to S-QUOTE
  5177                          
  5178  0fc7  cd4900                    call    INC_CH_ADD      ; routine CH-ADD+1 advances character pointer.
  5179                          
  5180  0fca  cd550f                    call    SCANNING        ; recursively call routine SCANNING to
  5181                                                          ; evaluate the sub-expression.
  5182                          
  5183  0fcd  fe11                      cp      $11             ; is subsequent character a ')' ?
  5184  0fcf  202e                      jr      nz, S_RPT_C     ; forward if not to S-RPT-C
  5185                          
  5186                          
  5187  0fd1  cd4900                    call    INC_CH_ADD      ; routine CH-ADD+1  advances.
  5188  0fd4  1822                      jr      S_JP_CONT3      ; relative jump to S-JP-CONT3 and then S-CONT3
  5189                          
  5190                          ; ---
  5191                          
  5192                          ; consider a quoted string e.g. PRINT "Hooray!"
  5193                          ; Note. quotes are not allowed within a string.
  5194                          
  5195                          S_QUOTE:
  5196  0fd6  fe0b                      cp      $0B             ; is character a quote (") ?
  5197  0fd8  2028                      jr      nz, S_FUNCTION  ; forward, if not, to S-FUNCTION
  5198                          
  5199  0fda  cd4900                    call    INC_CH_ADD      ; routine CH-ADD+1 advances
  5200  0fdd  e5                        push    hl              ; * save start of string.
  5201  0fde  1803                      jr      S_QUOTE_S       ; forward to S-QUOTE-S
  5202                          
  5203                          ; ---
  5204                          
  5205                          
  5206                          S_Q_AGAIN:
  5207  0fe0  cd4900                    call    INC_CH_ADD      ; routine CH-ADD+1
  5208                          
  5209                          S_QUOTE_S:
  5210  0fe3  fe0b                      cp      $0B             ; is character a '"' ?
  5211  0fe5  2014                      jr      nz, S_Q_NL      ; forward if not to S-Q-NL
  5212                          
  5213  0fe7  d1                        pop     de              ; * retrieve start of string
  5214  0fe8  a7                        and     a               ; prepare to subtract.
  5215  0fe9  ed52                      sbc     hl, de          ; subtract start from current position.
  5216  0feb  44                        ld      b, h            ; transfer this length
  5217  0fec  4d                        ld      c, l            ; to the BC register pair.
  5218                          
  5219                          S_STRING:
  5220  0fed  210140                    ld      hl, FLAGS       ; address system variable FLAGS
  5221  0ff0  cbb6                      res     6, (hl)         ; signal string result
  5222  0ff2  cb7e                      bit     7, (hl)         ; test if checking syntax.
  5223                          
  5224  0ff4  c4c312                    call    nz, STK_STO_DOLLAR
  5225                                                          ; in run-time routine STK-STO-$ stacks the
  5226                                                          ; string descriptor - start DE, length BC.
  5227                          
  5228  0ff7  e7                        rst     NEXT_CHAR       ; NEXT-CHAR advances pointer.
  5229                          
  5230                          S_JP_CONT3:
  5231  0ff8  c38810                    jp      S_CONT_3        ; jump to S-CONT-3
  5232                          
  5233                          ; ---
  5234                          
  5235                          ; A string with no terminating quote has to be considered.
  5236                          
  5237                          S_Q_NL:
  5238  0ffb  fe76                      cp      $76             ; compare to NEWLINE
  5239  0ffd  20e1                      jr      nz, S_Q_AGAIN   ; loop back if not to S-Q-AGAIN
  5240                          
  5241                          S_RPT_C:
  5242  0fff  c39a0d                    jp      REPORT_C        ; to REPORT-C
  5243                          
  5244                          ; ---
  5245                          
  5246                          S_FUNCTION:
  5247  1002  d6c4                      sub     $C4             ; subtract 'CODE' reducing codes
  5248                                                          ; CODE thru '<>' to range $00 - $XX
  5249  1004  38f9                      jr      c, S_RPT_C      ; back, if less, to S-RPT-C
  5250                          
  5251                          ; test for NOT the last function in character set.
  5252                          
  5253  1006  01ec04                    ld      bc, $04EC       ; prepare priority $04, operation 'not'
  5254  1009  fe13                      cp      $13             ; compare to 'NOT'  ( - CODE)
  5255  100b  2813                      jr      z, S_PUSH_PO    ; forward, if so, to S-PUSH-PO
  5256                          
  5257  100d  30f0                      jr      nc, S_RPT_C     ; back with anything higher to S-RPT-C
  5258                          
  5259                          ; else is a function 'CODE' thru 'CHR$'
  5260                          
  5261  100f  0610                      ld      b, $10          ; priority sixteen binds all functions to
  5262                                                          ; arguments removing the need for brackets.
  5263                          
  5264  1011  c6d9                      add     a, $D9          ; add $D9 to give range $D9 thru $EB
  5265                                                          ; bit 6 is set to show numeric argument.
  5266                                                          ; bit 7 is set to show numeric result.
  5267                          
  5268                          ; now adjust these default argument/result indicators.
  5269                          
  5270  1013  4f                        ld      c, a            ; save code in C
  5271                          
  5272  1014  fedc                      cp      $DC             ; separate 'CODE', 'VAL', 'LEN'
  5273  1016  3002                      jr      nc, S_NO_TO__DOLLAR
  5274                                                          ; skip forward if string operand to S-NO-TO-$
  5275                          
  5276  1018  cbb1                      res     6, c            ; signal string operand.
  5277                          
  5278                          S_NO_TO__DOLLAR:
  5279  101a  feea                      cp      $EA             ; isolate top of range 'STR$' and 'CHR$'
  5280  101c  3802                      jr      c, S_PUSH_PO    ; skip forward with others to S-PUSH-PO
  5281                          
  5282  101e  cbb9                      res     7, c            ; signal string result.
  5283                          
  5284                          S_PUSH_PO:
  5285  1020  c5                        push    bc              ; push the priority/operation
  5286                          
  5287  1021  e7                        rst     NEXT_CHAR       ; NEXT-CHAR
  5288  1022  c3590f                    jp      S_LOOP_1        ; jump back to S-LOOP-1
  5289                          
  5290                          ; ---
  5291                          
  5292                          S_LTR_DGT:
  5293  1025  fe26                      cp      'A' - 27        ; Jump if dealing with a digit (<'A').
  5294  1027  381e                      jr      c, S_DECIMAL    ; to the S-DECIMAL routine
  5295                          
  5296  1029  cd1c11                    call    LOOK_VARS       ; We have a variable name. See if it exists
  5297                                                          ; by calling LOOK-VARS
  5298  102c  da4b0d                    jp      c, REPORT_2     ; back if not found to REPORT-2
  5299                                                          ; (Undefined variable)
  5300                                                          ; a variable is always 'found' when checking
  5301                                                          ; syntax.
  5302                          
  5303  102f  cca711                    call    z, STK_VAR      ; routine STK-VAR stacks string parameters or
  5304                                                          ; returns cell location if numeric.
  5305                          
  5306                          
  5307                          ; In Edition 2 ROM, rewritten numeric processing routine to cater for
  5308                          ; syntax checking.
  5309                          
  5310  1032  3a0140                    ld      a, (FLAGS)      ; Fetch the value of FLAGS
  5311  1035  fec0                      cp      $C0             ; Test bit 6 & 7 together
  5312  1037  384e                      jr      c, S_CONT_2     ; Jump to S-CONT-2 to continue processing if
  5313                                                          ; not a number and/or are syntax checking
  5314                          
  5315  1039  23                        inc     hl              ; A numeric value is to be stacked during
  5316                                                          ; line execution
  5317  103a  ed5b1c40                  ld      de, (STKEND)    ; set destination to STKEND
  5318  103e  cdf619                    call    duplicate       ; routine MOVE-FP/duplicate stacks the five bytes
  5319  1041  eb                        ex      de, hl          ; transfer new free location from DE to HL.
  5320  1042  221c40                    ld      (STKEND), hl    ; update STKEND system variable.
  5321  1045  1840                      jr      S_CONT_2        ; forward to S-CONT-2
  5322                          
  5323                          ; ---
  5324                          
  5325                          ; The Scanning Decimal routine is invoked when a decimal point or digit is
  5326                          ; found in the expression.
  5327                          ; When checking syntax, then the 'hidden floating point' form is placed
  5328                          ; after the number in the BASIC line.
  5329                          ; In run-time, the digits are skipped and the floating point number is picked
  5330                          ; up.
  5331                          
  5332                          S_DECIMAL:
  5333  1047  cda60d                    call    SYNTAX_Z        ; routine SYNTAX-Z
  5334  104a  2023                      jr      nz, S_STK_DEC   ; forward in run-time to S-STK-DEC
  5335                          
  5336  104c  cdd914                    call    DEC_TO_FP       ; routine DEC-TO-FP
  5337                          
  5338  104f  df                        rst     GET_CHAR        ; GET-CHAR advances HL past digits
  5339  1050  010600                    ld      bc, $0006       ; six locations are required.
  5340  1053  cd9e09                    call    MAKE_ROOM       ; routine MAKE-ROOM
  5341  1056  23                        inc     hl              ; point to first new location
  5342  1057  367e                      ld      (hl), $7E       ; insert the number marker 126 decimal.
  5343  1059  23                        inc     hl              ; increment
  5344  105a  eb                        ex      de, hl          ; transfer destination to DE.
  5345  105b  2a1c40                    ld      hl, (STKEND)    ; set HL from STKEND which points to the
  5346                                                          ; first location after the 'last value'
  5347  105e  0e05                      ld      c, $05          ; five bytes to move.
  5348  1060  a7                        and     a               ; clear carry.
  5349  1061  ed42                      sbc     hl, bc          ; subtract five pointing to 'last value'.
  5350  1063  221c40                    ld      (STKEND), hl    ; update STKEND thereby 'deleting the value.
  5351                          
  5352  1066  edb0                      ldir                    ; copy the five value bytes.
  5353                          
  5354  1068  eb                        ex      de, hl          ; basic pointer to HL which may be white-space
  5355                                                          ; following the number.
  5356  1069  2b                        dec     hl              ; now points to last of five bytes.
  5357  106a  cd4c00                    call    TEMP_PTR1       ; routine TEMP-PTR1 advances the character
  5358                                                          ; address skipping any white-space.
  5359  106d  1814                      jr      S_NUMERIC       ; forward to S-NUMERIC
  5360                                                          ; to signal a numeric result.
  5361                          
  5362                          ; ---
  5363                          
  5364                          ; In run-time the branch is here when a digit or point is encountered.
  5365                          
  5366                          S_STK_DEC:
  5367  106f  e7                        rst     NEXT_CHAR       ; NEXT-CHAR
  5368  1070  fe7e                      cp      $7E             ; compare to 'number marker'
  5369  1072  20fb                      jr      nz, S_STK_DEC   ; loop back until found to S-STK-DEC
  5370                                                          ; skipping all the digits.
  5371                          
  5372  1074  23                        inc     hl              ; point to first of five hidden bytes.
  5373  1075  ed5b1c40                  ld      de, (STKEND)    ; set destination from STKEND system variable
  5374  1079  cdf619                    call    duplicate       ; routine MOVE-FP/duplicate stacks the number.
  5375  107c  ed531c40                  ld      (STKEND), de    ; update system variable STKEND.
  5376  1080  221640                    ld      (CH_ADD), hl    ; update system variable CH_ADD.
  5377                          
  5378                          S_NUMERIC:
  5379  1083  fdcb01f6                  set     6, (iy+FLAGS-IY0)
  5380                                                          ; update FLAGS  - Signal numeric result
  5381                          
  5382                          S_CONT_2:
  5383  1087  df                        rst     GET_CHAR        ; GET-CHAR
  5384                          
  5385                          S_CONT_3:
  5386  1088  fe10                      cp      $10             ; compare to opening bracket '('
  5387  108a  200c                      jr      nz, S_OPERTR    ; forward if not to S-OPERTR
  5388                          
  5389  108c  fdcb0176                  bit     6, (iy+FLAGS-IY0)
  5390                                                          ; test FLAGS  - Numeric or string result?
  5391  1090  202a                      jr      nz, S_LOOP      ; forward if numeric to S-LOOP
  5392                          
  5393                          ; else is a string
  5394                          
  5395  1092  cd6312                    call    SLICING         ; routine SLICING
  5396                          
  5397  1095  e7                        rst     NEXT_CHAR       ; NEXT-CHAR
  5398  1096  18f0                      jr      S_CONT_3        ; back to S-CONT-3
  5399                          
  5400                          ; ---
  5401                          
  5402                          ; the character is now manipulated to form an equivalent in the table of
  5403                          ; calculator literals. This is quite cumbersome and in the ZX Spectrum a
  5404                          ; simple look-up table was introduced at this point.
  5405                          
  5406                          S_OPERTR:
  5407  1098  01c300                    ld      bc, $00C3       ; prepare operator 'subtract' as default.
  5408                                                          ; also set B to zero for later indexing.
  5409                          
  5410  109b  fe12                      cp      $12             ; is character '>' ?
  5411  109d  381d                      jr      c, S_LOOP       ; forward if less to S-LOOP as
  5412                                                          ; we have reached end of meaningful expression
  5413                          
  5414  109f  d616                      sub     $16             ; is character '-' ?
  5415  10a1  3004                      jr      nc, SUBMLTDIV   ; forward with - * / and '**' '<>' to SUBMLTDIV
  5416                          
  5417  10a3  c60d                      add     a, $0D          ; increase others by thirteen
  5418                                                          ; $09 '>' thru $0C '+'
  5419  10a5  180e                      jr      GET_PRIO        ; forward to GET-PRIO
  5420                          
  5421                          ; ---
  5422                          
  5423                          SUBMLTDIV:
  5424  10a7  fe03                      cp      $03             ; isolate $00 '-', $01 '*', $02 '/'
  5425  10a9  380a                      jr      c, GET_PRIO     ; forward if so to GET-PRIO
  5426                          
  5427                          ; else possibly originally $D8 '**' thru $DD '<>' already reduced by $16
  5428                          
  5429  10ab  d6c2                      sub     $C2             ; giving range $00 to $05
  5430  10ad  380d                      jr      c, S_LOOP       ; forward if less to S-LOOP
  5431                          
  5432  10af  fe06                      cp      $06             ; test the upper limit for nonsense also
  5433  10b1  3009                      jr      nc, S_LOOP      ; forward if so to S-LOOP
  5434                          
  5435  10b3  c603                      add     a, $03          ; increase by 3 to give combined operators of
  5436                          
  5437                                                          ; $00 '-'
  5438                                                          ; $01 '*'
  5439                                                          ; $02 '/'
  5440                          
  5441                                                          ; $03 '**'
  5442                                                          ; $04 'OR'
  5443                                                          ; $05 'AND'
  5444                                                          ; $06 '<='
  5445                                                          ; $07 '>='
  5446                                                          ; $08 '<>'
  5447                          
  5448                                                          ; $09 '>'
  5449                                                          ; $0A '<'
  5450                                                          ; $0B '='
  5451                                                          ; $0C '+'
  5452                          
  5453                          GET_PRIO:
  5454  10b5  81                        add     a, c            ; add to default operation 'sub' ($C3)
  5455  10b6  4f                        ld      c, a            ; and place in operator byte - C.
  5456                          
  5457  10b7  214c10                    ld      hl, tbl_pri - $C3
  5458                                                          ; theoretical base of the priorities table.
  5459  10ba  09                        add     hl, bc          ; add C ( B is zero)
  5460  10bb  46                        ld      b, (hl)         ; pick up the priority in B
  5461                          
  5462                          S_LOOP:
  5463  10bc  d1                        pop     de              ; restore previous
  5464  10bd  7a                        ld      a, d            ; load A with priority.
  5465  10be  b8                        cp      b               ; is present priority higher
  5466  10bf  382c                      jr      c, S_TIGHTER    ; forward if so to S-TIGHTER
  5467                          
  5468  10c1  a7                        and     a               ; are both priorities zero
  5469  10c2  ca1800                    jp      z, GET_CHAR     ; exit if zero via GET-CHAR
  5470                          
  5471  10c5  c5                        push    bc              ; stack present values
  5472  10c6  d5                        push    de              ; stack last values
  5473  10c7  cda60d                    call    SYNTAX_Z        ; routine SYNTAX-Z
  5474  10ca  2809                      jr      z, S_SYNTEST    ; forward is checking syntax to S-SYNTEST
  5475                          
  5476  10cc  7b                        ld      a, e            ; fetch last operation
  5477  10cd  e63f                      and     $3F             ; mask off the indicator bits to give true
  5478                                                          ; calculator literal.
  5479  10cf  47                        ld      b, a            ; place in the B register for BREG
  5480                          
  5481                          ; perform the single operation
  5482                          
  5483  10d0  ef                        rst     FP_CALC         ;; FP-CALC
  5484  10d1  37                        defb    $37             ;;fp-calc-2
  5485  10d2  34                        defb    $34             ;;end-calc
  5486                          
  5487  10d3  1809                      jr      S_RUNTEST       ; forward to S-RUNTEST
  5488                          
  5489                          ; ---
  5490                          
  5491                          S_SYNTEST:
  5492  10d5  7b                        ld      a, e            ; transfer masked operator to A
  5493  10d6  fdae01                    xor     (iy+FLAGS-IY0)  ; XOR with FLAGS like results will reset bit 6
  5494  10d9  e640                      and     $40             ; test bit 6
  5495                          
  5496                          S_RPORT_C:
  5497  10db  c29a0d                    jp      nz, REPORT_C    ; back to REPORT-C if results do not agree.
  5498                          
  5499                          ; ---
  5500                          
  5501                          ; in run-time impose bit 7 of the operator onto bit 6 of the FLAGS
  5502                          
  5503                          S_RUNTEST:
  5504  10de  d1                        pop     de              ; restore last operation.
  5505  10df  210140                    ld      hl, FLAGS       ; address system variable FLAGS
  5506  10e2  cbf6                      set     6, (hl)         ; presume a numeric result
  5507  10e4  cb7b                      bit     7, e            ; test expected result in operation
  5508  10e6  2002                      jr      nz, S_LOOPEND   ; forward if numeric to S-LOOPEND
  5509                          
  5510  10e8  cbb6                      res     6, (hl)         ; reset to signal string result
  5511                          
  5512                          S_LOOPEND:
  5513  10ea  c1                        pop     bc              ; restore present values
  5514  10eb  18cf                      jr      S_LOOP          ; back to S-LOOP
  5515                          
  5516                          ; ---
  5517                          
  5518                          S_TIGHTER:
  5519  10ed  d5                        push    de              ; push last values and consider these
  5520                          
  5521  10ee  79                        ld      a, c            ; get the present operator.
  5522  10ef  fdcb0176                  bit     6, (iy+FLAGS-IY0)
  5523                                                          ; test FLAGS  - Numeric or string result?
  5524  10f3  2015                      jr      nz, S_NEXT      ; forward if numeric to S-NEXT
  5525                          
  5526  10f5  e63f                      and     $3F             ; strip indicator bits to give clear literal.
  5527  10f7  c608                      add     a, $08          ; add eight - augmenting numeric to equivalent
  5528                                                          ; string literals.
  5529  10f9  4f                        ld      c, a            ; place plain literal back in C.
  5530  10fa  fe10                      cp      $10             ; compare to 'AND'
  5531  10fc  2004                      jr      nz, S_NOT_AND   ; forward if not to S-NOT-AND
  5532                          
  5533  10fe  cbf1                      set     6, c            ; set the numeric operand required for 'AND'
  5534  1100  1808                      jr      S_NEXT          ; forward to S-NEXT
  5535                          
  5536                          ; ---
  5537                          
  5538                          S_NOT_AND:
  5539  1102  38d7                      jr      c, S_RPORT_C    ; back if less than 'AND' to S-RPORT-C
  5540                                                          ; Nonsense if '-', '*' etc.
  5541                          
  5542  1104  fe17                      cp      $17             ; compare to 'strs-add' literal
  5543  1106  2802                      jr      z, S_NEXT       ; forward if so signaling string result
  5544                          
  5545  1108  cbf9                      set     7, c            ; set bit to numeric (Boolean) for others.
  5546                          
  5547                          S_NEXT:
  5548  110a  c5                        push    bc              ; stack 'present' values
  5549                          
  5550  110b  e7                        rst     NEXT_CHAR       ; NEXT-CHAR
  5551  110c  c3590f                    jp      S_LOOP_1        ; jump back to S-LOOP-1
