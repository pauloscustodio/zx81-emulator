  1014  015b  34b7                      defb    $34, $37+$80    ; OR
  1015  015d  2633a9                    defb    $26, $33, $29+$80
  1016                                                          ; AND
  1017  0160  1394                      defb    $13, $14+$80    ; <=
  1018  0162  1294                      defb    $12, $14+$80    ; >=
  1019  0164  1392                      defb    $13, $12+$80    ; <>
  1020  0166  392d2ab3                  defb    $39, $2D, $2A, $33+$80
  1021                                                          ; THEN
  1022  016a  39b4                      defb    $39, $34+$80    ; TO
  1023  016c  38392ab5                  defb    $38, $39, $2A, $35+$80
  1024                                                          ; STEP
  1025  0170  3135372e33b9              defb    $31, $35, $37, $2E, $33, $39+$80
  1026                                                          ; LPRINT
  1027  0176  31312e38b9                defb    $31, $31, $2E, $38, $39+$80
  1028                                                          ; LLIST
  1029  017b  383934b5                  defb    $38, $39, $34, $35+$80
  1030                                                          ; STOP
  1031  017f  383134bc                  defb    $38, $31, $34, $3C+$80
  1032                                                          ; SLOW
  1033  0183  2b2638b9                  defb    $2B, $26, $38, $39+$80
  1034                                                          ; FAST
  1035  0187  332abc                    defb    $33, $2A, $3C+$80
  1036                                                          ; NEW
  1037  018a  3828373431b1              defb    $38, $28, $37, $34, $31, $31+$80
  1038                                                          ; SCROLL
