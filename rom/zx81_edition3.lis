  6132  1316  17                        rla                     ;
  6133  1317  3004                      jr      nc, HL_AGAIN    ; forward with no carry to HL-AGAIN
  6134                          
  6135  1319  19                        add     hl, de          ;
  6136                          
  6137                          HL_END:
  6138  131a  dad30e                    jp      c, REPORT_4     ; to REPORT-4
  6139                          
  6140                          HL_AGAIN:
