  1988                          ; THE 'WAIT FOR KEY' SECTION
  1989                          ; --------------------------
  1990                          ;
  1991                          ;
  1992                          
  1993                          DISPLAY_6:
  1994  04c1  210000                    ld      hl, $0000       ; These 2 zeros addressed from ZERO_DE
  1995  04c4  221840                    ld      (X_PTR), hl     ; sv X_PTR_lo
  1996                          
  1997  04c7  213b40                    ld      hl, CDFLAG      ; system variable CDFLAG
  1998  04ca  cb7e                      bit     7, (hl)         ; 0=fast mode
  1999                          
  2000  04cc  cc2902                    call    z, DISPLAY_1    ; routine DISPLAY-1, show display if FAST
  2001                          
  2002                          SLOW_DISP:
  2003  04cf  cb46                      bit     0, (hl)         ; bit 0 is set if key available
  2004  04d1  28fc                      jr      z, SLOW_DISP    ; to SLOW-DISP if no key available
  2005                          
  2006  04d3  ed4b2540                  ld      bc, (LAST_K)    ; sv LAST_K
  2007  04d7  cd4b0f                    call    DEBOUNCE        ; routine DEBOUNCE;
  2008                                                          ; initializes DEBOUNCE to FFh and resets
  2009                                                          ; and resets bit 0 of CDFLAG
  2010  04da  cdbd07                    call    DECODE          ; routine DECODE
  2011                          
  2012  04dd  3093                      jr      nc, LOWER       ; back to LOWER if no key pressed
  2013                          
  2014                          ; -------------------------------
  2015                          ; THE 'KEYBOARD DECODING' SECTION
  2016                          ; -------------------------------
  2017                          ;   The decoded key index value is in E and HL points to the position in the
  2018                          ;   key table. D contains zero.
  2019                          
  2020                          K_DECODE:
  2021  04df  3a0640                    ld      a, (MODE)       ; Fetch value of system variable MODE
  2022  04e2  3d                        dec     a               ; test the three values together
  2023                          
  2024  04e3  fa0805                    jp      m, FETCH_2      ; forward, if was zero, to FETCH-2
  2025                          
  2026  04e6  200f                      jr      nz, FETCH_1     ; forward, if was 2, to FETCH-1
  2027                          
  2028                          ;   The original value was one and is now zero.
  2029                          
  2030  04e8  320640                    ld      (MODE), a       ; update the system variable MODE
  2031                          
  2032  04eb  1d                        dec     e               ; reduce E to range $00 - $7F
  2033  04ec  7b                        ld      a, e            ; place in A
  2034  04ed  d627                      sub     $27             ; subtract 39 setting carry if range 00 - 38
  2035  04ef  3801                      jr      c, FUNC_BASE    ; forward, if so, to FUNC-BASE
  2036                          
  2037  04f1  5f                        ld      e, a            ; else set E to reduced value
  2038                          
  2039                          FUNC_BASE:
  2040  04f2  21cc00                    ld      hl, K_FUNCT     ; address of K-FUNCT table for function keys.
  2041  04f5  180e                      jr      TABLE_ADD       ; forward to TABLE-ADD
  2042                          
  2043                          ; ---
  2044                          
  2045                          FETCH_1:
  2046  04f7  7e                        ld      a, (hl)         ;
  2047  04f8  fe76                      cp      $76             ;
  2048  04fa  282f                      jr      z, KL_KEY       ; to K/L-KEY
  2049                          
  2050  04fc  fe40                      cp      $40             ;
  2051  04fe  cbff                      set     7, a            ;
  2052  0500  3819                      jr      c, ENTER        ; to ENTER
  2053                          
  2054  0502  21c700                    ld      hl, $00C7       ; (expr reqd)
  2055                          
  2056                          TABLE_ADD:
  2057  0505  19                        add     hl, de          ;
  2058  0506  180d                      jr      FETCH_3         ; to FETCH-3
  2059                          
  2060                          ; ---
  2061                          
  2062                          FETCH_2:
  2063  0508  7e                        ld      a, (hl)         ;
  2064  0509  fdcb0156                  bit     2, (iy+FLAGS-IY0)
  2065                                                          ; sv FLAGS  - K or L mode ?
  2066  050d  2007                      jr      nz, TEST_CURS   ; to TEST-CURS
  2067                          
  2068  050f  c6c0                      add     a, $C0          ;
  2069  0511  fee6                      cp      $E6             ;
  2070  0513  3001                      jr      nc, TEST_CURS   ; to TEST-CURS
  2071                          
  2072                          FETCH_3:
  2073  0515  7e                        ld      a, (hl)         ;
  2074                          
  2075                          TEST_CURS:
  2076  0516  fef0                      cp      $F0             ;
  2077  0518  ea2d05                    jp      pe, KEY_SORT    ; to KEY-SORT
  2078                          
  2079                          ENTER:
  2080  051b  5f                        ld      e, a            ;
  2081  051c  cd3705                    call    CURSOR          ; routine CURSOR
  2082                          
  2083  051f  7b                        ld      a, e            ;
  2084  0520  cd2605                    call    ADD_CHAR        ; routine ADD-CHAR
  2085                          
  2086                          BACK_NEXT:
  2087  0523  c37204                    jp      LOWER           ; back to LOWER
  2088                          
