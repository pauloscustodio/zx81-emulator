  2403  062a  cdba0c                    call    LINE_SCAN       ; routine LINE-SCAN
  2404  062d  e1                        pop     hl              ;
  2405  062e  cd3705                    call    CURSOR          ; routine CURSOR
  2406  0631  cd5c05                    call    CLEAR_ONE       ; routine CLEAR-ONE
  2407  0634  cd730a                    call    E_LINE_NO       ; routine E-LINE-NO
  2408  0637  2015                      jr      nz, NL_INP      ; to N/L-INP
  2409                          
  2410  0639  78                        ld      a, b            ;
  2411  063a  b1                        or      c               ;
  2412  063b  c2e006                    jp      nz, NL_LINE     ; to N/L-LINE
  2413                          
  2414  063e  0b                        dec     bc              ;
  2415  063f  0b                        dec     bc              ;
  2416  0640  ed430740                  ld      (PPC), bc       ; sv PPC_lo
  2417  0644  fd362202                  ld      (iy+DF_SZ-IY0), $02
  2418                                                          ; sv DF_SZ
  2419  0648  ed5b0c40                  ld      de, (D_FILE)    ; sv D_FILE_lo
  2420                          
  2421  064c  1813                      jr      TEST_NULL       ; forward to TEST-NULL
  2422                          
