  6634                          ; ------------------------------------------
  6635                          ; THE 'DECIMAL TO FLOATING POINT' SUBROUTINE
  6636                          ; ------------------------------------------
  6637                          ;
  6638                          
  6639                          DEC_TO_FP:
  6640  14d9  cd4815                    call    INT_TO_FP       ; routine INT-TO-FP gets first part
  6641  14dc  fe1b                      cp      $1B             ; is character a '.' ?
  6642  14de  2015                      jr      nz, E_FORMAT    ; forward if not to E-FORMAT
  6643                          
  6644                          
  6645  14e0  ef                        rst     FP_CALC         ;; FP-CALC
  6646  14e1  a1                        defb    $A1             ;;stk-one
  6647  14e2  c0                        defb    $C0             ;;st-mem-0
  6648  14e3  02                        defb    $02             ;;delete
  6649  14e4  34                        defb    $34             ;;end-calc
  6650                          
  6651                          
  6652                          ; ---------------------
  6653                          ; THE 'NEXT DIGIT' LOOP
  6654                          ; ---------------------
  6655                          
  6656                          NXT_DGT_1:
  6657  14e5  e7                        rst     NEXT_CHAR       ; NEXT-CHAR
  6658  14e6  cd1415                    call    STK_DIGIT       ; routine STK-DIGIT
  6659  14e9  380a                      jr      c, E_FORMAT     ; forward to E-FORMAT
  6660                          
  6661                          
  6662  14eb  ef                        rst     FP_CALC         ;; FP-CALC
  6663  14ec  e0                        defb    $E0             ;;get-mem-0
  6664  14ed  a4                        defb    $A4             ;;stk-ten
  6665  14ee  05                        defb    $05             ;;division
  6666  14ef  c0                        defb    $C0             ;;st-mem-0
  6667  14f0  04                        defb    $04             ;;multiply
  6668  14f1  0f                        defb    $0F             ;;addition
  6669  14f2  34                        defb    $34             ;;end-calc
  6670                          
  6671  14f3  18f0                      jr      NXT_DGT_1       ; loop back till exhausted to NXT-DGT-1
  6672                          
  6673                          ; ---
  6674                          
  6675                          E_FORMAT:
  6676  14f5  fe2a                      cp      $2A             ; is character 'E' ?
  6677  14f7  c0                        ret     nz              ; return if not
  6678                          
  6679  14f8  fd365dff                  ld      (iy+MEMBOT-IY0), $FF
  6680                                                          ; initialize sv MEM-0-1st to $FF TRUE
  6681                          
  6682  14fc  e7                        rst     NEXT_CHAR       ; NEXT-CHAR
  6683  14fd  fe15                      cp      $15             ; is character a '+' ?
  6684  14ff  2807                      jr      z, SIGN_DONE    ; forward if so to SIGN-DONE
  6685                          
  6686  1501  fe16                      cp      $16             ; is it a '-' ?
  6687  1503  2004                      jr      nz, ST_E_PART   ; forward if not to ST-E-PART
  6688                          
  6689  1505  fd345d                    inc     (iy+MEMBOT-IY0) ; sv MEM-0-1st change to FALSE
  6690                          
  6691                          SIGN_DONE:
  6692  1508  e7                        rst     NEXT_CHAR       ; NEXT-CHAR
  6693                          
  6694                          ST_E_PART:
  6695  1509  cd4815                    call    INT_TO_FP       ; routine INT-TO-FP
  6696                          
  6697  150c  ef                        rst     FP_CALC         ;; FP-CALC              m, e.
  6698  150d  e0                        defb    $E0             ;;get-mem-0             m, e, (1/0) TRUE/FALSE
  6699  150e  00                        defb    $00             ;;jump-true
  6700  150f  02                        defb    $02             ;;to L1511, E-POSTVE
  6701  1510  18                        defb    $18             ;;neg                   m, -e
  6702                          
  6703                          E_POSTVE:
  6704  1511  38                        defb    $38             ;;e-to-fp               x.
  6705  1512  34                        defb    $34             ;;end-calc              x.
  6706                          
  6707  1513  c9                        ret                     ; return.
  6708                          
  6709                          
  6710                          ; --------------------------
  6711                          ; THE 'STK-DIGIT' SUBROUTINE
  6712                          ; --------------------------
  6713                          ;
  6714                          
  6715                          STK_DIGIT:
  6716  1514  fe1c                      cp      $1C             ;
  6717  1516  d8                        ret     c               ;
  6718                          
  6719  1517  fe26                      cp      $26             ;
  6720  1519  3f                        ccf                     ; Complement Carry Flag
  6721  151a  d8                        ret     c               ;
  6722                          
  6723  151b  d61c                      sub     $1C             ;
  6724                          
  6725                          ; ------------------------
  6726                          ; THE 'STACK-A' SUBROUTINE
  6727                          ; ------------------------
  6728                          ;
  6729                          
  6730                          
  6731                          STACK_A:
  6732  151d  4f                        ld      c, a            ;
  6733  151e  0600                      ld      b, $00          ;
  6734                          
  6735                          ; -------------------------
  6736                          ; THE 'STACK-BC' SUBROUTINE
  6737                          ; -------------------------
  6738                          ; The ZX81 does not have an integer number format so the BC register contents
  6739                          ; must be converted to their full floating-point form.
  6740                          
  6741                          STACK_BC:
  6742  1520  fd210040                  ld      iy, ERR_NR      ; re-initialize the system variables pointer.
  6743  1524  c5                        push    bc              ; save the integer value.
  6744                          
  6745                          ; now stack zero, five zero bytes as a starting point.
  6746                          
  6747  1525  ef                        rst     FP_CALC         ;; FP-CALC
  6748  1526  a0                        defb    $A0             ;;stk-zero                      0.
  6749  1527  34                        defb    $34             ;;end-calc
  6750                          
  6751  1528  c1                        pop     bc              ; restore integer value.
  6752                          
  6753  1529  3691                      ld      (hl), $91       ; place $91 in exponent         65536.
  6754                                                          ; this is the maximum possible value
  6755                          
  6756  152b  78                        ld      a, b            ; fetch hi-byte.
  6757  152c  a7                        and     a               ; test for zero.
  6758  152d  2007                      jr      nz, STK_BC_2    ; forward if not zero to STK-BC-2
  6759                          
  6760  152f  77                        ld      (hl), a         ; else make exponent zero again
  6761  1530  b1                        or      c               ; test lo-byte
  6762  1531  c8                        ret     z               ; return if BC was zero - done.
  6763                          
  6764                          ; else  there has to be a set bit if only the value one.
  6765                          
  6766  1532  41                        ld      b, c            ; save C in B.
  6767  1533  4e                        ld      c, (hl)         ; fetch zero to C
  6768  1534  3689                      ld      (hl), $89       ; make exponent $89             256.
  6769                          
  6770                          STK_BC_2:
  6771  1536  35                        dec     (hl)            ; decrement exponent - halving number
  6772  1537  cb21                      sla     c               ;  C<-76543210<-0
  6773  1539  cb10                      rl      b               ;  C<-76543210<-C
  6774  153b  30f9                      jr      nc, STK_BC_2    ; loop back if no carry to STK-BC-2
  6775                          
  6776  153d  cb38                      srl     b               ;  0->76543210->C
  6777  153f  cb19                      rr      c               ;  C->76543210->C
  6778                          
  6779  1541  23                        inc     hl              ; address first byte of mantissa
  6780  1542  70                        ld      (hl), b         ; insert B
  6781  1543  23                        inc     hl              ; address second byte of mantissa
  6782  1544  71                        ld      (hl), c         ; insert C
  6783                          
  6784  1545  2b                        dec     hl              ; point to the
  6785  1546  2b                        dec     hl              ; exponent again
  6786  1547  c9                        ret                     ; return.
  6787                          
  6788                          ; ------------------------------------------
  6789                          ; THE 'INTEGER TO FLOATING POINT' SUBROUTINE
  6790                          ; ------------------------------------------
  6791                          ;
  6792                          ;
  6793                          
  6794                          INT_TO_FP:
  6795  1548  f5                        push    af              ;
  6796                          
  6797  1549  ef                        rst     FP_CALC         ;; FP-CALC
  6798  154a  a0                        defb    $A0             ;;stk-zero
  6799  154b  34                        defb    $34             ;;end-calc
  6800                          
  6801  154c  f1                        pop     af              ;
  6802                          
  6803                          NXT_DGT_2:
  6804  154d  cd1415                    call    STK_DIGIT       ; routine STK-DIGIT
  6805  1550  d8                        ret     c               ;
  6806                          
  6807                          
  6808  1551  ef                        rst     FP_CALC         ;; FP-CALC
  6809  1552  01                        defb    $01             ;;exchange
  6810  1553  a4                        defb    $A4             ;;stk-ten
  6811  1554  04                        defb    $04             ;;multiply
  6812  1555  0f                        defb    $0F             ;;addition
  6813  1556  34                        defb    $34             ;;end-calc
  6814                          
  6815                          
  6816  1557  e7                        rst     NEXT_CHAR       ; NEXT-CHAR
  6817  1558  18f3                      jr      NXT_DGT_2       ; to NXT-DGT-2
  6818                          
  6819                          
  6820                          ; -------------------------------------------
  6821                          ; THE 'E-FORMAT TO FLOATING POINT' SUBROUTINE
  6822                          ; -------------------------------------------
  6823                          ; (Offset $38: 'e-to-fp')
  6824                          ; invoked from DEC-TO-FP and PRINT-FP.
  6825                          ; e.g. 2.3E4 is 23000.
  6826                          ; This subroutine evaluates xEm where m is a positive or negative integer.
  6827                          ; At a simple level x is multiplied by ten for every unit of m.
  6828                          ; If the decimal exponent m is negative then x is divided by ten for each unit.
  6829                          ; A short-cut is taken if the exponent is greater than seven and in this
  6830                          ; case the exponent is reduced by seven and the value is multiplied or divided
  6831                          ; by ten million.
  6832                          ; Note. for the ZX Spectrum an even cleverer method was adopted which involved
  6833                          ; shifting the bits out of the exponent so the result was achieved with six
  6834                          ; shifts at most. The routine below had to be completely re-written mostly
  6835                          ; in Z80 machine code.
  6836                          ; Although no longer operable, the calculator literal was retained for old
  6837                          ; times sake, the routine being invoked directly from a machine code CALL.
  6838                          ;
  6839                          ; On entry in the ZX81, m, the exponent, is the 'last value', and the
  6840                          ; floating-point decimal mantissa is beneath it.
  6841                          
  6842                          
  6843                          e_to_fp:
  6844  155a  ef                        rst     FP_CALC         ;; FP-CALC              x, m.
  6845  155b  2d                        defb    $2D             ;;duplicate             x, m, m.
  6846  155c  32                        defb    $32             ;;less-0                x, m, (1/0).
  6847  155d  c0                        defb    $C0             ;;st-mem-0              x, m, (1/0).
  6848  155e  02                        defb    $02             ;;delete                x, m.
  6849  155f  27                        defb    $27             ;;abs                   x, +m.
  6850                          
  6851                          E_LOOP:
  6852  1560  a1                        defb    $A1             ;;stk-one               x, m,1.
  6853  1561  03                        defb    $03             ;;subtract              x, m-1.
  6854  1562  2d                        defb    $2D             ;;duplicate             x, m-1,m-1.
  6855  1563  32                        defb    $32             ;;less-0                x, m-1, (1/0).
  6856  1564  00                        defb    $00             ;;jump-true             x, m-1.
  6857  1565  22                        defb    $22             ;;to L1587, E-END       x, m-1.
  6858                          
  6859  1566  2d                        defb    $2D             ;;duplicate             x, m-1, m-1.
  6860  1567  30                        defb    $30             ;;stk-data
  6861  1568  33                        defb    $33             ;;Exponent: $83, Bytes: 1
  6862                          
  6863  1569  40                        defb    $40             ;;(+00,+00,+00)         x, m-1, m-1, 6.
  6864  156a  03                        defb    $03             ;;subtract              x, m-1, m-7.
  6865  156b  2d                        defb    $2D             ;;duplicate             x, m-1, m-7, m-7.
  6866  156c  32                        defb    $32             ;;less-0                x, m-1, m-7, (1/0).
  6867  156d  00                        defb    $00             ;;jump-true             x, m-1, m-7.
  6868  156e  0c                        defb    $0C             ;;to L157A, E-LOW
  6869                          
  6870                          ; but if exponent m is higher than 7 do a bigger chunk.
  6871                          ; multiplying (or dividing if negative) by 10 million - 1e7.
  6872                          
  6873  156f  01                        defb    $01             ;;exchange              x, m-7, m-1.
  6874  1570  02                        defb    $02             ;;delete                x, m-7.
  6875  1571  01                        defb    $01             ;;exchange              m-7, x.
  6876  1572  30                        defb    $30             ;;stk-data
  6877  1573  80                        defb    $80             ;;Bytes: 3
  6878  1574  48                        defb    $48             ;;Exponent $98
  6879  1575  189680                    defb    $18, $96, $80   ;;(+00)                 m-7, x, 10,000,000 (=f)
  6880  1578  2f                        defb    $2F             ;;jump
  6881  1579  04                        defb    $04             ;;to L157D, E-CHUNK
  6882                          
  6883                          ; ---
  6884                          
  6885                          E_LOW:
  6886  157a  02                        defb    $02             ;;delete                x, m-1.
  6887  157b  01                        defb    $01             ;;exchange              m-1, x.
  6888  157c  a4                        defb    $A4             ;;stk-ten               m-1, x, 10 (=f).
  6889                          
  6890                          E_CHUNK:
  6891  157d  e0                        defb    $E0             ;;get-mem-0             m-1, x, f, (1/0)
  6892  157e  00                        defb    $00             ;;jump-true             m-1, x, f
  6893  157f  04                        defb    $04             ;;to L1583, E-DIVSN
  6894                          
  6895  1580  04                        defb    $04             ;;multiply              m-1, x*f.
  6896  1581  2f                        defb    $2F             ;;jump
  6897  1582  02                        defb    $02             ;;to L1584, E-SWAP
  6898                          
  6899                          ; ---
  6900                          
  6901                          E_DIVSN:
  6902  1583  05                        defb    $05             ;;division              m-1, x/f (= new x).
  6903                          
  6904                          E_SWAP:
  6905  1584  01                        defb    $01             ;;exchange              x, m-1 (= new m).
  6906  1585  2f                        defb    $2F             ;;jump                  x, m.
  6907  1586  da                        defb    $DA             ;;to L1560, E-LOOP
  6908                          
  6909                          ; ---
  6910                          
  6911                          E_END:
  6912  1587  02                        defb    $02             ;;delete                x. (-1)
  6913  1588  34                        defb    $34             ;;end-calc              x.
  6914                          
  6915  1589  c9                        ret                     ; return.
  6916                          
  6917                          ; -------------------------------------
  6918                          ; THE 'FLOATING-POINT TO BC' SUBROUTINE
  6919                          ; -------------------------------------
  6920                          ; The floating-point form on the calculator stack is compressed directly into
  6921                          ; the BC register rounding up if necessary.
  6922                          ; Valid range is 0 to 65535.4999
  6923                          
  6924                          FP_TO_BC:
  6925  158a  cdf813                    call    STK_FETCH       ; routine STK-FETCH - exponent to A
  6926                                                          ; mantissa to EDCB.
  6927  158d  a7                        and     a               ; test for value zero.
  6928  158e  2005                      jr      nz, FPBC_NZRO   ; forward if not to FPBC-NZRO
  6929                          
  6930                          ; else value is zero
  6931                          
  6932  1590  47                        ld      b, a            ; zero to B
  6933  1591  4f                        ld      c, a            ; also to C
  6934  1592  f5                        push    af              ; save the flags on machine stack
  6935  1593  1831                      jr      FPBC_END        ; forward to FPBC-END
  6936                          
  6937                          ; ---
  6938                          
  6939                          ; EDCB  =>  BCE
  6940                          
  6941                          FPBC_NZRO:
  6942  1595  43                        ld      b, e            ; transfer the mantissa from EDCB
  6943  1596  59                        ld      e, c            ; to BCE. Bit 7 of E is the 17th bit which
  6944  1597  4a                        ld      c, d            ; will be significant for rounding if the
  6945                                                          ; number is already normalized.
  6946                          
  6947  1598  d691                      sub     $91             ; subtract 65536
  6948  159a  3f                        ccf                     ; complement carry flag
  6949  159b  cb78                      bit     7, b            ; test sign bit
  6950  159d  f5                        push    af              ; push the result
  6951                          
  6952  159e  cbf8                      set     7, b            ; set the implied bit
  6953  15a0  3824                      jr      c, FPBC_END     ; forward with carry from SUB/CCF to FPBC-END
  6954                                                          ; number is too big.
  6955                          
  6956  15a2  3c                        inc     a               ; increment the exponent and
  6957  15a3  ed44                      neg                     ; negate to make range $00 - $0F
  6958                          
  6959  15a5  fe08                      cp      $08             ; test if one or two bytes
  6960  15a7  3806                      jr      c, BIG_INT      ; forward with two to BIG-INT
  6961                          
  6962  15a9  59                        ld      e, c            ; shift mantissa
  6963  15aa  48                        ld      c, b            ; 8 places right
  6964  15ab  0600                      ld      b, $00          ; insert a zero in B
  6965  15ad  d608                      sub     $08             ; reduce exponent by eight
  6966                          
  6967                          BIG_INT:
  6968  15af  a7                        and     a               ; test the exponent
  6969  15b0  57                        ld      d, a            ; save exponent in D.
  6970                          
  6971  15b1  7b                        ld      a, e            ; fractional bits to A
  6972  15b2  07                        rlca                    ; rotate most significant bit to carry for
  6973                                                          ; rounding of an already normal number.
  6974                          
  6975  15b3  2807                      jr      z, EXP_ZERO     ; forward if exponent zero to EXP-ZERO
  6976                                                          ; the number is normalized
  6977                          
  6978                          FPBC_NORM:
  6979  15b5  cb38                      srl     b               ;   0->76543210->C
  6980  15b7  cb19                      rr      c               ;   C->76543210->C
  6981                          
  6982  15b9  15                        dec     d               ; decrement exponent
  6983                          
  6984  15ba  20f9                      jr      nz, FPBC_NORM   ; loop back till zero to FPBC-NORM
  6985                          
  6986                          EXP_ZERO:
  6987  15bc  3008                      jr      nc, FPBC_END    ; forward without carry to NO-ROUND
  6988                          
  6989  15be  03                        inc     bc              ; round up.
  6990  15bf  78                        ld      a, b            ; test result
  6991  15c0  b1                        or      c               ; for zero
  6992  15c1  2003                      jr      nz, FPBC_END    ; forward if not to GRE-ZERO
  6993                          
  6994  15c3  f1                        pop     af              ; restore sign flag
  6995  15c4  37                        scf                     ; set carry flag to indicate overflow
  6996  15c5  f5                        push    af              ; save combined flags again
  6997                          
  6998                          FPBC_END:
  6999  15c6  c5                        push    bc              ; save BC value
  7000                          
  7001                          ; set HL and DE to calculator stack pointers.
  7002                          
  7003  15c7  ef                        rst     FP_CALC         ;; FP-CALC
  7004  15c8  34                        defb    $34             ;;end-calc
  7005                          
  7006                          
  7007  15c9  c1                        pop     bc              ; restore BC value
  7008  15ca  f1                        pop     af              ; restore flags
  7009  15cb  79                        ld      a, c            ; copy low byte to A also.
  7010  15cc  c9                        ret                     ; return
  7011                          
  7012                          ; ------------------------------------
  7013                          ; THE 'FLOATING-POINT TO A' SUBROUTINE
  7014                          ; ------------------------------------
  7015                          ;
  7016                          ;
  7017                          
  7018                          FP_TO_A:
  7019  15cd  cd8a15                    call    FP_TO_BC        ; routine FP-TO-BC
  7020  15d0  d8                        ret     c               ;
  7021                          
  7022  15d1  f5                        push    af              ;
  7023  15d2  05                        dec     b               ;
  7024  15d3  04                        inc     b               ;
  7025  15d4  2803                      jr      z, FP_A_END     ; forward if in range to FP-A-END
  7026                          
  7027  15d6  f1                        pop     af              ; fetch result
  7028  15d7  37                        scf                     ; set carry flag signaling overflow
  7029  15d8  c9                        ret                     ; return
  7030                          
  7031                          FP_A_END:
  7032  15d9  f1                        pop     af              ;
  7033  15da  c9                        ret                     ;
  7034                          
  7035                          
  7036                          ; ----------------------------------------------
  7037                          ; THE 'PRINT A FLOATING-POINT NUMBER' SUBROUTINE
  7038                          ; ----------------------------------------------
  7039                          ; prints 'last value' x on calculator stack.
  7040                          ; There are a wide variety of formats see Chapter 4.
  7041                          ; e.g.
  7042                          ; PI            prints as       3.1415927
  7043                          ; .123          prints as       0.123
  7044                          ; .0123         prints as       .0123
  7045                          ; 999999999999  prints as       1000000000000
  7046                          ; 9876543210123 prints as       9876543200000
  7047                          
  7048                          ; Begin by isolating zero and just printing the '0' character
  7049                          ; for that case. For negative numbers print a leading '-' and
  7050                          ; then form the absolute value of x.
  7051                          
  7052                          PRINT_FP:
  7053  15db  ef                        rst     FP_CALC         ;; FP-CALC              x.
  7054  15dc  2d                        defb    $2D             ;;duplicate             x, x.
  7055  15dd  32                        defb    $32             ;;less-0                x, (1/0).
  7056  15de  00                        defb    $00             ;;jump-true
  7057  15df  0b                        defb    $0B             ;;to L15EA, PF-NGTVE    x.
  7058                          
  7059  15e0  2d                        defb    $2D             ;;duplicate             x, x
  7060  15e1  33                        defb    $33             ;;greater-0             x, (1/0).
  7061  15e2  00                        defb    $00             ;;jump-true
  7062  15e3  0d                        defb    $0D             ;;to L15F0, PF-POSTVE   x.
  7063                          
  7064  15e4  02                        defb    $02             ;;delete                .
  7065  15e5  34                        defb    $34             ;;end-calc              .
  7066                          
  7067  15e6  3e1c                      ld      a, $1C          ; load accumulator with character '0'
  7068                          
  7069  15e8  d7                        rst     PRINT_A         ; PRINT-A
  7070  15e9  c9                        ret                     ; return.                               >>
  7071                          
  7072                          ; ---
  7073                          
  7074                          PF_NEGTVE:
  7075  15ea  27                        defb    $27             ; abs                   +x.
  7076  15eb  34                        defb    $34             ;;end-calc              x.
  7077                          
  7078  15ec  3e16                      ld      a, $16          ; load accumulator with '-'
  7079                          
  7080  15ee  d7                        rst     PRINT_A         ; PRINT-A
  7081                          
  7082  15ef  ef                        rst     FP_CALC         ;; FP-CALC              x.
  7083                          
  7084                          PF_POSTVE:
  7085  15f0  34                        defb    $34             ;;end-calc              x.
  7086                          
  7087                          ; register HL addresses the exponent of the floating-point value.
  7088                          ; if positive, and point floats to left, then bit 7 is set.
  7089                          
  7090  15f1  7e                        ld      a, (hl)         ; pick up the exponent byte
  7091  15f2  cd1d15                    call    STACK_A         ; routine STACK-A places on calculator stack.
  7092                          
  7093                          ; now calculate roughly the number of digits, n, before the decimal point by
  7094                          ; subtracting a half from true exponent and multiplying by log to
  7095                          ; the base 10 of 2.
  7096                          ; The true number could be one higher than n, the integer result.
  7097                          
  7098  15f5  ef                        rst     FP_CALC         ;; FP-CALC              x, e.
  7099  15f6  30                        defb    $30             ;;stk-data
  7100  15f7  78                        defb    $78             ;;Exponent: $88, Bytes: 2
  7101  15f8  0080                      defb    $00, $80        ;;(+00,+00)             x, e, 128.5.
  7102  15fa  03                        defb    $03             ;;subtract              x, e -.5.
  7103  15fb  30                        defb    $30             ;;stk-data
  7104  15fc  ef                        defb    $EF             ;;Exponent: $7F, Bytes: 4
  7105  15fd  1a209a85                  defb    $1A, $20, $9A, $85
  7106                                                          ;;                      .30103 (log10 2)
  7107  1601  04                        defb    $04             ;;multiply              x,
  7108  1602  24                        defb    $24             ;;int
  7109  1603  c1                        defb    $C1             ;;st-mem-1              x, n.
  7110                          
  7111                          
  7112  1604  30                        defb    $30             ;;stk-data
  7113  1605  34                        defb    $34             ;;Exponent: $84, Bytes: 1
  7114  1606  00                        defb    $00             ;;(+00,+00,+00)         x, n, 8.
  7115                          
  7116  1607  03                        defb    $03             ;;subtract              x, n-8.
  7117  1608  18                        defb    $18             ;;neg                   x, 8-n.
  7118  1609  38                        defb    $38             ;;e-to-fp               x * (10^n)
  7119                          
  7120                          ; finally the 8 or 9 digit decimal is rounded.
  7121                          ; a ten-digit integer can arise in the case of, say, 999999999.5
  7122                          ; which gives 1000000000.
  7123                          
  7124  160a  a2                        defb    $A2             ;;stk-half
  7125  160b  0f                        defb    $0F             ;;addition
  7126  160c  24                        defb    $24             ;;int                   i.
  7127  160d  34                        defb    $34             ;;end-calc
  7128                          
  7129                          ; If there were 8 digits then final rounding will take place on the calculator
  7130                          ; stack above and the next two instructions insert a masked zero so that
  7131                          ; no further rounding occurs. If the result is a 9 digit integer then
  7132                          ; rounding takes place within the buffer.
  7133                          
  7134  160e  216b40                    ld      hl, MEMBOT+2*5+4; address system variable MEM-2-5th
  7135                                                          ; which could be the 'ninth' digit.
  7136  1611  3690                      ld      (hl), $90       ; insert the value $90  10010000
  7137                          
  7138                          ; now starting from lowest digit lay down the 8, 9 or 10 digit integer
  7139                          ; which represents the significant portion of the number
  7140                          ; e.g. PI will be the nine-digit integer 314159265
  7141                          
  7142  1613  060a                      ld      b, $0A          ; count is ten digits.
  7143                          
  7144                          PF_LOOP:
  7145  1615  23                        inc     hl              ; increase pointer
  7146                          
  7147  1616  e5                        push    hl              ; preserve buffer address.
  7148  1617  c5                        push    bc              ; preserve counter.
  7149                          
  7150  1618  ef                        rst     FP_CALC         ;; FP-CALC              i.
  7151  1619  a4                        defb    $A4             ;;stk-ten               i, 10.
  7152  161a  2e                        defb    $2E             ;;n-mod-m               i mod 10, i/10
  7153  161b  01                        defb    $01             ;;exchange              i/10, remainder.
  7154  161c  34                        defb    $34             ;;end-calc
  7155                          
  7156  161d  cdcd15                    call    FP_TO_A         ; routine FP-TO-A  $00-$09
  7157                          
  7158  1620  f690                      or      $90             ; make left hand nibble 9
  7159                          
  7160  1622  c1                        pop     bc              ; restore counter
  7161  1623  e1                        pop     hl              ; restore buffer address.
  7162                          
  7163  1624  77                        ld      (hl), a         ; insert masked digit in buffer.
  7164  1625  10ee                      djnz    PF_LOOP         ; loop back for all ten to PF-LOOP
  7165                          
  7166                          ; the most significant digit will be last but if the number is exhausted then
  7167                          ; the last one or two positions will contain zero ($90).
  7168                          
  7169                          ; e.g. for 'one' we have zero as estimate of leading digits.
  7170                          ; 1*10^8 100000000 as integer value
  7171                          ; 90 90 90 90 90   90 90 90 91 90 as buffer mem3/mem4 contents.
  7172                          
  7173                          
  7174  1627  23                        inc     hl              ; advance pointer to one past buffer
  7175  1628  010800                    ld      bc, $0008       ; set C to 8 ( B is already zero )
  7176  162b  e5                        push    hl              ; save pointer.
  7177                          
  7178                          PF_NULL:
  7179  162c  2b                        dec     hl              ; decrease pointer
  7180  162d  7e                        ld      a, (hl)         ; fetch masked digit
  7181  162e  fe90                      cp      $90             ; is it a leading zero ?
  7182  1630  28fa                      jr      z, PF_NULL      ; loop back if so to PF-NULL
  7183                          
  7184                          ; at this point a significant digit has been found. carry is reset.
  7185                          
  7186  1632  ed42                      sbc     hl, bc          ; subtract eight from the address.
  7187  1634  e5                        push    hl              ; ** save this pointer too
  7188  1635  7e                        ld      a, (hl)         ; fetch addressed byte
  7189  1636  c66b                      add     a, $6B          ; add $6B - forcing a round up ripple
  7190                                                          ; if  $95 or over.
  7191  1638  f5                        push    af              ; save the carry result.
  7192                          
  7193                          ; now enter a loop to round the number. After rounding has been considered
  7194                          ; a zero that has arisen from rounding or that was present at that position
  7195                          ; originally is changed from $90 to $80.
  7196                          
  7197                          PF_RND_LP:
  7198  1639  f1                        pop     af              ; retrieve carry from machine stack.
  7199  163a  23                        inc     hl              ; increment address
  7200  163b  7e                        ld      a, (hl)         ; fetch new byte
  7201  163c  ce00                      adc     a, $00          ; add in any carry
  7202                          
  7203  163e  27                        daa                     ; decimal adjust accumulator
  7204                                                          ; carry will ripple through the '9'
  7205                          
  7206  163f  f5                        push    af              ; save carry on machine stack.
  7207  1640  e60f                      and     $0F             ; isolate character 0 - 9 AND set zero flag
  7208                                                          ; if zero.
  7209  1642  77                        ld      (hl), a         ; place back in location.
  7210  1643  cbfe                      set     7, (hl)         ; set bit 7 to show printable.
  7211                                                          ; but not if trailing zero after decimal point.
  7212  1645  28f2                      jr      z, PF_RND_LP    ; back if a zero to PF-RND-LP
  7213                                                          ; to consider further rounding and/or trailing
  7214                                                          ; zero identification.
  7215                          
  7216  1647  f1                        pop     af              ; balance stack
  7217  1648  e1                        pop     hl              ; ** retrieve lower pointer
  7218                          
  7219                          ; now insert 6 trailing zeros which are printed if before the decimal point
  7220                          ; but mark the end of printing if after decimal point.
  7221                          ; e.g. 9876543210123 is printed as 9876543200000
  7222                          ; 123.456001 is printed as 123.456
  7223                          
  7224  1649  0606                      ld      b, $06          ; the count is six.
  7225                          
  7226                          PF_ZERO_6:
  7227  164b  3680                      ld      (hl), $80       ; insert a masked zero
  7228  164d  2b                        dec     hl              ; decrease pointer.
  7229  164e  10fb                      djnz    PF_ZERO_6       ; loop back for all six to PF-ZERO-6
  7230                          
  7231                          ; n-mod-m reduced the number to zero and this is now deleted from the calculator
  7232                          ; stack before fetching the original estimate of leading digits.
  7233                          
  7234                          
  7235  1650  ef                        rst     FP_CALC         ;; FP-CALC              0.
  7236  1651  02                        defb    $02             ;;delete                .
  7237  1652  e1                        defb    $E1             ;;get-mem-1             n.
  7238  1653  34                        defb    $34             ;;end-calc              n.
  7239                          
  7240  1654  cdcd15                    call    FP_TO_A         ; routine FP-TO-A
  7241  1657  2802                      jr      z, PF_POS       ; skip forward if positive to PF-POS
  7242                          
  7243  1659  ed44                      neg                     ; negate makes positive
  7244                          
  7245                          PF_POS:
  7246  165b  5f                        ld      e, a            ; transfer count of digits to E
  7247  165c  1c                        inc     e               ; increment twice
  7248  165d  1c                        inc     e               ;
  7249  165e  e1                        pop     hl              ; * retrieve pointer to one past buffer.
  7250                          
  7251                          GET_FIRST:
  7252  165f  2b                        dec     hl              ; decrement address.
  7253  1660  1d                        dec     e               ; decrement digit counter.
  7254  1661  7e                        ld      a, (hl)         ; fetch masked byte.
  7255  1662  e60f                      and     $0F             ; isolate right-hand nibble.
  7256  1664  28f9                      jr      z, GET_FIRST    ; back with leading zero to GET-FIRST
  7257                          
  7258                          ; now determine if E-format printing is needed
  7259                          
  7260  1666  7b                        ld      a, e            ; transfer now accurate number count to A.
  7261  1667  d605                      sub     $05             ; subtract five
  7262  1669  fe08                      cp      $08             ; compare with 8 as maximum digits is 13.
  7263  166b  f28216                    jp      p, PF_E_FMT     ; forward if positive to PF-E-FMT
  7264                          
  7265  166e  fef6                      cp      $F6             ; test for more than four zeros after point.
  7266  1670  fa8216                    jp      m, PF_E_FMT     ; forward if so to PF-E-FMT
  7267                          
  7268  1673  c606                      add     a, $06          ; test for zero leading digits, e.g. 0.5
  7269  1675  2848                      jr      z, PF_ZERO_1    ; forward if so to PF-ZERO-1
  7270                          
  7271  1677  fab216                    jp      m, PF_ZEROS     ; forward if more than one zero to PF-ZEROS
  7272                          
  7273                          ; else digits before the decimal point are to be printed
  7274                          
  7275  167a  47                        ld      b, a            ; count of leading characters to B.
  7276                          
  7277                          PF_NIB_LP:
  7278  167b  cdd016                    call    PF_NIBBLE       ; routine PF-NIBBLE
  7279  167e  10fb                      djnz    PF_NIB_LP       ; loop back for counted numbers to PF-NIB-LP
  7280                          
  7281  1680  1840                      jr      PF_DC_OUT       ; forward to consider decimal part to PF-DC-OUT
  7282                          
  7283                          ; ---
  7284                          
  7285                          PF_E_FMT:
  7286  1682  43                        ld      b, e            ; count to B
  7287  1683  cdd016                    call    PF_NIBBLE       ; routine PF-NIBBLE prints one digit.
  7288  1686  cdc216                    call    PF_DC_OUT       ; routine PF-DC-OUT considers fractional part.
  7289                          
  7290  1689  3e2a                      ld      a, $2A          ; prepare character 'E'
  7291  168b  d7                        rst     PRINT_A         ; PRINT-A
  7292                          
  7293  168c  78                        ld      a, b            ; transfer exponent to A
  7294  168d  a7                        and     a               ; test the sign.
  7295  168e  f29816                    jp      p, PF_E_POS     ; forward if positive to PF-E-POS
  7296                          
  7297  1691  ed44                      neg                     ; negate the negative exponent.
  7298  1693  47                        ld      b, a            ; save positive exponent in B.
  7299                          
  7300  1694  3e16                      ld      a, $16          ; prepare character '-'
  7301  1696  1802                      jr      PF_E_SIGN       ; skip forward to PF-E-SIGN
  7302                          
  7303                          ; ---
  7304                          
  7305                          PF_E_POS:
  7306  1698  3e15                      ld      a, $15          ; prepare character '+'
  7307                          
  7308                          PF_E_SIGN:
  7309  169a  d7                        rst     PRINT_A         ; PRINT-A
  7310                          
  7311                          ; now convert the integer exponent in B to two characters.
  7312                          ; it will be less than 99.
  7313                          
  7314  169b  78                        ld      a, b            ; fetch positive exponent.
  7315  169c  06ff                      ld      b, $FF          ; initialize left hand digit to minus one.
  7316                          
  7317                          PF_E_TENS:
  7318  169e  04                        inc     b               ; increment ten count
  7319  169f  d60a                      sub     $0A             ; subtract ten from exponent
  7320  16a1  30fb                      jr      nc, PF_E_TENS   ; loop back if greater than ten to PF-E-TENS
  7321                          
  7322  16a3  c60a                      add     a, $0A          ; reverse last subtraction
  7323  16a5  4f                        ld      c, a            ; transfer remainder to C
  7324                          
  7325  16a6  78                        ld      a, b            ; transfer ten value to A.
  7326  16a7  a7                        and     a               ; test for zero.
  7327  16a8  2803                      jr      z, PF_E_LOW     ; skip forward if so to PF-E-LOW
  7328                          
  7329  16aa  cdeb07                    call    OUT_CODE        ; routine OUT-CODE prints as digit '1' - '9'
  7330                          
  7331                          PF_E_LOW:
  7332  16ad  79                        ld      a, c            ; low byte to A
  7333  16ae  cdeb07                    call    OUT_CODE        ; routine OUT-CODE prints final digit of the
  7334                                                          ; exponent.
  7335  16b1  c9                        ret                     ; return.                               >>
  7336                          
  7337                          ; ---
  7338                          
  7339                          ; -------------------------------------
  7340                          ; THE 'FLOATING POINT PRINT ZEROS' LOOP
  7341                          ; -------------------------------------
  7342                          
  7343                          ; This branch deals with zeros after decimal point.
  7344                          ; e.g.      .01 or .0000999
  7345                          ; Note. that printing to the ZX Printer destroys A and that A should be
  7346                          ; initialized to '0' at each stage of the loop.
  7347                          ; LPRINT .00001 prints as .0XYZ1
  7348                          
  7349                          PF_ZEROS:
  7350  16b2  ed44                      neg                     ; negate makes number positive 1 to 4.
  7351  16b4  47                        ld      b, a            ; zero count to B.
  7352                          
  7353  16b5  3e1b                      ld      a, $1B          ; prepare character '.'
  7354  16b7  d7                        rst     PRINT_A         ; PRINT-A
  7355                          
  7356  16b8  3e1c                      ld      a, $1C          ; prepare a '0'
  7357                          
  7358                          PF_ZRO_LP:
  7359  16ba  d7                        rst     PRINT_A         ; PRINT-A
  7360                          
  7361  16bb  10fd                      djnz    PF_ZRO_LP       ; loop back to PF-ZRO-LP
  7362                          
  7363                          ;   and continue with trailing fractional digits...
  7364                          
  7365  16bd  1809                      jr      PF_FRAC_LP      ; forward to PF-FRAC-LP
  7366                          
  7367                          ; ---
  7368                          
  7369                          ; there is  a need to print a leading zero e.g. 0.1 but not with .01
  7370                          
  7371                          PF_ZERO_1:
  7372  16bf  3e1c                      ld      a, $1C          ; prepare character '0'.
  7373  16c1  d7                        rst     PRINT_A         ; PRINT-A
  7374                          
  7375                          ; this subroutine considers the decimal point and any trailing digits.
  7376                          ; if the next character is a marked zero, $80, then nothing more to print.
  7377                          
  7378                          PF_DC_OUT:
  7379  16c2  35                        dec     (hl)            ; decrement addressed character
  7380  16c3  34                        inc     (hl)            ; increment it again
  7381  16c4  e8                        ret     pe              ; return with overflow  (was 128) >>
  7382                                                          ; as no fractional part
  7383                          
  7384                          ; else there is a fractional part so print the decimal point.
  7385                          
  7386  16c5  3e1b                      ld      a, $1B          ; prepare character '.'
  7387  16c7  d7                        rst     PRINT_A         ; PRINT-A
  7388                          
  7389                          ; now enter a loop to print trailing digits
  7390                          
  7391                          PF_FRAC_LP:
  7392  16c8  35                        dec     (hl)            ; test for a marked zero.
  7393  16c9  34                        inc     (hl)            ;
  7394  16ca  e8                        ret     pe              ; return when digits exhausted          >>
  7395                          
  7396  16cb  cdd016                    call    PF_NIBBLE       ; routine PF-NIBBLE
  7397  16ce  18f8                      jr      PF_FRAC_LP      ; back for all fractional digits to PF-FRAC-LP.
  7398                          
  7399                          ; ---
  7400                          
  7401                          ; subroutine to print right-hand nibble
  7402                          
  7403                          PF_NIBBLE:
  7404  16d0  7e                        ld      a, (hl)         ; fetch addressed byte
  7405  16d1  e60f                      and     $0F             ; mask off lower 4 bits
  7406  16d3  cdeb07                    call    OUT_CODE        ; routine OUT-CODE
  7407  16d6  2b                        dec     hl              ; decrement pointer.
  7408  16d7  c9                        ret                     ; return.
  7409                          
  7410                          
  7411                          ; -------------------------------
  7412                          ; THE 'PREPARE TO ADD' SUBROUTINE
  7413                          ; -------------------------------
  7414                          ; This routine is called twice to prepare each floating point number for
  7415                          ; addition, in situ, on the calculator stack.
  7416                          ; The exponent is picked up from the first byte which is then cleared to act
  7417                          ; as a sign byte and accept any overflow.
  7418                          ; If the exponent is zero then the number is zero and an early return is made.
  7419                          ; The now redundant sign bit of the mantissa is set and if the number is
  7420                          ; negative then all five bytes of the number are twos-complemented to prepare
  7421                          ; the number for addition.
  7422                          ; On the second invocation the exponent of the first number is in B.
  7423                          
  7424                          
  7425                          PREP_ADD:
  7426  16d8  7e                        ld      a, (hl)         ; fetch exponent.
  7427  16d9  3600                      ld      (hl), $00       ; make this byte zero to take any overflow and
  7428                                                          ; default to positive.
  7429  16db  a7                        and     a               ; test stored exponent for zero.
  7430  16dc  c8                        ret     z               ; return with zero flag set if number is zero.
  7431                          
  7432  16dd  23                        inc     hl              ; point to first byte of mantissa.
  7433  16de  cb7e                      bit     7, (hl)         ; test the sign bit.
  7434  16e0  cbfe                      set     7, (hl)         ; set it to its implied state.
  7435  16e2  2b                        dec     hl              ; set pointer to first byte again.
  7436  16e3  c8                        ret     z               ; return if bit indicated number is positive.>>
  7437                          
  7438                          ; if negative then all five bytes are twos complemented starting at LSB.
  7439                          
  7440  16e4  c5                        push    bc              ; save B register contents.
  7441  16e5  010500                    ld      bc, $0005       ; set BC to five.
  7442  16e8  09                        add     hl, bc          ; point to location after 5th byte.
  7443  16e9  41                        ld      b, c            ; set the B counter to five.
  7444  16ea  4f                        ld      c, a            ; store original exponent in C.
  7445  16eb  37                        scf                     ; set carry flag so that one is added.
  7446                          
  7447                          ; now enter a loop to twos-complement the number.
  7448                          ; The first of the five bytes becomes $FF to denote a negative number.
  7449                          
  7450                          NEG_BYTE:
  7451  16ec  2b                        dec     hl              ; point to first or more significant byte.
  7452  16ed  7e                        ld      a, (hl)         ; fetch to accumulator.
  7453  16ee  2f                        cpl                     ; complement.
  7454  16ef  ce00                      adc     a, $00          ; add in initial carry or any subsequent carry.
  7455  16f1  77                        ld      (hl), a         ; place number back.
  7456  16f2  10f8                      djnz    NEG_BYTE        ; loop back five times to NEG-BYTE
  7457                          
  7458  16f4  79                        ld      a, c            ; restore the exponent to accumulator.
  7459  16f5  c1                        pop     bc              ; restore B register contents.
  7460                          
  7461  16f6  c9                        ret                     ; return.
  7462                          
  7463                          ; ----------------------------------
  7464                          ; THE 'FETCH TWO NUMBERS' SUBROUTINE
  7465                          ; ----------------------------------
  7466                          ; This routine is used by addition, multiplication and division to fetch
  7467                          ; the two five-byte numbers addressed by HL and DE from the calculator stack
  7468                          ; into the Z80 registers.
  7469                          ; The HL register may no longer point to the first of the two numbers.
  7470                          ; Since the 32-bit addition operation is accomplished using two Z80 16-bit
  7471                          ; instructions, it is important that the lower two bytes of each mantissa are
  7472                          ; in one set of registers and the other bytes all in the alternate set.
  7473                          ;
  7474                          ; In: HL = highest number, DE= lowest number
  7475                          ;
  7476                          ;         : alt':   :
  7477                          ; Out:    :H,B-C:C,B: num1
  7478                          ;         :L,D-E:D-E: num2
  7479                          
  7480                          FETCH_TWO:
  7481  16f7  e5                        push    hl              ; save HL
  7482  16f8  f5                        push    af              ; save A - result sign when used from division.
  7483                          
  7484  16f9  4e                        ld      c, (hl)         ;
  7485  16fa  23                        inc     hl              ;
  7486  16fb  46                        ld      b, (hl)         ;
  7487  16fc  77                        ld      (hl), a         ; insert sign when used from multiplication.
  7488  16fd  23                        inc     hl              ;
  7489  16fe  79                        ld      a, c            ; m1
  7490  16ff  4e                        ld      c, (hl)         ;
  7491  1700  c5                        push    bc              ; PUSH m2 m3
  7492                          
  7493  1701  23                        inc     hl              ;
  7494  1702  4e                        ld      c, (hl)         ; m4
  7495  1703  23                        inc     hl              ;
  7496  1704  46                        ld      b, (hl)         ; m5  BC holds m5 m4
  7497                          
  7498  1705  eb                        ex      de, hl          ; make HL point to start of second number.
  7499                          
  7500  1706  57                        ld      d, a            ; m1
  7501  1707  5e                        ld      e, (hl)         ;
  7502  1708  d5                        push    de              ; PUSH m1 n1
  7503                          
  7504  1709  23                        inc     hl              ;
  7505  170a  56                        ld      d, (hl)         ;
  7506  170b  23                        inc     hl              ;
  7507  170c  5e                        ld      e, (hl)         ;
  7508  170d  d5                        push    de              ; PUSH n2 n3
  7509                          
  7510  170e  d9                        exx                     ; - - - - - - -
  7511                          
  7512  170f  d1                        pop     de              ; POP n2 n3
  7513  1710  e1                        pop     hl              ; POP m1 n1
  7514  1711  c1                        pop     bc              ; POP m2 m3
  7515                          
  7516  1712  d9                        exx                     ; - - - - - - -
  7517                          
  7518  1713  23                        inc     hl              ;
  7519  1714  56                        ld      d, (hl)         ;
  7520  1715  23                        inc     hl              ;
  7521  1716  5e                        ld      e, (hl)         ; DE holds n4 n5
  7522                          
  7523  1717  f1                        pop     af              ; restore saved
  7524  1718  e1                        pop     hl              ; registers.
  7525  1719  c9                        ret                     ; return.
  7526                          
  7527                          ; -----------------------------
  7528                          ; THE 'SHIFT ADDEND' SUBROUTINE
  7529                          ; -----------------------------
  7530                          ; The accumulator A contains the difference between the two exponents.
  7531                          ; This is the lowest of the two numbers to be added
  7532                          
  7533                          SHIFT_FP:
  7534  171a  a7                        and     a               ; test difference between exponents.
  7535  171b  c8                        ret     z               ; return if zero. both normal.
  7536                          
  7537  171c  fe21                      cp      $21             ; compare with 33 bits.
  7538  171e  3016                      jr      nc, ADDEND_0    ; forward if greater than 32 to ADDEND-0
  7539                          
  7540  1720  c5                        push    bc              ; preserve BC - part
  7541  1721  47                        ld      b, a            ; shift counter to B.
  7542                          
  7543                          ; Now perform B right shifts on the addend  L'D'E'D E
  7544                          ; to bring it into line with the augend     H'B'C'C B
  7545                          
  7546                          ONE_SHIFT:
  7547  1722  d9                        exx                     ; - - -
  7548  1723  cb2d                      sra     l               ;    76543210->C    bit 7 unchanged.
  7549  1725  cb1a                      rr      d               ; C->76543210->C
  7550  1727  cb1b                      rr      e               ; C->76543210->C
  7551  1729  d9                        exx                     ; - - -
  7552  172a  cb1a                      rr      d               ; C->76543210->C
  7553  172c  cb1b                      rr      e               ; C->76543210->C
  7554  172e  10f2                      djnz    ONE_SHIFT       ; loop back B times to ONE-SHIFT
  7555                          
  7556  1730  c1                        pop     bc              ; restore BC
  7557  1731  d0                        ret     nc              ; return if last shift produced no carry.   >>
  7558                          
  7559                          ; if carry flag was set then accuracy is being lost so round up the addend.
  7560                          
  7561  1732  cd4117                    call    ADD_BACK        ; routine ADD-BACK
  7562  1735  c0                        ret     nz              ; return if not FF 00 00 00 00
  7563                          
  7564                          ; this branch makes all five bytes of the addend zero and is made during
  7565                          ; addition when the exponents are too far apart for the addend bits to
  7566                          ; affect the result.
  7567                          
  7568                          ADDEND_0:
  7569  1736  d9                        exx                     ; select alternate set for more significant
  7570                                                          ; bytes.
  7571                          
  7572                          
  7573                          ; In Edition 2 ROM, deleted spurious instructions causing floating point bug
  7574                          
  7575  1737  af                        xor     a               ; clear accumulator.
  7576                          
  7577                          ; this entry point (from multiplication) sets four of the bytes to zero or if
  7578                          ; continuing from above, during addition, then all five bytes are set to zero.
  7579                          
  7580                          ZEROS_4_OR_5:
  7581  1738  2e00                      ld      l, $00          ; set byte 1 to zero - sign indicator
  7582  173a  57                        ld      d, a            ; set byte 2 to A.
  7583  173b  5d                        ld      e, l            ; set byte 3 to zero.
  7584  173c  d9                        exx                     ; select main set
  7585  173d  110000                    ld      de, $0000       ; set lower bytes 4 and 5 to zero.
  7586  1740  c9                        ret                     ; return.
  7587                          
  7588                          ; -------------------------
  7589                          ; THE 'ADD-BACK' SUBROUTINE
  7590                          ; -------------------------
  7591                          ; Called from SHIFT-FP above during addition and after normalization from
  7592                          ; multiplication.
  7593                          ; This is really a 32-bit increment routine which sets the zero flag according
  7594                          ; to the 32-bit result.
  7595                          ; During addition, only negative numbers like FF FF FF FF FF,
  7596                          ; the twos-complement version of xx 80 00 00 01 say
  7597                          ; will result in a full ripple FF 00 00 00 00.
  7598                          ; FF FF FF FF FF when shifted right is unchanged by SHIFT-FP but sets the
  7599                          ; carry invoking this routine.
  7600                          
  7601                          ADD_BACK:
  7602  1741  1c                        inc     e               ;
  7603  1742  c0                        ret     nz              ;
  7604                          
  7605  1743  14                        inc     d               ;
  7606  1744  c0                        ret     nz              ;
  7607                          
  7608  1745  d9                        exx                     ;
  7609  1746  1c                        inc     e               ;
  7610  1747  2001                      jr      nz, ALL_ADDED   ; forward if no overflow to ALL-ADDED
  7611                          
  7612  1749  14                        inc     d               ;
  7613                          
  7614                          ALL_ADDED:
  7615  174a  d9                        exx                     ;
  7616  174b  c9                        ret                     ; return with zero flag set for zero mantissa.
  7617                          
  7618                          
  7619                          ; ---------------------------
  7620                          ; THE 'SUBTRACTION' OPERATION
  7621                          ; ---------------------------
  7622                          ; just switch the sign of subtrahend and do an add.
  7623                          
  7624                          subtract:
  7625  174c  1a                        ld      a, (de)         ; fetch exponent byte of second number the
  7626                                                          ; subtrahend.
  7627  174d  a7                        and     a               ; test for zero
  7628  174e  c8                        ret     z               ; return if zero - first number is result.
  7629                          
  7630  174f  13                        inc     de              ; address the first mantissa byte.
  7631  1750  1a                        ld      a, (de)         ; fetch to accumulator.
  7632  1751  ee80                      xor     $80             ; toggle the sign bit.
  7633  1753  12                        ld      (de), a         ; place back on calculator stack.
  7634  1754  1b                        dec     de              ; point to exponent byte.
  7635                                                          ; continue into addition routine.
  7636                          
  7637                          ; ------------------------
  7638                          ; THE 'ADDITION' OPERATION
  7639                          ; ------------------------
  7640                          ; The addition operation pulls out all the stops and uses most of the Z80's
  7641                          ; registers to add two floating-point numbers.
  7642                          ; This is a binary operation and on entry, HL points to the first number
  7643                          ; and DE to the second.
  7644                          
  7645                          addition:
  7646  1755  d9                        exx                     ; - - -
  7647  1756  e5                        push    hl              ; save the pointer to the next literal.
  7648  1757  d9                        exx                     ; - - -
  7649                          
  7650  1758  d5                        push    de              ; save pointer to second number
  7651  1759  e5                        push    hl              ; save pointer to first number - will be the
  7652                                                          ; result pointer on calculator stack.
  7653                          
  7654  175a  cdd816                    call    PREP_ADD        ; routine PREP-ADD
  7655  175d  47                        ld      b, a            ; save first exponent byte in B.
  7656  175e  eb                        ex      de, hl          ; switch number pointers.
  7657  175f  cdd816                    call    PREP_ADD        ; routine PREP-ADD
  7658  1762  4f                        ld      c, a            ; save second exponent byte in C.
  7659  1763  b8                        cp      b               ; compare the exponent bytes.
  7660  1764  3003                      jr      nc, SHIFT_LEN   ; forward if second higher to SHIFT-LEN
  7661                          
  7662  1766  78                        ld      a, b            ; else higher exponent to A
  7663  1767  41                        ld      b, c            ; lower exponent to B
  7664  1768  eb                        ex      de, hl          ; switch the number pointers.
  7665                          
  7666                          SHIFT_LEN:
  7667  1769  f5                        push    af              ; save higher exponent
  7668  176a  90                        sub     b               ; subtract lower exponent
  7669                          
  7670  176b  cdf716                    call    FETCH_TWO       ; routine FETCH-TWO
  7671  176e  cd1a17                    call    SHIFT_FP        ; routine SHIFT-FP
  7672                          
  7673  1771  f1                        pop     af              ; restore higher exponent.
  7674  1772  e1                        pop     hl              ; restore result pointer.
  7675  1773  77                        ld      (hl), a         ; insert exponent byte.
  7676  1774  e5                        push    hl              ; save result pointer again.
  7677                          
  7678                          ; now perform the 32-bit addition using two 16-bit Z80 add instructions.
  7679                          
  7680  1775  68                        ld      l, b            ; transfer low bytes of mantissa individually
  7681  1776  61                        ld      h, c            ; to HL register
  7682                          
  7683  1777  19                        add     hl, de          ; the actual binary addition of lower bytes
  7684                          
  7685                          ; now the two higher byte pairs that are in the alternate register sets.
  7686                          
  7687  1778  d9                        exx                     ; switch in set
  7688  1779  eb                        ex      de, hl          ; transfer high mantissa bytes to HL register.
  7689                          
  7690  177a  ed4a                      adc     hl, bc          ; the actual addition of higher bytes with
  7691                                                          ; any carry from first stage.
  7692                          
  7693  177c  eb                        ex      de, hl          ; result in DE, sign bytes ($FF or $00) to HL
  7694                          
  7695                          ; now consider the two sign bytes
  7696                          
  7697  177d  7c                        ld      a, h            ; fetch sign byte of num1
  7698                          
  7699  177e  8d                        adc     a, l            ; add including any carry from mantissa
  7700                                                          ; addition. 00 or 01 or FE or FF
  7701                          
  7702  177f  6f                        ld      l, a            ; result in L.
  7703                          
  7704                          ; possible outcomes of signs and overflow from mantissa are
  7705                          ;
  7706                          ;  H +  L + carry =  L    RRA  XOR L  RRA
  7707                          ; ------------------------------------------------------------
  7708                          ; 00 + 00         = 00    00   00
  7709                          ; 00 + 00 + carry = 01    00   01     carry
  7710                          ; FF + FF         = FE C  FF   01     carry
  7711                          ; FF + FF + carry = FF C  FF   00
  7712                          ; FF + 00         = FF    FF   00
  7713                          ; FF + 00 + carry = 00 C  80   80
  7714                          
  7715  1780  1f                        rra                     ; C->76543210->C
  7716  1781  ad                        xor     l               ; set bit 0 if shifting required.
  7717                          
  7718  1782  d9                        exx                     ; switch back to main set
  7719  1783  eb                        ex      de, hl          ; full mantissa result now in D'E'D E registers.
  7720  1784  e1                        pop     hl              ; restore pointer to result exponent on
  7721                                                          ; the calculator stack.
  7722                          
  7723  1785  1f                        rra                     ; has overflow occurred ?
  7724  1786  3008                      jr      nc, TEST_NEG    ; skip forward if not to TEST-NEG
  7725                          
  7726                          ; if the addition of two positive mantissas produced overflow or if the
  7727                          ; addition of two negative mantissas did not then the result exponent has to
  7728                          ; be incremented and the mantissa shifted one place to the right.
  7729                          
  7730  1788  3e01                      ld      a, $01          ; one shift required.
  7731  178a  cd1a17                    call    SHIFT_FP        ; routine SHIFT-FP performs a single shift
  7732                                                          ; rounding any lost bit
  7733  178d  34                        inc     (hl)            ; increment the exponent.
  7734  178e  2823                      jr      z, ADD_REP_6    ; forward to ADD-REP-6 if the exponent
  7735                                                          ; wraps round from FF to zero as number is too
  7736                                                          ; big for the system.
  7737                          
  7738                          ; at this stage the exponent on the calculator stack is correct.
  7739                          
  7740                          TEST_NEG:
  7741  1790  d9                        exx                     ; switch in the alternate set.
  7742  1791  7d                        ld      a, l            ; load result sign to accumulator.
  7743  1792  e680                      and     $80             ; isolate bit 7 from sign byte setting zero
  7744                                                          ; flag if positive.
  7745  1794  d9                        exx                     ; back to main set.
  7746                          
  7747  1795  23                        inc     hl              ; point to first byte of mantissa
  7748  1796  77                        ld      (hl), a         ; insert $00 positive or $80 negative at
  7749                                                          ; position on calculator stack.
  7750                          
  7751  1797  2b                        dec     hl              ; point to exponent again.
  7752  1798  281f                      jr      z, GO_NC_MLT    ; forward if positive to GO-NC-MLT
  7753                          
  7754                          ; a negative number has to be twos-complemented before being placed on stack.
  7755                          
  7756  179a  7b                        ld      a, e            ; fetch lowest (rightmost) mantissa byte.
  7757  179b  ed44                      neg                     ; Negate
  7758  179d  3f                        ccf                     ; Complement Carry Flag
  7759  179e  5f                        ld      e, a            ; place back in register
  7760                          
  7761  179f  7a                        ld      a, d            ; ditto
  7762  17a0  2f                        cpl                     ;
  7763  17a1  ce00                      adc     a, $00          ;
  7764  17a3  57                        ld      d, a            ;
  7765                          
  7766  17a4  d9                        exx                     ; switch to higher (leftmost) 16 bits.
  7767                          
  7768  17a5  7b                        ld      a, e            ; ditto
  7769  17a6  2f                        cpl                     ;
  7770  17a7  ce00                      adc     a, $00          ;
  7771  17a9  5f                        ld      e, a            ;
  7772                          
  7773  17aa  7a                        ld      a, d            ; ditto
  7774  17ab  2f                        cpl                     ;
  7775  17ac  ce00                      adc     a, $00          ;
  7776  17ae  3007                      jr      nc, END_COMPL   ; forward without overflow to END-COMPL
  7777                          
  7778                          ; else entire mantissa is now zero.  00 00 00 00
  7779                          
  7780  17b0  1f                        rra                     ; set mantissa to 80 00 00 00
  7781  17b1  d9                        exx                     ; switch.
  7782  17b2  34                        inc     (hl)            ; increment the exponent.
  7783                          
  7784                          ADD_REP_6:
  7785  17b3  ca8018                    jp      z, REPORT_6     ; jump forward if exponent now zero to REPORT-6
  7786                                                          ; 'Number too big'
  7787                          
  7788  17b6  d9                        exx                     ; switch back to alternate set.
  7789                          
  7790                          END_COMPL:
  7791  17b7  57                        ld      d, a            ; put first byte of mantissa back in DE.
  7792  17b8  d9                        exx                     ; switch to main set.
  7793                          
  7794                          GO_NC_MLT:
  7795  17b9  af                        xor     a               ; clear carry flag and
  7796                                                          ; clear accumulator so no extra bits carried
  7797                                                          ; forward as occurs in multiplication.
  7798                          
  7799  17ba  186c                      jr      TEST_NORM       ; forward to common code at TEST-NORM
  7800                                                          ; but should go straight to NORMALIZE.
  7801                          
  7802                          
  7803                          ; ----------------------------------------------
  7804                          ; THE 'PREPARE TO MULTIPLY OR DIVIDE' SUBROUTINE
  7805                          ; ----------------------------------------------
  7806                          ; this routine is called twice from multiplication and twice from division
  7807                          ; to prepare each of the two numbers for the operation.
  7808                          ; Initially the accumulator holds zero and after the second invocation bit 7
  7809                          ; of the accumulator will be the sign bit of the result.
  7810                          
  7811                          PREP_M_OR_D:
  7812  17bc  37                        scf                     ; set carry flag to signal number is zero.
  7813  17bd  35                        dec     (hl)            ; test exponent
  7814  17be  34                        inc     (hl)            ; for zero.
  7815  17bf  c8                        ret     z               ; return if zero with carry flag set.
  7816                          
  7817  17c0  23                        inc     hl              ; address first mantissa byte.
  7818  17c1  ae                        xor     (hl)            ; exclusive or the running sign bit.
  7819  17c2  cbfe                      set     7, (hl)         ; set the implied bit.
  7820  17c4  2b                        dec     hl              ; point to exponent byte.
  7821  17c5  c9                        ret                     ; return.
  7822                          
  7823                          ; ------------------------------
  7824                          ; THE 'MULTIPLICATION' OPERATION
  7825                          ; ------------------------------
  7826                          ;
  7827                          ;
  7828                          
  7829                          multiply:
  7830  17c6  af                        xor     a               ; reset bit 7 of running sign flag.
  7831  17c7  cdbc17                    call    PREP_M_OR_D     ; routine PREP-M/D
  7832  17ca  d8                        ret     c               ; return if number is zero.
  7833                                                          ; zero * anything = zero.
  7834                          
  7835  17cb  d9                        exx                     ; - - -
  7836  17cc  e5                        push    hl              ; save pointer to 'next literal'
  7837  17cd  d9                        exx                     ; - - -
  7838                          
  7839  17ce  d5                        push    de              ; save pointer to second number
  7840                          
  7841  17cf  eb                        ex      de, hl          ; make HL address second number.
  7842                          
  7843  17d0  cdbc17                    call    PREP_M_OR_D     ; routine PREP-M/D
  7844                          
  7845  17d3  eb                        ex      de, hl          ; HL first number, DE - second number
  7846  17d4  385a                      jr      c, ZERO_RSLT    ; forward with carry to ZERO-RSLT
  7847                                                          ; anything * zero = zero.
  7848                          
  7849  17d6  e5                        push    hl              ; save pointer to first number.
  7850                          
  7851  17d7  cdf716                    call    FETCH_TWO       ; routine FETCH-TWO fetches two mantissas from
  7852                                                          ; calc stack to B'C'C,B  D'E'D E
  7853                                                          ; (HL will be overwritten but the result sign
  7854                                                          ; in A is inserted on the calculator stack)
  7855                          
  7856  17da  78                        ld      a, b            ; transfer low mantissa byte of first number
  7857  17db  a7                        and     a               ; clear carry.
  7858  17dc  ed62                      sbc     hl, hl          ; a short form of LD HL,$0000 to take lower
  7859                                                          ; two bytes of result. (2 program bytes)
  7860  17de  d9                        exx                     ; switch in alternate set
  7861  17df  e5                        push    hl              ; preserve HL
  7862  17e0  ed62                      sbc     hl, hl          ; set HL to zero also to take higher two bytes
  7863                                                          ; of the result and clear carry.
  7864  17e2  d9                        exx                     ; switch back.
  7865                          
  7866  17e3  0621                      ld      b, $21          ; register B can now be used to count thirty
  7867                                                          ; three shifts.
  7868  17e5  1811                      jr      STRT_MLT        ; forward to loop entry point STRT-MLT
  7869                          
  7870                          ; ---
  7871                          
  7872                          ; The multiplication loop is entered at  STRT-LOOP.
  7873                          
  7874                          MLT_LOOP:
  7875  17e7  3005                      jr      nc, NO_ADD      ; forward if no carry to NO-ADD
  7876                          
  7877                                                          ; else add in the multiplicand.
  7878                          
  7879  17e9  19                        add     hl, de          ; add the two low bytes to result
  7880  17ea  d9                        exx                     ; switch to more significant bytes.
  7881  17eb  ed5a                      adc     hl, de          ; add high bytes of multiplicand and any carry.
  7882  17ed  d9                        exx                     ; switch to main set.
  7883                          
  7884                          ; in either case shift result right into B'C'C A
  7885                          
  7886                          NO_ADD:
  7887  17ee  d9                        exx                     ; switch to alternate set
  7888  17ef  cb1c                      rr      h               ; C > 76543210 > C
  7889  17f1  cb1d                      rr      l               ; C > 76543210 > C
  7890  17f3  d9                        exx                     ;
  7891  17f4  cb1c                      rr      h               ; C > 76543210 > C
  7892  17f6  cb1d                      rr      l               ; C > 76543210 > C
  7893                          
  7894                          STRT_MLT:
  7895  17f8  d9                        exx                     ; switch in alternate set.
  7896  17f9  cb18                      rr      b               ; C > 76543210 > C
  7897  17fb  cb19                      rr      c               ; C > 76543210 > C
  7898  17fd  d9                        exx                     ; now main set
  7899  17fe  cb19                      rr      c               ; C > 76543210 > C
  7900  1800  1f                        rra                     ; C > 76543210 > C
  7901  1801  10e4                      djnz    MLT_LOOP        ; loop back 33 times to MLT-LOOP
  7902                          
  7903                          ;
  7904                          
  7905  1803  eb                        ex      de, hl          ;
  7906  1804  d9                        exx                     ;
  7907  1805  eb                        ex      de, hl          ;
  7908  1806  d9                        exx                     ;
  7909  1807  c1                        pop     bc              ;
  7910  1808  e1                        pop     hl              ;
  7911  1809  78                        ld      a, b            ;
  7912  180a  81                        add     a, c            ;
  7913  180b  2001                      jr      nz, MAKE_EXPT   ; forward to MAKE-EXPT
  7914                          
  7915  180d  a7                        and     a               ;
  7916                          
  7917                          MAKE_EXPT:
  7918  180e  3d                        dec     a               ;
  7919  180f  3f                        ccf                     ; Complement Carry Flag
  7920                          
  7921                          DIVN_EXPT:
  7922  1810  17                        rla                     ;
  7923  1811  3f                        ccf                     ; Complement Carry Flag
  7924  1812  1f                        rra                     ;
  7925  1813  f21918                    jp      p, OFLW1_CLR    ; forward to OFLW1-CLR
  7926                          
  7927  1816  3068                      jr      nc, REPORT_6    ; forward to REPORT-6
  7928                          
  7929  1818  a7                        and     a               ;
  7930                          
  7931                          OFLW1_CLR:
  7932  1819  3c                        inc     a               ;
  7933  181a  2008                      jr      nz, OFLW2_CLR   ; forward to OFLW2-CLR
  7934                          
  7935  181c  3806                      jr      c, OFLW2_CLR    ; forward to OFLW2-CLR
  7936                          
  7937  181e  d9                        exx                     ;
  7938  181f  cb7a                      bit     7, d            ;
  7939  1821  d9                        exx                     ;
  7940  1822  205c                      jr      nz, REPORT_6    ; forward to REPORT-6
  7941                          
  7942                          OFLW2_CLR:
  7943  1824  77                        ld      (hl), a         ;
  7944  1825  d9                        exx                     ;
  7945  1826  78                        ld      a, b            ;
  7946  1827  d9                        exx                     ;
  7947                          
  7948                          ; addition joins here with carry flag clear.
  7949                          
  7950                          TEST_NORM:
  7951  1828  3015                      jr      nc, NORMALIZE   ; forward to NORMALIZE
  7952                          
  7953  182a  7e                        ld      a, (hl)         ;
  7954  182b  a7                        and     a               ;
  7955                          
  7956                          NEAR_ZERO:
  7957  182c  3e80                      ld      a, $80          ; prepare to rescue the most significant bit
  7958                                                          ; of the mantissa if it is set.
  7959  182e  2801                      jr      z, SKIP_ZERO    ; skip forward to SKIP-ZERO
  7960                          
  7961                          ZERO_RSLT:
  7962  1830  af                        xor     a               ; make mask byte zero signaling set five
  7963                                                          ; bytes to zero.
  7964                          
  7965                          SKIP_ZERO:
  7966  1831  d9                        exx                     ; switch in alternate set
  7967  1832  a2                        and     d               ; isolate most significant bit (if A is $80).
  7968                          
  7969  1833  cd3817                    call    ZEROS_4_OR_5    ; routine ZEROS-4/5 sets mantissa without
  7970                                                          ; affecting any flags.
  7971                          
  7972  1836  07                        rlca                    ; test if MSB set. bit 7 goes to bit 0.
  7973                                                          ; either $00 -> $00 or $80 -> $01
  7974  1837  77                        ld      (hl), a         ; make exponent $01 (lowest) or $00 zero
  7975  1838  382e                      jr      c, OFLOW_CLR    ; forward if first case to OFLOW-CLR
  7976                          
  7977  183a  23                        inc     hl              ; address first mantissa byte on the
  7978                                                          ; calculator stack.
  7979  183b  77                        ld      (hl), a         ; insert a zero for the sign bit.
  7980  183c  2b                        dec     hl              ; point to zero exponent
  7981  183d  1829                      jr      OFLOW_CLR       ; forward to OFLOW-CLR
  7982                          
  7983                          ; ---
  7984                          
  7985                          ; this branch is common to addition and multiplication with the mantissa
  7986                          ; result still in registers D'E'D E .
  7987                          
  7988                          NORMALIZE:
  7989  183f  0620                      ld      b, $20          ; a maximum of thirty-two left shifts will be
  7990                                                          ; needed.
  7991                          
  7992                          SHIFT_ONE:
  7993  1841  d9                        exx                     ; address higher 16 bits.
  7994  1842  cb7a                      bit     7, d            ; test the leftmost bit
  7995  1844  d9                        exx                     ; address lower 16 bits.
  7996                          
  7997  1845  2012                      jr      nz, NORML_NOW   ; forward if leftmost bit was set to NORML-NOW
  7998                          
  7999  1847  07                        rlca                    ; this holds zero from addition, 33rd bit
  8000                                                          ; from multiplication.
  8001                          
  8002  1848  cb13                      rl      e               ; C < 76543210 < C
  8003  184a  cb12                      rl      d               ; C < 76543210 < C
  8004                          
  8005  184c  d9                        exx                     ; address higher 16 bits.
  8006                          
  8007  184d  cb13                      rl      e               ; C < 76543210 < C
  8008  184f  cb12                      rl      d               ; C < 76543210 < C
  8009                          
  8010  1851  d9                        exx                     ; switch to main set.
  8011                          
  8012  1852  35                        dec     (hl)            ; decrement the exponent byte on the calculator
  8013                                                          ; stack.
  8014                          
  8015  1853  28d7                      jr      z, NEAR_ZERO    ; back if exponent becomes zero to NEAR-ZERO
  8016                                                          ; it's just possible that the last rotation
  8017                                                          ; set bit 7 of D. We shall see.
  8018                          
  8019  1855  10ea                      djnz    SHIFT_ONE       ; loop back to SHIFT-ONE
  8020                          
  8021                          ; if thirty-two left shifts were performed without setting the most significant
  8022                          ; bit then the result is zero.
  8023                          
  8024  1857  18d7                      jr      ZERO_RSLT       ; back to ZERO-RSLT
  8025                          
  8026                          ; ---
  8027                          
  8028                          NORML_NOW:
  8029  1859  17                        rla                     ; for the addition path, A is always zero.
  8030                                                          ; for the mult path, ...
  8031                          
  8032  185a  300c                      jr      nc, OFLOW_CLR   ; forward to OFLOW-CLR
  8033                          
  8034                          ; this branch is taken only with multiplication.
  8035                          
  8036  185c  cd4117                    call    ADD_BACK        ; routine ADD-BACK
  8037                          
  8038  185f  2007                      jr      nz, OFLOW_CLR   ; forward to OFLOW-CLR
  8039                          
  8040  1861  d9                        exx                     ;
  8041  1862  1680                      ld      d, $80          ;
  8042  1864  d9                        exx                     ;
  8043  1865  34                        inc     (hl)            ;
  8044  1866  2818                      jr      z, REPORT_6     ; forward to REPORT-6
  8045                          
  8046                          ; now transfer the mantissa from the register sets to the calculator stack
  8047                          ; incorporating the sign bit already there.
  8048                          
  8049                          OFLOW_CLR:
  8050  1868  e5                        push    hl              ; save pointer to exponent on stack.
  8051  1869  23                        inc     hl              ; address first byte of mantissa which was
  8052                                                          ; previously loaded with sign bit $00 or $80.
  8053                          
  8054  186a  d9                        exx                     ; - - -
  8055  186b  d5                        push    de              ; push the most significant two bytes.
  8056  186c  d9                        exx                     ; - - -
  8057                          
  8058  186d  c1                        pop     bc              ; pop - true mantissa is now BCDE.
  8059                          
  8060                          ; now pick up the sign bit.
  8061                          
  8062  186e  78                        ld      a, b            ; first mantissa byte to A
  8063  186f  17                        rla                     ; rotate out bit 7 which is set
  8064  1870  cb16                      rl      (hl)            ; rotate sign bit on stack into carry.
  8065  1872  1f                        rra                     ; rotate sign bit into bit 7 of mantissa.
  8066                          
  8067                          ; and transfer mantissa from main registers to calculator stack.
  8068                          
  8069  1873  77                        ld      (hl), a         ;
  8070  1874  23                        inc     hl              ;
  8071  1875  71                        ld      (hl), c         ;
  8072  1876  23                        inc     hl              ;
  8073  1877  72                        ld      (hl), d         ;
  8074  1878  23                        inc     hl              ;
  8075  1879  73                        ld      (hl), e         ;
  8076                          
  8077  187a  e1                        pop     hl              ; restore pointer to num1 now result.
  8078  187b  d1                        pop     de              ; restore pointer to num2 now STKEND.
  8079                          
  8080  187c  d9                        exx                     ; - - -
  8081  187d  e1                        pop     hl              ; restore pointer to next calculator literal.
  8082  187e  d9                        exx                     ; - - -
  8083                          
  8084  187f  c9                        ret                     ; return.
  8085                          
  8086                          ; ---
  8087                          
  8088                          REPORT_6:
  8089  1880  cf                        rst     ERROR_1         ; ERROR-1
  8090  1881  05                        defb    ERR_6_OVERFLOW  ; Error Report: Arithmetic overflow.
  8091                          
  8092                          ; ------------------------
  8093                          ; THE 'DIVISION' OPERATION
  8094                          ; ------------------------
  8095                          ;   "Of all the arithmetic subroutines, division is the most complicated and
  8096                          ;   the least understood.  It is particularly interesting to note that the
  8097                          ;   Sinclair programmer himself has made a mistake in his programming ( or has
  8098                          ;   copied over someone else's mistake!) for
  8099                          ;   PRINT PEEK 6352 [ $18D0 ] ('unimproved' ROM, 6351 [ $18CF ] )
  8100                          ;   should give 218 not 225."
  8101                          ;   - Dr. Ian Logan, Syntax magazine Jul/Aug 1982.
  8102                          ;   [  i.e. the jump should be made to div-34th ]
  8103                          
  8104                          ;   First check for division by zero.
  8105                          
  8106                          division:
  8107  1882  eb                        ex      de, hl          ; consider the second number first.
  8108  1883  af                        xor     a               ; set the running sign flag.
  8109  1884  cdbc17                    call    PREP_M_OR_D     ; routine PREP-M/D
  8110  1887  38f7                      jr      c, REPORT_6     ; back if zero to REPORT-6
  8111                                                          ; 'Arithmetic overflow'
  8112                          
  8113  1889  eb                        ex      de, hl          ; now prepare first number and check for zero.
  8114  188a  cdbc17                    call    PREP_M_OR_D     ; routine PREP-M/D
  8115  188d  d8                        ret     c               ; return if zero, 0/anything is zero.
  8116                          
  8117  188e  d9                        exx                     ; - - -
  8118  188f  e5                        push    hl              ; save pointer to the next calculator literal.
  8119  1890  d9                        exx                     ; - - -
  8120                          
  8121  1891  d5                        push    de              ; save pointer to divisor - will be STKEND.
  8122  1892  e5                        push    hl              ; save pointer to dividend - will be result.
  8123                          
  8124  1893  cdf716                    call    FETCH_TWO       ; routine FETCH-TWO fetches the two numbers
  8125                                                          ; into the registers H'B'C'C B
  8126                                                          ;                    L'D'E'D E
  8127  1896  d9                        exx                     ; - - -
  8128  1897  e5                        push    hl              ; save the two exponents.
  8129                          
  8130  1898  60                        ld      h, b            ; transfer the dividend to H'L'H L
  8131  1899  69                        ld      l, c            ;
  8132  189a  d9                        exx                     ;
  8133  189b  61                        ld      h, c            ;
  8134  189c  68                        ld      l, b            ;
  8135                          
  8136  189d  af                        xor     a               ; clear carry bit and accumulator.
  8137  189e  06df                      ld      b, $DF          ; count upwards from -33 decimal
  8138  18a0  1810                      jr      DIV_START       ; forward to mid-loop entry point DIV-START
  8139                          
  8140                          ; ---
  8141                          
  8142                          DIV_LOOP:
  8143  18a2  17                        rla                     ; multiply partial quotient by two
  8144  18a3  cb11                      rl      c               ; setting result bit from carry.
  8145  18a5  d9                        exx                     ;
  8146  18a6  cb11                      rl      c               ;
  8147  18a8  cb10                      rl      b               ;
  8148  18aa  d9                        exx                     ;
  8149                          
  8150                          div_34th:
  8151  18ab  29                        add     hl, hl          ;
  8152  18ac  d9                        exx                     ;
  8153  18ad  ed6a                      adc     hl, hl          ;
  8154  18af  d9                        exx                     ;
  8155  18b0  3810                      jr      c, SUBN_ONLY    ; forward to SUBN-ONLY
  8156                          
  8157                          DIV_START:
  8158  18b2  ed52                      sbc     hl, de          ; subtract divisor part.
  8159  18b4  d9                        exx                     ;
  8160  18b5  ed52                      sbc     hl, de          ;
  8161  18b7  d9                        exx                     ;
  8162  18b8  300f                      jr      nc, NO_RSTORE   ; forward if subtraction goes to NO-RSTORE
  8163                          
  8164  18ba  19                        add     hl, de          ; else restore
  8165  18bb  d9                        exx                     ;
  8166  18bc  ed5a                      adc     hl, de          ;
  8167  18be  d9                        exx                     ;
  8168  18bf  a7                        and     a               ; clear carry
  8169  18c0  1808                      jr      COUNT_ONE       ; forward to COUNT-ONE
  8170                          
  8171                          ; ---
  8172                          
  8173                          SUBN_ONLY:
  8174  18c2  a7                        and     a               ;
  8175  18c3  ed52                      sbc     hl, de          ;
  8176  18c5  d9                        exx                     ;
  8177  18c6  ed52                      sbc     hl, de          ;
  8178  18c8  d9                        exx                     ;
  8179                          
  8180                          NO_RSTORE:
  8181  18c9  37                        scf                     ; set carry flag
  8182                          
  8183                          COUNT_ONE:
  8184  18ca  04                        inc     b               ; increment the counter
  8185  18cb  faa218                    jp      m, DIV_LOOP     ; back while still minus to DIV-LOOP
  8186                          
  8187  18ce  f5                        push    af              ;
  8188                          
  8189  18cf  28e1                      jr      z, DIV_START    ; back to DIV-START
  8190                          
  8191                          ; "This jump is made to the wrong place. No 34th bit will ever be obtained
  8192                          ; without first shifting the dividend. Hence important results like 1/10 and
  8193                          ; 1/1000 are not rounded up as they should be. Rounding up never occurs when
  8194                          ; it depends on the 34th bit. The jump should be made to div-34th above."
  8195                          ; - Dr. Frank O'Hara, "The Complete Spectrum ROM Disassembly", 1983,
  8196                          ; published by Melbourne House.
  8197                          ; (Note. on the ZX81 this would be JR Z,L18AB)
  8198                          ;
  8199                          ; However if you make this change, then while (1/2=.5) will now evaluate as
  8200                          ; true, (.25=1/4), which did evaluate as true, no longer does.
  8201                          
  8202  18d1  5f                        ld      e, a            ;
  8203  18d2  51                        ld      d, c            ;
  8204  18d3  d9                        exx                     ;
  8205  18d4  59                        ld      e, c            ;
  8206  18d5  50                        ld      d, b            ;
  8207                          
  8208  18d6  f1                        pop     af              ;
  8209  18d7  cb18                      rr      b               ;
  8210  18d9  f1                        pop     af              ;
  8211  18da  cb18                      rr      b               ;
  8212                          
  8213  18dc  d9                        exx                     ;
  8214  18dd  c1                        pop     bc              ;
  8215  18de  e1                        pop     hl              ;
  8216  18df  78                        ld      a, b            ;
  8217  18e0  91                        sub     c               ;
  8218  18e1  c31018                    jp      DIVN_EXPT       ; jump back to DIVN-EXPT
  8219                          
  8220                          ; ------------------------------------------------
  8221                          ; THE 'INTEGER TRUNCATION TOWARDS ZERO' SUBROUTINE
  8222                          ; ------------------------------------------------
  8223                          ;
  8224                          
  8225                          truncate:
  8226  18e4  7e                        ld      a, (hl)         ; fetch exponent
  8227  18e5  fe81                      cp      $81             ; compare to +1
  8228  18e7  3006                      jr      nc, T_GR_ZERO   ; forward, if 1 or more, to T-GR-ZERO
  8229                          
  8230                          ; else the number is smaller than plus or minus 1 and can be made zero.
  8231                          
  8232  18e9  3600                      ld      (hl), $00       ; make exponent zero.
  8233  18eb  3e20                      ld      a, $20          ; prepare to set 32 bits of mantissa to zero.
  8234  18ed  1805                      jr      NIL_BYTES       ; forward to NIL-BYTES
  8235                          
  8236                          ; ---
  8237                          
  8238                          T_GR_ZERO:
  8239  18ef  d6a0                      sub     $A0             ; subtract +32 from exponent
  8240  18f1  f0                        ret     p               ; return if result is positive as all 32 bits
  8241                                                          ; of the mantissa relate to the integer part.
  8242                                                          ; The floating point is somewhere to the right
  8243                                                          ; of the mantissa
  8244                          
  8245  18f2  ed44                      neg                     ; else negate to form number of rightmost bits
  8246                                                          ; to be blanked.
  8247                          
  8248                          ; for instance, disregarding the sign bit, the number 3.5 is held as
  8249                          ; exponent $82 mantissa .11100000 00000000 00000000 00000000
  8250                          ; we need to set $82 - $A0 = $E2 NEG = $1E (thirty) bits to zero to form the
  8251                          ; integer.
  8252                          ; The sign of the number is never considered as the first bit of the mantissa
  8253                          ; must be part of the integer.
  8254                          
  8255                          NIL_BYTES:
  8256  18f4  d5                        push    de              ; save pointer to STKEND
  8257  18f5  eb                        ex      de, hl          ; HL points at STKEND
  8258  18f6  2b                        dec     hl              ; now at last byte of mantissa.
  8259  18f7  47                        ld      b, a            ; Transfer bit count to B register.
  8260  18f8  cb38                      srl     b               ; divide by
  8261  18fa  cb38                      srl     b               ; eight
  8262  18fc  cb38                      srl     b               ;
  8263  18fe  2805                      jr      z, BITS_ZERO    ; forward if zero to BITS-ZERO
  8264                          
  8265                          ; else the original count was eight or more and whole bytes can be blanked.
  8266                          
  8267                          BYTE_ZERO:
  8268  1900  3600                      ld      (hl), $00       ; set eight bits to zero.
  8269  1902  2b                        dec     hl              ; point to more significant byte of mantissa.
  8270  1903  10fb                      djnz    BYTE_ZERO       ; loop back to BYTE-ZERO
  8271                          
  8272                          ; now consider any residual bits.
  8273                          
  8274                          BITS_ZERO:
  8275  1905  e607                      and     $07             ; isolate the remaining bits
  8276  1907  2809                      jr      z, IX_END       ; forward if none to IX-END
  8277                          
  8278  1909  47                        ld      b, a            ; transfer bit count to B counter.
  8279  190a  3eff                      ld      a, $FF          ; form a mask 11111111
  8280                          
  8281                          LESS_MASK:
  8282  190c  cb27                      sla     a               ; 1 <- 76543210 <- o     slide mask leftwards.
  8283  190e  10fc                      djnz    LESS_MASK       ; loop back for bit count to LESS-MASK
  8284                          
  8285  1910  a6                        and     (hl)            ; lose the unwanted rightmost bits
  8286  1911  77                        ld      (hl), a         ; and place in mantissa byte.
  8287                          
  8288                          IX_END:
  8289  1912  eb                        ex      de, hl          ; restore result pointer from DE.
  8290  1913  d1                        pop     de              ; restore STKEND from stack.
  8291  1914  c9                        ret                     ; return.
  8292                          
  8293                          
  8294                          
  8295                          
  8296                          ;********************************
  8297                          ;**  FLOATING-POINT CALCULATOR **
  8298                          ;********************************
  8299                          
  8300                          ; As a general rule the calculator avoids using the IY register.
  8301                          ; Exceptions are val and str$.
  8302                          ; So an assembly language programmer who has disabled interrupts to use IY
  8303                          ; for other purposes can still use the calculator for mathematical
  8304                          ; purposes.
  8305                          
  8306                          
  8307                          ; ------------------------
  8308                          ; THE 'TABLE OF CONSTANTS'
  8309                          ; ------------------------
  8310                          ; The ZX81 has only floating-point number representation.
  8311                          ; Both the ZX80 and the ZX Spectrum have integer numbers in some form.
  8312                          
  8313                          TAB_CNST:
  8314                          ;; stk-zero                                                 00 00 00 00 00
  8315  1915  00                        defb    $00             ;;Bytes: 1
  8316  1916  b0                        defb    $B0             ;;Exponent $00
  8317  1917  00                        defb    $00             ;;(+00,+00,+00)
  8318                          
  8319                          ;; stk-one                                                  81 00 00 00 00
  8320  1918  31                        defb    $31             ;;Exponent $81, Bytes: 1
  8321  1919  00                        defb    $00             ;;(+00,+00,+00)
  8322                          
  8323                          
  8324                          ;; stk-half                                                 80 00 00 00 00
  8325  191a  30                        defb    $30             ;;Exponent: $80, Bytes: 1
  8326  191b  00                        defb    $00             ;;(+00,+00,+00)
  8327                          
  8328                          
  8329                          ;; stk-pi/2                                                 81 49 0F DA A2
  8330  191c  f1                        defb    $F1             ;;Exponent: $81, Bytes: 4
  8331  191d  490fdaa2                  defb    $49, $0F, $DA, $A2
  8332                                                          ;;
  8333                          
  8334                          ;; stk-ten                                                  84 20 00 00 00
  8335  1921  34                        defb    $34             ;;Exponent: $84, Bytes: 1
  8336  1922  20                        defb    $20             ;;(+00,+00,+00)
  8337                          
  8338                          ; ------------------------
  8339                          ; THE 'TABLE OF ADDRESSES'
  8340                          ; ------------------------
  8341                          ;
  8342                          ; Starts with binary operations which have two operands and one result.
  8343                          ; three pseudo binary operations first.
  8344                          
  8345                          tbl_addrs:
  8346  1923  2f1c                      defw    jump_true       ; $00 Address: $1C2F - jump-true
  8347  1925  721a                      defw    exchange        ; $01 Address: $1A72 - exchange
  8348  1927  e319                      defw    delete          ; $02 Address: $19E3 - delete
  8349                          
  8350                          ; true binary operations.
  8351                          
  8352  1929  4c17                      defw    subtract        ; $03 Address: $174C - subtract
  8353  192b  c617                      defw    multiply        ; $04 Address: $176C - multiply
  8354  192d  8218                      defw    division        ; $05 Address: $1882 - division
  8355  192f  e21d                      defw    to_power        ; $06 Address: $1DE2 - to-power
  8356  1931  ed1a                      defw    or_             ; $07 Address: $1AED - or
  8357                          
  8358  1933  f31a                      defw    no_and_no       ; $08 Address: $1B03 - no-&-no
  8359  1935  031b                      defw    no_l_eql        ; $09 Address: $1B03 - no-l-eql
  8360  1937  031b                      defw    no_l_eql        ; $0A Address: $1B03 - no-gr-eql
  8361  1939  031b                      defw    no_l_eql        ; $0B Address: $1B03 - nos-neql
  8362  193b  031b                      defw    no_l_eql        ; $0C Address: $1B03 - no-grtr
  8363  193d  031b                      defw    no_l_eql        ; $0D Address: $1B03 - no-less
  8364  193f  031b                      defw    no_l_eql        ; $0E Address: $1B03 - nos-eql
  8365  1941  5517                      defw    addition        ; $0F Address: $1755 - addition
  8366                          
  8367  1943  f81a                      defw    str_and_no      ; $10 Address: $1AF8 - str-&-no
  8368  1945  031b                      defw    no_l_eql        ; $11 Address: $1B03 - str-l-eql
  8369  1947  031b                      defw    no_l_eql        ; $12 Address: $1B03 - str-gr-eql
  8370  1949  031b                      defw    no_l_eql        ; $13 Address: $1B03 - strs-neql
  8371  194b  031b                      defw    no_l_eql        ; $14 Address: $1B03 - str-grtr
  8372  194d  031b                      defw    no_l_eql        ; $15 Address: $1B03 - str-less
  8373  194f  031b                      defw    no_l_eql        ; $16 Address: $1B03 - strs-eql
  8374  1951  621b                      defw    strs_add        ; $17 Address: $1B62 - strs-add
  8375                          
  8376                          ; unary follow
  8377                          
  8378  1953  a01a                      defw    neg             ; $18 Address: $1AA0 - neg
  8379                          
  8380  1955  061c                      defw    code            ; $19 Address: $1C06 - code
  8381  1957  a41b                      defw    val             ; $1A Address: $1BA4 - val
  8382  1959  111c                      defw    len             ; $1B Address: $1C11 - len
  8383  195b  491d                      defw    sin             ; $1C Address: $1D49 - sin
  8384  195d  3e1d                      defw    cos             ; $1D Address: $1D3E - cos
  8385  195f  6e1d                      defw    tan             ; $1E Address: $1D6E - tan
  8386  1961  c41d                      defw    asn             ; $1F Address: $1DC4 - asn
  8387  1963  d41d                      defw    acs             ; $20 Address: $1DD4 - acs
  8388  1965  761d                      defw    atn             ; $21 Address: $1D76 - atn
  8389  1967  a91c                      defw    ln              ; $22 Address: $1CA9 - ln
  8390  1969  5b1c                      defw    exp             ; $23 Address: $1C5B - exp
  8391  196b  461c                      defw    int             ; $24 Address: $1C46 - int
  8392  196d  db1d                      defw    sqr             ; $25 Address: $1DDB - sqr
  8393  196f  af1a                      defw    sgn             ; $26 Address: $1AAF - sgn
  8394  1971  aa1a                      defw    abs             ; $27 Address: $1AAA - abs
  8395  1973  be1a                      defw    peek            ; $28 Address: $1A1B - peek
  8396  1975  c51a                      defw    usr_no          ; $29 Address: $1AC5 - usr-no
  8397  1977  d51b                      defw    str_dollar      ; $2A Address: $1BD5 - str$
  8398  1979  8f1b                      defw    chr_dollar      ; $2B Address: $1B8F - chr$
  8399  197b  d51a                      defw    not             ; $2C Address: $1AD5 - not
  8400                          
  8401                          ; end of true unary
  8402                          
  8403  197d  f619                      defw    duplicate       ; $2D Address: $19F6 - duplicate
  8404  197f  371c                      defw    n_mod_m         ; $2E Address: $1C37 - n-mod-m
  8405                          
  8406  1981  231c                      defw    jump            ; $2F Address: $1C23 - jump
  8407  1983  fc19                      defw    stk_data        ; $30 Address: $19FC - stk-data
  8408                          
  8409  1985  171c                      defw    dec_jr_nz       ; $31 Address: $1C17 - dec-jr-nz
  8410  1987  db1a                      defw    less_0          ; $32 Address: $1ADB - less-0
  8411  1989  ce1a                      defw    greater_0       ; $33 Address: $1ACE - greater-0
  8412  198b  2b00                      defw    end_calc        ; $34 Address: $002B - end-calc
  8413  198d  181d                      defw    get_argt        ; $35 Address: $1D18 - get-argt
  8414  198f  e418                      defw    truncate        ; $36 Address: $18E4 - truncate
  8415  1991  e419                      defw    fp_calc_2       ; $37 Address: $19E4 - fp-calc-2
  8416  1993  5a15                      defw    e_to_fp         ; $38 Address: $155A - e-to-fp
  8417                          
  8418                          ; the following are just the next available slots for the 128 compound literals
  8419                          ; which are in range $80 - $FF.
  8420                          
  8421  1995  7f1a                      defw    seriesg_x       ; $39 Address: $1A7F - series-xx    $80 - $9F.
  8422  1997  511a                      defw    stk_con_x       ; $3A Address: $1A51 - stk-const-xx $A0 - $BF.
  8423  1999  631a                      defw    sto_mem_x       ; $3B Address: $1A63 - st-mem-xx    $C0 - $DF.
  8424  199b  451a                      defw    get_mem_x       ; $3C Address: $1A45 - get-mem-xx   $E0 - $FF.
  8425                          
  8426                          ; Aside: 3D - 7F are therefore unused calculator literals.
  8427                          ;        39 - 7B would be available for expansion.
  8428                          
  8429                          ; -------------------------------
  8430                          ; THE 'FLOATING POINT CALCULATOR'
  8431                          ; -------------------------------
  8432                          ;
  8433                          ;
  8434                          
  8435                          CALCULATE:
  8436  199d  cd851b                    call    STK_PNTRS       ; routine STK-PNTRS is called to set up the
  8437                                                          ; calculator stack pointers for a default
  8438                                                          ; unary operation. HL = last value on stack.
  8439                                                          ; DE = STKEND first location after stack.
  8440                          
  8441                          ; the calculate routine is called at this point by the series generator...
  8442                          
  8443                          GEN_ENT_1:
  8444  19a0  78                        ld      a, b            ; fetch the Z80 B register to A
  8445  19a1  321e40                    ld      (BREG), a       ; and store value in system variable BREG.
  8446                                                          ; this will be the counter for dec-jr-nz
  8447                                                          ; or if used from fp-calc2 the calculator
  8448                                                          ; instruction.
  8449                          
  8450                          ; ... and again later at this point
  8451                          
  8452                          GEN_ENT_2:
  8453  19a4  d9                        exx                     ; switch sets
  8454  19a5  e3                        ex      (sp), hl        ; and store the address of next instruction,
  8455                                                          ; the return address, in H'L'.
  8456                                                          ; If this is a recursive call then the H'L'
  8457                                                          ; of the previous invocation goes on stack.
  8458                                                          ; c.f. end-calc.
  8459  19a6  d9                        exx                     ; switch back to main set.
  8460                          
  8461                          ; this is the re-entry looping point when handling a string of literals.
  8462                          
  8463                          RE_ENTRY:
  8464  19a7  ed531c40                  ld      (STKEND), de    ; save end of stack in system variable STKEND
  8465  19ab  d9                        exx                     ; switch to alt
  8466  19ac  7e                        ld      a, (hl)         ; get next literal
  8467  19ad  23                        inc     hl              ; increase pointer'
  8468                          
  8469                          ; single operation jumps back to here
  8470                          
  8471                          SCAN_ENT:
  8472  19ae  e5                        push    hl              ; save pointer on stack   *
  8473  19af  a7                        and     a               ; now test the literal
  8474  19b0  f2c219                    jp      p, FIRST_3D     ; forward to FIRST-3D if in range $00 - $3D
  8475                                                          ; anything with bit 7 set will be one of
  8476                                                          ; 128 compound literals.
  8477                          
  8478                          ; Compound literals have the following format.
  8479                          ; bit 7 set indicates compound.
  8480                          ; bits 6-5 the subgroup 0-3.
  8481                          ; bits 4-0 the embedded parameter $00 - $1F.
  8482                          ; The subgroup 0-3 needs to be manipulated to form the next available four
  8483                          ; address places after the simple literals in the address table.
  8484                          
  8485  19b3  57                        ld      d, a            ; save literal in D
  8486  19b4  e660                      and     $60             ; and with 01100000 to isolate subgroup
  8487  19b6  0f                        rrca                    ; rotate bits
  8488  19b7  0f                        rrca                    ; 4 places to right
  8489  19b8  0f                        rrca                    ; not five as we need offset * 2
  8490  19b9  0f                        rrca                    ; 00000xx0
  8491  19ba  c672                      add     a, $72          ; add ($39 * 2) to give correct offset.
  8492                                                          ; alter above if you add more literals.
  8493  19bc  6f                        ld      l, a            ; store in L for later indexing.
  8494  19bd  7a                        ld      a, d            ; bring back compound literal
  8495  19be  e61f                      and     $1F             ; use mask to isolate parameter bits
  8496  19c0  180e                      jr      ENT_TABLE       ; forward to ENT-TABLE
  8497                          
  8498                          ; ---
  8499                          
  8500                          ; the branch was here with simple literals.
  8501                          
  8502                          FIRST_3D:
  8503  19c2  fe18                      cp      $18             ; compare with first unary operations.
  8504  19c4  3008                      jr      nc, DOUBLE_A    ; to DOUBLE-A with unary operations
  8505                          
  8506                          ; it is binary so adjust pointers.
  8507                          
  8508  19c6  d9                        exx                     ;
  8509  19c7  01fbff                    ld      bc, $FFFB       ; the value -5
  8510  19ca  54                        ld      d, h            ; transfer HL, the last value, to DE.
  8511  19cb  5d                        ld      e, l            ;
  8512  19cc  09                        add     hl, bc          ; subtract 5 making HL point to second
  8513                                                          ; value.
  8514  19cd  d9                        exx                     ;
  8515                          
  8516                          DOUBLE_A:
  8517  19ce  07                        rlca                    ; double the literal
  8518  19cf  6f                        ld      l, a            ; and store in L for indexing
  8519                          
  8520                          ENT_TABLE:
  8521  19d0  112319                    ld      de, tbl_addrs   ; Address: tbl-addrs
  8522  19d3  2600                      ld      h, $00          ; prepare to index
  8523  19d5  19                        add     hl, de          ; add to get address of routine
  8524  19d6  5e                        ld      e, (hl)         ; low byte to E
  8525  19d7  23                        inc     hl              ;
  8526  19d8  56                        ld      d, (hl)         ; high byte to D
  8527                          
  8528  19d9  21a719                    ld      hl, RE_ENTRY    ; Address: RE-ENTRY
  8529  19dc  e3                        ex      (sp), hl        ; goes on machine stack
  8530                                                          ; address of next literal goes to HL. *
  8531                          
  8532                          
  8533  19dd  d5                        push    de              ; now the address of routine is stacked.
  8534  19de  d9                        exx                     ; back to main set
  8535                                                          ; avoid using IY register.
  8536  19df  ed4b1d40                  ld      bc, (BREG-1)    ; STKEND_hi
  8537                                                          ; nothing much goes to C but BREG to B
  8538                                                          ; and continue into next ret instruction
  8539                                                          ; which has a dual identity
  8540                          
  8541                          
  8542                          ; -----------------------
  8543                          ; THE 'DELETE' SUBROUTINE
  8544                          ; -----------------------
  8545                          ; (offset $02: 'delete')
  8546                          ; A simple return but when used as a calculator literal this
  8547                          ; deletes the last value from the calculator stack.
  8548                          ; On entry, as always with binary operations,
  8549                          ; HL=first number, DE=second number
  8550                          ; On exit, HL=result, DE=stkend.
  8551                          ; So nothing to do
  8552                          
  8553                          delete:
  8554  19e3  c9                        ret                     ; return - indirect jump if from above.
  8555                          
  8556                          ; ---------------------------------
  8557                          ; THE 'SINGLE OPERATION' SUBROUTINE
  8558                          ; ---------------------------------
  8559                          ; (offset $37: 'fp-calc-2')
  8560                          ; this single operation is used, in the first instance, to evaluate most
  8561                          ; of the mathematical and string functions found in BASIC expressions.
  8562                          
  8563                          fp_calc_2:
  8564  19e4  f1                        pop     af              ; drop return address.
  8565  19e5  3a1e40                    ld      a, (BREG)       ; load accumulator from system variable BREG
  8566                                                          ; value will be literal eg. 'tan'
  8567  19e8  d9                        exx                     ; switch to alt
  8568  19e9  18c3                      jr      SCAN_ENT        ; back to SCAN-ENT
  8569                                                          ; next literal will be end-calc in scanning
  8570                          
  8571                          ; ------------------------------
  8572                          ; THE 'TEST 5 SPACES' SUBROUTINE
  8573                          ; ------------------------------
  8574                          ; This routine is called from MOVE-FP/duplicate, STK-CONST and STK-STORE to
  8575                          ; test that there is enough space between the calculator stack and the
  8576                          ; machine stack for another five-byte value. It returns with BC holding
  8577                          ; the value 5 ready for any subsequent LDIR.
  8578                          
  8579                          TEST_5_SP:
  8580  19eb  d5                        push    de              ; save
  8581  19ec  e5                        push    hl              ; registers
  8582  19ed  010500                    ld      bc, $0005       ; an overhead of five bytes
  8583  19f0  cdc50e                    call    TEST_ROOM       ; routine TEST-ROOM tests free RAM raising
  8584                                                          ; an error if not.
  8585  19f3  e1                        pop     hl              ; else restore
  8586  19f4  d1                        pop     de              ; registers.
  8587  19f5  c9                        ret                     ; return with BC set at 5.
  8588                          
  8589                          
  8590                          ; ---------------------------------------------
  8591                          ; THE 'MOVE A FLOATING POINT NUMBER' SUBROUTINE
  8592                          ; ---------------------------------------------
  8593                          ; (offset $2D: 'duplicate')
  8594                          ; This simple routine is a 5-byte LDIR instruction
  8595                          ; that incorporates a memory check.
  8596                          ; When used as a calculator literal it duplicates the last value on the
  8597                          ; calculator stack.
  8598                          ; Unary so on entry HL points to last value, DE to stkend
  8599                          
  8600                          duplicate:
  8601  19f6  cdeb19                    call    TEST_5_SP       ; routine TEST-5-SP test free memory
  8602                                                          ; and sets BC to 5.
  8603  19f9  edb0                      ldir                    ; copy the five bytes.
  8604  19fb  c9                        ret                     ; return with DE addressing new STKEND
  8605                                                          ; and HL addressing new last value.
  8606                          
  8607                          ; -------------------------------
  8608                          ; THE 'STACK LITERALS' SUBROUTINE
  8609                          ; -------------------------------
  8610                          ; (offset $30: 'stk-data')
  8611                          ; When a calculator subroutine needs to put a value on the calculator
  8612                          ; stack that is not a regular constant this routine is called with a
  8613                          ; variable number of following data bytes that convey to the routine
  8614                          ; the floating point form as succinctly as is possible.
  8615                          
  8616                          stk_data:
  8617  19fc  62                        ld      h, d            ; transfer STKEND
  8618  19fd  6b                        ld      l, e            ; to HL for result.
  8619                          
  8620                          STK_CONST:
  8621  19fe  cdeb19                    call    TEST_5_SP       ; routine TEST-5-SP tests that room exists
  8622                                                          ; and sets BC to $05.
  8623                          
  8624  1a01  d9                        exx                     ; switch to alternate set
  8625  1a02  e5                        push    hl              ; save the pointer to next literal on stack
  8626  1a03  d9                        exx                     ; switch back to main set
  8627                          
  8628  1a04  e3                        ex      (sp), hl        ; pointer to HL, destination to stack.
  8629  1a05  c5                        push    bc              ; save BC - value 5 from test room. No need.
  8630                          
  8631  1a06  7e                        ld      a, (hl)         ; fetch the byte following 'stk-data'
  8632  1a07  e6c0                      and     $C0             ; isolate bits 7 and 6
  8633  1a09  07                        rlca                    ; rotate
  8634  1a0a  07                        rlca                    ; to bits 1 and 0  range $00 - $03.
  8635  1a0b  4f                        ld      c, a            ; transfer to C
  8636  1a0c  0c                        inc     c               ; and increment to give number of bytes
  8637                                                          ; to read. $01 - $04
  8638  1a0d  7e                        ld      a, (hl)         ; reload the first byte
  8639  1a0e  e63f                      and     $3F             ; mask off to give possible exponent.
  8640  1a10  2002                      jr      nz, FORM_EXP    ; forward to FORM-EXP if it was possible to
  8641                                                          ; include the exponent.
  8642                          
  8643                          ; else byte is just a byte count and exponent comes next.
  8644                          
  8645  1a12  23                        inc     hl              ; address next byte and
  8646  1a13  7e                        ld      a, (hl)         ; pick up the exponent ( - $50).
  8647                          
  8648                          FORM_EXP:
  8649  1a14  c650                      add     a, $50          ; now add $50 to form actual exponent
  8650  1a16  12                        ld      (de), a         ; and load into first destination byte.
  8651  1a17  3e05                      ld      a, $05          ; load accumulator with $05 and
  8652  1a19  91                        sub     c               ; subtract C to give count of trailing
  8653                                                          ; zeros plus one.
  8654  1a1a  23                        inc     hl              ; increment source
  8655  1a1b  13                        inc     de              ; increment destination
  8656  1a1c  0600                      ld      b, $00          ; prepare to copy. Note. B is zero.
  8657  1a1e  edb0                      ldir                    ; copy C bytes
  8658                          
  8659  1a20  c1                        pop     bc              ; restore 5 counter to BC.
  8660                          
  8661  1a21  e3                        ex      (sp), hl        ; put HL on stack as next literal pointer
  8662                                                          ; and the stack value - result pointer -
  8663                                                          ; to HL.
  8664                          
  8665  1a22  d9                        exx                     ; switch to alternate set.
  8666  1a23  e1                        pop     hl              ; restore next literal pointer from stack
  8667                                                          ; to H'L'.
  8668  1a24  d9                        exx                     ; switch back to main set.
  8669                          
  8670  1a25  47                        ld      b, a            ; zero count to B
  8671  1a26  af                        xor     a               ; clear accumulator
  8672                          
  8673                          STK_ZEROS:
  8674  1a27  05                        dec     b               ; decrement B counter
  8675  1a28  c8                        ret     z               ; return if zero.          >>
  8676                                                          ; DE points to new STKEND
  8677                                                          ; HL to new number.
  8678                          
  8679  1a29  12                        ld      (de), a         ; else load zero to destination
  8680  1a2a  13                        inc     de              ; increase destination
  8681  1a2b  18fa                      jr      STK_ZEROS       ; loop back to STK-ZEROS until done.
  8682                          
  8683                          ; -------------------------------
  8684                          ; THE 'SKIP CONSTANTS' SUBROUTINE
  8685                          ; -------------------------------
  8686                          ; This routine traverses variable-length entries in the table of constants,
  8687                          ; stacking intermediate, unwanted constants onto a dummy calculator stack,
  8688                          ; in the first five bytes of the ZX81 ROM.
  8689                          
  8690                          SKIP_CONS:
  8691  1a2d  a7                        and     a               ; test if initially zero.
  8692                          
  8693                          SKIP_NEXT:
  8694  1a2e  c8                        ret     z               ; return if zero.          >>
  8695                          
  8696  1a2f  f5                        push    af              ; save count.
  8697  1a30  d5                        push    de              ; and normal STKEND
  8698                          
  8699  1a31  110000                    ld      de, $0000       ; dummy value for STKEND at start of ROM
  8700                                                          ; Note. not a fault but this has to be
  8701                                                          ; moved elsewhere when running in RAM.
  8702                                                          ;
  8703  1a34  cdfe19                    call    STK_CONST       ; routine STK-CONST works through variable
  8704                                                          ; length records.
  8705                          
  8706  1a37  d1                        pop     de              ; restore real STKEND
  8707  1a38  f1                        pop     af              ; restore count
  8708  1a39  3d                        dec     a               ; decrease
  8709  1a3a  18f2                      jr      SKIP_NEXT       ; loop back to SKIP-NEXT
  8710                          
  8711                          ; --------------------------------
  8712                          ; THE 'MEMORY LOCATION' SUBROUTINE
  8713                          ; --------------------------------
  8714                          ; This routine, when supplied with a base address in HL and an index in A,
  8715                          ; will calculate the address of the A'th entry, where each entry occupies
  8716                          ; five bytes. It is used for addressing floating-point numbers in the
  8717                          ; calculator's memory area.
  8718                          
  8719                          LOC_MEM:
  8720  1a3c  4f                        ld      c, a            ; store the original number $00-$1F.
  8721  1a3d  07                        rlca                    ; double.
  8722  1a3e  07                        rlca                    ; quadruple.
  8723  1a3f  81                        add     a, c            ; now add original value to multiply by five.
  8724                          
  8725  1a40  4f                        ld      c, a            ; place the result in C.
  8726  1a41  0600                      ld      b, $00          ; set B to 0.
  8727  1a43  09                        add     hl, bc          ; add to form address of start of number in HL.
  8728                          
  8729  1a44  c9                        ret                     ; return.
  8730                          
  8731                          ; -------------------------------------
  8732                          ; THE 'GET FROM MEMORY AREA' SUBROUTINE
  8733                          ; -------------------------------------
  8734                          ; offsets $E0 to $FF: 'get-mem-0', 'get-mem-1' etc.
  8735                          ; A holds $00-$1F offset.
  8736                          ; The calculator stack increases by 5 bytes.
  8737                          
  8738                          get_mem_x:
  8739  1a45  d5                        push    de              ; save STKEND
  8740  1a46  2a1f40                    ld      hl, (MEM)       ; MEM is base address of the memory cells.
  8741                          
  8742  1a49  cd3c1a                    call    LOC_MEM         ; routine LOC-MEM so that HL = first byte
  8743  1a4c  cdf619                    call    duplicate       ; routine MOVE-FP/duplicate moves 5 bytes with memory
  8744                                                          ; check.
  8745                                                          ; DE now points to new STKEND.
  8746  1a4f  e1                        pop     hl              ; the original STKEND is now RESULT pointer.
  8747  1a50  c9                        ret                     ; return.
  8748                          
  8749                          ; ---------------------------------
  8750                          ; THE 'STACK A CONSTANT' SUBROUTINE
  8751                          ; ---------------------------------
  8752                          ; (offset $A0: 'stk-zero')
  8753                          ; (offset $A1: 'stk-one')
  8754                          ; (offset $A2: 'stk-half')
  8755                          ; (offset $A3: 'stk-pi/2')
  8756                          ; (offset $A4: 'stk-ten')
  8757                          ; This routine allows a one-byte instruction to stack up to 32 constants
  8758                          ; held in short form in a table of constants. In fact only 5 constants are
  8759                          ; required. On entry the A register holds the literal ANDed with $1F.
  8760                          ;
  8761                          ; It isn't very efficient and it would have been better to hold the
  8762                          ; numbers in full, five byte form and stack them in a similar manner
  8763                          ; to that which would be used later for semi-tone table values.
  8764                          
  8765                          stk_con_x:
  8766  1a51  62                        ld      h, d            ; save STKEND - required for result
  8767  1a52  6b                        ld      l, e            ;
  8768  1a53  d9                        exx                     ; swap
  8769  1a54  e5                        push    hl              ; save pointer to next literal
  8770  1a55  211519                    ld      hl, TAB_CNST    ; Address: stk-zero - start of table of
  8771                                                          ; constants
  8772  1a58  d9                        exx                     ;
  8773  1a59  cd2d1a                    call    SKIP_CONS       ; routine SKIP-CONS
  8774  1a5c  cdfe19                    call    STK_CONST       ; routine STK-CONST
  8775  1a5f  d9                        exx                     ;
  8776  1a60  e1                        pop     hl              ; restore pointer to next literal.
  8777  1a61  d9                        exx                     ;
  8778  1a62  c9                        ret                     ; return.
  8779                          
  8780                          ; ---
  8781                          
  8782                          ; ---------------------------------------
  8783                          ; THE 'STORE IN A MEMORY AREA' SUBROUTINE
  8784                          ; ---------------------------------------
  8785                          ; Offsets $C0 to $DF: 'st-mem-0', 'st-mem-1' etc.
  8786                          ; Although 32 memory storage locations can be addressed, only six
  8787                          ; $C0 to $C5 are required by the ROM and only the thirty bytes (6*5)
  8788                          ; required for these are allocated. ZX81 programmers who wish to
  8789                          ; use the floating point routines from assembly language may wish to
  8790                          ; alter the system variable MEM to point to 160 bytes of RAM to have
  8791                          ; use the full range available.
  8792                          ; A holds derived offset $00-$1F.
  8793                          ; Unary so on entry HL points to last value, DE to STKEND.
  8794                          
  8795                          sto_mem_x:
  8796  1a63  e5                        push    hl              ; save the result pointer.
  8797  1a64  eb                        ex      de, hl          ; transfer to DE.
  8798  1a65  2a1f40                    ld      hl, (MEM)       ; fetch MEM the base of memory area.
  8799  1a68  cd3c1a                    call    LOC_MEM         ; routine LOC-MEM sets HL to the destination.
  8800  1a6b  eb                        ex      de, hl          ; swap - HL is start, DE is destination.
  8801                          
  8802  1a6c  cdf619                    call    duplicate       ; routine MOVE-FP/duplicate.
  8803                                                          ; note. a short ld bc,5; ldir
  8804                                                          ; the embedded memory check is not required
  8805                                                          ; so these instructions would be faster!
  8806                          
  8807  1a6f  eb                        ex      de, hl          ; DE = STKEND
  8808  1a70  e1                        pop     hl              ; restore original result pointer
  8809  1a71  c9                        ret                     ; return.
  8810                          
  8811                          ; -------------------------
  8812                          ; THE 'EXCHANGE' SUBROUTINE
  8813                          ; -------------------------
  8814                          ; (offset $01: 'exchange')
  8815                          ; This routine exchanges the last two values on the calculator stack
  8816                          ; On entry, as always with binary operations,
  8817                          ; HL=first number, DE=second number
  8818                          ; On exit, HL=result, DE=stkend.
  8819                          
  8820                          exchange:
  8821  1a72  0605                      ld      b, $05          ; there are five bytes to be swapped
  8822                          
  8823                          ; start of loop.
  8824                          
  8825                          SWAP_BYTE:
  8826  1a74  1a                        ld      a, (de)         ; each byte of second
  8827  1a75  4e                        ld      c, (hl)         ; each byte of first
  8828  1a76  eb                        ex      de, hl          ; swap pointers
  8829  1a77  12                        ld      (de), a         ; store each byte of first
  8830  1a78  71                        ld      (hl), c         ; store each byte of second
  8831  1a79  23                        inc     hl              ; advance both
  8832  1a7a  13                        inc     de              ; pointers.
  8833  1a7b  10f7                      djnz    SWAP_BYTE       ; loop back to SWAP-BYTE until all 5 done.
  8834                          
  8835  1a7d  eb                        ex      de, hl          ; even up the exchanges
  8836                                                          ; so that DE addresses STKEND.
  8837  1a7e  c9                        ret                     ; return.
  8838                          
  8839                          ; ---------------------------------
  8840                          ; THE 'SERIES GENERATOR' SUBROUTINE
  8841                          ; ---------------------------------
  8842                          ; (offset $86: 'series-06')
  8843                          ; (offset $88: 'series-08')
  8844                          ; (offset $8C: 'series-0C')
  8845                          ; The ZX81 uses Chebyshev polynomials to generate approximations for
  8846                          ; SIN, ATN, LN and EXP. These are named after the Russian mathematician
  8847                          ; Pafnuty Chebyshev, born in 1821, who did much pioneering work on numerical
  8848                          ; series. As far as calculators are concerned, Chebyshev polynomials have an
  8849                          ; advantage over other series, for example the Taylor series, as they can
  8850                          ; reach an approximation in just six iterations for SIN, eight for EXP and
  8851                          ; twelve for LN and ATN. The mechanics of the routine are interesting but
  8852                          ; for full treatment of how these are generated with demonstrations in
  8853                          ; Sinclair BASIC see "The Complete Spectrum ROM Disassembly" by Dr Ian Logan
  8854                          ; and Dr Frank O'Hara, published 1983 by Melbourne House.
  8855                          
  8856                          seriesg_x:
  8857  1a7f  47                        ld      b, a            ; parameter $00 - $1F to B counter
  8858  1a80  cda019                    call    GEN_ENT_1       ; routine GEN-ENT-1 is called.
  8859                                                          ; A recursive call to a special entry point
  8860                                                          ; in the calculator that puts the B register
  8861                                                          ; in the system variable BREG. The return
  8862                                                          ; address is the next location and where
  8863                                                          ; the calculator will expect its first
  8864                                                          ; instruction - now pointed to by HL'.
  8865                                                          ; The previous pointer to the series of
  8866                                                          ; five-byte numbers goes on the machine stack.
  8867                          
  8868                          ; The initialization phase.
  8869                          
  8870  1a83  2d                        defb    $2D             ;;duplicate       x,x
  8871  1a84  0f                        defb    $0F             ;;addition        x+x
  8872  1a85  c0                        defb    $C0             ;;st-mem-0        x+x
  8873  1a86  02                        defb    $02             ;;delete          .
  8874  1a87  a0                        defb    $A0             ;;stk-zero        0
  8875  1a88  c2                        defb    $C2             ;;st-mem-2        0
  8876                          
  8877                          ; a loop is now entered to perform the algebraic calculation for each of
  8878                          ; the numbers in the series
  8879                          
  8880                          G_LOOP:
  8881  1a89  2d                        defb    $2D             ;;duplicate       v,v.
  8882  1a8a  e0                        defb    $E0             ;;get-mem-0       v,v,x+2
  8883  1a8b  04                        defb    $04             ;;multiply        v,v*x+2
  8884  1a8c  e2                        defb    $E2             ;;get-mem-2       v,v*x+2,v
  8885  1a8d  c1                        defb    $C1             ;;st-mem-1
  8886  1a8e  03                        defb    $03             ;;subtract
  8887  1a8f  34                        defb    $34             ;;end-calc
  8888                          
  8889                          ; the previous pointer is fetched from the machine stack to H'L' where it
  8890                          ; addresses one of the numbers of the series following the series literal.
  8891                          
  8892  1a90  cdfc19                    call    stk_data        ; routine STK-DATA is called directly to
  8893                                                          ; push a value and advance H'L'.
  8894  1a93  cda419                    call    GEN_ENT_2       ; routine GEN-ENT-2 recursively re-enters
  8895                                                          ; the calculator without disturbing
  8896                                                          ; system variable BREG
  8897                                                          ; H'L' value goes on the machine stack and is
  8898                                                          ; then loaded as usual with the next address.
  8899                          
  8900  1a96  0f                        defb    $0F             ;;addition
  8901  1a97  01                        defb    $01             ;;exchange
  8902  1a98  c2                        defb    $C2             ;;st-mem-2
  8903  1a99  02                        defb    $02             ;;delete
  8904                          
  8905  1a9a  31                        defb    $31             ;;dec-jr-nz
  8906  1a9b  ee                        defb    G_LOOP - ASMPC  ;;back to L1A89, G-LOOP
  8907                          
  8908                          ; when the counted loop is complete the final subtraction yields the result
  8909                          ; for example SIN X.
  8910                          
  8911  1a9c  e1                        defb    $E1             ;;get-mem-1
  8912  1a9d  03                        defb    $03             ;;subtract
  8913  1a9e  34                        defb    $34             ;;end-calc
  8914                          
  8915  1a9f  c9                        ret                     ; return with H'L' pointing to location
  8916                                                          ; after last number in series.
  8917                          
  8918                          ; -----------------------
  8919                          ; Handle unary minus (18)
  8920                          ; -----------------------
  8921                          ; Unary so on entry HL points to last value, DE to STKEND.
  8922                          
  8923                          neg:
  8924  1aa0  7e                        ld      a, (hl)         ; fetch exponent of last value on the
  8925                                                          ; calculator stack.
  8926  1aa1  a7                        and     a               ; test it.
  8927  1aa2  c8                        ret     z               ; return if zero.
  8928                          
  8929  1aa3  23                        inc     hl              ; address the byte with the sign bit.
  8930  1aa4  7e                        ld      a, (hl)         ; fetch to accumulator.
  8931  1aa5  ee80                      xor     $80             ; toggle the sign bit.
  8932  1aa7  77                        ld      (hl), a         ; put it back.
  8933  1aa8  2b                        dec     hl              ; point to last value again.
  8934  1aa9  c9                        ret                     ; return.
  8935                          
  8936                          ; -----------------------
  8937                          ; Absolute magnitude (27)
  8938                          ; -----------------------
  8939                          ; This calculator literal finds the absolute value of the last value,
  8940                          ; floating point, on calculator stack.
  8941                          
  8942                          abs:
  8943  1aaa  23                        inc     hl              ; point to byte with sign bit.
  8944  1aab  cbbe                      res     7, (hl)         ; make the sign positive.
  8945  1aad  2b                        dec     hl              ; point to last value again.
  8946  1aae  c9                        ret                     ; return.
  8947                          
  8948                          ; -----------
  8949                          ; Signum (26)
  8950                          ; -----------
  8951                          ; This routine replaces the last value on the calculator stack,
  8952                          ; which is in floating point form, with one if positive and with minus one
  8953                          ; if it is negative. If it is zero then it is left unchanged.
  8954                          
  8955                          sgn:
  8956  1aaf  23                        inc     hl              ; point to first byte of 4-byte mantissa.
  8957  1ab0  7e                        ld      a, (hl)         ; pick up the byte with the sign bit.
  8958  1ab1  2b                        dec     hl              ; point to exponent.
  8959  1ab2  35                        dec     (hl)            ; test the exponent for
  8960  1ab3  34                        inc     (hl)            ; the value zero.
  8961                          
  8962  1ab4  37                        scf                     ; Set the carry flag.
  8963  1ab5  c4e01a                    call    nz, FP_0_1      ; Routine FP-0/1  replaces last value with one
  8964                                                          ; if exponent indicates the value is non-zero.
  8965                                                          ; In either case mantissa is now four zeros.
  8966                          
  8967  1ab8  23                        inc     hl              ; Point to first byte of 4-byte mantissa.
  8968  1ab9  07                        rlca                    ; Rotate original sign bit to carry.
  8969  1aba  cb1e                      rr      (hl)            ; Rotate the carry into sign.
  8970  1abc  2b                        dec     hl              ; Point to last value.
  8971  1abd  c9                        ret                     ; Return.
  8972                          
  8973                          
  8974                          ; -------------------------
  8975                          ; Handle PEEK function (28)
  8976                          ; -------------------------
  8977                          ; This function returns the contents of a memory address.
  8978                          ; The entire address space can be peeked including the ROM.
  8979                          
  8980                          peek:
  8981  1abe  cda70e                    call    FIND_INT        ; routine FIND-INT puts address in BC.
  8982  1ac1  0a                        ld      a, (bc)         ; load contents into A register.
  8983                          
  8984                          IN_PK_STK:
  8985  1ac2  c31d15                    jp      STACK_A         ; exit via STACK-A to put value on the
  8986                                                          ; calculator stack.
  8987                          
  8988                          ; ---------------
  8989                          ; USR number (29)
  8990                          ; ---------------
  8991                          ; The USR function followed by a number 0-65535 is the method by which
  8992                          ; the ZX81 invokes machine code programs. This function returns the
  8993                          ; contents of the BC register pair.
  8994                          ; Note. that STACK-BC re-initializes the IY register to $4000 if a user-written
  8995                          ; program has altered it.
  8996                          
  8997                          usr_no:
  8998  1ac5  cda70e                    call    FIND_INT        ; routine FIND-INT to fetch the
  8999                                                          ; supplied address into BC.
  9000                          
  9001  1ac8  212015                    ld      hl, STACK_BC    ; address: STACK-BC is
  9002  1acb  e5                        push    hl              ; pushed onto the machine stack.
  9003  1acc  c5                        push    bc              ; then the address of the machine code
  9004                                                          ; routine.
  9005                          
  9006  1acd  c9                        ret                     ; make an indirect jump to the user's routine
  9007                                                          ; and, hopefully, to STACK-BC also.
  9008                          
  9009                          
  9010                          ; -----------------------
  9011                          ; Greater than zero ($33)
  9012                          ; -----------------------
  9013                          ; Test if the last value on the calculator stack is greater than zero.
  9014                          ; This routine is also called directly from the end-tests of the comparison
  9015                          ; routine.
  9016                          
  9017                          greater_0:
  9018  1ace  7e                        ld      a, (hl)         ; fetch exponent.
  9019  1acf  a7                        and     a               ; test it for zero.
  9020  1ad0  c8                        ret     z               ; return if so.
  9021                          
  9022                          
  9023  1ad1  3eff                      ld      a, $FF          ; prepare XOR mask for sign bit
  9024  1ad3  1807                      jr      SIGN_TO_C       ; forward to SIGN-TO-C
  9025                                                          ; to put sign in carry
  9026                                                          ; (carry will become set if sign is positive)
  9027                                                          ; and then overwrite location with 1 or 0
  9028                                                          ; as appropriate.
  9029                          
  9030                          ; ------------------------
  9031                          ; Handle NOT operator ($2C)
  9032                          ; ------------------------
  9033                          ; This overwrites the last value with 1 if it was zero else with zero
  9034                          ; if it was any other value.
  9035                          ;
  9036                          ; e.g. NOT 0 returns 1, NOT 1 returns 0, NOT -3 returns 0.
  9037                          ;
  9038                          ; The subroutine is also called directly from the end-tests of the comparison
  9039                          ; operator.
  9040                          
  9041                          not:
  9042  1ad5  7e                        ld      a, (hl)         ; get exponent byte.
  9043  1ad6  ed44                      neg                     ; negate - sets carry if non-zero.
  9044  1ad8  3f                        ccf                     ; complement so carry set if zero, else reset.
  9045  1ad9  1805                      jr      FP_0_1          ; forward to FP-0/1.
  9046                          
  9047                          ; -------------------
  9048                          ; Less than zero (32)
  9049                          ; -------------------
  9050                          ; Destructively test if last value on calculator stack is less than zero.
  9051                          ; Bit 7 of second byte will be set if so.
  9052                          
  9053                          less_0:
  9054  1adb  af                        xor     a               ; set xor mask to zero
  9055                                                          ; (carry will become set if sign is negative).
  9056                          
  9057                          ; transfer sign of mantissa to Carry Flag.
  9058                          
  9059                          SIGN_TO_C:
  9060  1adc  23                        inc     hl              ; address 2nd byte.
  9061  1add  ae                        xor     (hl)            ; bit 7 of HL will be set if number is negative.
  9062  1ade  2b                        dec     hl              ; address 1st byte again.
  9063  1adf  07                        rlca                    ; rotate bit 7 of A to carry.
  9064                          
  9065                          ; -----------
  9066                          ; Zero or one
  9067                          ; -----------
  9068                          ; This routine places an integer value zero or one at the addressed location
  9069                          ; of calculator stack or MEM area. The value one is written if carry is set on
  9070                          ; entry else zero.
  9071                          
  9072                          FP_0_1:
  9073  1ae0  e5                        push    hl              ; save pointer to the first byte
  9074  1ae1  0605                      ld      b, $05          ; five bytes to do.
  9075                          
  9076                          PF_loop:
  9077  1ae3  3600                      ld      (hl), $00       ; insert a zero.
  9078  1ae5  23                        inc     hl              ;
  9079  1ae6  10fb                      djnz    PF_loop         ; repeat.
  9080                          
  9081  1ae8  e1                        pop     hl              ;
  9082  1ae9  d0                        ret     nc              ;
  9083                          
  9084  1aea  3681                      ld      (hl), $81       ; make value 1
  9085  1aec  c9                        ret                     ; return.
  9086                          
  9087                          
  9088                          ; -----------------------
  9089                          ; Handle OR operator (07)
  9090                          ; -----------------------
  9091                          ; The Boolean OR operator. eg. X OR Y
  9092                          ; The result is zero if both values are zero else a non-zero value.
  9093                          ;
  9094                          ; e.g.    0 OR 0  returns 0.
  9095                          ;        -3 OR 0  returns -3.
  9096                          ;         0 OR -3 returns 1.
  9097                          ;        -3 OR 2  returns 1.
  9098                          ;
  9099                          ; A binary operation.
  9100                          ; On entry HL points to first operand (X) and DE to second operand (Y).
  9101                          
  9102                          or_:
  9103  1aed  1a                        ld      a, (de)         ; fetch exponent of second number
  9104  1aee  a7                        and     a               ; test it.
  9105  1aef  c8                        ret     z               ; return if zero.
  9106                          
  9107  1af0  37                        scf                     ; set carry flag
  9108  1af1  18ed                      jr      FP_0_1          ; back to FP-0/1 to overwrite the first operand
  9109                                                          ; with the value 1.
  9110                          
  9111                          
  9112                          ; -----------------------------
  9113                          ; Handle number AND number (08)
  9114                          ; -----------------------------
  9115                          ; The Boolean AND operator.
  9116                          ;
  9117                          ; e.g.    -3 AND 2  returns -3.
  9118                          ;         -3 AND 0  returns 0.
  9119                          ;          0 and -2 returns 0.
  9120                          ;          0 and 0  returns 0.
  9121                          ;
  9122                          ; Compare with OR routine above.
  9123                          
  9124                          no_and_no:
  9125  1af3  1a                        ld      a, (de)         ; fetch exponent of second number.
  9126  1af4  a7                        and     a               ; test it.
  9127  1af5  c0                        ret     nz              ; return if not zero.
  9128                          
  9129  1af6  18e8                      jr      FP_0_1          ; back to FP-0/1 to overwrite the first operand
  9130                                                          ; with zero for return value.
  9131                          
  9132                          ; -----------------------------
  9133                          ; Handle string AND number (10)
  9134                          ; -----------------------------
  9135                          ; e.g. "YOU WIN" AND SCORE>99 will return the string if condition is true
  9136                          ; or the null string if false.
  9137                          
  9138                          str_and_no:
  9139  1af8  1a                        ld      a, (de)         ; fetch exponent of second number.
  9140  1af9  a7                        and     a               ; test it.
  9141  1afa  c0                        ret     nz              ; return if number was not zero - the string
  9142                                                          ; is the result.
  9143                          
  9144                          ; if the number was zero (false) then the null string must be returned by
  9145                          ; altering the length of the string on the calculator stack to zero.
  9146                          
  9147  1afb  d5                        push    de              ; save pointer to the now obsolete number
  9148                                                          ; (which will become the new STKEND)
  9149                          
  9150  1afc  1b                        dec     de              ; point to the 5th byte of string descriptor.
  9151  1afd  af                        xor     a               ; clear the accumulator.
  9152  1afe  12                        ld      (de), a         ; place zero in high byte of length.
  9153  1aff  1b                        dec     de              ; address low byte of length.
  9154  1b00  12                        ld      (de), a         ; place zero there - now the null string.
  9155                          
  9156  1b01  d1                        pop     de              ; restore pointer - new STKEND.
  9157  1b02  c9                        ret                     ; return.
  9158                          
  9159                          ; -------------------------------------
  9160                          ; Perform comparison ($09-$0E, $11-$16)
  9161                          ; -------------------------------------
  9162                          ; True binary operations.
  9163                          ;
  9164                          ; A single entry point is used to evaluate six numeric and six string
  9165                          ; comparisons. On entry, the calculator literal is in the B register and
  9166                          ; the two numeric values, or the two string parameters, are on the
  9167                          ; calculator stack.
  9168                          ; The individual bits of the literal are manipulated to group similar
  9169                          ; operations although the SUB 8 instruction does nothing useful and merely
  9170                          ; alters the string test bit.
  9171                          ; Numbers are compared by subtracting one from the other, strings are
  9172                          ; compared by comparing every character until a mismatch, or the end of one
  9173                          ; or both, is reached.
  9174                          ;
  9175                          ; Numeric Comparisons.
  9176                          ; --------------------
  9177                          ; The 'x>y' example is the easiest as it employs straight-thru logic.
  9178                          ; Number y is subtracted from x and the result tested for greater-0 yielding
  9179                          ; a final value 1 (true) or 0 (false).
  9180                          ; For 'x<y' the same logic is used but the two values are first swapped on the
  9181                          ; calculator stack.
  9182                          ; For 'x=y' NOT is applied to the subtraction result yielding true if the
  9183                          ; difference was zero and false with anything else.
  9184                          ; The first three numeric comparisons are just the opposite of the last three
  9185                          ; so the same processing steps are used and then a final NOT is applied.
  9186                          ;
  9187                          ; literal    Test   No  sub 8       ExOrNot  1st RRCA  exch sub  ?   End-Tests
  9188                          ; =========  ====   == ======== === ======== ========  ==== ===  =  === === ===
  9189                          ; no-l-eql   x<=y   09 00000001 dec 00000000 00000000  ---- x-y  ?  --- >0? NOT
  9190                          ; no-gr-eql  x>=y   0A 00000010 dec 00000001 10000000c swap y-x  ?  --- >0? NOT
  9191                          ; nos-neql   x<>y   0B 00000011 dec 00000010 00000001  ---- x-y  ?  NOT --- NOT
  9192                          ; no-grtr    x>y    0C 00000100  -  00000100 00000010  ---- x-y  ?  --- >0? ---
  9193                          ; no-less    x<y    0D 00000101  -  00000101 10000010c swap y-x  ?  --- >0? ---
  9194                          ; nos-eql    x=y    0E 00000110  -  00000110 00000011  ---- x-y  ?  NOT --- ---
  9195                          ;
  9196                          ;                                                           comp -> C/F
  9197                          ;                                                           ====    ===
  9198                          ; str-l-eql  x$<=y$ 11 00001001 dec 00001000 00000100  ---- x$y$ 0  !or >0? NOT
  9199                          ; str-gr-eql x$>=y$ 12 00001010 dec 00001001 10000100c swap y$x$ 0  !or >0? NOT
  9200                          ; strs-neql  x$<>y$ 13 00001011 dec 00001010 00000101  ---- x$y$ 0  !or >0? NOT
  9201                          ; str-grtr   x$>y$  14 00001100  -  00001100 00000110  ---- x$y$ 0  !or >0? ---
  9202                          ; str-less   x$<y$  15 00001101  -  00001101 10000110c swap y$x$ 0  !or >0? ---
  9203                          ; strs-eql   x$=y$  16 00001110  -  00001110 00000111  ---- x$y$ 0  !or >0? ---
  9204                          ;
  9205                          ; String comparisons are a little different in that the eql/neql carry flag
  9206                          ; from the 2nd RRCA is, as before, fed into the first of the end tests but
  9207                          ; along the way it gets modified by the comparison process. The result on the
  9208                          ; stack always starts off as zero and the carry fed in determines if NOT is
  9209                          ; applied to it. So the only time the greater-0 test is applied is if the
  9210                          ; stack holds zero which is not very efficient as the test will always yield
  9211                          ; zero. The most likely explanation is that there were once separate end tests
  9212                          ; for numbers and strings.
  9213                          
  9214                          no_l_eql:
  9215  1b03  78                        ld      a, b            ; transfer literal to accumulator.
  9216  1b04  d608                      sub     $08             ; subtract eight - which is not useful.
  9217                          
  9218  1b06  cb57                      bit     2, a            ; isolate '>', '<', '='.
  9219                          
  9220  1b08  2001                      jr      nz, EX_OR_NOT   ; skip to EX-OR-NOT with these.
  9221                          
  9222  1b0a  3d                        dec     a               ; else make $00-$02, $08-$0A to match bits 0-2.
  9223                          
  9224                          EX_OR_NOT:
  9225  1b0b  0f                        rrca                    ; the first RRCA sets carry for a swap.
  9226  1b0c  3008                      jr      nc, NU_OR_STR   ; forward to NU-OR-STR with other 8 cases
  9227                          
  9228                          ; for the other 4 cases the two values on the calculator stack are exchanged.
  9229                          
  9230  1b0e  f5                        push    af              ; save A and carry.
  9231  1b0f  e5                        push    hl              ; save HL - pointer to first operand.
  9232                                                          ; (DE points to second operand).
  9233                          
  9234  1b10  cd721a                    call    exchange        ; routine exchange swaps the two values.
  9235                                                          ; (HL = second operand, DE = STKEND)
  9236                          
  9237  1b13  d1                        pop     de              ; DE = first operand
  9238  1b14  eb                        ex      de, hl          ; as we were.
  9239  1b15  f1                        pop     af              ; restore A and carry.
  9240                          
  9241                          ; Note. it would be better if the 2nd RRCA preceded the string test.
  9242                          ; It would save two duplicate bytes and if we also got rid of that sub 8
  9243                          ; at the beginning we wouldn't have to alter which bit we test.
  9244                          
  9245                          NU_OR_STR:
  9246  1b16  cb57                      bit     2, a            ; test if a string comparison.
  9247  1b18  2007                      jr      nz, STRINGS     ; forward to STRINGS if so.
  9248                          
  9249                          ; continue with numeric comparisons.
  9250                          
  9251  1b1a  0f                        rrca                    ; 2nd RRCA causes eql/neql to set carry.
  9252  1b1b  f5                        push    af              ; save A and carry
  9253  1b1c  cd4c17                    call    subtract        ; routine subtract leaves result on stack.
  9254  1b1f  1833                      jr      END_TESTS       ; forward to END-TESTS
  9255                          
  9256                          ; ---
  9257                          
  9258                          STRINGS:
  9259  1b21  0f                        rrca                    ; 2nd RRCA causes eql/neql to set carry.
  9260  1b22  f5                        push    af              ; save A and carry.
  9261                          
  9262  1b23  cdf813                    call    STK_FETCH       ; routine STK-FETCH gets 2nd string params
  9263  1b26  d5                        push    de              ; save start2 *.
  9264  1b27  c5                        push    bc              ; and the length.
  9265                          
  9266  1b28  cdf813                    call    STK_FETCH       ; routine STK-FETCH gets 1st string
  9267                                                          ; parameters - start in DE, length in BC.
  9268  1b2b  e1                        pop     hl              ; restore length of second to HL.
  9269                          
  9270                          ; A loop is now entered to compare, by subtraction, each corresponding character
  9271                          ; of the strings. For each successful match, the pointers are incremented and
  9272                          ; the lengths decreased and the branch taken back to here. If both string
  9273                          ; remainders become null at the same time, then an exact match exists.
  9274                          
  9275                          BYTE_COMP:
  9276  1b2c  7c                        ld      a, h            ; test if the second string
  9277  1b2d  b5                        or      l               ; is the null string and hold flags.
  9278                          
  9279  1b2e  e3                        ex      (sp), hl        ; put length2 on stack, bring start2 to HL *.
  9280  1b2f  78                        ld      a, b            ; hi byte of length1 to A
  9281                          
  9282  1b30  200b                      jr      nz, SEC_PLUS    ; forward to SEC-PLUS if second not null.
  9283                          
  9284  1b32  b1                        or      c               ; test length of first string.
  9285                          
  9286                          SECND_LOW:
  9287  1b33  c1                        pop     bc              ; pop the second length off stack.
  9288  1b34  2804                      jr      z, BOTH_NULL    ; forward to BOTH-NULL if first string is also
  9289                                                          ; of zero length.
  9290                          
  9291                          ; the true condition - first is longer than second (SECND-LESS)
  9292                          
  9293  1b36  f1                        pop     af              ; restore carry (set if eql/neql)
  9294  1b37  3f                        ccf                     ; complement carry flag.
  9295                                                          ; Note. equality becomes false.
  9296                                                          ; Inequality is true. By swapping or applying
  9297                                                          ; a terminal 'not', all comparisons have been
  9298                                                          ; manipulated so that this is success path.
  9299  1b38  1816                      jr      STR_TEST        ; forward to leave via STR-TEST
  9300                          
  9301                          ; ---
  9302                          ; the branch was here with a match
  9303                          
  9304                          BOTH_NULL:
  9305  1b3a  f1                        pop     af              ; restore carry - set for eql/neql
  9306  1b3b  1813                      jr      STR_TEST        ; forward to STR-TEST
  9307                          
  9308                          ; ---
  9309                          ; the branch was here when 2nd string not null and low byte of first is yet
  9310                          ; to be tested.
  9311                          
  9312                          
  9313                          SEC_PLUS:
  9314  1b3d  b1                        or      c               ; test the length of first string.
  9315  1b3e  280d                      jr      z, FRST_LESS    ; forward to FRST-LESS if length is zero.
  9316                          
  9317                          ; both strings have at least one character left.
  9318                          
  9319  1b40  1a                        ld      a, (de)         ; fetch character of first string.
  9320  1b41  96                        sub     (hl)            ; subtract with that of 2nd string.
  9321  1b42  3809                      jr      c, FRST_LESS    ; forward to FRST-LESS if carry set
  9322                          
  9323  1b44  20ed                      jr      nz, SECND_LOW   ; back to SECND-LOW and then STR-TEST
  9324                                                          ; if not exact match.
  9325                          
  9326  1b46  0b                        dec     bc              ; decrease length of 1st string.
  9327  1b47  13                        inc     de              ; increment 1st string pointer.
  9328                          
  9329  1b48  23                        inc     hl              ; increment 2nd string pointer.
  9330  1b49  e3                        ex      (sp), hl        ; swap with length on stack
  9331  1b4a  2b                        dec     hl              ; decrement 2nd string length
  9332  1b4b  18df                      jr      BYTE_COMP       ; back to BYTE-COMP
  9333                          
  9334                          ; ---
  9335                          ;   the false condition.
  9336                          
  9337                          FRST_LESS:
  9338  1b4d  c1                        pop     bc              ; discard length
  9339  1b4e  f1                        pop     af              ; pop A
  9340  1b4f  a7                        and     a               ; clear the carry for false result.
  9341                          
  9342                          ; ---
  9343                          ;   exact match and x$>y$ rejoin here
  9344                          
  9345                          STR_TEST:
  9346  1b50  f5                        push    af              ; save A and carry
  9347                          
  9348  1b51  ef                        rst     FP_CALC         ;; FP-CALC
  9349  1b52  a0                        defb    $A0             ;;stk-zero      an initial false value.
  9350  1b53  34                        defb    $34             ;;end-calc
  9351                          
  9352                          ;   both numeric and string paths converge here.
  9353                          
  9354                          END_TESTS:
  9355  1b54  f1                        pop     af              ; pop carry  - will be set if eql/neql
  9356  1b55  f5                        push    af              ; save it again.
  9357                          
  9358  1b56  dcd51a                    call    c, not          ; routine NOT sets true(1) if equal(0)
  9359                                                          ; or, for strings, applies true result.
  9360  1b59  cdce1a                    call    greater_0       ; greater-0  ??????????
  9361                          
  9362                          
  9363  1b5c  f1                        pop     af              ; pop A
  9364  1b5d  0f                        rrca                    ; the third RRCA - test for '<=', '>=' or '<>'.
  9365  1b5e  d4d51a                    call    nc, not         ; apply a terminal NOT if so.
  9366  1b61  c9                        ret                     ; return.
  9367                          
  9368                          ; -----------------------------------
  9369                          ; THE 'STRING CONCATENATION' OPERATOR
  9370                          ; -----------------------------------
  9371                          ; (offset $17: 'strs_add')
  9372                          ;   This literal combines two strings into one e.g. LET A$ = B$ + C$
  9373                          ;   The two parameters of the two strings to be combined are on the stack.
  9374                          
  9375                          strs_add:
  9376  1b62  cdf813                    call    STK_FETCH       ; routine STK-FETCH fetches string parameters
  9377                                                          ; and deletes calculator stack entry.
  9378  1b65  d5                        push    de              ; save start address.
  9379  1b66  c5                        push    bc              ; and length.
  9380                          
  9381  1b67  cdf813                    call    STK_FETCH       ; routine STK-FETCH for first string
  9382  1b6a  e1                        pop     hl              ; re-fetch first length
  9383  1b6b  e5                        push    hl              ; and save again
  9384  1b6c  d5                        push    de              ; save start of second string
  9385  1b6d  c5                        push    bc              ; and its length.
  9386                          
  9387  1b6e  09                        add     hl, bc          ; add the two lengths.
  9388  1b6f  44                        ld      b, h            ; transfer to BC
  9389  1b70  4d                        ld      c, l            ; and create
  9390  1b71  f7                        rst     BC_SPACES       ; BC-SPACES in workspace.
  9391                                                          ; DE points to start of space.
  9392                          
  9393  1b72  cdc312                    call    STK_STO_DOLLAR  ; routine STK-STO-$ stores parameters
  9394                                                          ; of new string updating STKEND.
  9395                          
  9396  1b75  c1                        pop     bc              ; length of first
  9397  1b76  e1                        pop     hl              ; address of start
  9398                          
  9399  1b77  78                        ld      a, b            ; test for
  9400  1b78  b1                        or      c               ; zero length.
  9401  1b79  2802                      jr      z, OTHER_STR    ; to OTHER-STR if null string
  9402                          
  9403  1b7b  edb0                      ldir                    ; copy string to workspace.
  9404                          
  9405                          OTHER_STR:
  9406  1b7d  c1                        pop     bc              ; now second length
  9407  1b7e  e1                        pop     hl              ; and start of string
  9408                          
  9409  1b7f  78                        ld      a, b            ; test this one
  9410  1b80  b1                        or      c               ; for zero length
  9411  1b81  2802                      jr      z, STK_PNTRS    ; skip forward to STK-PNTRS if so as complete.
  9412                          
  9413  1b83  edb0                      ldir                    ; else copy the bytes.
  9414                          
  9415                          ; Continue into next routine which sets the calculator stack pointers.
  9416                          
  9417                          ; ----------------------------
  9418                          ; THE 'STACK POINTERS' ROUTINE
  9419                          ; ----------------------------
  9420                          ;   Register DE is set to STKEND and HL, the result pointer, is set to five
  9421                          ;   locations below this - the 'last value'.
  9422                          ;   This routine is used when it is inconvenient to save these values at the
  9423                          ;   time the calculator stack is manipulated due to other activity on the
  9424                          ;   machine stack.
  9425                          ;   This routine is also used to terminate the VAL routine for
  9426                          ;   the same reason and to initialize the calculator stack at the start of
  9427                          ;   the CALCULATE routine.
  9428                          
  9429                          STK_PNTRS:
  9430  1b85  2a1c40                    ld      hl, (STKEND)    ; fetch STKEND value from system variable.
  9431  1b88  11fbff                    ld      de, $FFFB       ; the value -5
  9432  1b8b  e5                        push    hl              ; push STKEND value.
  9433                          
  9434  1b8c  19                        add     hl, de          ; subtract 5 from HL.
  9435                          
  9436  1b8d  d1                        pop     de              ; pop STKEND to DE.
  9437  1b8e  c9                        ret                     ; return.
  9438                          
  9439                          ; -------------------
  9440                          ; THE 'CHR$' FUNCTION
  9441                          ; -------------------
  9442                          ; (offset $2B: 'chr$')
  9443                          ;   This function returns a single character string that is a result of
  9444                          ;   converting a number in the range 0-255 to a string e.g. CHR$ 38 = "A".
  9445                          ;   Note. the ZX81 does not have an ASCII character set.
  9446                          
  9447                          chr_dollar:
  9448  1b8f  cdcd15                    call    FP_TO_A         ; routine FP-TO-A puts the number in A.
  9449                          
  9450  1b92  380e                      jr      c, REPORT_Bd    ; forward to REPORT-Bd if overflow
  9451  1b94  200c                      jr      nz, REPORT_Bd   ; forward to REPORT-Bd if negative
  9452                          
  9453  1b96  f5                        push    af              ; save the argument.
  9454                          
  9455  1b97  010100                    ld      bc, $0001       ; one space required.
  9456  1b9a  f7                        rst     BC_SPACES       ; BC-SPACES makes DE point to start
  9457                          
  9458  1b9b  f1                        pop     af              ; restore the number.
  9459                          
  9460  1b9c  12                        ld      (de), a         ; and store in workspace
  9461                          
  9462  1b9d  cdc312                    call    STK_STO_DOLLAR  ; routine STK-STO-$ stacks descriptor.
  9463                          
  9464  1ba0  eb                        ex      de, hl          ; make HL point to result and DE to STKEND.
  9465  1ba1  c9                        ret                     ; return.
  9466                          
  9467                          ; ---
  9468                          
  9469                          REPORT_Bd:
  9470  1ba2  cf                        rst     ERROR_1         ; ERROR-1
  9471  1ba3  0a                        defb    ERR_B_INT_OVERFLOW
  9472                                                          ; Error Report: Integer out of range
  9473                          
  9474                          ; ------------------
  9475                          ; THE 'VAL' FUNCTION
  9476                          ; ------------------
  9477                          ; (offset $1A: 'val')
  9478                          ;   VAL treats the characters in a string as a numeric expression.
  9479                          ;       e.g. VAL "2.3" = 2.3, VAL "2+4" = 6, VAL ("2" + "4") = 24.
  9480                          
  9481                          val:
  9482  1ba4  2a1640                    ld      hl, (CH_ADD)    ; fetch value of system variable CH_ADD
  9483                          
  9484  1ba7  e5                        push    hl              ; and save on the machine stack.
  9485                          
  9486  1ba8  cdf813                    call    STK_FETCH       ; routine STK-FETCH fetches the string operand
  9487                                                          ; from calculator stack.
  9488                          
  9489  1bab  d5                        push    de              ; save the address of the start of the string.
  9490  1bac  03                        inc     bc              ; increment the length for a carriage return.
  9491                          
  9492  1bad  f7                        rst     BC_SPACES       ; BC-SPACES creates the space in workspace.
  9493  1bae  e1                        pop     hl              ; restore start of string to HL.
  9494  1baf  ed531640                  ld      (CH_ADD), de    ; load CH_ADD with start DE in workspace.
  9495                          
  9496  1bb3  d5                        push    de              ; save the start in workspace
  9497  1bb4  edb0                      ldir                    ; copy string from program or variables or
  9498                                                          ; workspace to the workspace area.
  9499  1bb6  eb                        ex      de, hl          ; end of string + 1 to HL
  9500  1bb7  2b                        dec     hl              ; decrement HL to point to end of new area.
  9501  1bb8  3676                      ld      (hl), $76       ; insert a carriage return at end.
  9502                                                          ; ZX81 has a non-ASCII character set
  9503  1bba  fdcb01be                  res     7, (iy+FLAGS-IY0)
  9504                                                          ; update FLAGS  - signal checking syntax.
  9505  1bbe  cd920d                    call    CLASS_6         ; routine CLASS-06 - SCANNING evaluates string
  9506                                                          ; expression and checks for integer result.
  9507                          
  9508  1bc1  cd220d                    call    CHECK_2         ; routine CHECK-2 checks for carriage return.
  9509                          
  9510                          
  9511  1bc4  e1                        pop     hl              ; restore start of string in workspace.
  9512                          
  9513  1bc5  221640                    ld      (CH_ADD), hl    ; set CH_ADD to the start of the string again.
  9514  1bc8  fdcb01fe                  set     7, (iy+FLAGS-IY0)
  9515                                                          ; update FLAGS  - signal running program.
  9516  1bcc  cd550f                    call    SCANNING        ; routine SCANNING evaluates the string
  9517                                                          ; in full leaving result on calculator stack.
  9518                          
  9519  1bcf  e1                        pop     hl              ; restore saved character address in program.
  9520  1bd0  221640                    ld      (CH_ADD), hl    ; and reset the system variable CH_ADD.
  9521                          
  9522  1bd3  18b0                      jr      STK_PNTRS       ; back to exit via STK-PNTRS.
  9523                                                          ; resetting the calculator stack pointers
  9524                                                          ; HL and DE from STKEND as it wasn't possible
  9525                                                          ; to preserve them during this routine.
  9526                          
  9527                          ; -------------------
  9528                          ; THE 'STR$' FUNCTION
  9529                          ; -------------------
  9530                          ; (offset $2A: 'str$')
  9531                          ;   This function returns a string representation of a numeric argument.
  9532                          ;   The method used is to trick the PRINT-FP routine into thinking it
  9533                          ;   is writing to a collapsed display file when in fact it is writing to
  9534                          ;   string workspace.
  9535                          ;   If there is already a newline at the intended print position and the
  9536                          ;   column count has not been reduced to zero then the print routine
  9537                          ;   assumes that there is only 1K of RAM and the screen memory, like the rest
  9538                          ;   of dynamic memory, expands as necessary using calls to the ONE-SPACE
  9539                          ;   routine. The screen is character-mapped not bit-mapped.
  9540                          
  9541                          str_dollar:
  9542  1bd5  010100                    ld      bc, $0001       ; create an initial byte in workspace
  9543  1bd8  f7                        rst     BC_SPACES       ; using BC-SPACES restart.
  9544                          
  9545  1bd9  3676                      ld      (hl), $76       ; place a carriage return there.
  9546                          
  9547  1bdb  2a3940                    ld      hl, (S_POSN)    ; fetch value of S_POSN column/line
  9548  1bde  e5                        push    hl              ; and preserve on stack.
  9549                          
  9550  1bdf  2eff                      ld      l, $FF          ; make column value high to create a
  9551                                                          ; contrived buffer of length 254.
  9552  1be1  223940                    ld      (S_POSN), hl    ; and store in system variable S_POSN.
  9553                          
  9554  1be4  2a0e40                    ld      hl, (DF_CC)     ; fetch value of DF_CC
  9555  1be7  e5                        push    hl              ; and preserve on stack also.
  9556                          
  9557  1be8  ed530e40                  ld      (DF_CC), de     ; now set DF_CC which normally addresses
  9558                                                          ; somewhere in the display file to the start
  9559                                                          ; of workspace.
  9560  1bec  d5                        push    de              ; save the start of new string.
  9561                          
  9562  1bed  cddb15                    call    PRINT_FP        ; routine PRINT-FP.
  9563                          
  9564  1bf0  d1                        pop     de              ; retrieve start of string.
  9565                          
  9566  1bf1  2a0e40                    ld      hl, (DF_CC)     ; fetch end of string from DF_CC.
  9567  1bf4  a7                        and     a               ; prepare for true subtraction.
  9568  1bf5  ed52                      sbc     hl, de          ; subtract to give length.
  9569                          
  9570  1bf7  44                        ld      b, h            ; and transfer to the BC
  9571  1bf8  4d                        ld      c, l            ; register.
  9572                          
  9573  1bf9  e1                        pop     hl              ; restore original
  9574  1bfa  220e40                    ld      (DF_CC), hl     ; DF_CC value
  9575                          
  9576  1bfd  e1                        pop     hl              ; restore original
  9577  1bfe  223940                    ld      (S_POSN), hl    ; S_POSN values.
  9578                          
  9579  1c01  cdc312                    call    STK_STO_DOLLAR  ; routine STK-STO-$ stores the string
  9580                                                          ; descriptor on the calculator stack.
  9581                          
  9582  1c04  eb                        ex      de, hl          ; HL = last value, DE = STKEND.
  9583  1c05  c9                        ret                     ; return.
  9584                          
  9585                          
  9586                          ; -------------------
  9587                          ; THE 'CODE' FUNCTION
  9588                          ; -------------------
  9589                          ; (offset $19: 'code')
  9590                          ;   Returns the code of a character or first character of a string
  9591                          ;   e.g. CODE "AARDVARK" = 38  (not 65 as the ZX81 does not have an ASCII
  9592                          ;   character set).
  9593                          
  9594                          
  9595                          code:
  9596  1c06  cdf813                    call    STK_FETCH       ; routine STK-FETCH to fetch and delete the
  9597                                                          ; string parameters.
  9598                                                          ; DE points to the start, BC holds the length.
  9599  1c09  78                        ld      a, b            ; test length
  9600  1c0a  b1                        or      c               ; of the string.
  9601  1c0b  2801                      jr      z, STK_CODE     ; skip to STK-CODE with zero if the null string.
  9602                          
  9603  1c0d  1a                        ld      a, (de)         ; else fetch the first character.
  9604                          
  9605                          STK_CODE:
  9606  1c0e  c31d15                    jp      STACK_A         ; jump back to STACK-A (with memory check)
  9607                          
  9608                          ; --------------------
  9609                          ; THE 'LEN' SUBROUTINE
  9610                          ; --------------------
  9611                          ; (offset $1b: 'len')
  9612                          ;   Returns the length of a string.
  9613                          ;   In Sinclair BASIC strings can be more than twenty thousand characters long
  9614                          ;   so a sixteen-bit register is required to store the length
  9615                          
  9616                          len:
  9617  1c11  cdf813                    call    STK_FETCH       ; routine STK-FETCH to fetch and delete the
  9618                                                          ; string parameters from the calculator stack.
  9619                                                          ; register BC now holds the length of string.
  9620                          
  9621  1c14  c32015                    jp      STACK_BC        ; jump back to STACK-BC to save result on the
  9622                                                          ; calculator stack (with memory check).
  9623                          
  9624                          ; -------------------------------------
  9625                          ; THE 'DECREASE THE COUNTER' SUBROUTINE
  9626                          ; -------------------------------------
  9627                          ; (offset $31: 'dec-jr-nz')
  9628                          ;   The calculator has an instruction that decrements a single-byte
  9629                          ;   pseudo-register and makes consequential relative jumps just like
  9630                          ;   the Z80's DJNZ instruction.
  9631                          
  9632                          dec_jr_nz:
  9633  1c17  d9                        exx                     ; switch in set that addresses code
  9634                          
  9635  1c18  e5                        push    hl              ; save pointer to offset byte
  9636  1c19  211e40                    ld      hl, BREG        ; address BREG in system variables
  9637  1c1c  35                        dec     (hl)            ; decrement it
  9638  1c1d  e1                        pop     hl              ; restore pointer
  9639                          
  9640  1c1e  2004                      jr      nz, JUMP_2      ; to JUMP-2 if not zero
  9641                          
  9642  1c20  23                        inc     hl              ; step past the jump length.
  9643  1c21  d9                        exx                     ; switch in the main set.
  9644  1c22  c9                        ret                     ; return.
  9645                          
  9646                          ;   Note. as a general rule the calculator avoids using the IY register
  9647                          ;   otherwise the cumbersome 4 instructions in the middle could be replaced by
  9648                          ;   dec (iy+$xx) - using three instruction bytes instead of six.
  9649                          
  9650                          
  9651                          ; ---------------------
  9652                          ; THE 'JUMP' SUBROUTINE
  9653                          ; ---------------------
  9654                          ; Offset $2F; 'jump'
  9655                          ;   This enables the calculator to perform relative jumps just like
  9656                          ;   the Z80 chip's JR instruction.
  9657                          ;   This is one of the few routines to be polished for the ZX Spectrum.
  9658                          ;   See, without looking at the ZX Spectrum ROM, if you can get rid of the
  9659                          ;   relative jump.
  9660                          
  9661                          jump:
  9662  1c23  d9                        exx                     ;switch in pointer set
  9663                          
  9664                          JUMP_2:
  9665  1c24  5e                        ld      e, (hl)         ; the jump byte 0-127 forward, 128-255 back.
  9666  1c25  af                        xor     a               ; clear accumulator.
  9667  1c26  cb7b                      bit     7, e            ; test if negative jump
  9668  1c28  2801                      jr      z, JUMP_3       ; skip, if positive, to JUMP-3.
  9669                          
  9670  1c2a  2f                        cpl                     ; else change to $FF.
  9671                          
  9672                          JUMP_3:
  9673  1c2b  57                        ld      d, a            ; transfer to high byte.
  9674  1c2c  19                        add     hl, de          ; advance calculator pointer forward or back.
  9675                          
  9676  1c2d  d9                        exx                     ; switch out pointer set.
  9677  1c2e  c9                        ret                     ; return.
  9678                          
  9679                          ; -----------------------------
  9680                          ; THE 'JUMP ON TRUE' SUBROUTINE
  9681                          ; -----------------------------
  9682                          ; Offset $00; 'jump-true'
  9683                          ;   This enables the calculator to perform conditional relative jumps
  9684                          ;   dependent on whether the last test gave a true result
  9685                          ;   On the ZX81, the exponent will be zero for zero or else $81 for one.
  9686                          
  9687                          jump_true:
  9688  1c2f  1a                        ld      a, (de)         ; collect exponent byte
  9689                          
  9690  1c30  a7                        and     a               ; is result 0 or 1 ?
  9691  1c31  20f0                      jr      nz, jump        ; back to jump if true (1).
  9692                          
  9693  1c33  d9                        exx                     ; else switch in the pointer set.
  9694  1c34  23                        inc     hl              ; step past the jump length.
  9695  1c35  d9                        exx                     ; switch in the main set.
  9696  1c36  c9                        ret                     ; return.
  9697                          
  9698                          
  9699                          ; ------------------------
  9700                          ; THE 'MODULUS' SUBROUTINE
  9701                          ; ------------------------
  9702                          ; ( Offset $2E: 'n-mod-m' )
  9703                          ; ( i1, i2 -- i3, i4 )
  9704                          ;   The subroutine calculate N mod M where M is the positive integer, the
  9705                          ;   'last value' on the calculator stack and N is the integer beneath.
  9706                          ;   The subroutine returns the integer quotient as the last value and the
  9707                          ;   remainder as the value beneath.
  9708                          ;   e.g.    17 MOD 3 = 5 remainder 2
  9709                          ;   It is invoked during the calculation of a random number and also by
  9710                          ;   the PRINT-FP routine.
  9711                          
  9712                          n_mod_m:
  9713  1c37  ef                        rst     FP_CALC         ;; FP-CALC          17, 3.
  9714  1c38  c0                        defb    $C0             ;;st-mem-0          17, 3.
  9715  1c39  02                        defb    $02             ;;delete            17.
  9716  1c3a  2d                        defb    $2D             ;;duplicate         17, 17.
  9717  1c3b  e0                        defb    $E0             ;;get-mem-0         17, 17, 3.
  9718  1c3c  05                        defb    $05             ;;division          17, 17/3.
  9719  1c3d  24                        defb    $24             ;;int               17, 5.
  9720  1c3e  e0                        defb    $E0             ;;get-mem-0         17, 5, 3.
  9721  1c3f  01                        defb    $01             ;;exchange          17, 3, 5.
  9722  1c40  c0                        defb    $C0             ;;st-mem-0          17, 3, 5.
  9723  1c41  04                        defb    $04             ;;multiply          17, 15.
  9724  1c42  03                        defb    $03             ;;subtract          2.
  9725  1c43  e0                        defb    $E0             ;;get-mem-0         2, 5.
  9726  1c44  34                        defb    $34             ;;end-calc          2, 5.
  9727                          
  9728  1c45  c9                        ret                     ; return.
  9729                          
  9730                          
  9731                          ; ----------------------
  9732                          ; THE 'INTEGER' FUNCTION
  9733                          ; ----------------------
  9734                          ; (offset $24: 'int')
  9735                          ;   This function returns the integer of x, which is just the same as truncate
  9736                          ;   for positive numbers. The truncate literal truncates negative numbers
  9737                          ;   upwards so that -3.4 gives -3 whereas the BASIC INT function has to
  9738                          ;   truncate negative numbers down so that INT -3.4 is 4.
  9739                          ; It is best to work through using, say, plus and minus 3.4 as examples.
  9740                          
  9741                          int:
  9742  1c46  ef                        rst     FP_CALC         ;; FP-CALC              x.    (= 3.4 or -3.4).
  9743  1c47  2d                        defb    $2D             ;;duplicate             x, x.
  9744  1c48  32                        defb    $32             ;;less-0                x, (1/0)
  9745  1c49  00                        defb    $00             ;;jump-true             x, (1/0)
  9746  1c4a  04                        defb    X_NEG - ASMPC   ;;to L1C46, X-NEG
  9747                          
  9748  1c4b  36                        defb    $36             ;;truncate              trunc 3.4 = 3.
  9749  1c4c  34                        defb    $34             ;;end-calc              3.
  9750                          
  9751  1c4d  c9                        ret                     ; return with + int x on stack.
  9752                          
  9753                          
  9754                          X_NEG:
  9755  1c4e  2d                        defb    $2D             ;;duplicate             -3.4, -3.4.
  9756  1c4f  36                        defb    $36             ;;truncate              -3.4, -3.
  9757  1c50  c0                        defb    $C0             ;;st-mem-0              -3.4, -3.
  9758  1c51  03                        defb    $03             ;;subtract              -.4
  9759  1c52  e0                        defb    $E0             ;;get-mem-0             -.4, -3.
  9760  1c53  01                        defb    $01             ;;exchange              -3, -.4.
  9761  1c54  2c                        defb    $2C             ;;not                   -3, (0).
  9762  1c55  00                        defb    $00             ;;jump-true             -3.
  9763  1c56  03                        defb    EXIT - ASMPC    ;;to L1C59, EXIT        -3.
  9764                          
  9765  1c57  a1                        defb    $A1             ;;stk-one               -3, 1.
  9766  1c58  03                        defb    $03             ;;subtract              -4.
  9767                          
  9768                          EXIT:
  9769  1c59  34                        defb    $34             ;;end-calc              -4.
  9770                          
  9771  1c5a  c9                        ret                     ; return.
  9772                          
  9773                          
  9774                          ; --------------------------
  9775                          ; THE 'EXPONENTIAL' FUNCTION
  9776                          ; --------------------------
  9777                          ; (Offset $23: 'exp')
  9778                          ;   The exponential function returns the exponential of the argument, or the
  9779                          ;   value of 'e' (2.7182818...) raised to the power of the argument.
  9780                          ;   PRINT EXP 1 gives 2.7182818
  9781                          ;
  9782                          ;   EXP is the opposite of the LN function (see below) and is equivalent to
  9783                          ;   the 'antiln' function found on pocket calculators or the 'Inverse ln'
  9784                          ;   function found on the Windows scientific calculator.
  9785                          ;   So PRINT EXP LN 5.3 will give 5.3 as will PRINT LN EXP 5.3 or indeed
  9786                          ;   any number e.g. PRINT EXP LN PI.
  9787                          ;
  9788                          ;   The applications of the exponential function are in areas where exponential
  9789                          ;   growth is experienced, calculus, population growth and compound interest.
  9790                          ;
  9791                          ;   Error 6 if the argument is above 88.
  9792                          
  9793                          exp:
  9794  1c5b  ef                        rst     FP_CALC         ;; FP-CALC
  9795  1c5c  30                        defb    $30             ;;stk-data          1/LN 2
  9796  1c5d  f1                        defb    $F1             ;;Exponent: $81, Bytes: 4
  9797  1c5e  38aa3b29                  defb    $38, $AA, $3B, $29
  9798                                                          ;;
  9799  1c62  04                        defb    $04             ;;multiply
  9800  1c63  2d                        defb    $2D             ;;duplicate
  9801  1c64  24                        defb    $24             ;;int
  9802  1c65  c3                        defb    $C3             ;;st-mem-3
  9803  1c66  03                        defb    $03             ;;subtract
  9804  1c67  2d                        defb    $2D             ;;duplicate
  9805  1c68  0f                        defb    $0F             ;;addition
  9806  1c69  a1                        defb    $A1             ;;stk-one
  9807  1c6a  03                        defb    $03             ;;subtract
  9808  1c6b  88                        defb    $88             ;;series-08
  9809  1c6c  13                        defb    $13             ;;Exponent: $63, Bytes: 1
  9810  1c6d  36                        defb    $36             ;;(+00,+00,+00)
  9811  1c6e  58                        defb    $58             ;;Exponent: $68, Bytes: 2
  9812  1c6f  6566                      defb    $65, $66        ;;(+00,+00)
  9813  1c71  9d                        defb    $9D             ;;Exponent: $6D, Bytes: 3
  9814  1c72  786540                    defb    $78, $65, $40   ;;(+00)
  9815  1c75  a2                        defb    $A2             ;;Exponent: $72, Bytes: 3
  9816  1c76  6032c9                    defb    $60, $32, $C9   ;;(+00)
  9817  1c79  e7                        defb    $E7             ;;Exponent: $77, Bytes: 4
  9818  1c7a  21f7af24                  defb    $21, $F7, $af, $24
  9819                                                          ;;
  9820  1c7e  eb                        defb    $EB             ;;Exponent: $7B, Bytes: 4
  9821  1c7f  2fb0b014                  defb    $2F, $B0, $B0, $14
  9822                                                          ;;
  9823  1c83  ee                        defb    $EE             ;;Exponent: $7E, Bytes: 4
  9824  1c84  7ebb9458                  defb    $7E, $BB, $94, $58
  9825                                                          ;;
  9826  1c88  f1                        defb    $F1             ;;Exponent: $81, Bytes: 4
  9827  1c89  3a7ef8cf                  defb    $3A, $7E, $F8, $CF
  9828                                                          ;;
  9829  1c8d  e3                        defb    $E3             ;;get-mem-3
  9830  1c8e  34                        defb    $34             ;;end-calc
  9831                          
  9832  1c8f  cdcd15                    call    FP_TO_A         ; routine FP-TO-A
  9833  1c92  2007                      jr      nz, N_NEGTV     ; to N-NEGTV
  9834                          
  9835  1c94  3803                      jr      c, REPORT_6b    ; to REPORT-6b
  9836                          
  9837  1c96  86                        add     a, (hl)         ;
  9838  1c97  3009                      jr      nc, RESULT_OK   ; to RESULT-OK
  9839                          
  9840                          
  9841                          REPORT_6b:
  9842  1c99  cf                        rst     ERROR_1         ; ERROR-1
  9843  1c9a  05                        defb    ERR_6_OVERFLOW  ; Error Report: Number too big
  9844                          
  9845                          N_NEGTV:
  9846  1c9b  3807                      jr      c, RSLT_ZERO    ; to RSLT-ZERO
  9847                          
  9848  1c9d  96                        sub     (hl)            ;
  9849  1c9e  3004                      jr      nc, RSLT_ZERO   ; to RSLT-ZERO
  9850                          
  9851  1ca0  ed44                      neg                     ; Negate
  9852                          
  9853                          RESULT_OK:
  9854  1ca2  77                        ld      (hl), a         ;
  9855  1ca3  c9                        ret                     ; return.
  9856                          
  9857                          
  9858                          RSLT_ZERO:
  9859  1ca4  ef                        rst     FP_CALC         ;; FP-CALC
  9860  1ca5  02                        defb    $02             ;;delete
  9861  1ca6  a0                        defb    $A0             ;;stk-zero
  9862  1ca7  34                        defb    $34             ;;end-calc
  9863                          
  9864  1ca8  c9                        ret                     ; return.
  9865                          
  9866                          
  9867                          ; --------------------------------
  9868                          ; THE 'NATURAL LOGARITHM' FUNCTION
  9869                          ; --------------------------------
  9870                          ; (offset $22: 'ln')
  9871                          ;   Like the ZX81 itself, 'natural' logarithms came from Scotland.
  9872                          ;   They were devised in 1614 by well-traveled Scotsman John Napier who noted
  9873                          ;   "Nothing doth more molest and hinder calculators than the multiplications,
  9874                          ;    divisions, square and cubical extractions of great numbers".
  9875                          ;
  9876                          ;   Napier's logarithms enabled the above operations to be accomplished by
  9877                          ;   simple addition and subtraction simplifying the navigational and
  9878                          ;   astronomical calculations which beset his age.
  9879                          ;   Napier's logarithms were quickly overtaken by logarithms to the base 10
  9880                          ;   devised, in conjunction with Napier, by Henry Briggs a Cambridge-educated
  9881                          ;   professor of Geometry at Oxford University. These simplified the layout
  9882                          ;   of the tables enabling humans to easily scale calculations.
  9883                          ;
  9884                          ;   It is only recently with the introduction of pocket calculators and
  9885                          ;   computers like the ZX81 that natural logarithms are once more at the fore,
  9886                          ;   although some computers retain logarithms to the base ten.
  9887                          ;   'Natural' logarithms are powers to the base 'e', which like 'pi' is a
  9888                          ;   naturally occurring number in branches of mathematics.
  9889                          ;   Like 'pi' also, 'e' is an irrational number and starts 2.718281828...
  9890                          ;
  9891                          ;   The tabular use of logarithms was that to multiply two numbers one looked
  9892                          ;   up their two logarithms in the tables, added them together and then looked
  9893                          ;   for the result in a table of antilogarithms to give the desired product.
  9894                          ;
  9895                          ;   The EXP function is the BASIC equivalent of a calculator's 'antiln' function
  9896                          ;   and by picking any two numbers, 1.72 and 6.89 say,
  9897                          ;     10 PRINT EXP ( LN 1.72 + LN 6.89 )
  9898                          ;   will give just the same result as
  9899                          ;     20 PRINT 1.72 * 6.89.
  9900                          ;   Division is accomplished by subtracting the two logs.
  9901                          ;
  9902                          ;   Napier also mentioned "square and cubicle extractions".
  9903                          ;   To raise a number to the power 3, find its 'ln', multiply by 3 and find the
  9904                          ;   'antiln'.  e.g. PRINT EXP( LN 4 * 3 )  gives 64.
  9905                          ;   Similarly to find the n'th root divide the logarithm by 'n'.
  9906                          ;   The ZX81 ROM used PRINT EXP ( LN 9 / 2 ) to find the square root of the
  9907                          ;   number 9. The Napieran square root function is just a special case of
  9908                          ;   the 'to_power' function. A cube root or indeed any root/power would be just
  9909                          ;   as simple.
  9910                          
  9911                          ;   First test that the argument to LN is a positive, non-zero number.
  9912                          
  9913                          ln:
  9914  1ca9  ef                        rst     FP_CALC         ;; FP-CALC      x.
  9915  1caa  2d                        defb    $2D             ;;duplicate     x,x.
  9916  1cab  33                        defb    $33             ;;greater-0     x,(0/1).
  9917  1cac  00                        defb    $00             ;;jump-true     x.
  9918  1cad  04                        defb    VALID - ASMPC   ;;to L1CB1, VALID
  9919                          
  9920  1cae  34                        defb    $34             ;;end-calc      x.
  9921                          
  9922                          
  9923                          REPORT_Ab:
  9924  1caf  cf                        rst     ERROR_1         ; ERROR-1
  9925  1cb0  09                        defb    ERR_A_INVALID_ARG
  9926                                                          ; Error Report: Invalid argument
  9927                          
  9928                          VALID:
  9929  1cb1  a0                        defb    $A0             ;;stk-zero              Note. not
  9930  1cb2  02                        defb    $02             ;;delete                necessary.
  9931  1cb3  34                        defb    $34             ;;end-calc      x.
  9932                          
  9933                          ;   Register HL addresses the 'last value' x.
  9934                          
  9935  1cb4  7e                        ld      a, (hl)         ; Fetch exponent to A.
  9936                          
  9937  1cb5  3680                      ld      (hl), $80       ; Insert 'plus zero' as exponent.
  9938  1cb7  cd1d15                    call    STACK_A         ; routine STACK-A stacks true binary exponent.
  9939                          
  9940  1cba  ef                        rst     FP_CALC         ;; FP-CALC
  9941  1cbb  30                        defb    $30             ;;stk-data
  9942  1cbc  38                        defb    $38             ;;Exponent: $88, Bytes: 1
  9943  1cbd  00                        defb    $00             ;;(+00,+00,+00)
  9944  1cbe  03                        defb    $03             ;;subtract
  9945  1cbf  01                        defb    $01             ;;exchange
  9946  1cc0  2d                        defb    $2D             ;;duplicate
  9947  1cc1  30                        defb    $30             ;;stk-data
  9948  1cc2  f0                        defb    $F0             ;;Exponent: $80, Bytes: 4
  9949  1cc3  4ccccccd                  defb    $4C, $CC, $CC, $CD
  9950                                                          ;;
  9951  1cc7  03                        defb    $03             ;;subtract
  9952  1cc8  33                        defb    $33             ;;greater-0
  9953  1cc9  00                        defb    $00             ;;jump-true
  9954  1cca  08                        defb    GRE_8 - ASMPC   ;;to L1CD2, GRE.8
  9955                          
  9956  1ccb  01                        defb    $01             ;;exchange
  9957  1ccc  a1                        defb    $A1             ;;stk-one
  9958  1ccd  03                        defb    $03             ;;subtract
  9959  1cce  01                        defb    $01             ;;exchange
  9960  1ccf  34                        defb    $34             ;;end-calc
  9961                          
  9962  1cd0  34                        inc     (hl)            ;
  9963                          
  9964  1cd1  ef                        rst     FP_CALC         ;; FP-CALC
  9965                          
  9966                          GRE_8:
  9967  1cd2  01                        defb    $01             ;;exchange
  9968  1cd3  30                        defb    $30             ;;stk-data          LN 2
  9969  1cd4  f0                        defb    $F0             ;;Exponent: $80, Bytes: 4
  9970  1cd5  317217f8                  defb    $31, $72, $17, $F8
  9971                                                          ;;
  9972  1cd9  04                        defb    $04             ;;multiply
  9973  1cda  01                        defb    $01             ;;exchange
  9974  1cdb  a2                        defb    $A2             ;;stk-half
  9975  1cdc  03                        defb    $03             ;;subtract
  9976  1cdd  a2                        defb    $A2             ;;stk-half
  9977  1cde  03                        defb    $03             ;;subtract
  9978  1cdf  2d                        defb    $2D             ;;duplicate
  9979  1ce0  30                        defb    $30             ;;stk-data
  9980  1ce1  32                        defb    $32             ;;Exponent: $82, Bytes: 1
  9981  1ce2  20                        defb    $20             ;;(+00,+00,+00)
  9982  1ce3  04                        defb    $04             ;;multiply
  9983  1ce4  a2                        defb    $A2             ;;stk-half
  9984  1ce5  03                        defb    $03             ;;subtract
  9985  1ce6  8c                        defb    $8C             ;;series-0C
  9986  1ce7  11                        defb    $11             ;;Exponent: $61, Bytes: 1
  9987  1ce8  ac                        defb    $AC             ;;(+00,+00,+00)
  9988  1ce9  14                        defb    $14             ;;Exponent: $64, Bytes: 1
  9989  1cea  09                        defb    $09             ;;(+00,+00,+00)
  9990  1ceb  56                        defb    $56             ;;Exponent: $66, Bytes: 2
  9991  1cec  daa5                      defb    $DA, $A5        ;;(+00,+00)
  9992  1cee  59                        defb    $59             ;;Exponent: $69, Bytes: 2
  9993  1cef  30c5                      defb    $30, $C5        ;;(+00,+00)
  9994  1cf1  5c                        defb    $5C             ;;Exponent: $6C, Bytes: 2
  9995  1cf2  90aa                      defb    $90, $AA        ;;(+00,+00)
  9996  1cf4  9e                        defb    $9E             ;;Exponent: $6E, Bytes: 3
  9997  1cf5  706f61                    defb    $70, $6F, $61   ;;(+00)
  9998  1cf8  a1                        defb    $A1             ;;Exponent: $71, Bytes: 3
  9999  1cf9  cbda96                    defb    $CB, $DA, $96   ;;(+00)
 10000  1cfc  a4                        defb    $A4             ;;Exponent: $74, Bytes: 3
 10001  1cfd  319fb4                    defb    $31, $9F, $B4   ;;(+00)
 10002  1d00  e7                        defb    $E7             ;;Exponent: $77, Bytes: 4
 10003  1d01  a0fe5cfc                  defb    $A0, $FE, $5C, $FC
 10004                                                          ;;
 10005  1d05  ea                        defb    $EA             ;;Exponent: $7A, Bytes: 4
 10006  1d06  1b43ca36                  defb    $1B, $43, $CA, $36
 10007                                                          ;;
 10008  1d0a  ed                        defb    $ED             ;;Exponent: $7D, Bytes: 4
 10009  1d0b  a79c7e5e                  defb    $A7, $9C, $7E, $5E
 10010                                                          ;;
 10011  1d0f  f0                        defb    $F0             ;;Exponent: $80, Bytes: 4
 10012  1d10  6e238093                  defb    $6E, $23, $80, $93
 10013                                                          ;;
 10014  1d14  04                        defb    $04             ;;multiply
 10015  1d15  0f                        defb    $0F             ;;addition
 10016  1d16  34                        defb    $34             ;;end-calc
 10017                          
 10018  1d17  c9                        ret                     ; return.
