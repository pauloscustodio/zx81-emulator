rom/zx81_edition3.asm:
     1                          ; =============================================================================
     2                          ; Assembly Listing of the Operating System of the ZX81 edition 3 (improved) ROM
     3                          ; =============================================================================
     4                          ;
     5                          ; Work in progress.
     6                          ; This file will cross-assemble an original version of the "Improved"
     7                          ; ZX81 ROM.  The file can be modified to change the behaviour of the ROM
     8                          ; when used in emulators although there is no spare space available.
     9                          ;
    10                          ; The documentation is incomplete and if you can find a copy
    11                          ; of "The Complete Spectrum ROM Disassembly" then many routines
    12                          ; such as POINTERS and most of the mathematical routines are
    13                          ; similar and often identical.
    14                          ;
    15                          ; I've used the labels from the above book in this file and also
    16                          ; some from the more elusive Complete ZX81 ROM Disassembly
    17                          ; by the same publishers, Melbourne House.
    18                          
    19                          
    20                          ; ================
    21                          ; ZX-81 MEMORY MAP
    22                          ; ================
    23                          
    24                          ; +------------------+-- Top of memory
    25                          ; | Reserved area    |
    26                          ; +------------------+-- (RAMTOP)
    27                          ; | GOSUB stack      |
    28                          ; +------------------+-- (ERR_SP)
    29                          ; | Machine stack    |
    30                          ; +------------------+-- SP
    31                          ; | Spare memory     |
    32                          ; +------------------+-- (STKEND)
    33                          ; | Calculator stack |
    34                          ; +------------------+-- (STKBOT)
    35                          ; | Edit line        |
    36                          ; +------------------+-- (E_LINE)
    37                          ; | User variables   |
    38                          ; +------------------+-- (VARS)
    39                          ; | Screen           |
    40                          ; +------------------+-- (D_FILE)
    41                          ; | User program     |
    42                          ; +------------------+-- 407Dh (16509d)
    43                          ; | System variables |
    44                          ; +------------------+-- 4000h (16384d)
    45                          
    46                          ; ======================
    47                          ; ZX-81 User VARIABLES
    48                          ; ======================
    49                          ;
    50                          ; Example for the following code:
    51                          ;       10 LET Z=100
    52                          ;       20 LET ABC=1
    53                          ;       30 DIM N(4)
    54                          ;       40 FOR I=1 TO 10
    55                          ;       50 LET H$="HELLO"
    56                          ;       60 DIM Z$(100)
    57                          ;
    58                          ; VARS:
    59                          ;       7F = %011 vvvvv, v = Z - number Z
    60                          ;           87 48 00 00 00      - value
    61                          ;
    62                          ;       A6 = %101 vvvvv, v = A
    63                          ;       27 = %001 vvvvv, V = B
    64                          ;       A8 = %101 vvvvv, v = C - long number ABC
    65                          ;           81 00 00 00 00      - value
    66                          ;
    67                          ;       93 = %100 vvvvv, v = N - array of numbers
    68                          ;           17 00               - total length of elements & dimensions + 1 = 23
    69                          ;           01                  - number of dimensions = 1
    70                          ;           04 00               - first dimension = 4
    71                          ;           00 00 00 00 00      - N(1)
    72                          ;           00 00 00 00 00      - N(2)
    73                          ;           00 00 00 00 00      - N(3)
    74                          ;           00 00 00 00 00      - N(4)
    75                          ;
    76                          ;       EE = %111 vvvvv, v = I - loop control variable
    77                          ;           81 00 00 00 00      - value
    78                          ;           84 20 00 00 00      - limit
    79                          ;           81 00 00 00 00      - step
    80                          ;           29 00               - looping line = 41 (LSB first, manual says MSB first)
    81                          ;
    82                          ;       4D = %010 vvvvv, v = H - string
    83                          ;           05 00               - length = 5
    84                          ;           2D 2A 31 31 34      - "HELLO"
    85                          ;
    86                          ;       DF = %110 vvvvv, v = Z - array of characters
    87                          ;           67 00               - total length of elements & dimensions + 1 = 103
    88                          ;           01                  - number of dimensions = 1
    89                          ;           64 00               - first dimension = 100
    90                          ;           00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
    91                          ;           00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
    92                          ;           00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
    93                          ;           00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
    94                          ;           00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 - 20*5 blank spaces
    95                          ;
    96                          ;       80 = %100 00000 - end marker
    97                          ;
    98                          
