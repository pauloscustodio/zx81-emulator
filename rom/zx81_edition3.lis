  6120                          
  6121  1309  c5                        push    bc              ;
  6122  130a  0610                      ld      b, $10          ;
  6123  130c  7c                        ld      a, h            ;
  6124  130d  4d                        ld      c, l            ;
  6125  130e  210000                    ld      hl, $0000       ;
