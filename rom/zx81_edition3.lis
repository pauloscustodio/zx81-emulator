  2301                          
  2302  05c7  216f04                    ld      hl, EDIT_INP    ; Address: EDIT-INP
  2303  05ca  e5                        push    hl              ; ** is pushed as an error looping address.
  2304                          
  2305  05cb  fdcb2d6e                  bit     5, (iy+FLAGX-IY0)
  2306                                                          ; test FLAGX
  2307  05cf  c0                        ret     nz              ; indirect jump if in input mode
  2308                                                          ; to L046F, EDIT-INP (begin again).
  2309                          
  2310                          ;
  2311                          
  2312  05d0  2a1440                    ld      hl, (E_LINE)    ; fetch E_LINE
  2313  05d3  220e40                    ld      (DF_CC), hl     ; and use to update the screen cursor DF_CC
  2314                          
  2315                          ; so now RST $10 will print the line numbers to the edit line instead of screen.
  2316                          ; first make sure that no newline/out of screen can occur while sprinting the
  2317                          ; line numbers to the edit line.
  2318                          
  2319  05d6  212118                    ld      hl, $1821       ; prepare line 0, column 0.
  2320  05d9  223940                    ld      (S_POSN), hl    ; update S_POSN with these dummy values.
  2321                          
  2322  05dc  2a0a40                    ld      hl, (E_PPC)     ; fetch current line from E_PPC may be a
  2323                                                          ; non-existent line e.g. last line deleted.
  2324  05df  cdd809                    call    LINE_ADDR       ; routine LINE-ADDR gets address or that of
  2325                                                          ; the following line.
  2326  05e2  cdbb05                    call    LINE_NO         ; routine LINE-NO gets line number if any in DE
  2327                                                          ; leaving HL pointing at second low byte.
  2328                          
  2329  05e5  7a                        ld      a, d            ; test the line number for zero.
  2330  05e6  b3                        or      e               ;
  2331  05e7  c8                        ret     z               ; return if no line number - no program to edit.
  2332                          
  2333  05e8  2b                        dec     hl              ; point to high byte.
  2334  05e9  cda50a                    call    OUT_NO          ; routine OUT-NO writes number to edit line.
  2335                          
  2336  05ec  23                        inc     hl              ; point to length bytes.
  2337  05ed  4e                        ld      c, (hl)         ; low byte to C.
  2338  05ee  23                        inc     hl              ;
  2339  05ef  46                        ld      b, (hl)         ; high byte to B.
  2340                          
  2341  05f0  23                        inc     hl              ; point to first character in line.
  2342  05f1  ed5b0e40                  ld      de, (DF_CC)     ; fetch display file cursor DF_CC
  2343                          
  2344  05f5  3e7f                      ld      a, $7F          ; prepare the cursor character.
  2345  05f7  12                        ld      (de), a         ; and insert in edit line.
  2346  05f8  13                        inc     de              ; increment intended destination.
  2347                          
  2348  05f9  e5                        push    hl              ; * save start of BASIC.
  2349                          
  2350  05fa  211d00                    ld      hl, $001D       ; set an overhead of 29 bytes.
  2351  05fd  19                        add     hl, de          ; add in the address of cursor.
  2352  05fe  09                        add     hl, bc          ; add the length of the line.
  2353  05ff  ed72                      sbc     hl, sp          ; subtract the stack pointer.
  2354                          
  2355  0601  e1                        pop     hl              ; * restore pointer to start of BASIC.
  2356                          
  2357  0602  d0                        ret     nc              ; return if not enough room to L046F EDIT-INP.
  2358                                                          ; the edit key appears not to work.
  2359                          
  2360  0603  edb0                      ldir                    ; else copy bytes from program to edit line.
  2361                                                          ; Note. hidden floating point forms are also
  2362                                                          ; copied to edit line.
  2363                          
  2364  0605  eb                        ex      de, hl          ; transfer free location pointer to HL
  2365                          
  2366  0606  d1                        pop     de              ; ** remove address EDIT-INP from stack.
  2367                          
  2368  0607  cda614                    call    SET_STK_B       ; routine SET-STK-B sets STKEND from HL.
  2369                          
  2370  060a  1891                      jr      ENDED_2         ; back to ENDED-2 and after 3 more jumps
  2371                                                          ; to L0472, LOWER.
  2372                                                          ; Note. The LOWER routine removes the hidden
  2373                                                          ; floating-point numbers from the edit line.
  2374                          
  2375                          ; -------------------------
  2376                          ; THE 'NEWLINE KEY' ROUTINE
  2377                          ; -------------------------
  2378                          ;
  2379                          ;
