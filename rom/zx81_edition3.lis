  4348                          ; --------------------------
  4349                          ; THE 'CHECK END' SUBROUTINE
  4350                          ; --------------------------
  4351                          ; Check for end of statement and that no spurious characters occur after
  4352                          ; a correctly parsed statement. Since only one statement is allowed on each
  4353                          ; line, the only character that may follow a statement is a NEWLINE.
  4354                          ;
  4355                          
  4356                          CHECK_END:
  4357  0d1d  cda60d                    call    SYNTAX_Z        ; routine SYNTAX-Z
  4358  0d20  c0                        ret     nz              ; return in runtime.
  4359                          
  4360  0d21  c1                        pop     bc              ; else drop return address.
  4361                          
  4362                          CHECK_2:
  4363  0d22  7e                        ld      a, (hl)         ; fetch character.
  4364  0d23  fe76                      cp      $76             ; compare to NEWLINE.
  4365  0d25  c8                        ret     z               ; return if so.
  4366                          
  4367                          REPORT_C2:
  4368  0d26  1872                      jr      REPORT_C        ; to REPORT-C
  4369                                                          ; 'Nonsense in BASIC'
  4370                          
  4371                          ; --------------------------
