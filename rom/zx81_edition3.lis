  3663  0ad7  ce00                      adc     a, $00          ;
  3664  0ad9  2869                      jr      z, SPACING      ; to SPACING
  3665                          
  3666  0adb  fea7                      cp      $A7             ;
  3667  0add  201b                      jr      nz, NOT_AT      ; to NOT-AT
  3668                          
  3669                          
