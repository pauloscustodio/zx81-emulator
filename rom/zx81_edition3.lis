  2680                          OUT_CURS:
  2681  079d  3a0640                    ld      a, (MODE)       ; Fetch value of system variable MODE
  2682  07a0  06ab                      ld      b, $AB          ; Prepare an inverse [F] for function cursor.
  2683                          
  2684  07a2  a7                        and     a               ; Test for zero -
  2685  07a3  2005                      jr      nz, FLAGS_2     ; forward if not to FLAGS-2
  2686                          
  2687  07a5  3a0140                    ld      a, (FLAGS)      ; Fetch system variable FLAGS.
  2688  07a8  06b0                      ld      b, $B0          ; Prepare an inverse [K] for keyword cursor.
  2689                          
  2690                          FLAGS_2:
  2691  07aa  1f                        rra                     ; 00000?00 -> 000000?0
  2692  07ab  1f                        rra                     ; 000000?0 -> 0000000?
  2693  07ac  e601                      and     $01             ; 0000000?    0000000x
  2694                          
  2695  07ae  80                        add     a, b            ; Possibly [F] -> [G]  or  [K] -> [L]
  2696                          
  2697  07af  cdf507                    call    PRINT_SP        ; routine PRINT-SP prints character
  2698  07b2  18b9                      jr      MORE_LINE       ; back to MORE-LINE
  2699                          
