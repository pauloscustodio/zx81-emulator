  2387                                                          ; sv FLAGX
  2388  0616  2011                      jr      nz, NOW_SCAN    ; to NOW-SCAN
  2389                          
  2390  0618  2a1440                    ld      hl, (E_LINE)    ; sv E_LINE_lo
  2391  061b  7e                        ld      a, (hl)         ;
  2392  061c  feff                      cp      $FF             ;
  2393  061e  2806                      jr      z, STK_UPPER    ; to STK-UPPER
  2394                          
