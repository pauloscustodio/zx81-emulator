 10020                          ; -----------------------------
 10021                          ; THE 'TRIGONOMETRIC' FUNCTIONS
 10022                          ; -----------------------------
 10023                          ;   Trigonometry is rocket science. It is also used by carpenters and pyramid
 10024                          ;   builders.
 10025                          ;   Some uses can be quite abstract but the principles can be seen in simple
 10026                          ;   right-angled triangles. Triangles have some special properties -
 10027                          ;
 10028                          ;   1) The sum of the three angles is always PI radians (180 degrees).
 10029                          ;      Very helpful if you know two angles and wish to find the third.
 10030                          ;   2) In any right-angled triangle the sum of the squares of the two shorter
 10031                          ;      sides is equal to the square of the longest side opposite the right-angle.
 10032                          ;      Very useful if you know the length of two sides and wish to know the
 10033                          ;      length of the third side.
 10034                          ;   3) Functions sine, cosine and tangent enable one to calculate the length
 10035                          ;      of an unknown side when the length of one other side and an angle is
 10036                          ;      known.
 10037                          ;   4) Functions arcsin, arccosine and arctan enable one to calculate an unknown
 10038                          ;      angle when the length of two of the sides is known.
 10039                          
 10040                          ; --------------------------------
 10041                          ; THE 'REDUCE ARGUMENT' SUBROUTINE
 10042                          ; --------------------------------
 10043                          ; (offset $35: 'get-argt')
 10044                          ;
 10045                          ;   This routine performs two functions on the angle, in radians, that forms
 10046                          ;   the argument to the sine and cosine functions.
 10047                          ;   First it ensures that the angle 'wraps round'. That if a ship turns through
 10048                          ;   an angle of, say, 3*PI radians (540 degrees) then the net effect is to turn
 10049                          ;   through an angle of PI radians (180 degrees).
 10050                          ;   Secondly it converts the angle in radians to a fraction of a right angle,
 10051                          ;   depending within which quadrant the angle lies, with the periodicity
 10052                          ;   resembling that of the desired sine value.
 10053                          ;   The result lies in the range -1 to +1.
 10054                          ;
 10055                          ;                       90 deg.
 10056                          ;
 10057                          ;                       (pi/2)
 10058                          ;                II       +1        I
 10059                          ;                         |
 10060                          ;          sin+      |\   |   /|    sin+
 10061                          ;          cos-      | \  |  / |    cos+
 10062                          ;          tan-      |  \ | /  |    tan+
 10063                          ;                    |   \|/)  |
 10064                          ;   180 deg. (pi) 0 -|----+----|-- 0  (0)   0 degrees
 10065                          ;                    |   /|\   |
 10066                          ;          sin-      |  / | \  |    sin-
 10067                          ;          cos-      | /  |  \ |    cos+
 10068                          ;          tan+      |/   |   \|    tan-
 10069                          ;                         |
 10070                          ;                III      -1       IV
 10071                          ;                       (3pi/2)
 10072                          ;
 10073                          ;                       270 deg.
 10074                          
 10075                          
 10076                          get_argt:
 10077  1d18  ef                        rst     FP_CALC         ;; FP-CALC         X.
 10078  1d19  30                        defb    $30             ;;stk-data
 10079  1d1a  ee                        defb    $EE             ;;Exponent: $7E,
 10080                                                          ;;Bytes: 4
 10081  1d1b  22f9836e                  defb    $22, $F9, $83, $6E
 10082                                                          ;;                 X, 1/(2*PI)
 10083  1d1f  04                        defb    $04             ;;multiply         X/(2*PI) = fraction
 10084                          
 10085  1d20  2d                        defb    $2D             ;;duplicate
 10086  1d21  a2                        defb    $A2             ;;stk-half
 10087  1d22  0f                        defb    $0F             ;;addition
 10088  1d23  24                        defb    $24             ;;int
 10089                          
 10090  1d24  03                        defb    $03             ;;subtract         now range -.5 to .5
 10091                          
 10092  1d25  2d                        defb    $2D             ;;duplicate
 10093  1d26  0f                        defb    $0F             ;;addition         now range -1 to 1.
 10094  1d27  2d                        defb    $2D             ;;duplicate
 10095  1d28  0f                        defb    $0F             ;;addition         now range -2 to 2.
 10096                          
 10097                          ;   quadrant I (0 to +1) and quadrant IV (-1 to 0) are now correct.
 10098                          ;   quadrant II ranges +1 to +2.
 10099                          ;   quadrant III ranges -2 to -1.
 10100                          
 10101  1d29  2d                        defb    $2D             ;;duplicate        Y, Y.
 10102  1d2a  27                        defb    $27             ;;abs              Y, abs(Y).    range 1 to 2
 10103  1d2b  a1                        defb    $A1             ;;stk-one          Y, abs(Y), 1.
 10104  1d2c  03                        defb    $03             ;;subtract         Y, abs(Y)-1.  range 0 to 1
 10105  1d2d  2d                        defb    $2D             ;;duplicate        Y, Z, Z.
 10106  1d2e  33                        defb    $33             ;;greater-0        Y, Z, (1/0).
 10107                          
 10108  1d2f  c0                        defb    $C0             ;;st-mem-0         store as possible sign
 10109                                                          ;;                 for cosine function.
 10110                          
 10111  1d30  00                        defb    $00             ;;jump-true
 10112  1d31  04                        defb    ZPLUS - ASMPC   ;;to L1D35, ZPLUS  with quadrants II and III
 10113                          
 10114                          ;   else the angle lies in quadrant I or IV and value Y is already correct.
 10115                          
 10116  1d32  02                        defb    $02             ;;delete          Y    delete test value.
 10117  1d33  34                        defb    $34             ;;end-calc        Y.
 10118                          
 10119  1d34  c9                        ret                     ; return.         with Q1 and Q4 >>>
 10120                          
 10121                          ;   The branch was here with quadrants II (0 to 1) and III (1 to 0).
 10122                          ;   Y will hold -2 to -1 if this is quadrant III.
 10123                          
 10124                          ZPLUS:
 10125  1d35  a1                        defb    $A1             ;;stk-one         Y, Z, 1
 10126  1d36  03                        defb    $03             ;;subtract        Y, Z-1.       Q3 = 0 to -1
 10127  1d37  01                        defb    $01             ;;exchange        Z-1, Y.
 10128  1d38  32                        defb    $32             ;;less-0          Z-1, (1/0).
 10129  1d39  00                        defb    $00             ;;jump-true       Z-1.
 10130  1d3a  02                        defb    YNEG - ASMPC    ;;to L1D3C, YNEG
 10131                                                          ;;if angle in quadrant III
 10132                          
 10133                          ;   else angle is within quadrant II (-1 to 0)
 10134                          
 10135  1d3b  18                        defb    $18             ;;negate          range +1 to 0
 10136                          
 10137                          
 10138                          YNEG:
 10139  1d3c  34                        defb    $34             ;;end-calc        quadrants II and III correct.
 10140                          
 10141  1d3d  c9                        ret                     ; return.
 10142                          
 10143                          
 10144                          ; ---------------------
 10145                          ; THE 'COSINE' FUNCTION
 10146                          ; ---------------------
 10147                          ; (offset $1D: 'cos')
 10148                          ;   Cosines are calculated as the sine of the opposite angle rectifying the
 10149                          ;   sign depending on the quadrant rules.
 10150                          ;
 10151                          ;
 10152                          ;             /|
 10153                          ;          h /y|
 10154                          ;           /  |o
 10155                          ;          /x  |
 10156                          ;         /----|
 10157                          ;           a
 10158                          ;
 10159                          ;   The cosine of angle x is the adjacent side (a) divided by the hypotenuse 1.
 10160                          ;   However if we examine angle y then a/h is the sine of that angle.
 10161                          ;   Since angle x plus angle y equals a right-angle, we can find angle y by
 10162                          ;   subtracting angle x from pi/2.
 10163                          ;   However it's just as easy to reduce the argument first and subtract the
 10164                          ;   reduced argument from the value 1 (a reduced right-angle).
 10165                          ;   It's even easier to subtract 1 from the angle and rectify the sign.
 10166                          ;   In fact, after reducing the argument, the absolute value of the argument
 10167                          ;   is used and rectified using the test result stored in mem-0 by 'get-argt'
 10168                          ;   for that purpose.
 10169                          
 10170                          cos:
 10171  1d3e  ef                        rst     FP_CALC         ;; FP-CALC              angle in radians.
 10172  1d3f  35                        defb    $35             ;;get-argt              X       reduce -1 to +1
 10173                          
 10174  1d40  27                        defb    $27             ;;abs                   ABS X   0 to 1
 10175  1d41  a1                        defb    $A1             ;;stk-one               ABS X, 1.
 10176  1d42  03                        defb    $03             ;;subtract              now opposite angle
 10177                                                          ;;                      though negative sign.
 10178  1d43  e0                        defb    $E0             ;;get-mem-0             fetch sign indicator.
 10179  1d44  00                        defb    $00             ;;jump-true
 10180  1d45  06                        defb    C_ENT - ASMPC   ;;fwd to L1D4B, C-ENT
 10181                                                          ;;forward to common code if in QII or QIII
 10182                          
 10183                          
 10184  1d46  18                        defb    $18             ;;negate                else make positive.
 10185  1d47  2f                        defb    $2F             ;;jump
 10186  1d48  03                        defb    C_ENT - ASMPC   ;;fwd to L1D4B, C-ENT
 10187                                                          ;;with quadrants QI and QIV
 10188                          
 10189                          ; -------------------
 10190                          ; THE 'SINE' FUNCTION
 10191                          ; -------------------
 10192                          ; (offset $1C: 'sin')
 10193                          ;   This is a fundamental transcendental function from which others such as cos
 10194                          ;   and tan are directly, or indirectly, derived.
 10195                          ;   It uses the series generator to produce Chebyshev polynomials.
 10196                          ;
 10197                          ;
 10198                          ;             /|
 10199                          ;          1 / |
 10200                          ;           /  |x
 10201                          ;          /a  |
 10202                          ;         /----|
 10203                          ;           y
 10204                          ;
 10205                          ;   The 'get-argt' function is designed to modify the angle and its sign
 10206                          ;   in line with the desired sine value and afterwards it can launch straight
 10207                          ;   into common code.
 10208                          
 10209                          sin:
 10210  1d49  ef                        rst     FP_CALC         ;; FP-CALC      angle in radians
 10211  1d4a  35                        defb    $35             ;;get-argt      reduce - sign now correct.
 10212                          
 10213                          C_ENT:
 10214  1d4b  2d                        defb    $2D             ;;duplicate
 10215  1d4c  2d                        defb    $2D             ;;duplicate
 10216  1d4d  04                        defb    $04             ;;multiply
 10217  1d4e  2d                        defb    $2D             ;;duplicate
 10218  1d4f  0f                        defb    $0F             ;;addition
 10219  1d50  a1                        defb    $A1             ;;stk-one
 10220  1d51  03                        defb    $03             ;;subtract
 10221                          
 10222  1d52  86                        defb    $86             ;;series-06
 10223  1d53  14                        defb    $14             ;;Exponent: $64, Bytes: 1
 10224  1d54  e6                        defb    $E6             ;;(+00,+00,+00)
 10225  1d55  5c                        defb    $5C             ;;Exponent: $6C, Bytes: 2
 10226  1d56  1f0b                      defb    $1F, $0B        ;;(+00,+00)
 10227  1d58  a3                        defb    $A3             ;;Exponent: $73, Bytes: 3
 10228  1d59  8f38ee                    defb    $8F, $38, $EE   ;;(+00)
 10229  1d5c  e9                        defb    $E9             ;;Exponent: $79, Bytes: 4
 10230  1d5d  1563bb23                  defb    $15, $63, $BB, $23
 10231                                                          ;;
 10232  1d61  ee                        defb    $EE             ;;Exponent: $7E, Bytes: 4
 10233  1d62  920dcded                  defb    $92, $0D, $CD, $ED
 10234                                                          ;;
 10235  1d66  f1                        defb    $F1             ;;Exponent: $81, Bytes: 4
 10236  1d67  235d1bea                  defb    $23, $5D, $1B, $EA
 10237                                                          ;;
 10238                          
 10239  1d6b  04                        defb    $04             ;;multiply
 10240  1d6c  34                        defb    $34             ;;end-calc
 10241                          
 10242  1d6d  c9                        ret                     ; return.
 10243                          
 10244                          
 10245                          ; ----------------------
 10246                          ; THE 'TANGENT' FUNCTION
 10247                          ; ----------------------
 10248                          ; (offset $1E: 'tan')
 10249                          ;
 10250                          ;   Evaluates tangent x as    sin(x) / cos(x).
 10251                          ;
 10252                          ;
 10253                          ;             /|
 10254                          ;          h / |
 10255                          ;           /  |o
 10256                          ;          /x  |
 10257                          ;         /----|
 10258                          ;           a
 10259                          ;
 10260                          ;   The tangent of angle x is the ratio of the length of the opposite side
 10261                          ;   divided by the length of the adjacent side. As the opposite length can
 10262                          ;   be calculates using sin(x) and the adjacent length using cos(x) then
 10263                          ;   the tangent can be defined in terms of the previous two functions.
 10264                          
 10265                          ;   Error 6 if the argument, in radians, is too close to one like pi/2
 10266                          ;   which has an infinite tangent. e.g. PRINT TAN (PI/2)  evaluates as 1/0.
 10267                          ;   Similarly PRINT TAN (3*PI/2), TAN (5*PI/2) etc.
 10268                          
 10269                          tan:
 10270  1d6e  ef                        rst     FP_CALC         ;; FP-CALC          x.
 10271  1d6f  2d                        defb    $2D             ;;duplicate         x, x.
 10272  1d70  1c                        defb    $1C             ;;sin               x, sin x.
 10273  1d71  01                        defb    $01             ;;exchange          sin x, x.
 10274  1d72  1d                        defb    $1D             ;;cos               sin x, cos x.
 10275  1d73  05                        defb    $05             ;;division          sin x/cos x (= tan x).
 10276  1d74  34                        defb    $34             ;;end-calc          tan x.
 10277                          
 10278  1d75  c9                        ret                     ; return.
 10279                          
 10280                          ; ---------------------
 10281                          ; THE 'ARCTAN' FUNCTION
 10282                          ; ---------------------
 10283                          ; (Offset $21: 'atn')
 10284                          ;   The inverse tangent function with the result in radians.
 10285                          ;   This is a fundamental transcendental function from which others such as
 10286                          ;   asn and acs are directly, or indirectly, derived.
 10287                          ;   It uses the series generator to produce Chebyshev polynomials.
 10288                          
 10289                          atn:
 10290  1d76  7e                        ld      a, (hl)         ; fetch exponent
 10291  1d77  fe81                      cp      $81             ; compare to that for 'one'
 10292  1d79  380e                      jr      c, SMALL        ; forward, if less, to SMALL
 10293                          
 10294  1d7b  ef                        rst     FP_CALC         ;; FP-CALC      X.
 10295  1d7c  a1                        defb    $A1             ;;stk-one
 10296  1d7d  18                        defb    $18             ;;negate
 10297  1d7e  01                        defb    $01             ;;exchange
 10298  1d7f  05                        defb    $05             ;;division
 10299  1d80  2d                        defb    $2D             ;;duplicate
 10300  1d81  32                        defb    $32             ;;less-0
 10301  1d82  a3                        defb    $A3             ;;stk-pi/2
 10302  1d83  01                        defb    $01             ;;exchange
 10303  1d84  00                        defb    $00             ;;jump-true
 10304  1d85  06                        defb    CASES - ASMPC   ;;to L1D8B, CASES
 10305                          
 10306  1d86  18                        defb    $18             ;;negate
 10307  1d87  2f                        defb    $2F             ;;jump
 10308  1d88  03                        defb    CASES - ASMPC   ;;to L1D8B, CASES
 10309                          
 10310                          ; ---
 10311                          
 10312                          SMALL:
 10313  1d89  ef                        rst     FP_CALC         ;; FP-CALC
 10314  1d8a  a0                        defb    $A0             ;;stk-zero
 10315                          
 10316                          CASES:
 10317  1d8b  01                        defb    $01             ;;exchange
 10318  1d8c  2d                        defb    $2D             ;;duplicate
 10319  1d8d  2d                        defb    $2D             ;;duplicate
 10320  1d8e  04                        defb    $04             ;;multiply
 10321  1d8f  2d                        defb    $2D             ;;duplicate
 10322  1d90  0f                        defb    $0F             ;;addition
 10323  1d91  a1                        defb    $A1             ;;stk-one
 10324  1d92  03                        defb    $03             ;;subtract
 10325                          
 10326  1d93  8c                        defb    $8C             ;;series-0C
 10327  1d94  10                        defb    $10             ;;Exponent: $60, Bytes: 1
 10328  1d95  b2                        defb    $B2             ;;(+00,+00,+00)
 10329  1d96  13                        defb    $13             ;;Exponent: $63, Bytes: 1
 10330  1d97  0e                        defb    $0E             ;;(+00,+00,+00)
 10331  1d98  55                        defb    $55             ;;Exponent: $65, Bytes: 2
 10332  1d99  e48d                      defb    $E4, $8D        ;;(+00,+00)
 10333  1d9b  58                        defb    $58             ;;Exponent: $68, Bytes: 2
 10334  1d9c  39bc                      defb    $39, $bc        ;;(+00,+00)
 10335  1d9e  5b                        defb    $5B             ;;Exponent: $6B, Bytes: 2
 10336  1d9f  98fd                      defb    $98, $FD        ;;(+00,+00)
 10337  1da1  9e                        defb    $9E             ;;Exponent: $6E, Bytes: 3
 10338  1da2  003675                    defb    $00, $36, $75   ;;(+00)
 10339  1da5  a0                        defb    $A0             ;;Exponent: $70, Bytes: 3
 10340  1da6  dbe8b4                    defb    $DB, $E8, $B4   ;;(+00)
 10341  1da9  63                        defb    $63             ;;Exponent: $73, Bytes: 2
 10342  1daa  42c4                      defb    $42, $C4        ;;(+00,+00)
 10343  1dac  e6                        defb    $E6             ;;Exponent: $76, Bytes: 4
 10344  1dad  b50936be                  defb    $B5, $09, $36, $BE
 10345                                                          ;;
 10346  1db1  e9                        defb    $E9             ;;Exponent: $79, Bytes: 4
 10347  1db2  36731b5d                  defb    $36, $73, $1B, $5D
 10348                                                          ;;
 10349  1db6  ec                        defb    $EC             ;;Exponent: $7C, Bytes: 4
 10350  1db7  d8de63be                  defb    $D8, $de, $63, $BE
 10351                                                          ;;
 10352  1dbb  f0                        defb    $F0             ;;Exponent: $80, Bytes: 4
 10353  1dbc  61a1b30c                  defb    $61, $A1, $B3, $0C
 10354                                                          ;;
 10355                          
 10356  1dc0  04                        defb    $04             ;;multiply
 10357  1dc1  0f                        defb    $0F             ;;addition
 10358  1dc2  34                        defb    $34             ;;end-calc
 10359                          
 10360  1dc3  c9                        ret                     ; return.
 10361                          
 10362                          
 10363                          ; ---------------------
 10364                          ; THE 'ARCSIN' FUNCTION
 10365                          ; ---------------------
 10366                          ; (Offset $1F: 'asn')
 10367                          ;   The inverse sine function with result in radians.
 10368                          ;   Derived from arctan function above.
 10369                          ;   Error A unless the argument is between -1 and +1 inclusive.
 10370                          ;   Uses an adaptation of the formula asn(x) = atn(x/sqr(1-x*x))
 10371                          ;
 10372                          ;
 10373                          ;                 /|
 10374                          ;                / |
 10375                          ;              1/  |x
 10376                          ;              /a  |
 10377                          ;             /----|
 10378                          ;               y
 10379                          ;
 10380                          ;   e.g. We know the opposite side (x) and hypotenuse (1)
 10381                          ;   and we wish to find angle a in radians.
 10382                          ;   We can derive length y by Pythagoras and then use ATN instead.
 10383                          ;   Since y*y + x*x = 1*1 (Pythagoras Theorem) then
 10384                          ;   y=sqr(1-x*x)                         - no need to multiply 1 by itself.
 10385                          ;   So, asn(a) = atn(x/y)
 10386                          ;   or more fully,
 10387                          ;   asn(a) = atn(x/sqr(1-x*x))
 10388                          
 10389                          ;   Close but no cigar.
 10390                          
 10391                          ;   While PRINT ATN (x/SQR (1-x*x)) gives the same results as PRINT ASN x,
 10392                          ;   it leads to division by zero when x is 1 or -1.
 10393                          ;   To overcome this, 1 is added to y giving half the required angle and the
 10394                          ;   result is then doubled.
 10395                          ;   That is, PRINT ATN (x/(SQR (1-x*x) +1)) *2
 10396                          ;
 10397                          ;
 10398                          ;               . /|
 10399                          ;            .  c/ |
 10400                          ;         .     /1 |x
 10401                          ;      . c   b /a  |
 10402                          ;    ---------/----|
 10403                          ;      1      y
 10404                          ;
 10405                          ;   By creating an isosceles triangle with two equal sides of 1, angles c and
 10406                          ;   c are also equal. If b+c+c = 180 degrees and b+a = 180 degrees then c=a/2.
 10407                          ;
 10408                          ;   A value higher than 1 gives the required error as attempting to find  the
 10409                          ;   square root of a negative number generates an error in Sinclair BASIC.
 10410                          
 10411                          asn:
 10412  1dc4  ef                        rst     FP_CALC         ;; FP-CALC      x.
 10413  1dc5  2d                        defb    $2D             ;;duplicate     x, x.
 10414  1dc6  2d                        defb    $2D             ;;duplicate     x, x, x.
 10415  1dc7  04                        defb    $04             ;;multiply      x, x*x.
 10416  1dc8  a1                        defb    $A1             ;;stk-one       x, x*x, 1.
 10417  1dc9  03                        defb    $03             ;;subtract      x, x*x-1.
 10418  1dca  18                        defb    $18             ;;negate        x, 1-x*x.
 10419  1dcb  25                        defb    $25             ;;sqr           x, sqr(1-x*x) = y.
 10420  1dcc  a1                        defb    $A1             ;;stk-one       x, y, 1.
 10421  1dcd  0f                        defb    $0F             ;;addition      x, y+1.
 10422  1dce  05                        defb    $05             ;;division      x/y+1.
 10423  1dcf  21                        defb    $21             ;;atn           a/2     (half the angle)
 10424  1dd0  2d                        defb    $2D             ;;duplicate     a/2, a/2.
 10425  1dd1  0f                        defb    $0F             ;;addition      a.
 10426  1dd2  34                        defb    $34             ;;end-calc      a.
 10427                          
 10428  1dd3  c9                        ret                     ; return.
 10429                          
 10430                          
 10431                          ; ------------------------
 10432                          ; THE 'ARCCOS' FUNCTION
 10433                          ; ------------------------
 10434                          ; (Offset $20: 'acs')
 10435                          ;   The inverse cosine function with the result in radians.
 10436                          ;   Error A unless the argument is between -1 and +1.
 10437                          ;   Result in range 0 to pi.
 10438                          ;   Derived from asn above which is in turn derived from the preceding atn.
 10439                          ;   It could have been derived directly from atn using acs(x) = atn(sqr(1-x*x)/x).
 10440                          ;   However, as sine and cosine are horizontal translations of each other,
 10441                          ;   uses acs(x) = pi/2 - asn(x)
 10442                          
 10443                          ;   e.g. the arccosine of a known x value will give the required angle b in
 10444                          ;   radians.
 10445                          ;   We know, from above, how to calculate the angle a using asn(x).
 10446                          ;   Since the three angles of any triangle add up to 180 degrees, or pi radians,
 10447                          ;   and the largest angle in this case is a right-angle (pi/2 radians), then
 10448                          ;   we can calculate angle b as pi/2 (both angles) minus asn(x) (angle a).
 10449                          ;
 10450                          ;
 10451                          ;            /|
 10452                          ;         1 /b|
 10453                          ;          /  |x
 10454                          ;         /a  |
 10455                          ;        /----|
 10456                          ;          y
 10457                          
 10458                          acs:
 10459  1dd4  ef                        rst     FP_CALC         ;; FP-CALC      x.
 10460  1dd5  1f                        defb    $1F             ;;asn           asn(x).
 10461  1dd6  a3                        defb    $A3             ;;stk-pi/2      asn(x), pi/2.
 10462  1dd7  03                        defb    $03             ;;subtract      asn(x) - pi/2.
 10463  1dd8  18                        defb    $18             ;;negate        pi/2 - asn(x) = acs(x).
 10464  1dd9  34                        defb    $34             ;;end-calc      acs(x)
 10465                          
 10466  1dda  c9                        ret                     ; return.
 10467                          
 10468                          
 10469                          ; ------------------------------
 10470                          ; THE OLD 'SQUARE ROOT' FUNCTION
 10471                          ; ------------------------------
 10472                          ; (Offset $25: 'sqr')
 10473                          ;   Error A if argument is negative.
 10474                          ;   This routine is remarkable for its brevity - 7 bytes.
 10475                          ;   The ZX81 code was originally 9K and various techniques had to be
 10476                          ;   used to shoe-horn it into an 8K Rom chip.
 10477                          
 10478                          
 10479                          sqr:
 10480  1ddb  ef                        rst     FP_CALC         ;; FP-CALC              x.
 10481  1ddc  2d                        defb    $2D             ;;duplicate             x, x.
 10482  1ddd  2c                        defb    $2C             ;;not                   x, 1/0
 10483  1dde  00                        defb    $00             ;;jump-true             x, (1/0).
 10484  1ddf  1e                        defb    LAST - ASMPC    ;;to L1DFD, LAST        exit if argument zero
 10485                                                          ;;                      with zero result.
 10486                          
 10487                          ;   else continue to calculate as x ** .5
 10488                          
 10489  1de0  a2                        defb    $A2             ;;stk-half              x, .5.
 10490  1de1  34                        defb    $34             ;;end-calc              x, .5.
 10491                          
 10492                          
 10493                          ; drop into the exponentiation operation
 10494                          
 10495                          ; ------------------------
 10496                          ; THE 'TO POWER' OPERATION
 10497                          ; ------------------------
 10498                          ; (Offset $06: 'to-power')
 10499                          ;   The 'Exponential' operation.
 10500                          ;   This raises the first number X to the power of the second number Y.
 10501                          ;   e.g. PRINT 2 ** 3 gives the result 8
 10502                          ;   As with the ZX80,
 10503                          ;   0 ** 0 = 1
 10504                          ;   0 ** +n = 0
 10505                          ;   0 ** -n = arithmetic overflow.
 10506                          
 10507                          to_power:
 10508  1de2  ef                        rst     FP_CALC         ;; FP-CALC              X,Y.
 10509  1de3  01                        defb    $01             ;;exchange              Y,X.
 10510  1de4  2d                        defb    $2D             ;;duplicate             Y,X,X.
 10511  1de5  2c                        defb    $2C             ;;not                   Y,X,(1/0).
 10512  1de6  00                        defb    $00             ;;jump-true
 10513  1de7  07                        defb    XISO - ASMPC    ;;forward to L1DEE, XISO if X is zero.
 10514                          
 10515                          ;   else X is non-zero. function 'ln' will catch a negative value of X.
 10516                          
 10517  1de8  22                        defb    $22             ;;ln                    Y, LN X.
 10518                          
 10519                          ;   Multiply the power by the logarithm of the argument.
 10520                          
 10521  1de9  04                        defb    $04             ;;multiply              Y * LN X
 10522  1dea  34                        defb    $34             ;;end-calc
 10523                          
 10524  1deb  c35b1c                    jp      exp             ; jump back to EXP routine             ->>
 10525                                                          ; to find the 'antiln'
 10526                          
 10527                          ; ---
 10528                          
 10529                          ;   These routines form the three simple results when the number is zero.
 10530                          ;   begin by deleting the known zero to leave Y the power factor.
 10531                          
 10532                          XISO:
 10533  1dee  02                        defb    $02             ;;delete                Y.
 10534  1def  2d                        defb    $2D             ;;duplicate             Y, Y.
 10535  1df0  2c                        defb    $2C             ;;not                   Y, (1/0).
 10536  1df1  00                        defb    $00             ;;jump-true
 10537  1df2  09                        defb    ONE - ASMPC     ;;forward to L1DFB, ONE if Y is zero.
 10538                          
 10539                          ;   the power factor is not zero. If negative then an error exists.
 10540                          
 10541  1df3  a0                        defb    $A0             ;;stk-zero              Y, 0.
 10542  1df4  01                        defb    $01             ;;exchange              0, Y.
 10543  1df5  33                        defb    $33             ;;greater-0             0, (1/0).
 10544  1df6  00                        defb    $00             ;;jump-true             0
 10545  1df7  06                        defb    LAST - ASMPC    ;;to L1DFD, LAST        if Y was any positive
 10546                                                          ;;                      number.
 10547                          
 10548                          ;   else force division by zero thereby raising an Arithmetic overflow error.
 10549                          ;   There are some one and two-byte alternatives but perhaps the most formal
 10550                          ;   might have been to use end-calc; rst 08; defb 05.
 10551                          
 10552  1df8  a1                        defb    $A1             ;;stk-one               0, 1.
 10553  1df9  01                        defb    $01             ;;exchange              1, 0.
 10554  1dfa  05                        defb    $05             ;;division              1/0    >> error
 10555                          
 10556                          ; ---
 10557                          
 10558                          ONE:
 10559  1dfb  02                        defb    $02             ;;delete                .
 10560  1dfc  a1                        defb    $A1             ;;stk-one               1.
 10561                          
 10562                          LAST:
 10563  1dfd  34                        defb    $34             ;;end-calc              last value 1 or 0.
 10564                          
 10565  1dfe  c9                        ret                     ; return.
 10566                          
 10567                          
 10568                          ; ---------------------
 10569                          ; THE 'SPARE LOCATIONS'
 10570                          ; ---------------------
 10571                          
 10572                          SPARE:
 10573  1dff  ff                        defs    $1E00 - ASMPC, $FF
 10574                          
 10575                          ; That's all folks.
 10576                          
