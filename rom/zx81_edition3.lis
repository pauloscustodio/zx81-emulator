  3673  0ae5  c29a0d                    jp      nz, REPORT_C    ; to REPORT-C
  3674                          
  3675                          
  3676  0ae8  e7                        rst     NEXT_CHAR       ; NEXT-CHAR
  3677  0ae9  cd920d                    call    CLASS_6         ; routine CLASS-6
  3678  0aec  cd4e0b                    call    SYNTAX_ON       ; routine SYNTAX-ON
  3679                          
  3680  0aef  ef                        rst     FP_CALC         ;; FP-CALC
  3681  0af0  01                        defb    $01             ;;exchange
  3682  0af1  34                        defb    $34             ;;end-calc
  3683                          
  3684  0af2  cdf50b                    call    STK_TO_BC       ; routine STK-TO-BC
  3685  0af5  cdf508                    call    PRINT_AT        ; routine PRINT-AT
