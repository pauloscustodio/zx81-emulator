   172                          ; ======================
   173                          ; ZX-81 SYSTEM VARIABLES
   174                          ; ======================
   175                          ; X The variable should not be poked, because the system might crash.
   176                          ; N Poking the variable will have no lasting effect.
   177                          ; S The variable is saved by SAVE.
   178                          ;
   179                          defc    ERR_NR  = $4000         ;    1  16384
   180                                                          ;       1 less than the report code. Starts off
   181                                                          ;       at 255 (for -1), so PEEK 16384, if it
   182                                                          ;       works at all, gives 255.
   183                                                          ;       POKE 16384,n can be used to force an
   184                                                          ;       error halt: 0 <= n <= 14 gives one of
   185                                                          ;       the usual reports, 15 <= n <= 34 or
   186                                                          ;       99 <= n <= 127 gives a nonstandard
   187                                                          ;       report, and 35 <= n <= 98 is likely to
   188                                                          ;       mess up the display file.
   189                          defc    FLAGS   = $4001         ;   X1  16385
   190                                                          ;       Various flags to control the BASIC system.
   191                                                          ;       bit 0: 1 surpress leading space
   192                                                          ;       bit 1: 0 output to display; 1 to printer
   193                                                          ;       bit 2: 0 K mode, 1 L mode
   194                                                          ;       bit 6: 0 numeric result, 1 string result
   195                                                          ;       bit 7: 0 syntax check, 1 run
   196                          defc    ERR_SP  = $4002         ;   X2  16386
   197                                                          ;       Address of first item on machine stack
   198                                                          ;       (after GOSUB returns).
   199                          defc    RAMTOP  = $4004         ;    2  16388
   200                                                          ;       Address of first byte above BASIC system
   201                                                          ;       area. You can poke this to make NEW
   202                                                          ;       reserve space above that area (see
   203                                                          ;       Chapter 26) or to fool CLS into setting
   204                                                          ;       up a minimal display file (Chapter 27).
   205                          defc    MODE    = $4006         ;   N1  16390
   206                                                          ;       Specifies K, L, F or G cursor.
   207                          defc    PPC     = $4007         ;   N2  16391
   208                                                          ;       Line number of statement currently being
   209                                                          ;       executed. Poking this has no lasting
   210                                                          ;       effect except in the last line of the
   211                                                          ;       program.
   212                          defc    VERSN   = $4009         ;   S1  16393
   213                                                          ;       0 identifies 8K ROM in saved programs.
   214                          defc    E_PPC   = $400A         ;   S2  16394
   215                                                          ;       Number of current line (with program
   216                                                          ;       cursor).
   217                          defc    D_FILE  = $400C         ;  SX2  16396
   218                                                          ;       The display file is the memory copy of
   219                                                          ;       the television picture. It begins with a
   220                                                          ;       NEWLINE character, & then has the twenty
   221                                                          ;       four lines of text, each finishing with
   222                                                          ;       a NEWLINE.
   223                          defc    DF_CC   = $400E         ;   S2  16398
   224                                                          ;       Address of PRINT position in display
   225                                                          ;       file. Can be poked so that PRINT output
   226                                                          ;       is sent elsewhere.
   227                          defc    VARS    = $4010         ;  SX2  16400
   228                                                          ;       The variables have different formats
   229                                                          ;       according to their different natures.
   230                          defc    DEST    = $4012         ;  SN2  16402
   231                                                          ;       Address of variable in assignment.
   232                          defc    E_LINE  = $4014         ;  SX2  16404
   233                                                          ;       Contains the line being typed (as a
   234                                                          ;       command, a program line, or INPUT data)
   235                                                          ;       & also some work space.
   236                          defc    CH_ADD  = $4016         ;  SX2  16406
   237                                                          ;       Address of the next character to be
   238                                                          ;       interpreted: the character after the
   239                                                          ;       argument of PEEK, or the ENTER at the
   240                                                          ;       end of a POKE statement.
   241                          defc    X_PTR   = $4018         ;   S2  16408
   242                                                          ;       Address of the character preceding the
   243                                                          ;       syntax error marker.
   244                          defc    STKBOT  = $401A         ;  SX2  16410
   245                                                          ;       Calculator stack start. The calculator
   246                                                          ;       stack is the part of the BASIC system
   247                                                          ;       that deals with arithmetic, & the
   248                                                          ;       numbers on which it is operating are
   249                                                          ;       held mostly in the calculator stack.
   250                          defc    STKEND  = $401C         ;  SX2  16412
   251                                                          ;       Calculator stack end.
   252                          defc    BREG    = $401E         ;  SN1  16414
   253                                                          ;       Calculator's b register.
   254                          defc    MEM     = $401F         ;  SN2  16415
   255                                                          ;       Address of area used for calculator's
   256                                                          ;       memory. (Usually MEMBOT but not always.)
   257                          defc    SPARE1  = $4021         ;   S1  16417
   258                                                          ;       Not used.
   259                          defc    DF_SZ   = $4022         ;  SX1  16418
   260                                                          ;       The number of lines (including one blank
   261                                                          ;       line) in the lower part of the screen.
   262                          defc    S_TOP   = $4023         ;   S2  16419
   263                                                          ;       The number of the top program line in
   264                                                          ;       automatic listings.
   265                          defc    LAST_K  = $4025         ;  SN2  16421
   266                                                          ;       Shows which keys pressed.
   267                                                          ;       The low byte (L) identifies the keyboard
   268                                                          ;       row (horizontal zone).
   269                                                          ;       The high byte (H) identifies the
   270                                                          ;       keyboard column group (vertical zone).
   271                                                          ;       Bits are normally set; the bit
   272                                                          ;       corresponding to a pressed key is reset
   273                          defc    DB_ST   = $4027         ;  SN1  16423
   274                                                          ;       Debounce status of keyboard.
   275                          defc    MARGIN  = $4028         ;  SN1  16424
   276                                                          ;       Number of blank lines above or below
   277                                                          ;       picture - 31.
   278                          defc    NXTLIN  = $4029         ;  SX2  16425
   279                                                          ;       Address of next program line to be
   280                                                          ;       executed.
   281                          defc    OLDPPC  = $402B         ;   S2  16427
   282                                                          ;       Line number to which CONT jumps.
   283                          defc    FLAGX   = $402D         ;  SN1  16429
   284                                                          ;       Various flags.
   285                          defc    STRLEN  = $402E         ;  SN2  16430
   286                                                          ;       Length of string type designation in
   287                                                          ;       assignment.
   288                          defc    T_ADDR  = $4030         ;  SN2  16432
   289                                                          ;       Address of next item in syntax table
   290                                                          ;       (very unlikely to be useful).
   291                          defc    SEED    = $4032         ;   S2  16434
   292                                                          ;       The seed for RND. This is the variable
   293                                                          ;       that is set by RAND.
   294                          defc    FRAMES  = $4034         ;   S2  16436
   295                                                          ;       Counts the frames displayed on the
   296                                                          ;       television. Bit 15 is 1. Bits 0 to 14
   297                                                          ;       are decremented for each frame sent to
   298                                                          ;       the television. This can be used for
   299                                                          ;       timing, but PAUSE also uses it.
   300                                                          ;       PAUSE resets bit 15 to 0 and puts in
   301                                                          ;       bits 0 to 14 the length of the pause.
   302                                                          ;       When these have been counted down to
   303                                                          ;       zero, the pause stops. If the pause
   304                                                          ;       stops because of a key depression, bit
   305                                                          ;       15 is set to 1 again.
   306                          defc    COORDS  = $4036         ;   S1  16438
   307                                                          ;       x-coordinate of last pointed PLOTted.
   308                                                          ;   S1  16439
   309                                                          ;       y-coordinate of last pointed PLOTted.
   310                          defc    PR_CC   = $4038         ;   S1  16440
   311                                                          ;       Less significant byte of address of next
   312                                                          ;       position for LPRINT to print at (in
   313                                                          ;       PRBUFF).
   314                          defc    S_POSN  = $4039         ;  SX1  16441
   315                                                          ;       Column number for PRINT position.
   316                                                          ;  SX1  16442
   317                                                          ;       Line number for PRINT position.
   318                          defc    CDFLAG  = $403B         ;   S1  16443
   319                                                          ;       Various flags.
   320                                                          ;       Bit 7 is 1 during compute and display
   321                                                          ;       mode, 0 for fast mode.
   322                                                          ;       Bit 6 is 1 to request slow mode, 0 to
   323                                                          ;       request fast mode. If slow mode not
   324                                                          ;       available then bit 6 is set back to 0.
   325                                                          ;       If slow mode is available then bit 7
   326                                                          ;       will be set to 1.
   327                                                          ;       Bit 0 is set if key available.
   328                          defc    PRBUFF  = $403C         ;  S33  16444
   329                                                          ;       Printer buffer (33rd character is ENTER).
   330                          defc    MEMBOT  = $405D         ; SN30  16477
   331                                                          ;       Calculator's memory area; used to store
   332                                                          ;       numbers that cannot conveniently be put
   333                                                          ;       on the calculator stack.
   334                          defc    SPARE2  = $407B         ;   S2  16507
   335                                                          ;       Not used.
   336                          
   337                          defc    PROG    = $407D         ;       16509
   338                                                          ;       Start of BASIC program
   339                          
   340                          defc    MAXRAM  = $7FFF         ; Maximum value of RAMTOP
   341                          
   342                          defc    IY0     = ERR_NR        ; Base of system variables
   343                          
   344                          
   345                          ; =================
   346                          ; ZX-81 Error Codes
   347                          ; =================
   348                          
   349                          ; 0     Successful completion, or jump to line number bigger than any
   350                          ;       existing. A report with code 0 does not change the line number
   351                          ;       used by CONT.
   352                          defc    ERR_0_OK = 0 - 1
   353                          
   354                          ; 1     The control variable does not exist (has not been set up by a
   355                          ;       FOR statement) but there is an ordinary variable with the same
   356                          ;       name.
   357                          defc    ERR_1_NEXT_WO_FOR = 1 - 1
   358                          
   359                          ; 2     An undefined variable has been used.
   360                          ;       For a simple variable this will happen if the variable is used
   361                          ;       before it has been assigned to in a LET statement.
   362                          ;       For a subscripted variable it will happen if the variable is used
   363                          ;       before it has been dimensioned in a DIM statement.
   364                          ;       For a control variable this will happen if the variable is used
   365                          ;       before it has been set up as a control variable in a FOR
   366                          ;       statement, when there is no ordinary simple variable with the
   367                          ;       same name.
   368                          defc    ERR_2_UNDEF_VAR = 2 - 1
   369                          
   370                          ; 3     Subscript out of range.
   371                          ;       If the subscript is hopelessly out of range (negative, or bigger
   372                          ;       than 65535) then error B will result.
   373                          defc    ERR_3_SUBSCRIPT_RANGE = 3 - 1
   374                          
   375                          ; 4     Not enough room in memory. Note that the line number in the
   376                          ;       report (after the /) may be incomplete on the screen, because of
   377                          ;       the shortage of memory: for instance 4/20 may appear as 4/2.
   378                          ;       See chapter 23. For GOSUB see exercise 6 of chapter 14.
   379                          defc    ERR_4_NO_ROOM = 4 - 1
   380                          
   381                          ; 5     No more room on the screen. CONT will make room by clearing
   382                          ;       the screen.
   383                          defc    ERR_4_SCREEN_FULL = 5 - 1
   384                          
   385                          ; 6     Arithmetic overflow: calculations have led to a number greater
   386                          ;       than about 10^38.
   387                          defc    ERR_6_OVERFLOW = 6 - 1
   388                          
   389                          ; 7     No corresponding GOSUB for a RETURN statement.
   390                          defc    ERR_7_RET_WO_GOSUB = 7 - 1
   391                          
   392                          ; 8     You have attempted INPUT as a command (not allowed).
   393                          defc    ERR_8_EOF = 8 - 1
   394                          
   395                          ; 9     STOP statement executed. CONT will not try to re-execute the
   396                          ;       STOP statement.
   397                          defc    ERR_9_STOP = 9 - 1
   398                          
   399                          ; A     Invalid argument to certain functions.
   400                          defc    ERR_A_INVALID_ARG = $0A - 1
   401                          
   402                          ; B     Integer out of range. When an integer is required, the floating
   403                          ;       point argument is rounded to the nearest integer. If this is
   404                          ;       outside a suitable range then error B results.
   405                          ;       For array access, see also report 3.
   406                          defc    ERR_B_INT_OVERFLOW = $0B - 1
   407                          
   408                          ; C     The text of the (string) argument of VAL does not form a valid
   409                          ;       numerical expression.
   410                          defc    ERR_C_NONSENSE = $0C - 1
   411                          
   412                          ; D     (i) Program interrupted by BREAK.
   413                          ;       (ii) The INPUT line starts with STOP.
   414                          defc    ERR_D_BREAK = $0D - 1
   415                          
   416                          ; E     Not used
   417                          ;
   418                          ; F     The program name provided is the empty string.
   419                          defc    ERR_F_PROG_NAME = $0F - 1
   420                          
   421                          
   422                          
   423                          org     $0000
   424                          
   425                          
   426                          ;*****************************************
   427                          ;** Part 1. RESTART ROUTINES AND TABLES **
   428                          ;*****************************************
   429                          
   430                          ; -----------
   431                          ; THE 'START'
   432                          ; -----------
   433                          ; All Z80 chips start at location zero.
   434                          ; At start-up the Interrupt Mode is 0, ZX computers use Interrupt Mode 1.
   435                          ; Interrupts are disabled .
   436                          
   437                          START:
   438  0000  d3fd                      out     ($FD), a        ; Turn off the NMI generator if this ROM is
   439                                                          ; running in ZX81 hardware. This does nothing
   440                                                          ; if this ROM is running within an upgraded
   441                                                          ; ZX80.
   442  0002  01ff7f                    ld      bc, MAXRAM      ; Set BC to the top of possible RAM.
   443                                                          ; The higher unpopulated addresses are used for
   444                                                          ; video generation.
   445  0005  c3cb03                    jp      RAM_CHECK       ; Jump forward to RAM-CHECK.
   446                          
   447                          ; -------------------
   448                          ; THE 'ERROR' RESTART
   449                          ; -------------------
   450                          ; The error restart deals immediately with an error. ZX computers execute the
   451                          ; same code in runtime as when checking syntax. If the error occurred while
   452                          ; running a program then a brief report is produced. If the error occurred
   453                          ; while entering a BASIC line or in input etc., then the error marker indicates
   454                          ; the exact point at which the error lies.
   455                          
   456                          ERROR_1:
   457  0008  2a1640                    ld      hl, (CH_ADD)    ; fetch character address from CH_ADD.
   458  000b  221840                    ld      (X_PTR), hl     ; and set the error pointer X_PTR.
   459  000e  1846                      jr      ERROR_2         ; forward to continue at ERROR-2.
   460                          
   461                          ; ---
   462                          
   463                          ; -------------------------------
   464                          ; THE 'PRINT A CHARACTER' RESTART
   465                          ; -------------------------------
   466                          ; This restart prints the character in the accumulator using the alternate
   467                          ; register set so there is no requirement to save the main registers.
   468                          ; There is sufficient room available to separate a space (zero) from other
   469                          ; characters as leading spaces need not be considered with a space.
   470                          ; Note. the accumulator is preserved only when printing to the screen.
   471                          
   472                          PRINT_A:
   473  0010  a7                        and     a               ; test for zero - space.
   474  0011  c2f107                    jp      nz, PRINT_CH    ; jump forward if not to PRINT-CH.
   475                          
   476  0014  c3f507                    jp      PRINT_SP        ; jump forward to PRINT-SP.
   477                          
   478                          ; ---
   479                          
   480  0017  ff                        defs    PRINT_A + 8 - ASMPC, $FF
   481                                                          ; fill remaining space
   482                          
   483                          ; ---------------------------------
   484                          ; THE 'COLLECT A CHARACTER' RESTART
   485                          ; ---------------------------------
   486                          ; The character addressed by the system variable CH_ADD is fetched and if it
   487                          ; is a non-space, non-cursor character it is returned else CH_ADD is
   488                          ; incremented and the new addressed character tested until it is not a space.
   489                          
   490                          GET_CHAR:
   491  0018  2a1640                    ld      hl, (CH_ADD)    ; set HL to character address CH_ADD.
   492  001b  7e                        ld      a, (hl)         ; fetch addressed character to A.
   493                          
   494                          TEST_SP:
   495  001c  a7                        and     a               ; test for space.
   496  001d  c0                        ret     nz              ; return if not a space
   497                          
   498  001e  00                        nop                     ; else trickle through
   499  001f  00                        nop                     ; to the next routine.
   500                          
   501                          ; ------------------------------------
   502                          ; THE 'COLLECT NEXT CHARACTER' RESTART
   503                          ; ------------------------------------
   504                          ; The character address in incremented and the new addressed character is
   505                          ; returned if not a space, or cursor, else the process is repeated.
   506                          
   507                          NEXT_CHAR:
   508  0020  cd4900                    call    INC_CH_ADD      ; routine CH-ADD+1 gets next immediate
   509                                                          ; character.
   510  0023  18f7                      jr      TEST_SP         ; back to TEST-SP.
   511                          
   512                          ; ---
   513                          
   514  0025  ffffff                    defs    NEXT_CHAR + 8 - ASMPC, $FF
   515                                                          ; unused locations.
   516                          
   517                          ; ---------------------------------------
   518                          ; THE 'FLOATING POINT CALCULATOR' RESTART
   519                          ; ---------------------------------------
   520                          ; this restart jumps to the recursive floating-point calculator.
   521                          ; the ZX81's internal, FORTH-like, stack-based language.
   522                          ;
   523                          ; In the five remaining bytes there is, appropriately, enough room for the
   524                          ; end-calc literal - the instruction which exits the calculator.
   525                          
   526                          FP_CALC:
   527  0028  c39d19                    jp      CALCULATE       ; jump immediately to the CALCULATE routine.
   528                          
   529                          ; ---
   530                          
   531                          end_calc:
   532  002b  f1                        pop     af              ; drop the calculator return address RE-ENTRY
   533  002c  d9                        exx                     ; switch to the other set.
   534                          
   535  002d  e3                        ex      (sp), hl        ; transfer H'L' to machine stack for the
   536                                                          ; return address.
   537                                                          ; when exiting recursion then the previous
   538                                                          ; pointer is transferred to H'L'.
   539                          
   540  002e  d9                        exx                     ; back to main set.
   541  002f  c9                        ret                     ; return.
   542                          
   543                          
   544                          ; -----------------------------
   545                          ; THE 'MAKE BC SPACES'  RESTART
   546                          ; -----------------------------
   547                          ; This restart is used eight times to create, in workspace, the number of
   548                          ; spaces passed in the BC register.
   549                          
   550                          BC_SPACES:
   551  0030  c5                        push    bc              ; push number of spaces on stack.
   552  0031  2a1440                    ld      hl, (E_LINE)    ; fetch edit line location from E_LINE.
   553  0034  e5                        push    hl              ; save this value on stack.
   554  0035  c38814                    jp      RESERVE         ; jump forward to continue at RESERVE.
   555                          
   556                          ; -----------------------
   557                          ; THE 'INTERRUPT' RESTART
   558                          ; -----------------------
   559                          ;   The Mode 1 Interrupt routine is concerned solely with generating the central
   560                          ;   television picture.
   561                          ;   On the ZX81 interrupts are enabled only during the interrupt routine,
   562                          ;   although the interrupt
   563                          ;   This Interrupt Service Routine automatically disables interrupts at the
   564                          ;   outset and the last interrupt in a cascade exits before the interrupts are
   565                          ;   enabled.
   566                          ;   There is no DI instruction in the ZX81 ROM.
   567                          ;   An maskable interrupt is triggered when bit 6 of the Z80's Refresh register
   568                          ;   changes from set to reset.
   569                          ;   The Z80 will always be executing a HALT (NEWLINE) when the interrupt occurs.
   570                          ;   A HALT instruction repeatedly executes NOPS but the seven lower bits
   571                          ;   of the Refresh register are incremented each time as they are when any
   572                          ;   simple instruction is executed. (The lower 7 bits are incremented twice for
   573                          ;   a prefixed instruction)
   574                          ;   This is controlled by the Sinclair Computer Logic Chip - manufactured from
   575                          ;   a Ferranti Uncommitted Logic Array.
   576                          ;
   577                          ;   When a Mode 1 Interrupt occurs the Program Counter, which is the address in
   578                          ;   the upper echo display following the NEWLINE/HALT instruction, goes on the
   579                          ;   machine stack.  193 interrupts are required to generate the last part of
   580                          ;   the 56th border line and then the 192 lines of the central TV picture and,
   581                          ;   although each interrupt interrupts the previous one, there are no stack
   582                          ;   problems as the 'return address' is discarded each time.
   583                          ;
   584                          ;   The scan line counter in C counts down from 8 to 1 within the generation of
   585                          ;   each text line. For the first interrupt in a cascade the initial value of
   586                          ;   C is set to 1 for the last border line.
   587                          ;   Timing is of the utmost importance as the RH border, horizontal retrace
   588                          ;   and LH border are mostly generated in the 58 clock cycles this routine
   589                          ;   takes .
   590                          
   591                          INTERRUPT:
   592  0038  0d                        dec     c               ; (4)  decrement C - the scan line counter.
   593  0039  c24500                    jp      nz, SCAN_LINE   ; (10/10) jump forward if not zero to SCAN-LINE
   594                          
   595  003c  e1                        pop     hl              ; (10) point to start of next row in display
   596                                                          ;      file.
   597                          
   598  003d  05                        dec     b               ; (4)  decrement the row counter. (4)
   599  003e  c8                        ret     z               ; (11/5) return when picture complete to DISPLAY_5_RET
   600                                                          ;      with interrupts disabled.
   601                          
   602  003f  cbd9                      set     3, c            ; (8)  Load the scan line counter with eight.
   603                                                          ;      Note. LD C, $08 is 7 clock cycles which
   604                                                          ;      is way too fast.
   605                          
   606                          ; ->
   607                          
   608                          WAIT_INT:
   609  0041  ed4f                      ld      r, a            ; (9) Load R with initial rising value $DD.
   610                          
   611  0043  fb                        ei                      ; (4) Enable Interrupts.  [ R is now $DE ].
   612                          
   613  0044  e9                        jp      (hl)            ; (4) jump to the echo display file in upper
   614                                                          ;     memory and execute characters $00 - $3F
   615                                                          ;     as NOP instructions.  The video hardware
   616                                                          ;     is able to read these characters and,
   617                                                          ;     with the I register is able to convert
   618                                                          ;     the character bitmaps in this ROM into a
   619                                                          ;     line of bytes. Eventually the NEWLINE/HALT
   620                                                          ;     will be encountered before R reaches $FF.
   621                                                          ;     It is however the transition from $FF to
   622                                                          ;     $80 that triggers the next interrupt.
   623                                                          ;     [ The Refresh register is now $DF ]
   624                          
   625                          ; ---
   626                          
   627                          SCAN_LINE:
   628  0045  d1                        pop     de              ; (10) discard the address after NEWLINE as the
   629                                                          ;      same text line has to be done again
   630                                                          ;      eight times.
   631                          
   632  0046  c8                        ret     z               ; (5)  Harmless Nonsensical Timing.
   633                                                          ;      (condition never met)
   634                          
   635  0047  18f8                      jr      WAIT_INT        ; (12) back to WAIT-INT
   636                          
   637                          ;   Note. that a computer with less than 4K or RAM will have a collapsed
   638                          ;   display file and the above mechanism deals with both types of display.
   639                          ;
   640                          ;   With a full display, the 32 characters in the line are treated as NOPS
   641                          ;   and the Refresh register rises from $E0 to $FF and, at the next instruction
   642                          ;   - HALT, the interrupt occurs.
   643                          ;   With a collapsed display and an initial NEWLINE/HALT, it is the NOPs
   644                          ;   generated by the HALT that cause the Refresh value to rise from $E0 to $FF,
   645                          ;   triggering an Interrupt on the next transition.
   646                          ;   This works happily for all display lines between these extremes and the
   647                          ;   generation of the 32 character, 1 pixel high, line will always take 128
   648                          ;   clock cycles.
   649                          
   650                          ; ---------------------------------
   651                          ; THE 'INCREMENT CH-ADD' SUBROUTINE
   652                          ; ---------------------------------
   653                          ; This is the subroutine that increments the character address system variable
   654                          ; and returns if it is not the cursor character. The ZX81 has an actual
   655                          ; character at the cursor position rather than a pointer system variable
   656                          ; as is the case with prior and subsequent ZX computers.
   657                          
   658                          INC_CH_ADD:
   659  0049  2a1640                    ld      hl, (CH_ADD)    ; fetch character address to CH_ADD.
   660                          
   661                          TEMP_PTR1:
   662  004c  23                        inc     hl              ; address next immediate location.
   663                          
   664                          TEMP_PTR2:
   665  004d  221640                    ld      (CH_ADD), hl    ; update system variable CH_ADD.
   666                          
   667  0050  7e                        ld      a, (hl)         ; fetch the character.
   668  0051  fe7f                      cp      $7F             ; compare to cursor character.
   669  0053  c0                        ret     nz              ; return if not the cursor.
   670                          
   671  0054  18f6                      jr      TEMP_PTR1       ; back for next character to TEMP-PTR1.
   672                          
   673                          ; --------------------
   674                          ; THE 'ERROR-2' BRANCH
   675                          ; --------------------
   676                          ; This is a continuation of the error restart.
   677                          ; If the error occurred in runtime then the error stack pointer will probably
   678                          ; lead to an error report being printed unless it occurred during input.
   679                          ; If the error occurred when checking syntax then the error stack pointer
   680                          ; will be an editing routine and the position of the error will be shown
   681                          ; when the lower screen is reprinted.
   682                          
   683                          ERROR_2:
   684  0056  e1                        pop     hl              ; pop the return address which points to the
   685                                                          ; DEFB, error code, after the RST 08.
   686  0057  6e                        ld      l, (hl)         ; load L with the error code. HL is not needed
   687                                                          ; anymore.
   688                          
   689                          ERROR_3:
   690  0058  fd7500                    ld      (iy+ERR_NR-IY0), l
   691                                                          ; place error code in system variable ERR_NR
   692  005b  ed7b0240                  ld      sp, (ERR_SP)    ; set the stack pointer from ERR_SP
   693  005f  cd0702                    call    SLOW_FAST       ; routine SLOW/FAST selects slow mode.
   694  0062  c3bc14                    jp      SET_MIN         ; exit to address on stack via routine SET-MIN.
   695                          
   696                          ; ---
   697                          
   698  0065  ff                        defs    0x0066 - ASMPC, $FF
   699                                                          ; unused.
   700                          
   701                          ; ------------------------------------
   702                          ; THE 'NON MASKABLE INTERRUPT' ROUTINE
   703                          ; ------------------------------------
   704                          ;   Jim Westwood's technical dodge using Non-Maskable Interrupts solved the
   705                          ;   flicker problem of the ZX80 and gave the ZX81 a multi-tasking SLOW mode
   706                          ;   with a steady display.  Note that the AF' register is reserved for this
   707                          ;   function and its interaction with the display routines.  When counting
   708                          ;   TV lines, the NMI makes no use of the main registers.
   709                          ;   The circuitry for the NMI generator is contained within the SCL (Sinclair
   710                          ;   Computer Logic) chip.
   711                          ;   ( It takes 32 clock cycles while incrementing towards zero ).
   712                          
   713                          NMI:
   714  0066  08                        ex      af, af'         ; (4) switch in the NMI's copy of the
   715                                                          ;     accumulator.
   716  0067  3c                        inc     a               ; (4) increment.
   717  0068  fa6d00                    jp      m, NMI_RET      ; (10/10) jump, if minus, to NMI-RET as this is
   718                                                          ;     part of a test to see if the NMI
   719                                                          ;     generation is working or an intermediate
   720                                                          ;     value for the ascending negated blank
   721                                                          ;     line counter.
   722                          
   723  006b  2802                      jr      z, NMI_CONT     ; (12) forward to NMI-CONT
   724                                                          ;      when line count has incremented to zero.
   725                          
   726                          ; Note. the synchronizing NMI when A increments from zero to one takes this
   727                          ; 7 clock cycle route making 39 clock cycles in all.
   728                          
   729                          NMI_RET:
   730  006d  08                        ex      af, af'         ; (4)  switch out the incremented line counter
   731                                                          ;      or test result $80
   732  006e  c9                        ret                     ; (10) return to User application for a while.
   733                          
   734                          ; ---
   735                          
   736                          ;   This branch is taken when the 55 (or 31) lines have been drawn.
   737                          
   738                          NMI_CONT:
   739  006f  08                        ex      af, af'         ; (4) restore the main accumulator.
   740                          
   741  0070  f5                        push    af              ; (11) *             Save Main Registers
   742  0071  c5                        push    bc              ; (11) **
   743  0072  d5                        push    de              ; (11) ***
   744  0073  e5                        push    hl              ; (11) ****
   745                          
   746                          ;   the next set-up procedure is only really applicable when the top set of
   747                          ;   blank lines have been generated.
   748                          
   749  0074  2a0c40                    ld      hl, (D_FILE)    ; (16) fetch start of Display File from D_FILE
   750                                                          ;      points to the HALT at beginning.
   751  0077  cbfc                      set     7, h            ; (8) point to upper 32K 'echo display file'
   752                          
   753  0079  76                        halt                    ; (1) HALT synchronizes with NMI.
   754                                                          ; Used with special hardware connected to the
   755                                                          ; Z80 HALT and WAIT lines to take 1 clock cycle.
   756                          
   757                          ; ----------------------------------------------------------------------------
   758                          ;   the NMI has been generated - start counting. The cathode ray is at the RH
   759                          ;   side of the TV.
   760                          ;   First the NMI servicing, similar to CALL            =  17 clock cycles.
   761                          ;   Then the time taken by the NMI for zero-to-one path =  39 cycles
   762                          ;   The HALT above                                      =  01 cycles.
   763                          ;   The two instructions below                          =  19 cycles.
   764                          ;   The code at L0281 up to and including the CALL      =  43 cycles.
   765                          ;   The Called routine at L02B5                         =  24 cycles.
   766                          ;   --------------------------------------                ---
   767                          ;   Total Z80 instructions                              = 143 cycles.
   768                          ;
   769                          ;   Meanwhile in TV world,
   770                          ;   Horizontal retrace                                  =  15 cycles.
   771                          ;   Left blanking border 8 character positions          =  32 cycles
   772                          ;   Generation of 75% scanline from the first NEWLINE   =  96 cycles
   773                          ;   ---------------------------------------               ---
   774                          ;                                                         143 cycles
   775                          ;
   776                          ;   Since at the time the first JP (HL) is encountered to execute the echo
   777                          ;   display another 8 character positions have to be put out, then the
   778                          ;   Refresh register need to hold $F8. Working back and counteracting
   779                          ;   the fact that every instruction increments the Refresh register then
   780                          ;   the value that is loaded into R needs to be $F5.      :-)
   781                          ;
   782                          ;
   783  007a  d3fd                      out     ($FD), a        ; (11) Stop the NMI generator.
   784                          
   785  007c  dde9                      jp      (ix)            ; (8) forward to L0281 (after top) or L028F
   786                          
   787                          
   788                          ; ****************
   789                          ; ** KEY TABLES **
   790                          ; ****************
