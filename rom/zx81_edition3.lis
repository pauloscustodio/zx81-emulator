  2708  07b6  c0                        ret     nz              ;
  2709                          
  2710  07b7  23                        inc     hl              ;
  2711  07b8  23                        inc     hl              ;
  2712  07b9  23                        inc     hl              ;
  2713  07ba  23                        inc     hl              ;
  2714  07bb  23                        inc     hl              ;
  2715  07bc  c9                        ret                     ;
  2716                          
  2717                          ; --------------------------------
  2718                          ; THE 'KEYBOARD DECODE' SUBROUTINE
  2719                          ; --------------------------------
  2720                          ; Input: BC = contents of LAST_K
  2721                          ; B = high byte (column scan mask)
  2722                          ; C = low  byte (section scan mask)
  2723                          ; DECODE loops forever if B=$FF or C=$FF
  2724                          ; Output: Carry set (C=1): a valid key has been decoded.
  2725                          ; HL points to a one-byte table entry containing the ZX81 key code.
  2726                          ; LD A,(HL) retrieves the key code. Shifted keys are also decoded.
  2727                          ; D=0, E=key index in the table
  2728                          
  2729                          DECODE:
  2730  07bd  1600                      ld      d, $00          ;
  2731  07bf  cb28                      sra     b               ;
  2732  07c1  9f                        sbc     a, a            ;
  2733  07c2  f626                      or      $26             ;
  2734  07c4  2e05                      ld      l, $05          ;
  2735  07c6  95                        sub     l               ;
  2736                          
  2737                          KEY_LINE:
  2738  07c7  85                        add     a, l            ;
  2739  07c8  37                        scf                     ; Set Carry Flag
  2740  07c9  cb19                      rr      c               ;
  2741  07cb  38fa                      jr      c, KEY_LINE     ; to KEY-LINE
  2742                          
  2743  07cd  0c                        inc     c               ;
  2744  07ce  c0                        ret     nz              ;
  2745                          
  2746  07cf  48                        ld      c, b            ;
  2747  07d0  2d                        dec     l               ;
  2748  07d1  2e01                      ld      l, $01          ;
  2749  07d3  20f2                      jr      nz, KEY_LINE    ; to KEY-LINE
  2750                          
  2751  07d5  217d00                    ld      hl, $007D       ; (expr reqd)
  2752  07d8  5f                        ld      e, a            ;
  2753  07d9  19                        add     hl, de          ;
  2754  07da  37                        scf                     ; Set Carry Flag
  2755  07db  c9                        ret                     ;
  2756                          
  2757                          ; -------------------------
  2758                          ; THE 'PRINTING' SUBROUTINE
  2759                          ; -------------------------
  2760                          ;
  2761                          ;
  2762                          
  2763                          LEAD_SP:
  2764  07dc  7b                        ld      a, e            ;
  2765  07dd  a7                        and     a               ;
  2766  07de  f8                        ret     m               ;
  2767                          
  2768  07df  1810                      jr      PRINT_CH        ; to PRINT-CH
  2769                          
  2770                          ; ---
  2771                          
  2772                          OUT_DIGIT:
  2773  07e1  af                        xor     a               ;
  2774                          
  2775                          DIGIT_INC:
  2776  07e2  09                        add     hl, bc          ;
  2777  07e3  3c                        inc     a               ;
  2778  07e4  38fc                      jr      c, DIGIT_INC    ; to DIGIT-INC
  2779                          
  2780  07e6  ed42                      sbc     hl, bc          ;
  2781  07e8  3d                        dec     a               ;
  2782  07e9  28f1                      jr      z, LEAD_SP      ; to LEAD-SP
  2783                          
  2784                          OUT_CODE:
  2785  07eb  1e1c                      ld      e, $1C          ;
  2786  07ed  83                        add     a, e            ;
  2787                          
  2788                          OUT_CH:
  2789  07ee  a7                        and     a               ;
  2790  07ef  2804                      jr      z, PRINT_SP     ; to PRINT-SP
  2791                          
  2792                          PRINT_CH:
  2793  07f1  fdcb0186                  res     0, (iy+FLAGS-IY0)
  2794                                                          ; update FLAGS - signal leading space permitted
  2795                          
  2796                          PRINT_SP:
  2797  07f5  d9                        exx                     ;
  2798  07f6  e5                        push    hl              ;
  2799  07f7  fdcb014e                  bit     1, (iy+FLAGS-IY0)
  2800                                                          ; test FLAGS - is printer in use ?
  2801  07fb  2005                      jr      nz, LPRINT_A    ; to LPRINT-A
  2802                          
  2803  07fd  cd0808                    call    ENTER_CH        ; routine ENTER-CH
  2804  0800  1803                      jr      PRINT_EXX       ; to PRINT-EXX
  2805                          
  2806                          ; ---
  2807                          
  2808                          LPRINT_A:
  2809  0802  cd5108                    call    LPRINT_CH       ; routine LPRINT-CH
  2810                          
  2811                          PRINT_EXX:
  2812  0805  e1                        pop     hl              ;
  2813  0806  d9                        exx                     ;
  2814  0807  c9                        ret                     ;
  2815                          
  2816                          ; ---
  2817                          
  2818                          ENTER_CH:
  2819  0808  57                        ld      d, a            ;
  2820  0809  ed4b3940                  ld      bc, (S_POSN)    ; sv S_POSN_x
  2821  080d  79                        ld      a, c            ;
  2822  080e  fe21                      cp      $21             ;
  2823  0810  281a                      jr      z, TEST_LOW     ; to TEST-LOW
  2824                          
  2825                          TEST_NL:
  2826  0812  3e76                      ld      a, $76          ;
  2827  0814  ba                        cp      d               ;
  2828  0815  2830                      jr      z, WRITE_NL     ; to WRITE-N/L
  2829                          
  2830  0817  2a0e40                    ld      hl, (DF_CC)     ; sv DF_CC_lo
  2831  081a  be                        cp      (hl)            ;
  2832  081b  7a                        ld      a, d            ;
  2833  081c  2020                      jr      nz, WRITE_CH    ; to WRITE-CH
  2834                          
  2835  081e  0d                        dec     c               ;
  2836  081f  2019                      jr      nz, EXPAND_1    ; to EXPAND-1
  2837                          
  2838  0821  23                        inc     hl              ;
  2839  0822  220e40                    ld      (DF_CC), hl     ; sv DF_CC_lo
  2840  0825  0e21                      ld      c, $21          ;
  2841  0827  05                        dec     b               ;
  2842  0828  ed433940                  ld      (S_POSN), bc    ; sv S_POSN_x
  2843                          
  2844                          TEST_LOW:
  2845  082c  78                        ld      a, b            ;
  2846  082d  fdbe22                    cp      (iy+DF_SZ-IY0)  ; sv DF_SZ
  2847  0830  2803                      jr      z, REPORT_5     ; to REPORT-5
  2848                          
  2849  0832  a7                        and     a               ;
  2850  0833  20dd                      jr      nz, TEST_NL     ; to TEST-N/L
  2851                          
  2852                          REPORT_5:
  2853  0835  2e04                      ld      l, ERR_4_SCREEN_FULL
  2854                                                          ; 'No more room on screen'
  2855  0837  c35800                    jp      ERROR_3         ; to ERROR-3
  2856                          
  2857                          ; ---
  2858                          
  2859                          EXPAND_1:
  2860  083a  cd9b09                    call    ONE_SPACE       ; routine ONE-SPACE
  2861  083d  eb                        ex      de, hl          ;
  2862                          
  2863                          WRITE_CH:
  2864  083e  77                        ld      (hl), a         ;
  2865  083f  23                        inc     hl              ;
  2866  0840  220e40                    ld      (DF_CC), hl     ; sv DF_CC_lo
  2867  0843  fd3539                    dec     (iy+S_POSN-IY0) ; sv S_POSN_x
  2868  0846  c9                        ret                     ;
  2869                          
  2870                          ; ---
  2871                          
  2872                          WRITE_NL:
  2873  0847  0e21                      ld      c, $21          ;
  2874  0849  05                        dec     b               ;
  2875  084a  fdcb01c6                  set     0, (iy+FLAGS-IY0)
  2876                                                          ; sv FLAGS  - Suppress leading space
  2877  084e  c31809                    jp      LOC_ADDR        ; to LOC-ADDR
  2878                          
  2879                          ; --------------------------
  2880                          ; THE 'LPRINT-CH' SUBROUTINE
  2881                          ; --------------------------
  2882                          ; This routine sends a character to the ZX-Printer placing the code for the
  2883                          ; character in the Printer Buffer.
  2884                          ; Note. PR-CC contains the low byte of the buffer address. The high order byte
  2885                          ; is always constant.
  2886                          
  2887                          
  2888                          LPRINT_CH:
  2889  0851  fe76                      cp      $76             ; compare to NEWLINE.
  2890  0853  281c                      jr      z, COPY_BUFF    ; forward if so to COPY-BUFF
  2891                          
  2892  0855  4f                        ld      c, a            ; take a copy of the character in C.
  2893  0856  3a3840                    ld      a, (PR_CC)      ; fetch print location from PR_CC
  2894  0859  e67f                      and     $7F             ; ignore bit 7 to form true position.
  2895  085b  fe5c                      cp      $5C             ; compare to 33rd location
  2896                          
  2897  085d  6f                        ld      l, a            ; form low-order byte.
  2898  085e  2640                      ld      h, $40          ; the high-order byte is fixed.
  2899                          
  2900  0860  cc7108                    call    z, COPY_BUFF    ; routine COPY-BUFF to send full buffer to
  2901                                                          ; the printer if first 32 bytes full.
  2902                                                          ; (this will reset HL to start.)
  2903                          
  2904  0863  71                        ld      (hl), c         ; place character at location.
  2905  0864  2c                        inc     l               ; increment - will not cross a 256 boundary.
  2906  0865  fd7538                    ld      (iy+PR_CC-IY0), l
  2907                                                          ; update system variable PR_CC
  2908                                                          ; automatically resetting bit 7 to show that
  2909                                                          ; the buffer is not empty.
  2910  0868  c9                        ret                     ; return.
  2911                          
  2912                          ; --------------------------
  2913                          ; THE 'COPY' COMMAND ROUTINE
  2914                          ; --------------------------
  2915                          ; The full character-mapped screen is copied to the ZX-Printer.
  2916                          ; All twenty-four text/graphic lines are printed.
  2917                          
  2918                          COPY:
  2919  0869  1616                      ld      d, $16          ; prepare to copy twenty four text lines.
  2920  086b  2a0c40                    ld      hl, (D_FILE)    ; set HL to start of display file from D_FILE.
  2921  086e  23                        inc     hl              ;
  2922  086f  1805                      jr      COPY_MULT_D     ; forward to COPY*D
  2923                          
  2924                          ; ---
  2925                          
  2926                          ; A single character-mapped printer buffer is copied to the ZX-Printer.
  2927                          
  2928                          COPY_BUFF:
  2929  0871  1601                      ld      d, $01          ; prepare to copy a single text line.
  2930  0873  213c40                    ld      hl, PRBUFF      ; set HL to start of printer buffer PRBUFF.
  2931                          
  2932                          ; both paths converge here.
  2933                          
  2934                          COPY_MULT_D:
  2935  0876  cde702                    call    SET_FAST        ; routine SET-FAST
  2936                          
  2937  0879  c5                        push    bc              ; *** preserve BC throughout.
  2938                                                          ; a pending character may be present
  2939                                                          ; in C from LPRINT-CH
  2940                          
  2941                          COPY_LOOP:
  2942  087a  e5                        push    hl              ; save first character of line pointer. (*)
  2943  087b  af                        xor     a               ; clear accumulator.
  2944  087c  5f                        ld      e, a            ; set pixel line count, range 0-7, to zero.
  2945                          
  2946                          ; this inner loop deals with each horizontal pixel line.
  2947                          
  2948                          COPY_TIME:
  2949  087d  d3fb                      out     ($FB), a        ; bit 2 reset starts the printer motor
  2950                                                          ; with an inactive stylus - bit 7 reset.
  2951  087f  e1                        pop     hl              ; pick up first character of line pointer (*)
  2952                                                          ; on inner loop.
  2953                          
  2954                          COPY_BRK:
  2955  0880  cd460f                    call    BREAK_1         ; routine BREAK-1
  2956  0883  3805                      jr      c, COPY_CONT    ; forward with no keypress to COPY-CONT
  2957                          
  2958                          ; else A will hold 11111111 0
  2959                          
  2960  0885  1f                        rra                     ; 0111 1111
  2961  0886  d3fb                      out     ($FB), a        ; stop ZX printer motor, de-activate stylus.
  2962                          
  2963                          REPORT_D2:
  2964  0888  cf                        rst     ERROR_1         ; ERROR-1
  2965  0889  0c                        defb    ERR_D_BREAK     ; Error Report: BREAK - CONT repeats
  2966                          
  2967                          ; ---
  2968                          
  2969                          COPY_CONT:
  2970  088a  dbfb                      in      a, ($FB)        ; read from printer port.
  2971  088c  87                        add     a, a            ; test bit 6 and 7
  2972  088d  fade08                    jp      m, COPY_END     ; jump forward with no printer to COPY-END
  2973                          
  2974  0890  30ee                      jr      nc, COPY_BRK    ; back if stylus not in position to COPY-BRK
  2975                          
  2976  0892  e5                        push    hl              ; save first character of line pointer (*)
  2977  0893  d5                        push    de              ; ** preserve character line and pixel line.
  2978                          
  2979  0894  7a                        ld      a, d            ; text line count to A?
  2980  0895  fe02                      cp      $02             ; sets carry if last line.
  2981  0897  9f                        sbc     a, a            ; now $FF if last line else zero.
  2982                          
  2983                          ; now cleverly prepare a printer control mask setting bit 2 (later moved to 1)
  2984                          ; of D to slow printer for the last two pixel lines ( E = 6 and 7)
  2985                          
  2986  0898  a3                        and     e               ; and with pixel line offset 0-7
  2987  0899  07                        rlca                    ; shift to left.
  2988  089a  a3                        and     e               ; and again.
  2989  089b  57                        ld      d, a            ; store control mask in D.
  2990                          
  2991                          COPY_NEXT:
  2992  089c  4e                        ld      c, (hl)         ; load character from screen or buffer.
  2993  089d  79                        ld      a, c            ; save a copy in C for later inverse test.
  2994  089e  23                        inc     hl              ; update pointer for next time.
  2995  089f  fe76                      cp      $76             ; is character a NEWLINE ?
  2996  08a1  2824                      jr      z, COPY_NL      ; forward, if so, to COPY-N/L
  2997                          
  2998  08a3  e5                        push    hl              ; * else preserve the character pointer.
  2999                          
  3000  08a4  cb27                      sla     a               ; (?) multiply by two
  3001  08a6  87                        add     a, a            ; multiply by four
  3002  08a7  87                        add     a, a            ; multiply by eight
  3003                          
  3004  08a8  260f                      ld      h, $0F          ; load H with half the address of character set.
  3005  08aa  cb14                      rl      h               ; now $1E or $1F (with carry)
  3006  08ac  83                        add     a, e            ; add byte offset 0-7
  3007  08ad  6f                        ld      l, a            ; now HL addresses character source byte
  3008                          
  3009  08ae  cb11                      rl      c               ; test character, setting carry if inverse.
  3010  08b0  9f                        sbc     a, a            ; accumulator now $00 if normal, $FF if inverse.
  3011                          
  3012  08b1  ae                        xor     (hl)            ; combine with bit pattern at end or ROM.
  3013  08b2  4f                        ld      c, a            ; transfer the byte to C.
  3014  08b3  0608                      ld      b, $08          ; count eight bits to output.
  3015                          
  3016                          COPY_BITS:
  3017  08b5  7a                        ld      a, d            ; fetch speed control mask from D.
  3018  08b6  cb01                      rlc     c               ; rotate a bit from output byte to carry.
  3019  08b8  1f                        rra                     ; pick up in bit 7, speed bit to bit 1
  3020  08b9  67                        ld      h, a            ; store aligned mask in H register.
  3021                          
  3022                          COPY_WAIT:
  3023  08ba  dbfb                      in      a, ($FB)        ; read the printer port
  3024  08bc  1f                        rra                     ; test for alignment signal from encoder.
  3025  08bd  30fb                      jr      nc, COPY_WAIT   ; loop if not present to COPY-WAIT
  3026                          
  3027  08bf  7c                        ld      a, h            ; control byte to A.
  3028  08c0  d3fb                      out     ($FB), a        ; and output to printer port.
  3029  08c2  10f1                      djnz    COPY_BITS       ; loop for all eight bits to COPY-BITS
  3030                          
  3031  08c4  e1                        pop     hl              ; * restore character pointer.
  3032  08c5  18d5                      jr      COPY_NEXT       ; back for adjacent character line to COPY-NEXT
  3033                          
  3034                          ; ---
  3035                          
  3036                          ; A NEWLINE has been encountered either following a text line or as the
  3037                          ; first character of the screen or printer line.
  3038                          
  3039                          COPY_NL:
  3040  08c7  dbfb                      in      a, ($FB)        ; read printer port.
  3041  08c9  1f                        rra                     ; wait for encoder signal.
  3042  08ca  30fb                      jr      nc, COPY_NL     ; loop back if not to COPY-N/L
  3043                          
  3044  08cc  7a                        ld      a, d            ; transfer speed mask to A.
  3045  08cd  0f                        rrca                    ; rotate speed bit to bit 1.
  3046                                                          ; bit 7, stylus control is reset.
  3047  08ce  d3fb                      out     ($FB), a        ; set the printer speed.
  3048                          
  3049  08d0  d1                        pop     de              ; ** restore character line and pixel line.
  3050  08d1  1c                        inc     e               ; increment pixel line 0-7.
  3051  08d2  cb5b                      bit     3, e            ; test if value eight reached.
  3052  08d4  28a7                      jr      z, COPY_TIME    ; back if not to COPY-TIME
  3053                          
  3054                          ; eight pixel lines, a text line have been completed.
  3055                          
  3056  08d6  c1                        pop     bc              ; lose the now redundant first character
  3057                                                          ; pointer
  3058  08d7  15                        dec     d               ; decrease text line count.
  3059  08d8  20a0                      jr      nz, COPY_LOOP   ; back if not zero to COPY-LOOP
  3060                          
  3061  08da  3e04                      ld      a, $04          ; stop the already slowed printer motor.
  3062  08dc  d3fb                      out     ($FB), a        ; output to printer port.
  3063                          
  3064                          COPY_END:
  3065  08de  cd0702                    call    SLOW_FAST       ; routine SLOW/FAST
  3066  08e1  c1                        pop     bc              ; *** restore preserved BC.
  3067                          
  3068                          ; -------------------------------------
  3069                          ; THE 'CLEAR PRINTER BUFFER' SUBROUTINE
  3070                          ; -------------------------------------
  3071                          ; This subroutine sets 32 bytes of the printer buffer to zero (space) and
  3072                          ; the 33rd character is set to a NEWLINE.
  3073                          ; This occurs after the printer buffer is sent to the printer but in addition
  3074                          ; after the 24 lines of the screen are sent to the printer.
  3075                          ; Note. This is a logic error as the last operation does not involve the
  3076                          ; buffer at all. Logically one should be able to use
  3077                          ; 10 LPRINT "HELLO ";
  3078                          ; 20 COPY
  3079                          ; 30 LPRINT ; "WORLD"
  3080                          ; and expect to see the entire greeting emerge from the printer.
  3081                          ; Surprisingly this logic error was never discovered and although one can argue
  3082                          ; if the above is a bug, the repetition of this error on the Spectrum was most
  3083                          ; definitely a bug.
  3084                          ; Since the printer buffer is fixed at the end of the system variables, and
  3085                          ; the print position is in the range $3C - $5C, then bit 7 of the system
  3086                          ; variable is set to show the buffer is empty and automatically reset when
  3087                          ; the variable is updated with any print position - neat.
  3088                          
  3089                          CLEAR_PRB:
  3090  08e2  215c40                    ld      hl, PRBUFF+$20  ; address fixed end of PRBUFF
  3091  08e5  3676                      ld      (hl), $76       ; place a newline at last position.
  3092  08e7  0620                      ld      b, $20          ; prepare to blank 32 preceding characters.
  3093                          
  3094                          PRB_BYTES:
  3095  08e9  2b                        dec     hl              ; decrement address - could be DEC L.
  3096  08ea  3600                      ld      (hl), $00       ; place a zero byte.
  3097  08ec  10fb                      djnz    PRB_BYTES       ; loop for all thirty-two to PRB-BYTES
  3098                          
  3099  08ee  7d                        ld      a, l            ; fetch character print position.
  3100  08ef  cbff                      set     7, a            ; signal the printer buffer is clear.
  3101  08f1  323840                    ld      (PR_CC), a      ; update one-byte system variable PR_CC
  3102  08f4  c9                        ret                     ; return.
  3103                          
  3104                          ; -------------------------
  3105                          ; THE 'PRINT AT' SUBROUTINE
  3106                          ; -------------------------
  3107                          ;
  3108                          ;
  3109                          
  3110                          PRINT_AT:
  3111  08f5  3e17                      ld      a, $17          ;
  3112  08f7  90                        sub     b               ;
  3113  08f8  380b                      jr      c, WRONG_VAL    ; to WRONG-VAL
  3114                          
  3115                          TEST_VAL:
  3116  08fa  fdbe22                    cp      (iy+DF_SZ-IY0)  ; sv DF_SZ
  3117  08fd  da3508                    jp      c, REPORT_5     ; to REPORT-5
  3118                          
  3119  0900  3c                        inc     a               ;
  3120  0901  47                        ld      b, a            ;
  3121  0902  3e1f                      ld      a, $1F          ;
  3122  0904  91                        sub     c               ;
  3123                          
  3124                          WRONG_VAL:
  3125  0905  daad0e                    jp      c, REPORT_B     ; to REPORT-B
  3126                          
  3127  0908  c602                      add     a, $02          ;
  3128  090a  4f                        ld      c, a            ;
  3129                          
  3130                          SET_FIELD:
  3131  090b  fdcb014e                  bit     1, (iy+FLAGS-IY0)
  3132                                                          ; sv FLAGS  - Is printer in use
  3133  090f  2807                      jr      z, LOC_ADDR     ; to LOC-ADDR
  3134                          
  3135  0911  3e5d                      ld      a, $5D          ;
  3136  0913  91                        sub     c               ;
  3137  0914  323840                    ld      (PR_CC), a      ; sv PR_CC
  3138  0917  c9                        ret                     ;
  3139                          
  3140                          ; ----------------------------
  3141                          ; THE 'LOCATE ADDRESS' ROUTINE
  3142                          ; ----------------------------
  3143                          ;
  3144                          ;
  3145                          
  3146                          LOC_ADDR:
  3147  0918  ed433940                  ld      (S_POSN), bc    ; sv S_POSN_x
  3148  091c  2a1040                    ld      hl, (VARS)      ; sv VARS_lo
  3149  091f  51                        ld      d, c            ;
  3150  0920  3e22                      ld      a, $22          ;
  3151  0922  91                        sub     c               ;
  3152  0923  4f                        ld      c, a            ;
  3153  0924  3e76                      ld      a, $76          ;
  3154  0926  04                        inc     b               ;
  3155                          
  3156                          LOOK_BACK:
  3157  0927  2b                        dec     hl              ;
  3158  0928  be                        cp      (hl)            ;
  3159  0929  20fc                      jr      nz, LOOK_BACK   ; to LOOK-BACK
  3160                          
  3161  092b  10fa                      djnz    LOOK_BACK       ; to LOOK-BACK
  3162                          
  3163  092d  23                        inc     hl              ;
  3164  092e  edb1                      cpir                    ;
  3165  0930  2b                        dec     hl              ;
  3166  0931  220e40                    ld      (DF_CC), hl     ; sv DF_CC_lo
  3167  0934  37                        scf                     ; Set Carry Flag
  3168  0935  e0                        ret     po              ;
  3169                          
  3170  0936  15                        dec     d               ;
  3171  0937  c8                        ret     z               ;
  3172                          
  3173  0938  c5                        push    bc              ;
  3174  0939  cd9e09                    call    MAKE_ROOM       ; routine MAKE-ROOM
  3175  093c  c1                        pop     bc              ;
  3176  093d  41                        ld      b, c            ;
  3177  093e  62                        ld      h, d            ;
  3178  093f  6b                        ld      l, e            ;
  3179                          
  3180                          EXPAND_2:
  3181  0940  3600                      ld      (hl), $00       ;
  3182  0942  2b                        dec     hl              ;
  3183  0943  10fb                      djnz    EXPAND_2        ; to EXPAND-2
  3184                          
  3185  0945  eb                        ex      de, hl          ;
  3186  0946  23                        inc     hl              ;
  3187  0947  220e40                    ld      (DF_CC), hl     ; sv DF_CC_lo
  3188  094a  c9                        ret                     ;
  3189                          
  3190                          ; ------------------------------
  3191                          ; THE 'EXPAND TOKENS' SUBROUTINE
  3192                          ; ------------------------------
  3193                          ;
  3194                          ;
  3195                          
  3196                          TOKENS:
  3197  094b  f5                        push    af              ;
  3198  094c  cd7509                    call    TOKEN_ADD       ; routine TOKEN-ADD
  3199  094f  3008                      jr      nc, ALL_CHARS   ; to ALL-CHARS
  3200                          
  3201  0951  fdcb0146                  bit     0, (iy+FLAGS-IY0)
  3202                                                          ; sv FLAGS  - Leading space if set
  3203  0955  2002                      jr      nz, ALL_CHARS   ; to ALL-CHARS
  3204                          
  3205  0957  af                        xor     a               ;
  3206                          
  3207  0958  d7                        rst     PRINT_A         ; PRINT-A
  3208                          
  3209                          ALL_CHARS:
  3210  0959  0a                        ld      a, (bc)         ;
  3211  095a  e63f                      and     $3F             ;
  3212                          
  3213  095c  d7                        rst     PRINT_A         ; PRINT-A
  3214  095d  0a                        ld      a, (bc)         ;
  3215  095e  03                        inc     bc              ;
  3216  095f  87                        add     a, a            ;
  3217  0960  30f7                      jr      nc, ALL_CHARS   ; to ALL-CHARS
  3218                          
