  3967  0bfa  cd020c                    call    STK_TO_A        ; routine STK-TO-A
  3968  0bfd  59                        ld      e, c            ;
  3969  0bfe  c1                        pop     bc              ;
  3970  0bff  51                        ld      d, c            ;
  3971  0c00  4f                        ld      c, a            ;
  3972  0c01  c9                        ret                     ;
