  6476  145f  c5                        push    bc              ;
  6477  1460  e5                        push    hl              ;
  6478  1461  44                        ld      b, h            ;
  6479  1462  4d                        ld      c, l            ;
  6480  1463  2a1440                    ld      hl, (E_LINE)    ; sv E_LINE_lo
  6481  1466  2b                        dec     hl              ;
  6482  1467  cd9e09                    call    MAKE_ROOM       ; routine MAKE-ROOM
  6483  146a  23                        inc     hl              ;
  6484  146b  77                        ld      (hl), a         ;
  6485  146c  c1                        pop     bc              ;
  6486  146d  0b                        dec     bc              ;
  6487  146e  0b                        dec     bc              ;
  6488  146f  0b                        dec     bc              ;
  6489  1470  23                        inc     hl              ;
  6490  1471  71                        ld      (hl), c         ;
  6491  1472  23                        inc     hl              ;
  6492  1473  70                        ld      (hl), b         ;
  6493  1474  f1                        pop     af              ;
  6494  1475  23                        inc     hl              ;
  6495  1476  77                        ld      (hl), a         ;
  6496  1477  62                        ld      h, d            ;
  6497  1478  6b                        ld      l, e            ;
  6498  1479  1b                        dec     de              ;
  6499  147a  3600                      ld      (hl), $00       ;
  6500  147c  c1                        pop     bc              ;
  6501  147d  edb8                      lddr                    ; Copy Bytes
  6502                          
  6503                          DIM_SIZES:
  6504  147f  c1                        pop     bc              ;
  6505  1480  70                        ld      (hl), b         ;
  6506  1481  2b                        dec     hl              ;
  6507  1482  71                        ld      (hl), c         ;
  6508  1483  2b                        dec     hl              ;
  6509  1484  3d                        dec     a               ;
  6510  1485  20f8                      jr      nz, DIM_SIZES   ; back to DIM-SIZES
  6511                          
  6512  1487  c9                        ret                     ; return.
