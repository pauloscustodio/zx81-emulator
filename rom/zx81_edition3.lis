  2514  06d7  cd980a                    call    OUT_NUM         ; routine OUT-NUM
  2515  06da  cdad14                    call    CURSOR_IN       ; routine CURSOR-IN
  2516  06dd  c3c104                    jp      DISPLAY_6       ; to DISPLAY-6
  2517                          
  2518                          ; ---
  2519                          
  2520                          NL_LINE:
