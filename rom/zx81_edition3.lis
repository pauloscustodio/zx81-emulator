  4402                          ;
  4403                          
  4404                          CLASS_1:
  4405  0d3c  cd1c11                    call    LOOK_VARS       ; routine LOOK-VARS
  4406                          
  4407                          CLASS_4_2:
  4408  0d3f  fd362d00                  ld      (iy+FLAGX-IY0), $00
  4409                                                          ; sv FLAGX
  4410  0d43  3008                      jr      nc, SET_STK     ; to SET-STK
  4411                          
  4412  0d45  fdcb2dce                  set     1, (iy+FLAGX-IY0)
  4413                                                          ; sv FLAGX
  4414  0d49  2018                      jr      nz, SET_STRLN   ; to SET-STRLN
  4415                          
  4416                          
  4417                          REPORT_2:
  4418  0d4b  cf                        rst     ERROR_1         ; ERROR-1
  4419  0d4c  01                        defb    ERR_2_UNDEF_VAR ; Error Report: Variable not found
  4420                          
  4421                          ; ---
  4422                          
  4423                          SET_STK:
  4424  0d4d  cca711                    call    z, STK_VAR      ; routine STK-VAR
  4425  0d50  fdcb0176                  bit     6, (iy+FLAGS-IY0)
  4426                                                          ; sv FLAGS  - Numeric or string result?
  4427  0d54  200d                      jr      nz, SET_STRLN   ; to SET-STRLN
  4428                          
  4429  0d56  af                        xor     a               ;
  4430  0d57  cda60d                    call    SYNTAX_Z        ; routine SYNTAX-Z
  4431  0d5a  c4f813                    call    nz, STK_FETCH   ; routine STK-FETCH
  4432  0d5d  212d40                    ld      hl, FLAGX       ; sv FLAGX
  4433  0d60  b6                        or      (hl)            ;
  4434  0d61  77                        ld      (hl), a         ;
  4435  0d62  eb                        ex      de, hl          ;
  4436                          
  4437                          SET_STRLN:
