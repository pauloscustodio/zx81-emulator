  4341  0d18  53                        defb    CLASS_2 - ASMPC ; 53 offset to; Address: CLASS-2
  4342  0d19  0f                        defb    CLASS_3 - ASMPC ; 0F offset to; Address: CLASS-3
  4343  0d1a  6b                        defb    CLASS_4 - ASMPC ; 6B offset to; Address: CLASS-4
  4344  0d1b  13                        defb    CLASS_5 - ASMPC ; 13 offset to; Address: CLASS-5
  4345  0d1c  76                        defb    CLASS_6 - ASMPC ; 76 offset to; Address: CLASS-6
  4346                          
