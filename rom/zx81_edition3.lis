  4217                          ; ---------------------------
  4218                          ; THE 'LINE SCANNING' ROUTINE
  4219                          ; ---------------------------
  4220                          ;
  4221                          ;
  4222                          
  4223                          LINE_SCAN:
  4224  0cba  fd360101                  ld      (iy+FLAGS-IY0), $01
  4225                                                          ; sv FLAGS
  4226  0cbe  cd730a                    call    E_LINE_NO       ; routine E-LINE-NO
  4227                          
  4228                          LINE_RUN:
  4229  0cc1  cdbc14                    call    SET_MIN         ; routine SET-MIN
  4230                          
  4231  0cc4  210040                    ld      hl, ERR_NR      ; sv ERR_NR
  4232  0cc7  36ff                      ld      (hl), ERR_0_OK
  4233                          
  4234  0cc9  212d40                    ld      hl, FLAGX       ; sv FLAGX
  4235  0ccc  cb6e                      bit     5, (hl)         ;
  4236  0cce  280e                      jr      z, LINE_NULL    ; to LINE-NULL
  4237                          
  4238  0cd0  fee3                      cp      $E3             ; 'STOP' ?
  4239  0cd2  7e                        ld      a, (hl)         ;
  4240  0cd3  c26f0d                    jp      nz, INPUT_REP   ; to INPUT-REP
  4241                          
  4242  0cd6  cda60d                    call    SYNTAX_Z        ; routine SYNTAX-Z
  4243  0cd9  c8                        ret     z               ;
  4244                          
  4245                          
  4246  0cda  cf                        rst     ERROR_1         ; ERROR-1
  4247  0cdb  0c                        defb    ERR_D_BREAK     ; Error Report: BREAK - CONT repeats
  4248                          
  4249                          
  4250                          ; --------------------------
  4251                          ; THE 'STOP' COMMAND ROUTINE
  4252                          ; --------------------------
  4253                          ;
  4254                          ;
  4255                          
  4256                          STOP:
  4257  0cdc  cf                        rst     ERROR_1         ; ERROR-1
  4258  0cdd  08                        defb    ERR_9_STOP      ; Error Report: STOP statement
  4259                          
  4260                          ; ---
  4261                          
  4262                          ; the interpretation of a line continues with a check for just spaces
  4263                          ; followed by a carriage return.
  4264                          ; The IF command also branches here with a true value to execute the
  4265                          ; statement after the THEN but the statement can be null so
  4266                          ; 10 IF 1 = 1 THEN
  4267                          ; passes syntax (on all ZX computers).
  4268                          
  4269                          LINE_NULL:
  4270  0cde  df                        rst     GET_CHAR        ; GET-CHAR
  4271  0cdf  0600                      ld      b, $00          ; prepare to index - early.
  4272  0ce1  fe76                      cp      $76             ; compare to NEWLINE.
  4273  0ce3  c8                        ret     z               ; return if so.
  4274                          
  4275  0ce4  4f                        ld      c, a            ; transfer character to C.
  4276                          
  4277  0ce5  e7                        rst     NEXT_CHAR       ; NEXT-CHAR advances.
  4278  0ce6  79                        ld      a, c            ; character to A
  4279  0ce7  d6e1                      sub     $E1             ; subtract 'LPRINT' - lowest command.
  4280  0ce9  383b                      jr      c, REPORT_C2    ; forward if less to REPORT-C2
  4281                          
  4282  0ceb  4f                        ld      c, a            ; reduced token to C
  4283  0cec  21290c                    ld      hl, offset_t    ; set HL to address of offset table.
  4284  0cef  09                        add     hl, bc          ; index into offset table.
  4285  0cf0  4e                        ld      c, (hl)         ; fetch offset
  4286  0cf1  09                        add     hl, bc          ; index into parameter table.
  4287  0cf2  1803                      jr      GET_PARAM       ; to GET-PARAM
  4288                          
  4289                          ; ---
  4290                          
  4291                          SCAN_LOOP:
  4292  0cf4  2a3040                    ld      hl, (T_ADDR)    ; sv T_ADDR_lo
  4293                          
  4294                          ; -> Entry Point to Scanning Loop
  4295                          
  4296                          GET_PARAM:
  4297  0cf7  7e                        ld      a, (hl)         ;
  4298  0cf8  23                        inc     hl              ;
  4299  0cf9  223040                    ld      (T_ADDR), hl    ; sv T_ADDR_lo
  4300                          
  4301  0cfc  01f40c                    ld      bc, SCAN_LOOP   ; Address: SCAN-LOOP
  4302  0cff  c5                        push    bc              ; is pushed on machine stack.
  4303                          
  4304  0d00  4f                        ld      c, a            ;
  4305  0d01  fe0b                      cp      $0B             ;
  4306  0d03  300b                      jr      nc, SEPARATOR   ; to SEPARATOR
  4307                          
  4308  0d05  21160d                    ld      hl, class_tbl   ; class-tbl - the address of the class table.
  4309  0d08  0600                      ld      b, $00          ;
  4310  0d0a  09                        add     hl, bc          ;
  4311  0d0b  4e                        ld      c, (hl)         ;
  4312  0d0c  09                        add     hl, bc          ;
  4313  0d0d  e5                        push    hl              ;
  4314                          
  4315  0d0e  df                        rst     GET_CHAR        ; GET-CHAR
  4316  0d0f  c9                        ret                     ; indirect jump to class routine and
  4317                                                          ; by subsequent RET to SCAN-LOOP.
  4318                          
  4319                          ; -----------------------
  4320                          ; THE 'SEPARATOR' ROUTINE
  4321                          ; -----------------------
  4322                          
  4323                          SEPARATOR:
  4324  0d10  df                        rst     GET_CHAR        ; GET-CHAR
  4325  0d11  b9                        cp      c               ;
  4326  0d12  2012                      jr      nz, REPORT_C2   ; to REPORT-C2
  4327                                                          ; 'Nonsense in BASIC'
  4328                          
  4329  0d14  e7                        rst     NEXT_CHAR       ; NEXT-CHAR
  4330  0d15  c9                        ret                     ; return
  4331                          
  4332                          
