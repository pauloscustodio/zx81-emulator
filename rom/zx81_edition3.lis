  6093                          ; --------------------------
  6094                          ; THE 'DE, (DE+1)' SUBROUTINE
  6095                          ; --------------------------
  6096                          ; INDEX and LOAD Z80 subroutine.
  6097                          ; This emulates the 6800 processor instruction LDX 1,X which loads a two-byte
  6098                          ; value from memory into the register indexing it. Often these are hardly worth
  6099                          ; the bother of writing as subroutines and this one doesn't save any time or
  6100                          ; memory. The timing and space overheads have to be offset against the ease of
  6101                          ; writing and the greater program readability from using such toolkit routines.
  6102                          
  6103                          GET_DE_FROM_DE_PLUS_1:
  6104  12ff  eb                        ex      de, hl          ; move index address into HL.
  6105  1300  23                        inc     hl              ; increment to address word.
  6106  1301  5e                        ld      e, (hl)         ; pick up word low-order byte.
  6107  1302  23                        inc     hl              ; index high-order byte and
  6108  1303  56                        ld      d, (hl)         ; pick it up.
  6109  1304  c9                        ret                     ; return with DE = word.
  6110                          
