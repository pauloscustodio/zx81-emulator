  3619                          ; --------------------------
  3620                          ; THE 'UNSTACK-Z' SUBROUTINE
  3621                          ; --------------------------
  3622                          ; This subroutine is used to return early from a routine when checking syntax.
  3623                          ; On the ZX81 the same routines that execute commands also check the syntax
  3624                          ; on line entry. This enables precise placement of the error marker in a line
  3625                          ; that fails syntax.
  3626                          ; The sequence CALL SYNTAX-Z ; RET Z can be replaced by a call to this routine
  3627                          ; although it has not replaced every occurrence of the above two instructions.
  3628                          ; Even on the ZX-80 this routine was not fully utilized.
  3629                          
  3630                          UNSTACK_Z:
  3631  0ac5  cda60d                    call    SYNTAX_Z        ; routine SYNTAX-Z resets the ZERO flag if
  3632                                                          ; checking syntax.
  3633  0ac8  e1                        pop     hl              ; drop the return address.
  3634  0ac9  c8                        ret     z               ; return to previous calling routine if
  3635                                                          ; checking syntax.
  3636                          
  3637  0aca  e9                        jp      (hl)            ; else jump to the continuation address in
  3638                                                          ; the calling routine as RET would have done.
  3639                          
