  2428                          
  2429  0652  ed4b3040                  ld      bc, (T_ADDR)    ; sv T_ADDR_lo
  2430  0656  cd1809                    call    LOC_ADDR        ; routine LOC-ADDR
  2431  0659  ed5b2940                  ld      de, (NXTLIN)    ; sv NXTLIN_lo
  2432  065d  fd362202                  ld      (iy+DF_SZ-IY0), $02
  2433                                                          ; sv DF_SZ
  2434                          
