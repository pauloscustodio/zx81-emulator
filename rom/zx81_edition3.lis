  4472  0d88  f5                        push    af              ;
  4473  0d89  79                        ld      a, c            ;
  4474  0d8a  f69f                      or      $9F             ;
  4475  0d8c  3c                        inc     a               ;
  4476  0d8d  200b                      jr      nz, REPORT_C    ; to REPORT-C
  4477                          
  4478  0d8f  f1                        pop     af              ;
  4479  0d90  18ad                      jr      CLASS_4_2       ; to CLASS-4-2
  4480                          
