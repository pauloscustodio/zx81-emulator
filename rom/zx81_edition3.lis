  2606                          ;
  2607                          ;
  2608                          
  2609                          OUT_LINE:
  2610  0745  ed4b0a40                  ld      bc, (E_PPC)     ; sv E_PPC_lo
  2611  0749  cdea09                    call    CP_LINES        ; routine CP-LINES
  2612  074c  1692                      ld      d, $92          ;
  2613  074e  2805                      jr      z, TEST_END     ; to TEST-END
  2614                          
  2615  0750  110000                    ld      de, $0000       ;
  2616  0753  cb13                      rl      e               ;
  2617                          
  2618                          TEST_END:
  2619  0755  fd731e                    ld      (iy+BREG-IY0), e
  2620                                                          ; sv BREG
  2621  0758  7e                        ld      a, (hl)         ;
  2622  0759  fe40                      cp      $40             ;
  2623  075b  c1                        pop     bc              ;
  2624  075c  d0                        ret     nc              ;
  2625                          
  2626  075d  c5                        push    bc              ;
  2627  075e  cda50a                    call    OUT_NO          ; routine OUT-NO
  2628  0761  23                        inc     hl              ;
  2629  0762  7a                        ld      a, d            ;
