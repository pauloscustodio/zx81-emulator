  1916                          ; ----------------------------
  1917                          ; THE 'EDIT LINE COPY' SECTION
  1918                          ; ----------------------------
  1919                          ; This routine sets the edit line to just the cursor when
  1920                          ; 1) There is not enough memory to edit a BASIC line.
  1921                          ; 2) The edit key is used during input.
  1922                          ; The entry point LOWER
  1923                          
  1924                          
  1925                          EDIT_INP:
  1926  046f  cdad14                    call    CURSOR_IN       ; routine CURSOR-IN sets cursor only edit line.
  1927                          
  1928                          ; ->
  1929                          
  1930                          LOWER:
  1931  0472  2a1440                    ld      hl, (E_LINE)    ; fetch edit line start from E_LINE.
  1932                          
  1933                          EACH_CHAR:
  1934  0475  7e                        ld      a, (hl)         ; fetch a character from edit line.
  1935  0476  fe7e                      cp      $7E             ; compare to the number marker.
  1936  0478  2008                      jr      nz, END_LINE    ; forward if not to END-LINE
  1937                          
  1938  047a  010600                    ld      bc, $0006       ; else six invisible bytes to be removed.
  1939  047d  cd600a                    call    RECLAIM_2       ; routine RECLAIM-2
  1940  0480  18f3                      jr      EACH_CHAR       ; back to EACH-CHAR
  1941                          
  1942                          ; ---
  1943                          
  1944                          END_LINE:
  1945  0482  fe76                      cp      $76             ;
  1946  0484  23                        inc     hl              ;
  1947  0485  20ee                      jr      nz, EACH_CHAR   ; to EACH-CHAR
  1948                          
  1949                          EDIT_LINE:
  1950  0487  cd3705                    call    CURSOR          ; routine CURSOR sets cursor K or L.
  1951                          
  1952                          EDIT_ROOM:
  1953  048a  cd1f0a                    call    LINE_ENDS       ; routine LINE-ENDS
  1954  048d  2a1440                    ld      hl, (E_LINE)    ; sv E_LINE_lo
  1955  0490  fd3600ff                  ld      (iy+ERR_NR-IY0), ERR_0_OK
  1956                                                          ; sv ERR_NR
  1957  0494  cd6607                    call    COPY_LINE       ; routine COPY-LINE
  1958  0497  fdcb007e                  bit     7, (iy+ERR_NR-IY0)
  1959                                                          ; sv ERR_NR
  1960  049b  2024                      jr      nz, DISPLAY_6   ; to DISPLAY-6
  1961                          
  1962  049d  3a2240                    ld      a, (DF_SZ)      ; sv DF_SZ
  1963  04a0  fe18                      cp      $18             ;
  1964  04a2  301d                      jr      nc, DISPLAY_6   ; to DISPLAY-6
  1965                          
  1966  04a4  3c                        inc     a               ;
  1967  04a5  322240                    ld      (DF_SZ), a      ; sv DF_SZ
  1968  04a8  47                        ld      b, a            ;
  1969  04a9  0e01                      ld      c, $01          ;
  1970  04ab  cd1809                    call    LOC_ADDR        ; routine LOC-ADDR
  1971  04ae  54                        ld      d, h            ;
  1972  04af  5d                        ld      e, l            ;
  1973  04b0  7e                        ld      a, (hl)         ;
  1974                          
  1975                          FREE_LINE:
  1976  04b1  2b                        dec     hl              ;
  1977  04b2  be                        cp      (hl)            ;
  1978  04b3  20fc                      jr      nz, FREE_LINE   ; to FREE-LINE
  1979                          
  1980  04b5  23                        inc     hl              ;
  1981  04b6  eb                        ex      de, hl          ;
  1982  04b7  3a0540                    ld      a, (RAMTOP+1)   ; sv RAMTOP_hi
  1983  04ba  fe4d                      cp      $4D             ;
  1984  04bc  dc5d0a                    call    c, RECLAIM_1    ; routine RECLAIM-1
  1985  04bf  18c9                      jr      EDIT_ROOM       ; to EDIT-ROOM
