  2491  06b5  012101                    ld      bc, $0121       ;
  2492  06b8  cd1809                    call    LOC_ADDR        ; routine LOC-ADDR
  2493  06bb  3a0040                    ld      a, (ERR_NR)     ; sv ERR_NR
  2494  06be  ed4b0740                  ld      bc, (PPC)       ; sv PPC_lo
  2495  06c2  3c                        inc     a               ;
  2496  06c3  280c                      jr      z, REPORT       ; to REPORT
  2497                          
  2498  06c5  fe09                      cp      $09             ;
  2499  06c7  2001                      jr      nz, CONTINUE    ; to CONTINUE
  2500                          
  2501  06c9  03                        inc     bc              ;
  2502                          
