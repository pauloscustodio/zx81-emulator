  1052                                                          ; INPUT
  1053  01ab  313426a9                  defb    $31, $34, $26, $29+$80
  1054                                                          ; LOAD
  1055  01af  312e38b9                  defb    $31, $2E, $38, $39+$80
  1056                                                          ; LIST
  1057  01b3  312ab9                    defb    $31, $2A, $39+$80
  1058                                                          ; LET
  1059  01b6  35263a38aa                defb    $35, $26, $3A, $38, $2A+$80
  1060                                                          ; PAUSE
