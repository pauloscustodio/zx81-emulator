  6594                          SET_MIN:
  6595  14bc  215d40                    ld      hl, MEMBOT      ; normal location of calculator's memory area
  6596  14bf  221f40                    ld      (MEM), hl       ; update system variable MEM
  6597  14c2  2a1a40                    ld      hl, (STKBOT)    ; fetch STKBOT
  6598  14c5  18e2                      jr      SET_STK_E       ; back to SET-STK-E
  6599                          
