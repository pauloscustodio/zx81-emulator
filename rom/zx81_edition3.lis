  1874                          
  1875  043b  2a0a40                    ld      hl, (E_PPC)     ; sv E_PPC_lo
  1876  043e  cdd809                    call    LINE_ADDR       ; routine LINE-ADDR
  1877  0441  2a1640                    ld      hl, (CH_ADD)    ; sv CH_ADD_lo
  1878  0444  37                        scf                     ; Set Carry Flag
  1879  0445  ed52                      sbc     hl, de          ;
  1880  0447  212340                    ld      hl, S_TOP       ; sv S_TOP_lo
  1881  044a  300b                      jr      nc, INC_LINE    ; to INC-LINE
  1882                          
  1883  044c  eb                        ex      de, hl          ;
  1884  044d  7e                        ld      a, (hl)         ;
  1885  044e  23                        inc     hl              ;
  1886  044f  eda0                      ldi                     ;
  1887  0451  12                        ld      (de), a         ;
  1888  0452  18c5                      jr      UPPER           ; to UPPER
