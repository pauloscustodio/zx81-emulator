  2658                          
  2659  0789  fe7f                      cp      $7F             ;
  2660  078b  2810                      jr      z, OUT_CURS     ; to OUT-CURS
  2661                          
  2662  078d  fe76                      cp      $76             ;
  2663  078f  285d                      jr      z, OUT_CH       ; to OUT-CH
  2664                          
  2665  0791  cb77                      bit     6, a            ;
  2666  0793  2805                      jr      z, NOT_TOKEN    ; to NOT-TOKEN
  2667                          
