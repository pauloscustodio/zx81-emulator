  1897  0458  23                        inc     hl              ;
  1898  0459  56                        ld      d, (hl)         ;
  1899  045a  e5                        push    hl              ;
  1900  045b  eb                        ex      de, hl          ;
  1901  045c  23                        inc     hl              ;
  1902  045d  cdd809                    call    LINE_ADDR       ; routine LINE-ADDR
