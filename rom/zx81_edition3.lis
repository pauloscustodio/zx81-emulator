  2540  0705  c1                        pop     bc              ;
  2541  0706  79                        ld      a, c            ;
  2542  0707  3d                        dec     a               ;
  2543  0708  b0                        or      b               ;
  2544  0709  c8                        ret     z               ;
  2545                          
  2546  070a  c5                        push    bc              ;
  2547  070b  03                        inc     bc              ;
  2548  070c  03                        inc     bc              ;
  2549  070d  03                        inc     bc              ;
  2550  070e  03                        inc     bc              ;
  2551  070f  2b                        dec     hl              ;
  2552  0710  cd9e09                    call    MAKE_ROOM       ; routine MAKE-ROOM
  2553  0713  cd0702                    call    SLOW_FAST       ; routine SLOW/FAST
  2554  0716  c1                        pop     bc              ;
  2555  0717  c5                        push    bc              ;
  2556  0718  13                        inc     de              ;
  2557  0719  2a1a40                    ld      hl, (STKBOT)    ; sv STKBOT_lo
  2558  071c  2b                        dec     hl              ;
  2559  071d  edb8                      lddr                    ; copy bytes
  2560  071f  2a0a40                    ld      hl, (E_PPC)     ; sv E_PPC_lo
  2561  0722  eb                        ex      de, hl          ;
