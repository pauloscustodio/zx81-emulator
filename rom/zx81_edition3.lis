  4485  0d95  fdcb0176                  bit     6, (iy+FLAGS-IY0)
  4486                                                          ; sv FLAGS  - Numeric or string result?
  4487  0d99  c0                        ret     nz              ;
  4488                          
  4489                          
  4490                          REPORT_C:
