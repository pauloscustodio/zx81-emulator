  6374                          ; --------------------------
  6375                          ; THE 'STK-FETCH' SUBROUTINE
  6376                          ; --------------------------
  6377                          ; This routine fetches a five-byte value from the calculator stack
  6378                          ; reducing the pointer to the end of the stack by five.
  6379                          ; For a floating-point number the exponent is in A and the mantissa
  6380                          ; is the thirty-two bits EDCB.
  6381                          ; For strings, the start of the string is in DE and the length in BC.
  6382                          ; A is unused.
  6383                          
  6384                          STK_FETCH:
  6385  13f8  2a1c40                    ld      hl, (STKEND)    ; load HL from system variable STKEND
  6386                          
  6387  13fb  2b                        dec     hl              ;
  6388  13fc  46                        ld      b, (hl)         ;
  6389  13fd  2b                        dec     hl              ;
  6390  13fe  4e                        ld      c, (hl)         ;
  6391  13ff  2b                        dec     hl              ;
  6392  1400  56                        ld      d, (hl)         ;
  6393  1401  2b                        dec     hl              ;
  6394  1402  5e                        ld      e, (hl)         ;
  6395  1403  2b                        dec     hl              ;
  6396  1404  7e                        ld      a, (hl)         ;
  6397                          
  6398  1405  221c40                    ld      (STKEND), hl    ; set system variable STKEND to lower value.
  6399  1408  c9                        ret                     ; return.
  6400                          
