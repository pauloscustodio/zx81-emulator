  2112                                                          ; base address of ED-KEYS (exp reqd)
  2113  0531  19                        add     hl, de          ;
  2114  0532  19                        add     hl, de          ;
  2115  0533  4e                        ld      c, (hl)         ;
  2116  0534  23                        inc     hl              ;
  2117  0535  46                        ld      b, (hl)         ;
