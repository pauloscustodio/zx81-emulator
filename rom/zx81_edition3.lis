  4450  0d6c  3a0140                    ld      a, (FLAGS)      ; sv FLAGS
  4451                          
  4452                          INPUT_REP:
  4453  0d6f  f5                        push    af              ;
  4454  0d70  cd550f                    call    SCANNING        ; routine SCANNING
  4455  0d73  f1                        pop     af              ;
  4456  0d74  012113                    ld      bc, LET         ; Address: LET
  4457  0d77  fd5601                    ld      d, (iy+FLAGS-IY0)
  4458                                                          ; sv FLAGS
  4459  0d7a  aa                        xor     d               ;
  4460  0d7b  e640                      and     $40             ;
  4461  0d7d  201b                      jr      nz, REPORT_C    ; to REPORT-C
  4462                          
  4463  0d7f  cb7a                      bit     7, d            ;
  4464  0d81  20b7                      jr      nz, CLASS_END   ; to CLASS-END
  4465                          
  4466  0d83  189d                      jr      CHECK_2         ; to CHECK-2
  4467                          
