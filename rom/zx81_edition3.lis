  2573                          ; ---------------------------------------
  2574                          ; THE 'LIST' AND 'LLIST' COMMAND ROUTINES
  2575                          ; ---------------------------------------
  2576                          ;
  2577                          ;
  2578                          
  2579                          LLIST:
  2580  072c  fdcb01ce                  set     1, (iy+FLAGS-IY0)
  2581                                                          ; sv FLAGS  - signal printer in use
  2582                          
  2583                          LIST:
  2584  0730  cda70e                    call    FIND_INT        ; routine FIND-INT
  2585                          
  2586  0733  78                        ld      a, b            ; fetch high byte of user-supplied line number.
  2587  0734  e63f                      and     $3F             ; and crudely limit to range 1-16383.
  2588                          
  2589  0736  67                        ld      h, a            ;
  2590  0737  69                        ld      l, c            ;
  2591  0738  220a40                    ld      (E_PPC), hl     ; sv E_PPC_lo
  2592  073b  cdd809                    call    LINE_ADDR       ; routine LINE-ADDR
  2593                          
  2594                          LIST_PROG:
  2595  073e  1e00                      ld      e, $00          ;
  2596                          
  2597                          UNTIL_END:
  2598  0740  cd4507                    call    OUT_LINE        ; routine OUT-LINE lists one line of BASIC
  2599                                                          ; making an early return when the screen is
  2600                                                          ; full or the end of program is reached.    >>
  2601  0743  18fb                      jr      UNTIL_END       ; loop back to UNTIL-END
  2602                          
  2603                          ; -----------------------------------
  2604                          ; THE 'PRINT A BASIC LINE' SUBROUTINE
