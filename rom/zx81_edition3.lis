  2449  0670  cd4d00                    call    TEMP_PTR2       ; routine TEMP-PTR-2
  2450  0673  cdc10c                    call    LINE_RUN        ; routine LINE-RUN
  2451  0676  fdcb018e                  res     1, (iy+FLAGS-IY0)
  2452                                                          ; sv FLAGS  - Signal printer not in use
  2453  067a  3ec0                      ld      a, $C0          ;
  2454  067c  fd7719                    ld      (iy+X_PTR+1-IY0), a
  2455                                                          ; sv X_PTR_hi
  2456  067f  cda314                    call    X_TEMP          ; routine X-TEMP
  2457  0682  fdcb2dae                  res     5, (iy+FLAGX-IY0)
  2458                                                          ; sv FLAGX
