  2135  0548  23                        inc     hl              ;
  2136  0549  cdb407                    call    NUMBER          ; routine NUMBER
  2137  054c  28f6                      jr      z, TEST_CHAR    ; to TEST-CHAR
  2138                          
  2139  054e  fe26                      cp      $26             ;
  2140  0550  38f2                      jr      c, TEST_CHAR    ; to TEST-CHAR
  2141                          
  2142  0552  fede                      cp      $de             ;
  2143  0554  28ea                      jr      z, K_MODE       ; to K-MODE
  2144                          
  2145                          L_MODE:
