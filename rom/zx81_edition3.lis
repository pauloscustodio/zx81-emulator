  4379  0d2a  cd9c0d                    call    NO_TO_STK       ; routine NO-TO-STK
  4380                          
  4381                          CLASS_0:
  4382  0d2d  bf                        cp      a               ;
  4383                          
  4384                          CLASS_5:
  4385  0d2e  c1                        pop     bc              ;
  4386  0d2f  cc1d0d                    call    z, CHECK_END    ; routine CHECK-END
  4387  0d32  eb                        ex      de, hl          ;
  4388  0d33  2a3040                    ld      hl, (T_ADDR)    ; sv T_ADDR_lo
  4389  0d36  4e                        ld      c, (hl)         ;
  4390  0d37  23                        inc     hl              ;
  4391  0d38  46                        ld      b, (hl)         ;
  4392  0d39  eb                        ex      de, hl          ;
  4393                          
  4394                          CLASS_END:
  4395  0d3a  c5                        push    bc              ;
  4396  0d3b  c9                        ret                     ;
  4397                          
  4398                          ; ------------------------------
  4399                          ; COMMAND CLASSES 01, 02, 04, 06
