  3838                          ; --------------------------------------
  3839                          ; THE 'PLOT AND UNPLOT' COMMAND ROUTINES
  3840                          ; --------------------------------------
  3841                          ;
  3842                          ; The graphic character codes used by PLOT are formed by assigning values as follows:
  3843                          ;
  3844                          ; +---+---+
  3845                          ; | 1 | 2 |
  3846                          ; +---+---+
  3847                          ; | 4 |   |
  3848                          ; +---+---+
  3849                          ;
  3850                          ; This yields codes $00 to $07:
  3851                          ;
  3852                          ; +---+---+ +---+---+ +---+---+ +---+---+ +---+---+ +---+---+ +---+---+ +---+---+
  3853                          ; |   |   | |###|   | |   |###| |###|###| |   |   | |###|   | |   |###| |###|###|
  3854                          ; +---+---+ +---+---+ +---+---+ +---+---+ +---+---+ +---+---+ +---+---+ +---+---+
  3855                          ; |   |   | |   |   | |   |   | |   |   | |###|   | |###|   | |###|   | |###|   |
  3856                          ; +---+---+ +---+---+ +---+---+ +---+---+ +---+---+ +---+---+ +---+---+ +---+---+
  3857                          ;    $00       $01       $02       $03       $04       $05       $06       $07
  3858                          ;
  3859                          ; The inverse characters are therefore available via codes $80 to $87:
  3860                          ;
  3861                          ; +---+---+ +---+---+ +---+---+ +---+---+ +---+---+ +---+---+ +---+---+ +---+---+
  3862                          ; |###|###| |   |###| |###|   | |   |   | |###|###| |   |###| |###|   | |   |   |
  3863                          ; +---+---+ +---+---+ +---+---+ +---+---+ +---+---+ +---+---+ +---+---+ +---+---+
  3864                          ; |###|###| |###|###| |###|###| |###|###| |   |###| |   |###| |   |###| |   |###|
  3865                          ; +---+---+ +---+---+ +---+---+ +---+---+ +---+---+ +---+---+ +---+---+ +---+---+
  3866                          ;    $80       $81       $82       $83       $84       $85       $86       $87
  3867                          
  3868                          PLOT_UNPLOT:
  3869  0baf  cdf50b                    call    STK_TO_BC       ; Call routine STK-TO-BC to fetch the x coordinate
  3870                                                          ; to C and the y coordinate to B.
  3871  0bb2  ed433640                  ld      (COORDS), bc    ; Store the coordinates in system variable COORDS.
  3872                          
  3873  0bb6  3e2b                      ld      a, 43           ; Is the specified y coordinate out of range, i.e. greater than 43?
  3874  0bb8  90                        sub     b               ;
  3875  0bb9  daad0e                    jp      c, REPORT_B     ; Jump if so to produce an error (REPORT-B).
  3876                          
  3877                          ; The y coordinate is within range and has been negated.
  3878                          
  3879  0bbc  47                        ld      b, a            ; Store 43-y in B.
  3880                          
  3881  0bbd  3e01                      ld      a, $01          ; Assume it is a point with even x and y coordinates.
  3882  0bbf  cb28                      sra     b               ; Test whether an even or odd y coordinate by dividing B by 2.
  3883  0bc1  3002                      jr      nc, COLUMNS     ; Jump if an even coordinate to COLUMNS.
  3884                          
  3885  0bc3  3e04                      ld      a, $04          ; It is an odd y coordinate, but still assume an even x coordinate.
  3886                          
  3887                          COLUMNS:
  3888  0bc5  cb29                      sra     c               ; Test whether an even or odd x coordinate by dividing C by 2.
  3889  0bc7  3001                      jr      nc, FIND_ADDR   ; Jump if an even coordinate to FIND-ADDR.
  3890                          
  3891  0bc9  07                        rlca                    ; It is an odd x coordinate so multiple by 2, i.e. A holds
  3892                                                          ; $02 (even y coordinate) or $08 (odd y coordinate).
  3893                          
  3894                          ; By here the A register holds either $01 (even y, even x), $02 (even y, odd x),
  3895                          ; $04 (odd y, even x) or $08 (odd y, odd x),
  3896                          ; and B holds the row position and C the column position.
  3897                          
  3898                          FIND_ADDR:
  3899  0bca  f5                        push    af              ; Save the generated plot code.
  3900  0bcb  cdf508                    call    PRINT_AT        ; Call routine PRINT-AT to find the location within the display file.
  3901  0bce  7e                        ld      a, (hl)         ; Fetch the current character at the display file location.
  3902  0bcf  07                        rlca                    ; Shift such that the 'invert' flags goes into bit 0. The low
  3903                                                          ; 4 bits uniquely identifies all graphic plot characters.
  3904  0bd0  fe10                      cp      $10             ; Did the location hold a graphic plot character (code $00 to $0F)?
  3905  0bd2  3006                      jr      nc, TABLE_PTR   ; Jump if not to TABLE-PTR.
  3906                          
  3907  0bd4  0f                        rrca                    ; Shift to restore the 'invert' flag, testing it in the process.
  3908  0bd5  3002                      jr      nc, SQ_SAVED    ; Jump if the 'invert' flag is reset (i.e. a non-inverted
  3909                                                          ; character) to SQ-SAVED.
  3910                          
  3911  0bd7  ee8f                      xor     $8F             ; The existing character code is inverted so un-invert it.
  3912                          
  3913                          SQ_SAVED:
  3914  0bd9  47                        ld      b, a            ; Store the non-inverted character code of the existing
  3915                                                          ; graphic character.
  3916                          
  3917                          ; Now determine whether plotting or unplotting.
  3918                          
  3919                          TABLE_PTR:
  3920  0bda  119e0c                    ld      de, P_UNPLOT    ; Address: P-UNPLOT
  3921  0bdd  3a3040                    ld      a, (T_ADDR)     ; sv T_ADDR_lo
  3922  0be0  93                        sub     e               ;
  3923  0be1  fae90b                    jp      m, PLOT         ; Jump if plotting to PLOT.
  3924                          
  3925  0be4  f1                        pop     af              ; Fetch the plot code.
  3926  0be5  2f                        cpl                     ; Invert it and
  3927  0be6  a0                        and     b               ; mask out the point in the existing character code.
  3928  0be7  1802                      jr      UNPLOT          ; Jump ahead to UNPLOT.
  3929                          
  3930                          ; ---
  3931                          
  3932                          PLOT:
  3933  0be9  f1                        pop     af              ; Fetch the plot code and
  3934  0bea  b0                        or      b               ; set the point in the existing character code.
  3935                          
  3936                          ; Plot and unplot join here. If the new generated graphic code is above $07 then it needs to
  3937                          ; be represented by an inverse character code.
  3938                          
  3939                          UNPLOT:
  3940  0beb  fe08                      cp      $08             ; If the new graphic code below $08?
  3941  0bed  3802                      jr      c, PLOT_END     ; Jump if so to PLOT-END.
  3942                          
  3943  0bef  ee8f                      xor     $8F             ; Invert the graphic code to form the appropriate
  3944                                                          ; inverse character code.
  3945                          
  3946                          ; The character code to display has been constructed.
  3947                          
  3948                          PLOT_END:
  3949  0bf1  d9                        exx                     ; Preserve the main registers.
  3950                          
  3951  0bf2  d7                        rst     PRINT_A         ; Call PRINT-A to update the display file location with
  3952                                                          ; the new character code.
  3953                          
  3954  0bf3  d9                        exx                     ; Restore the main registers.
  3955  0bf4  c9                        ret
  3956                          
